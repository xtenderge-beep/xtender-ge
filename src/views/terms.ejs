<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('terms_page_title') %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'] } } }
        }
    </script>
    <style>
        .lang-btn.active { background: #fff; color: #1c1917; font-weight: 800; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
    </style>
</head>
<body class="font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

    <header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
        <div class="max-w-xl mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-xl font-black tracking-tight text-stone-900">xtender<span class="text-emerald-600">.ge</span></span>
                </a>
                <div class="flex bg-stone-100 p-1 rounded-xl text-xs font-bold border border-stone-200">
                    <a href="/lang/ka" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ka' ? 'active' : 'hover:bg-white/50' %>">GE</a>
                    <a href="/lang/ru" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ru' ? 'active' : 'hover:bg-white/50' %>">RU</a>
                    <a href="/lang/en" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'en' ? 'active' : 'hover:bg-white/50' %>">EN</a>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-xl mx-auto px-4 py-8">
        <h1 class="text-xl font-black tracking-tight text-stone-900"><%= t('terms_headline') %></h1>

        <div class="mt-4 bg-white rounded-2xl shadow-xl border border-stone-200/80 p-5 sm:p-6 space-y-4 text-sm text-stone-700 leading-relaxed">
            <% t('terms_body').split('\n\n').forEach(function (paragraph) { %>
                <p><%= paragraph %></p>
            <% }); %>
        </div>
    </main>
</body>
</html>

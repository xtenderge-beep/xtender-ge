<%#
  Анимация «как работает заявка» рядом с формой (на телефоне — под ней).
  Сцена нарисована в координатах 480×420 и масштабируется целиком (public/js/home-explainer.js),
  поэтому сдвиги полётов ниже заданы в этих координатах. Тексты — home-explainer-copy.js.
  Шаги для чтения с экрана — в списке .hx-sr; сама картинка скрыта от них (aria-hidden).
%>
<section class="hx" id="homeExplainer">
  <svg width="0" height="0" class="hx-defs" aria-hidden="true" focusable="false">
    <symbol id="hx-i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></symbol>
    <symbol id="hx-i-phone" viewBox="0 0 24 24"><path d="M7 3.5h2.8l1.5 4-2 1.4a11.5 11.5 0 0 0 5.8 5.8l1.4-2 4 1.5v2.8a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 5 5.7a2 2 0 0 1 2-2.2z"/></symbol>
    <symbol id="hx-i-doc" viewBox="0 0 24 24"><path d="M6 3.5h8.5L19 8v12.5H6z"/><path d="M14.5 3.5V8H19M9 12.5h6.5M9 16h4.5"/></symbol>
    <symbol id="hx-i-truck" viewBox="0 0 24 24"><path d="M2.5 6.5h10.5v9.5H2.5z"/><path d="M13 9.5h4.2l3.3 3.4v3.1H13"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="16.8" cy="17.5" r="1.8"/></symbol>
    <symbol id="hx-i-movers" viewBox="0 0 24 24"><circle cx="9" cy="7.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="8.5" r="2.4"/><path d="M15.8 13.6a4.6 4.6 0 0 1 5.2 4.6"/></symbol>
    <symbol id="hx-i-replay" viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4.5v4h4"/></symbol>
    <symbol id="hx-i-up" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></symbol>
  </svg>
  <%# Свёрнута по умолчанию: первый экран говорит только главное, подробности — по кнопке (решение владельца 2026-10-01). %>
  <button type="button" class="hx-toggle" id="hxToggle" aria-expanded="false" aria-controls="hxPanel" data-label-open="<%= t('home_nav_how') %>" data-label-close="<%= t('explainer_collapse') %>">
    <span class="hx-toggle-ic" aria-hidden="true"><svg class="hx-i hx-ic-play" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none"/></svg><svg class="hx-i hx-ic-close"><use href="#hx-i-up"/></svg></span>
    <span class="hx-toggle-t"><%= t('home_nav_how') %></span>
  </button>
  <div class="hx-panel" id="hxPanel" role="region" aria-labelledby="hx-title" hidden>
  <h2 id="hx-title" class="hx-sr"><%= t('explainer_title') %></h2>
  <ol class="hx-sr" id="hxSteps">
    <li><%= t('explainer_step1') %></li>
    <li><%= t('explainer_step2') %></li>
    <li><%= t('explainer_step3') %></li>
    <li><%= t('explainer_step4') %></li>
  </ol>

  <div class="hx-head" aria-hidden="true">
    <ol class="hx-dots">
      <li class="is-current">1</li>
      <li>2</li>
      <li>3</li>
      <li><svg class="hx-i"><use href="#hx-i-check"/></svg></li>
    </ol>
    <p class="hx-now" id="hxNow"><%= t('explainer_step1') %></p>
  </div>

  <div class="hx-vis">
    <div class="hx-canvas" aria-hidden="true">
      <svg class="hx-crowd" viewBox="0 0 480 420">
        <% const people = [
             { x: 75, y: 268, at: 5.55, shirt: '#c9774e', neck: '#b07a50', skin: '#c68c5f', hair: 'cap', hairColor: '#173f32', visor: '#12352a', icon: 'movers' },
             { x: 185, y: 268, at: 5.65, shirt: '#2f6f8f', neck: '#e5b68b', skin: '#f2c9a0', hair: 'short', hairColor: '#3a2a20', icon: 'truck' },
             { x: 295, y: 268, at: 5.75, shirt: '#b5673f', neck: '#e0a982', skin: '#e8b98e', hair: 'curly', hairColor: '#7a4b2a', icon: 'movers' },
             { x: 405, y: 268, at: 5.85, shirt: '#3e7d5f', neck: '#e5b68b', skin: '#f2c9a0', hair: 'short', hairColor: '#d9b27c', icon: 'truck' },
             { x: 130, y: 350, at: 5.95, shirt: '#d0844f', neck: '#a8714a', skin: '#b97a50', hair: 'short', hairColor: '#1f1a17', icon: 'movers' },
             { x: 240, y: 350, at: 6.05, shirt: '#285f7a', neck: '#e5b68b', skin: '#f2c9a0', hair: 'cap', hairColor: '#c9774e', visor: '#a85f39', icon: 'truck' },
             { x: 350, y: 350, at: 6.15, shirt: '#356d52', neck: '#c9966b', skin: '#d9a77c', hair: 'curly', hairColor: '#2b211c', icon: 'truck' },
           ]; %>
        <% people.forEach(function (p) { %>
        <g transform="translate(<%= p.x %>,<%= p.y %>) scale(.9)">
          <g class="hx-bust" data-at="<%= p.at %>" data-until="<%= (p.at + 0.55).toFixed(2) %>"><g class="hx-bb">
            <rect x="-38" y="26" width="76" height="120" rx="30" fill="<%= p.shirt %>"/>
            <rect x="-8" y="18" width="16" height="12" fill="<%= p.neck %>"/>
            <circle cx="0" cy="0" r="24" fill="<%= p.skin %>"/>
            <% if (p.hair === 'cap') { %>
            <path d="M-24 -4 A24 24 0 0 1 24 -4 Z" fill="<%= p.hairColor %>"/><path d="M6 -7 h24 a3.5 3.5 0 0 1 0 7 h-24 z" fill="<%= p.visor %>"/>
            <% } else if (p.hair === 'curly') { %>
            <path d="M-24 2 Q-26 -14 -12 -20 Q0 -26 12 -20 Q26 -14 24 2 Q18 -8 0 -9 Q-18 -8 -24 2 Z" fill="<%= p.hairColor %>"/>
            <% } else { %>
            <path d="M-24 -2 A24 24 0 0 1 24 -2 Q12 -14 0 -11 Q-12 -14 -24 -2 Z" fill="<%= p.hairColor %>"/>
            <% } %>
            <g class="hx-eyes"><circle cx="-8" cy="2" r="2.6" fill="#152e29"/><circle cx="8" cy="2" r="2.6" fill="#152e29"/></g>
            <path d="M-8 11 Q0 17 8 11" fill="none" stroke="#152e29" stroke-width="2.4" stroke-linecap="round"/>
            <circle cx="0" cy="64" r="15" fill="#fff"/>
            <use href="#hx-i-<%= p.icon %>" x="-10" y="54" width="20" height="20" class="hx-u" style="color:<%= p.shirt %>"/>
          </g></g>
          <g class="hx-pop" data-at="<%= (p.at + 0.05).toFixed(2) %>" data-off="13.4">
            <circle cx="26" cy="-30" r="14" fill="#087e61"/>
            <use href="#hx-i-doc" x="18" y="-38" width="16" height="16" class="hx-u" style="color:#fff"/>
          </g>
        </g>
        <% }); %>
      </svg>

      <div class="hx-form" data-off="4.7">
        <div class="hx-form-top"><span><%= t('home_form_title') %></span><span class="hx-tag"><%= t('explainer_example_tag') %></span></div>
        <div class="hx-input"><span class="hx-typed" data-type-at="0.6" data-type-dur="3"><%= t('explainer_request') %></span><span class="hx-caret"></span></div>
        <div class="hx-send" data-at="4.1" data-until="4.6"><%= t('explainer_send') %></div>
      </div>
      <div class="hx-sent hx-pop" data-at="4.8"><span class="hx-sent-ic"><svg class="hx-i"><use href="#hx-i-check"/></svg></span><%= t('explainer_sent') %></div>

      <% [[-141, 87], [-31, 87], [79, 87], [189, 87], [-86, 169], [24, 169], [134, 169]].forEach(function (d, i) { %>
      <span class="hx-fly" data-at="<%= (4.8 + i * 0.08).toFixed(2) %>" data-until="<%= (5.6 + i * 0.08).toFixed(2) %>" style="--tx:<%= d[0] %>px;--ty:<%= d[1] %>px"></span>
      <% }); %>

      <% [
           { top: 54, fx: -55, fy: 135, states: '0:hide 9.2:head 9.9:stack 14.4:picked', icon: 'truck', color: '#2f6f8f', price: '130 ₾', terms: 'explainer_offer1_terms' },
           { top: 100, fx: -110, fy: 171, states: '0:hide 10:head 10.7:stack', icon: 'movers', color: '#d0844f', price: '80 ₾', terms: 'explainer_offer2_terms' },
           { top: 146, fx: 155, fy: 43, states: '0:hide 10.8:head 11.5:stack', icon: 'truck', color: '#3e7d5f', price: '140 ₾', terms: 'explainer_offer3_terms' },
         ].forEach(function (o) { %>
      <div class="hx-offer" data-state="hide" data-states="<%= o.states %>" style="top:<%= o.top %>px;--fx:<%= o.fx %>px;--fy:<%= o.fy %>px">
        <span class="hx-oi" style="background:<%= o.color %>"><svg class="hx-i"><use href="#hx-i-<%= o.icon %>"/></svg></span>
        <b class="hx-price"><%= o.price %></b>
        <span class="hx-terms"><%= t(o.terms) %></span>
        <span class="hx-call"><svg class="hx-i"><use href="#hx-i-phone"/></svg></span>
        <span class="hx-pick"><svg class="hx-i"><use href="#hx-i-check"/></svg></span>
      </div>
      <% }); %>
      <span class="hx-tap" data-at="14.1" data-until="14.9"></span>
    </div>

    <div class="hx-final" data-at="16.2">
      <ul class="hx-chips">
        <li><svg class="hx-i"><use href="#hx-i-check"/></svg><%= t('explainer_free') %></li>
        <li><svg class="hx-i"><use href="#hx-i-check"/></svg><%= t('explainer_phone_only') %></li>
        <li><svg class="hx-i"><use href="#hx-i-check"/></svg><%= t('explainer_you_choose') %></li>
      </ul>
      <div class="hx-final-actions">
        <a class="hx-cta" href="#post-section"><%= t('explainer_cta') %><svg class="hx-i"><use href="#hx-i-up"/></svg></a>
        <button type="button" class="hx-replay"><svg class="hx-i" aria-hidden="true"><use href="#hx-i-replay"/></svg><span class="hx-replay-t"><%= t('explainer_replay') %></span></button>
      </div>
    </div>
  </div>
  </div>
</section>
<script src="/js/home-explainer.js" defer></script>

<%# «Предложения Xtender» в кабинете (smsPermissions.service): отдельно от заявок. Включение — только после
    показанного текста согласия и кнопки «Согласен, включить»; вход по коду согласие не возвращает.
    endpoint — /api/master/<ссылка кабинета>/marketing; subscribed — текущее состояние. %>
<div class="lead-sub" data-mkt-box data-endpoint="<%= endpoint %>">
  <div data-mkt-view="on"<%= subscribed ? '' : ' hidden' %>>
    <p class="lead-sub-done"><%= t('mkt_state_on') %></p>
    <button type="button" data-mkt-set="off" class="lead-sub-link"><%= t('mkt_off_btn') %></button>
  </div>
  <div data-mkt-view="off"<%= subscribed ? ' hidden' : '' %>>
    <p class="lead-sub-done"><%= t('mkt_state_off') %></p>
    <button type="button" data-mkt-ask class="lead-sub-primary"><%= t('mkt_on_btn') %></button>
    <div data-mkt-confirm class="mt-3 rounded-xl border border-stone-200 bg-stone-50 p-3" hidden>
      <p class="lead-sub-hint"><b><%= t('signup_marketing_sms_title') %>.</b> <%= t('signup_marketing_sms') %></p>
      <div class="lead-sub-actions">
        <button type="button" data-mkt-set="on" class="lead-sub-primary"><%= t('mkt_confirm_btn') %></button>
        <button type="button" data-mkt-cancel class="lead-sub-plain"><%= t('lead_sub_cancel') %></button>
      </div>
    </div>
  </div>
  <p data-mkt-msg class="lead-sub-msg" role="status" hidden></p>
</div>
<script>
  (function () {
    var box = document.querySelector('[data-mkt-box]');
    if (!box) return;
    var msg = box.querySelector('[data-mkt-msg]');
    var DONE = { on: <%- JSON.stringify(t('mkt_done_on')) %>, off: <%- JSON.stringify(t('mkt_done_off')) %> };
    var ERR = <%- JSON.stringify(t('lead_sub_error')) %>;
    function confirmOpen(open) {
      box.querySelector('[data-mkt-confirm]').hidden = !open;
      box.querySelector('[data-mkt-ask]').hidden = open;
    }
    box.addEventListener('click', function (event) {
      if (event.target.closest('[data-mkt-ask]')) return confirmOpen(true);
      if (event.target.closest('[data-mkt-cancel]')) return confirmOpen(false);
      var button = event.target.closest('[data-mkt-set]');
      if (!button || button.disabled) return;
      var on = button.getAttribute('data-mkt-set') === 'on';
      button.disabled = true;
      fetch(box.getAttribute('data-endpoint'), { method: 'POST', cache: 'no-store', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ subscribed: on }) })
        .then(function (response) { return response.json().catch(function () { return {}; }); })
        .then(function (data) {
          if (!data.success) throw data;
          box.querySelector('[data-mkt-view="on"]').hidden = !data.subscribed;
          box.querySelector('[data-mkt-view="off"]').hidden = data.subscribed;
          confirmOpen(false);
          msg.textContent = DONE[data.subscribed ? 'on' : 'off']; msg.classList.add('ok'); msg.hidden = false;
        })
        .catch(function (data) { msg.textContent = (data && data.message) || ERR; msg.classList.remove('ok'); msg.hidden = false; })
        .then(function () { button.disabled = false; });
    });
  })();
</script>

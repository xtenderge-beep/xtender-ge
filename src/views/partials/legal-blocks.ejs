<%
  // Renders a legal-content.js block array: { h }, { p }, { ul }, { requisites: true }.
  // Shared by /terms, /privacy (_legal-doc.ejs) and the in-page Оферта modal on /join.
  // Expects: blocks, reqLabels, reqPending, requisites (SERVICE_REQUISITES), lang
  const RL = reqLabels[lang] || reqLabels.ru;
  function reqVal(v) { return v && typeof v === 'object' ? (v[lang] || v.ru) : v; }
  function reqRow(label, value) {
%>
  <div class="flex flex-col sm:flex-row sm:gap-3 py-1.5 border-b border-stone-100 last:border-0">
    <dt class="text-xs font-bold text-stone-500 uppercase sm:w-64 shrink-0"><%= label %></dt>
    <dd class="<%= value ? 'text-stone-800' : 'text-stone-400 italic' %>"><%= value || (reqPending[lang] || reqPending.ru) %></dd>
  </div>
<% } %>
<% blocks.forEach(function (b) { %>
    <% if (b.h) { %>
        <h2 class="text-sm font-extrabold text-stone-900 mt-5 first:mt-0"><%= b.h %></h2>
    <% } else if (b.p) { %>
        <p class="mt-2"><%= b.p %></p>
    <% } else if (b.ul) { %>
        <ul class="mt-2 list-disc pl-5 space-y-1">
            <% b.ul.forEach(function (li) { %><li><%= li %></li><% }); %>
        </ul>
    <% } else if (b.requisites) { %>
        <dl class="mt-3">
            <%- reqRow(RL.entityName, reqVal(requisites.entityName)) %>
            <%- reqRow(RL.idCode, reqVal(requisites.idCode)) %>
            <%- reqRow(RL.legalAddress, reqVal(requisites.legalAddress)) %>
            <%- reqRow(RL.email, requisites.email) %>
            <%- reqRow(RL.website, requisites.website) %>
            <% if (requisites.vatStatus) { %><%- reqRow(RL.vatStatus, reqVal(requisites.vatStatus)) %><% } %>
            <% if (requisites.bankAccount) { %>
                <%- reqRow(RL.bankName, requisites.bankName) %>
                <%- reqRow(RL.bankAccount, requisites.bankAccount) %>
                <%- reqRow(RL.bankSwift, requisites.bankSwift) %>
            <% } %>
        </dl>
    <% } %>
<% }); %>

<%#
  Блок мини-страницы компании (docs/company-pages.md): на /company/<slug>, в предпросмотре и на странице анкеты /c/<token>.
  c — companyPage.model(). headingTag — h1 на странице компании, h2 внутри анкеты.
%>
<% const _h = typeof headingTag !== 'undefined' ? headingTag : 'h1'; const k = c.copy; %>
<article class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-stone-100">
        <<%= _h %> class="text-2xl font-black tracking-tight text-stone-900"><%= c.name %></<%= _h %>>
        <% if (c.items.length) { %><p class="text-sm font-bold text-emerald-700 mt-1"><%= c.items.map(i => i.title).join(' · ') %></p><% } %>
        <p class="text-xs text-stone-500 mt-1"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= k.areaTitle %>: <%= k.area %><%= c.districts && c.districts.length ? ' (' + c.districts.join(', ') + ')' : '' %>
            <% if (c.avg) { %> · <i class="fa-solid fa-star text-amber-500" aria-hidden="true"></i> <%= c.avg %> (<%= k.reviewsCount(c.reviews.length) %>)<% } %>
            <% if (!c.preview) { %> · <span class="text-emerald-700 font-bold"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> <%= k.verified %></span><% } %></p>
        <% if (c.intro) { %><p class="text-sm text-stone-700 mt-3 whitespace-pre-line"><%= c.intro %></p><% } %>
    </div>

    <% if (c.items.length) { %>
    <section class="p-5 border-b border-stone-100">
        <h3 class="text-sm font-black text-stone-900 mb-3"><%= k.servicesTitle %></h3>
        <ul class="space-y-3">
            <% c.items.forEach(i => { %>
            <li class="flex gap-3"><i class="fa-solid fa-check text-emerald-600 mt-1" aria-hidden="true"></i>
                <div><a href="<%= i.href %>" class="font-bold text-stone-900 underline decoration-stone-300"><%= i.title %></a><p class="text-sm text-stone-600"><%= i.text %></p></div></li>
            <% }); %>
        </ul>
        <% if (c.extras.length) { %>
        <p class="text-xs font-bold text-stone-500 mt-4 mb-2"><%= k.extrasTitle %></p>
        <div class="flex flex-wrap gap-2"><% c.extras.forEach(x => { %><span class="px-2.5 py-1 rounded-full bg-stone-100 text-xs font-bold text-stone-700"><%= x %></span><% }); %></div>
        <% } %>
    </section>
    <% } %>

    <section class="p-5 border-b border-stone-100">
        <a href="<%= c.ctaHref %>" class="flex justify-center px-4 py-3 rounded-xl bg-emerald-600 text-white font-bold text-sm"><%= k.cta %></a>
        <p class="text-xs text-stone-500 mt-2 text-center"><%= k.ctaNote %></p>
    </section>

    <section class="p-5 border-b border-stone-100">
        <h3 class="text-sm font-black text-stone-900 mb-2"><%= k.reviewsTitle %><% if (c.reviews.length) { %> · <%= k.reviewsCount(c.reviews.length) %><% } %></h3>
        <% if (!c.reviews.length) { %>
            <p class="text-sm text-stone-500"><%= k.noReviews %></p>
        <% } else { %>
            <ul class="space-y-3"><% c.reviews.forEach(r => { %>
                <li class="text-sm"><span class="text-amber-500"><%= '★'.repeat(r.rating) %><span class="text-stone-300"><%= '★'.repeat(5 - r.rating) %></span></span>
                    <% if (r.comment) { %><p class="text-stone-700 mt-0.5"><%= r.comment %></p><% } %></li>
            <% }); %></ul>
        <% } %>
    </section>

    <section class="p-5">
        <h3 class="text-sm font-black text-stone-900 mb-2"><%= k.howTitle %></h3>
        <ol class="list-decimal list-inside text-sm text-stone-600 space-y-1"><% k.how.forEach(step => { %><li><%= step %></li><% }); %></ol>
    </section>
</article>

<%#
  Мини-страница компании (docs/company-pages.md): /company/<slug>, предпросмотр и блок на странице анкеты /c/<token>.
  Схема как у страниц компаний на маркетплейсах: слева карточка (имя, оценка, «на xtender с…», отметки доверия,
  кнопка), справа услуги, о компании, отзывы с разбивкой по звёздам, «как это работает».
  c — companyPage.model(). headingTag — h1 на странице компании, h2 внутри анкеты. compact — внутри анкеты (одна колонка).
%>
<% const _h = typeof headingTag !== 'undefined' ? headingTag : 'h1'; const k = c.copy; const one = typeof compact !== 'undefined' && compact;
   const initials = String(c.name || '?').replace(/\.(ge|com|org|net)$/i, '').split(/[\s.\-_]+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase() || '?';
   const icons = { movers: 'fa-people-carry-box', van: 'fa-truck', junk: 'fa-trash-can', bucket_lift: 'fa-truck-ramp-box', tow: 'fa-truck-pickup' }; %>
<div class="<%= one ? 'space-y-4' : 'grid gap-4 md:grid-cols-[300px_1fr] items-start' %>">
    <aside class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5 <%= one ? '' : 'md:sticky md:top-4' %>">
        <div class="flex items-center gap-3">
            <div class="w-14 h-14 shrink-0 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-xl font-black" aria-hidden="true"><%= initials %></div>
            <div class="min-w-0">
                <<%= _h %> class="text-xl font-black tracking-tight text-stone-900 break-words"><%= c.name %></<%= _h %>>
                <% if (c.avg) { %><p class="text-sm"><span class="font-black text-stone-900"><%= c.avg %></span> <span class="text-amber-500" aria-hidden="true"><%= '★'.repeat(Math.round(c.avg)) %></span> <a href="#reviews" class="text-emerald-700 font-bold"><%= k.reviewsCount(c.reviews.length) %></a></p><% } %>
            </div>
        </div>
        <%# Короткий ответ: кто, что, где, цена, оценка — одной фразой (её берут в сниппет и цитируют ИИ-ассистенты). %>
        <p class="text-sm text-stone-700 mt-3" data-summary><%= c.summary %></p>
        <ul class="mt-3 space-y-1.5 text-sm text-stone-600">
            <li><i class="fa-solid fa-location-dot w-4 text-stone-400" aria-hidden="true"></i> <%= k.area %><%= c.districts && c.districts.length ? ': ' + c.districts.join(', ') : '' %></li>
            <% if (c.since) { %><li><i class="fa-solid fa-clock w-4 text-stone-400" aria-hidden="true"></i> <%= k.since(c.since) %></li><% } %>
            <% if (c.languages.length) { %><li><i class="fa-solid fa-language w-4 text-stone-400" aria-hidden="true"></i> <%= k.languagesTitle %>: <%= c.languages.join(', ') %></li><% } %>
        </ul>
        <% if (c.preview) { %>
            <p class="mt-3 text-xs text-stone-400"><%= k.badgePending %></p>
        <% } else { %>
        <ul class="mt-3 space-y-1.5 text-sm">
            <li class="text-emerald-800"><i class="fa-solid fa-circle-check w-4" aria-hidden="true"></i> <%= k.badgePhone %></li>
            <li class="text-emerald-800"><i class="fa-solid fa-shield-halved w-4" aria-hidden="true"></i> <%= k.badgeModerated %></li>
        </ul>
        <% } %>
        <%# На телефоне на странице компании кнопка закреплена внизу экрана (company.ejs) — здесь вторая не нужна. %>
        <a href="<%= c.ctaHref %>" class="mt-4 <%= one ? 'flex' : 'hidden md:flex' %> justify-center px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm"><%= k.cta %></a>
        <p class="text-xs text-stone-500 mt-2"><%= k.ctaNote %></p>
    </aside>

    <div class="space-y-4">
        <% if (c.items.length) { %>
        <section class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5">
            <h3 class="text-base font-black text-stone-900 mb-3"><%= k.servicesTitle %></h3>
            <div class="grid gap-3 sm:grid-cols-2">
                <% c.items.forEach(i => { %>
                <a href="<%= i.href %>" class="block rounded-xl border border-stone-200 hover:border-emerald-400 p-3">
                    <p class="font-bold text-stone-900"><i class="fa-solid <%= icons[i.code] || 'fa-check' %> text-emerald-600 mr-1" aria-hidden="true"></i> <%= i.title %></p>
                    <p class="text-sm text-stone-600 mt-1"><%= i.text %></p>
                </a>
                <% }); %>
            </div>
            <% if (c.priceText) { %><p class="text-sm mt-3"><span class="font-bold text-stone-900"><%= k.pricesTitle %>:</span> <%= c.priceText %></p><% } %>
            <% if (c.extras.length) { %>
            <p class="text-xs font-bold text-stone-500 mt-4 mb-2"><%= k.extrasTitle %></p>
            <div class="flex flex-wrap gap-2"><% c.extras.forEach(x => { %><span class="px-2.5 py-1 rounded-full bg-stone-100 text-xs font-bold text-stone-700"><%= x %></span><% }); %></div>
            <% } %>
        </section>
        <% } %>

        <% if (c.intro) { %>
        <section class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5">
            <h3 class="text-base font-black text-stone-900 mb-2"><%= k.aboutTitle %></h3>
            <p class="text-sm text-stone-700 whitespace-pre-line"><%= c.intro %></p>
        </section>
        <% } %>

        <section id="reviews" class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5">
            <h3 class="text-base font-black text-stone-900 mb-3"><%= k.reviewsTitle %></h3>
            <% if (!c.reviews.length) { %>
                <p class="text-sm text-stone-500"><%= k.noReviews %></p>
            <% } else { const max = Math.max(...c.dist.map(d => d.n), 1); %>
                <div class="flex gap-5 items-center mb-4">
                    <div class="text-center"><p class="text-4xl font-black text-stone-900"><%= c.avg %></p><p class="text-amber-500 text-sm" aria-hidden="true"><%= '★'.repeat(Math.round(c.avg)) %></p><p class="text-xs text-stone-500"><%= k.reviewsCount(c.reviews.length) %></p></div>
                    <div class="flex-1 space-y-1">
                        <% c.dist.forEach(d => { %><div class="flex items-center gap-2 text-xs text-stone-500"><span class="w-3"><%= d.star %></span><div class="flex-1 h-1.5 rounded-full bg-stone-100"><div class="h-1.5 rounded-full bg-amber-400" style="width: <%= Math.round(d.n / max * 100) %>%"></div></div><span class="w-6 text-right"><%= d.n %></span></div><% }); %>
                    </div>
                </div>
                <ul class="divide-y divide-stone-100">
                    <% c.reviews.forEach(r => { %>
                    <li class="py-3 text-sm">
                        <p class="text-xs text-stone-500"><span class="font-bold text-stone-700"><%= k.reviewFrom %></span><% if (r.date) { %> · <%= new Date(r.date).toLocaleDateString(c.lang === 'ka' ? 'ka-GE' : c.lang, { day: 'numeric', month: 'long', year: 'numeric' }) %><% } %> · <%= k.reviewDeal %></p>
                        <p class="text-amber-500 mt-0.5" aria-label="<%= r.rating %>/5"><%= '★'.repeat(r.rating) %><span class="text-stone-300"><%= '★'.repeat(5 - r.rating) %></span></p>
                        <% if (r.comment) { %><p class="text-stone-700 mt-1"><%= r.comment %></p><% } %>
                    </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>

        <% if (c.faq && c.faq.length) { %>
        <section class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5">
            <h3 class="text-base font-black text-stone-900 mb-2"><%= k.faqTitle %></h3>
            <div class="divide-y divide-stone-100"><% c.faq.forEach(f => { %>
                <details class="py-2 group"><summary class="cursor-pointer text-sm font-bold text-stone-800 list-none flex justify-between gap-2"><%= f.q %><i class="fa-solid fa-chevron-down text-stone-400 text-xs mt-1 group-open:rotate-180" aria-hidden="true"></i></summary><p class="text-sm text-stone-600 mt-1"><%= f.a %></p></details>
            <% }); %></div>
        </section>
        <% } %>

        <section class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5">
            <h3 class="text-base font-black text-stone-900 mb-3"><%= k.howTitle %></h3>
            <ol class="grid gap-3 sm:grid-cols-3"><% k.how.forEach((step, n) => { %>
                <li class="rounded-xl bg-stone-50 p-3 text-sm text-stone-700"><span class="block text-emerald-700 font-black text-lg"><%= n + 1 %></span><%= step %></li>
            <% }); %></ol>
        </section>

        <% if (c.similar && c.similar.length) { %>
        <section class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5">
            <h3 class="text-base font-black text-stone-900 mb-3"><%= k.similarTitle %></h3>
            <div class="grid gap-3 sm:grid-cols-2"><% c.similar.forEach(s => { %>
                <a href="<%= s.href %>" class="block rounded-xl border border-stone-200 hover:border-emerald-400 p-3"><p class="font-bold text-stone-900"><%= s.name %></p><p class="text-xs text-stone-500 mt-1"><%= s.services %></p></a>
            <% }); %></div>
        </section>
        <% } %>
    </div>
</div>

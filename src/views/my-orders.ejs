<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
  <%- include('partials/head', { title: t('my_orders_title'), noindex: true }) %>
</head>
<body class="font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

  <header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
    <div class="max-w-xl mx-auto px-4">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2">
          <%- include('partials/brand') %>
        </a>
        <%- include('partials/lang-switch') %>
      </div>
    </div>
  </header>

  <main class="max-w-xl mx-auto px-4 py-8 space-y-4">
    <h1 class="text-lg font-extrabold text-stone-900"><%= t('my_orders_title') %></h1>

    <% if (!orders.length) { %>
      <div class="bg-white rounded-3xl shadow-xl border border-stone-200/80 p-6 text-center text-sm text-stone-500 font-medium">
        <%= t('my_orders_empty') %>
      </div>
    <% } else { %>
      <div class="space-y-3">
        <% orders.forEach(function (order) { %>
          <a href="/order/<%= order.token %>" class="block bg-white rounded-2xl border border-stone-200/90 p-4 shadow-sm hover:shadow-md transition space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold text-stone-900"><%= t('order_hash') %><%= order.token.slice(0, 6).toUpperCase() %></span>
              <% if (order.status === 'closed') { %>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-500 text-[11px] font-bold">
                  <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span><%= t('status_closed') %>
                </span>
              <% } else if (order.status === 'needs_revision') { %><span class="text-xs font-bold text-amber-700"><%= revisionCopy.title %></span><% } else if (order.status === 'pending_review') { %>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[11px] font-bold">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span><%= t('status_pending_review') %>
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-bold">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span><%= t('status_active') %>
                </span>
              <% } %>
            </div>
            <p class="text-xs text-stone-600 leading-snug line-clamp-2"><%= order.description %></p>
            <div class="flex items-center gap-1.5 text-[11px] font-semibold text-stone-400">
              <i class="fa-solid fa-clock"></i>
              <span><%= new Date(order.created_at).toLocaleDateString(lang) %></span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>

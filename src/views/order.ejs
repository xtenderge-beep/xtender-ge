<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex, nofollow">
  <title><%= t('site_title_order') %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'] },
        }
      }
    }
  </script>
  <style>
    .lang-btn.active { background: #fff; color: #0f172a; font-weight: 800; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
  </style>
</head>
<body class="font-sans text-slate-800 bg-slate-50 min-h-screen antialiased">

  <% const cabHref = (order && masterAccount) ? '/master/' + masterAccount.token : '/'; %>
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-xl mx-auto px-4">
      <div class="flex items-center justify-between h-16">
        <a href="<%= cabHref %>" class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-slate-900">xtender<span class="text-emerald-600">.ge</span></span>
        </a>
        <div class="flex bg-slate-100 p-1 rounded-xl text-xs font-bold border border-slate-200">
          <a href="/lang/ka" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ka' ? 'active' : 'hover:bg-white/50' %>">GE</a>
          <a href="/lang/ru" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ru' ? 'active' : 'hover:bg-white/50' %>">RU</a>
          <a href="/lang/en" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'en' ? 'active' : 'hover:bg-white/50' %>">EN</a>
        </div>
      </div>
    </div>
  </header>

  <% if (order && masterAccount) { %>
    <div class="bg-slate-900 text-white">
      <div class="max-w-xl mx-auto px-4 py-2.5 flex items-center justify-between text-xs sm:text-sm font-bold">
        <a href="/master/<%= masterAccount.token %>" class="flex items-center gap-1.5 hover:text-emerald-400 transition">
          <i class="fa-solid fa-arrow-left text-[10px]"></i><i class="fa-solid fa-helmet-safety text-amber-400"></i><%= t('nav_my_cabinet') %>
        </a>
        <span class="text-slate-300"><%= t('order_master_balance') %>: <span class="font-mono font-black text-emerald-400"><%= (masterAccount.balanceTetri / 100).toFixed(2) %> ₾</span></span>
      </div>
    </div>
  <% } %>

  <main class="max-w-xl mx-auto px-4 py-8">
    <% if (!order) { %>
      <div class="bg-white rounded-3xl shadow-xl border border-slate-200/80 p-6 text-center">
        <h1 class="text-lg font-bold text-slate-900"><%= t('order_not_found') %></h1>
      </div>
    <% } else { %>
      <div class="bg-white rounded-3xl shadow-xl border border-slate-200/80 p-6 space-y-5">

        <div class="flex items-center justify-between">
          <h1 class="text-lg font-extrabold text-slate-900"><%= t('order_hash') %><%= order.id %></h1>
          <% if (order.status === 'closed') { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-500 text-xs font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span><%= t('status_closed') %>
            </span>
          <% } else if (order.status === 'pending_review') { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span><%= t('status_pending_review') %>
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span><%= t('status_active') %>
            </span>
          <% } %>
        </div>

        <% if (masterAccount && masterAccount.leadsLeft < 5) { %>
          <div class="p-3 rounded-2xl bg-amber-50 border border-amber-200 text-xs text-amber-800 font-semibold flex items-start gap-2">
            <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
            <span><%= t('order_master_low_balance') %></span>
          </div>
        <% } %>

        <% if (order.district_name) { %>
          <div>
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1"><%= t('label_district') %></div>
            <div class="text-sm text-slate-800"><%= order.district_name %></div>
          </div>
        <% } %>

        <%
          // Тексты заявки по языкам: оригинал на source_lang + все переводы.
          const src = order.source_lang;
          const reqTexts = {};
          if (src) reqTexts[src] = order.description;
          Object.entries(order.description_translations || {}).forEach(function (e) { if (e[1]) reqTexts[e[0]] = e[1]; });
          if (!Object.keys(reqTexts).length) reqTexts[src || 'ka'] = order.description;
          const reqLangs = ['ka', 'ru', 'en'].filter(function (l) { return reqTexts[l]; });
          // Владельцу — всегда его оригинал, без переключателя. Исполнителю/модератору —
          // переключатель языка ЗАЯВКИ (не страницы), если переводов больше одного.
          const showReqSwitcher = !isOwner && reqLangs.length > 1;
          const initReqLang = !isOwner && reqTexts[lang] ? lang : (src || reqLangs[0]);
          const LBL = { ka: 'GE', ru: 'RU', en: 'EN' };
        %>
        <div>
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider"><%= t('label_request') %></div>
            <% if (showReqSwitcher) { %>
              <div class="flex bg-slate-100 p-0.5 rounded-lg border border-slate-200" id="reqLangBar">
                <% reqLangs.forEach(function (l) { %>
                  <button type="button" data-req-lang="<%= l %>" onclick="setReqLang('<%= l %>')"
                    class="req-lang-btn text-[11px] font-extrabold px-2 py-0.5 rounded-md transition <%= l === initReqLang ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-400' %>"><%= LBL[l] %></button>
                <% }); %>
              </div>
              <span id="reqTrBadge" class="text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded px-1.5 py-0.5 <%= initReqLang === src ? 'hidden' : '' %>">🌐 <%= t('order_translated') %></span>
            <% } %>
            <% if (!isOwner) { %>
              <button type="button" id="copyOrigBtn" class="ml-auto shrink-0 text-[11px] font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1 transition">
                <i class="fa-regular fa-copy"></i><span id="copyOrigLabel"><%= t('order_copy') %></span>
              </button>
            <% } %>
          </div>
          <div id="reqText" class="text-sm text-slate-800 leading-relaxed whitespace-pre-line"><%= reqTexts[initReqLang] || order.description %></div>
          <textarea id="origSource" class="hidden" readonly><%= order.description %></textarea>
        </div>
        <script>
          window.__reqTexts = <%- JSON.stringify(reqTexts) %>;
          window.__reqSrc = <%- JSON.stringify(src || null) %>;
        </script>

        <% if (files && files.length) { %>
          <div>
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2"><%= t('label_photos') %></div>
            <div class="flex flex-wrap gap-2">
              <% files.forEach(function (f) { %>
                <% if (f.mime_type.startsWith('image/')) { %>
                  <a href="<%= f.file_path %>" target="_blank" rel="noopener">
                    <img src="<%= f.file_path %>" alt="<%= f.original_name %>" class="w-20 h-20 object-cover rounded-xl border border-slate-200">
                  </a>
                <% } else { %>
                  <a href="<%= f.file_path %>" target="_blank" rel="noopener" class="text-sm text-emerald-600 font-semibold underline"><%= f.original_name %></a>
                <% } %>
              <% }); %>
            </div>
          </div>
        <% } %>

        <% if (isOwner && funnel) { %>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold text-slate-500">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-eye text-emerald-600"></i><%= funnel.view %> <%= t('my_orders_views_label') %></span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-phone text-emerald-600"></i><%= funnel.call %></span>
            <span class="flex items-center gap-1.5"><i class="fa-brands fa-whatsapp text-emerald-600"></i><%= funnel.whatsapp %></span>
          </div>
        <% } %>

        <% if (order.status === 'closed') { %>
          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-sm text-slate-600 font-medium">
            <%= isOwner ? t('order_closed_notice') : t('order_closed_notice_late') %>
          </div>
        <% } else if ((order.status === 'pending_review' || order.status === 'unverified') && !isOwner) { %>
          <div class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200 text-sm text-amber-800 font-medium">
            <%= t('order_pending_review_notice') %>
          </div>
        <% } else if (isOwner) { %>
          <button id="closeBtn" class="w-full py-3.5 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-black text-sm shadow-lg shadow-red-600/20 transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-trash-can"></i>
            <span><%= t('btn_close_order') %></span>
          </button>
          <a href="/my-orders" class="flex items-center justify-center gap-1.5 text-xs font-bold text-slate-500 hover:text-slate-800 transition">
            <i class="fa-solid fa-list-check text-[10px]"></i><%= t('my_orders_nav') %>
          </a>
        <% } else { %>
          <div class="flex gap-2.5">
            <a id="callBtn" href="tel:<%= order.phone %>" class="flex-1 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm shadow-lg shadow-emerald-600/20 transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-phone"></i><span><%= t('btn_call') %></span>
            </a>
            <a id="whatsappBtn" href="https://wa.me/<%= order.phone.replace(/\D/g, '') %>?text=<%= encodeURIComponent(whatsappText) %>" target="_blank" rel="noopener" class="flex-1 py-3.5 rounded-2xl bg-[#25d366] hover:brightness-95 text-white font-black text-sm shadow-lg transition flex items-center justify-center gap-2">
              <i class="fa-brands fa-whatsapp"></i><span><%= t('btn_whatsapp') %></span>
            </a>
          </div>
          <% if (order.source_lang && order.source_lang !== lang) { %>
            <p class="mt-2 text-[11px] text-slate-400 flex items-start gap-1.5">
              <i class="fa-brands fa-whatsapp text-emerald-500 mt-0.5 shrink-0"></i><span><%= t('order_lang_hint') %></span>
            </p>
          <% } %>
        <% } %>

        <div id="msg" class="hidden p-3 rounded-xl bg-red-50 text-red-700 border border-red-200 text-xs font-bold"></div>
      </div>

      <script>
        const T = <%- JSON.stringify(clientStrings) %>;
        const token = '<%= order.token %>';
        const masterId = <%- masterId ? JSON.stringify(masterId) : 'null' %>;
        const msg = document.getElementById('msg');

        function logEvent(eventType) {
          if (!masterId) return;
          fetch('/api/orders/' + token + '/log-view', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ masterId, eventType }),
            keepalive: true,
          }).catch(() => {});
        }

        if (masterId) logEvent('view');

        function setReqLang(l) {
          const texts = window.__reqTexts || {};
          if (!texts[l]) return;
          document.getElementById('reqText').textContent = texts[l];
          document.querySelectorAll('.req-lang-btn').forEach((b) => {
            const on = b.dataset.reqLang === l;
            b.classList.toggle('bg-white', on);
            b.classList.toggle('text-slate-900', on);
            b.classList.toggle('shadow-sm', on);
            b.classList.toggle('text-slate-400', !on);
          });
          const badge = document.getElementById('reqTrBadge');
          if (badge) badge.classList.toggle('hidden', l === window.__reqSrc);
        }

        const copyOrigBtn = document.getElementById('copyOrigBtn');
        if (copyOrigBtn) {
          copyOrigBtn.addEventListener('click', async () => {
            const text = document.getElementById('origSource').value;
            try {
              await navigator.clipboard.writeText(text);
            } catch (e) {
              const ta = document.getElementById('origSource');
              ta.classList.remove('hidden'); ta.select();
              document.execCommand('copy');
              ta.classList.add('hidden');
            }
            const label = document.getElementById('copyOrigLabel');
            const prev = label.textContent;
            label.textContent = T.order_copied || 'Скопировано';
            copyOrigBtn.classList.add('text-emerald-600');
            setTimeout(() => { label.textContent = prev; copyOrigBtn.classList.remove('text-emerald-600'); }, 1800);
          });
        }

        const callBtn = document.getElementById('callBtn');
        const whatsappBtn = document.getElementById('whatsappBtn');
        if (callBtn) callBtn.addEventListener('click', () => logEvent('call'));
        if (whatsappBtn) whatsappBtn.addEventListener('click', () => logEvent('whatsapp'));

        const closeBtn = document.getElementById('closeBtn');
        if (closeBtn) {
          closeBtn.addEventListener('click', async () => {
            const res = await fetch('/api/orders/' + token + '/close', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
              window.location.reload();
            } else {
              msg.classList.remove('hidden');
              msg.textContent = data.message || T.js_err_close_order;
            }
          });
        }
      </script>
    <% } %>
  </main>
</body>
</html>

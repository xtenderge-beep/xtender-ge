<%
  // Ожидает: doc (из legal-content.js), headline, reqLabels, reqPending, labels, requisites (SERVICE_REQUISITES), lang
  const blocks = doc.body[lang] || doc.body.ru;
  const RL = reqLabels[lang] || reqLabels.ru;
  const L = labels[lang] || labels.ru;
  function reqRow(label, value) {
%>
  <div class="flex flex-col sm:flex-row sm:gap-3 py-1.5 border-b border-stone-100 last:border-0">
    <dt class="text-xs font-bold text-stone-500 uppercase sm:w-64 shrink-0"><%= label %></dt>
    <dd class="<%= value ? 'text-stone-800' : 'text-stone-400 italic' %>"><%= value || (reqPending[lang] || reqPending.ru) %></dd>
  </div>
<% } %>

<header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
    <div class="max-w-2xl mx-auto px-4">
        <div class="flex items-center justify-between h-16">
            <a href="/" class="flex items-center gap-2">
                <span class="text-xl font-black tracking-tight text-stone-900">xtender<span class="text-emerald-600">.ge</span></span>
            </a>
            <div class="flex items-center gap-1">
                <% [['ka','🇬🇪','GE'],['ru','🇷🇺','RU'],['en','🇬🇧','EN']].forEach(function (lf) { %>
                    <a href="<%= seo.alternates[lf[0]] %>" title="<%= lf[2] %>" aria-label="<%= lf[2] %>"
                       class="w-7 h-7 flex items-center justify-center rounded-full text-base leading-none transition <%= lang === lf[0] ? 'ring-2 ring-emerald-500 bg-white shadow-sm' : 'opacity-40 grayscale hover:opacity-100 hover:grayscale-0' %>"><%= lf[1] %></a>
                <% }); %>
            </div>
        </div>
    </div>
</header>

<main class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-xl font-black tracking-tight text-stone-900"><%= headline %></h1>
    <p class="mt-1 text-xs text-stone-500">
        <%= L.updated %>: <%= doc.updated[lang] || doc.updated.ru %> · <%= L.version %>: <span class="font-mono"><%= doc.version %></span>
    </p>

    <nav class="mt-3 flex gap-4 text-xs font-bold">
        <a href="/terms" class="<%= docKind === 'terms' ? 'text-emerald-700 underline' : 'text-stone-500 hover:text-stone-800' %>"><%= L.tab_terms %></a>
        <a href="/privacy" class="<%= docKind === 'privacy' ? 'text-emerald-700 underline' : 'text-stone-500 hover:text-stone-800' %>"><%= L.tab_privacy %></a>
    </nav>

    <div class="mt-4 bg-white rounded-2xl shadow-xl border border-stone-200/80 p-5 sm:p-6 text-sm text-stone-700 leading-relaxed">
        <% blocks.forEach(function (b) { %>
            <% if (b.h) { %>
                <h2 class="text-sm font-extrabold text-stone-900 mt-5 first:mt-0"><%= b.h %></h2>
            <% } else if (b.p) { %>
                <p class="mt-2"><%= b.p %></p>
            <% } else if (b.ul) { %>
                <ul class="mt-2 list-disc pl-5 space-y-1">
                    <% b.ul.forEach(function (li) { %><li><%= li %></li><% }); %>
                </ul>
            <% } else if (b.requisites) { %>
                <dl class="mt-3">
                    <%- reqRow(RL.entityName, requisites.entityName) %>
                    <%- reqRow(RL.idCode, requisites.idCode) %>
                    <%- reqRow(RL.legalAddress, requisites.legalAddress) %>
                    <%- reqRow(RL.email, requisites.email) %>
                    <%- reqRow(RL.website, requisites.website) %>
                </dl>
            <% } %>
        <% }); %>
    </div>
</main>

<%
  // Ожидает: doc (из legal-content.js), headline, reqLabels, reqPending, labels, requisites (SERVICE_REQUISITES), lang
  const blocks = doc.body[lang] || doc.body.ru;
  const L = labels[lang] || labels.ru;
%>

<header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
    <div class="max-w-2xl mx-auto px-4">
        <div class="flex items-center justify-between h-16">
            <a href="/" class="flex items-center gap-2">
                <%- include('partials/brand') %>
            </a>
            <div class="flex items-center gap-0.5 p-1 bg-stone-100 rounded-full border border-stone-200">
                <% [['ka','🇬🇪','GE'],['ru','🇷🇺','RU'],['en','🇬🇧','EN']].forEach(function (lf) { %>
                    <% /* ?lang=ka — иначе кука ru/en тут же откидывает голый URL обратно, см. public.routes.js */ %>
                    <a href="<%= seo.alternates[lf[0]] %><%= lf[0] === 'ka' ? '?lang=ka' : '' %>" title="<%= lf[2] %>" aria-label="<%= lf[2] %>"
                       class="flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-full text-sm sm:text-base font-bold leading-none transition <%= lang === lf[0] ? 'bg-white shadow-sm text-stone-900' : 'text-stone-500 hover:bg-white/60 hover:text-stone-800 active:scale-95' %>">
                        <%= lf[1] %>
                    </a>
                <% }); %>
            </div>
        </div>
    </div>
</header>

<main class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-xl font-black tracking-tight text-stone-900"><%= headline %></h1>
    <p class="mt-1 text-xs text-stone-500">
        <%= L.updated %>: <%= doc.updated[lang] || doc.updated.ru %> · <%= L.version %>: <span class="font-mono"><%= doc.version %></span>
    </p>

    <nav class="mt-3 flex gap-4 text-xs font-bold">
        <a href="/terms" class="<%= docKind === 'terms' ? 'text-emerald-700 underline' : 'text-stone-500 hover:text-stone-800' %>"><%= L.tab_terms %></a>
        <a href="/privacy" class="<%= docKind === 'privacy' ? 'text-emerald-700 underline' : 'text-stone-500 hover:text-stone-800' %>"><%= L.tab_privacy %></a>
    </nav>

    <div class="mt-4 bg-white rounded-2xl shadow-xl border border-stone-200/80 p-5 sm:p-6 text-sm text-stone-700 leading-relaxed">
        <%- include('partials/legal-blocks', { blocks, reqLabels, reqPending, requisites, lang }) %>
    </div>
</main>

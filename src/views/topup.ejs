<!DOCTYPE html><html lang="<%= lang %>"><head><%- include('partials/head',{title:t('pay_title'),noindex:true}) %><meta name="referrer" content="no-referrer"></head>
<body class="provider-page payment-page"><header class="bg-white border-b"><div class="max-w-3xl mx-auto px-4 py-4 flex justify-between"><a href="/master/<%= master.master_token %>#balance">← <%= t('pay_back') %></a><%- include('partials/lang-switch') %></div></header>
<main class="max-w-3xl mx-auto px-4 py-8"><h1><%= t('pay_title') %></h1><p class="provider-status pending"><%= t('pay_'+topup.status) %></p>
<% if(topup.note) { %><p class="payment-note"><%= topup.note %></p><% } %>
<% if(topup.status==='credited') { %><p class="payment-note"><%= t('pay_done') %> <strong><%= t('pay_paid_amount') %>: <%= (topup.credited_tetri/100).toFixed(2) %> ₾</strong></p><% } %>
<section class="payment-document"><div class="payment-document-heading"><div><%- include('partials/brand') %><p><%= t('pay_document') %></p></div><div><strong><span id="payment-amount"><%= (topup.amount_tetri/100).toFixed(2) %></span> GEL</strong><button type="button" class="payment-copy" data-copy="payment-amount"><%= t('pay_copy') %></button></div></div>
<dl><% const fields=[['pay_reference',topup.reference],['pay_date',new Date(topup.created_at).toLocaleDateString(lang)],['pay_payer',topup.payer_name],['pay_recipient',topup.recipient.RECIPIENT_NAME],['pay_id',topup.recipient.RECIPIENT_ID],['pay_address',topup.recipient.RECIPIENT_ADDRESS],['pay_bank',topup.recipient.BANK_NAME],['pay_iban',topup.recipient.BANK_ACCOUNT],['pay_swift',topup.recipient.SWIFT],['pay_purpose',purpose],['pay_email',topup.recipient.EMAIL],['pay_vat',topup.recipient.VAT_NOTE]]; fields.forEach(([key,value],i)=>{ %>
<div><dt><%= t(key) %></dt><dd><span id="payment-value-<%= i %>"><%= value %></span><% if(['pay_iban','pay_purpose','pay_recipient'].includes(key)) { %><button type="button" class="payment-copy" data-copy="payment-value-<%= i %>"><%= t('pay_copy') %></button><% } %></dd></div><% }) %></dl><p class="provider-help"><%= t('pay_not_receipt') %></p></section>
<div class="payment-language"><label for="documentLanguage"><%= t('pay_document_language') %></label><select id="documentLanguage"><% [['ka','ქართული'],['ru','Русский'],['en','English']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= value===lang?'selected':'' %>><%= label %></option><% }) %></select></div><div class="payment-actions"><a class="provider-primary" id="downloadDocument" href="/master/<%= master.master_token %>/topups/<%= topup.id %>/pdf?lang=<%= lang %>"><%= t('pay_pdf') %></a><button type="button" onclick="window.print()"><%= t('pay_print') %></button></div>
<div class="payment-help"><details open><summary><%= t('pay_app') %></summary><p><%= t('pay_app_steps') %></p></details><details><summary><%= t('pay_branch') %></summary><p><%= t('pay_branch_steps') %></p></details>
<section class="provider-pricing"><h2><%= t('pay_after') %></h2><p><%= t('pay_after_text') %></p>
<% if(['awaiting','rejected'].includes(topup.status)) { %><form id="paymentReceipt" class="payment-form"><label for="paymentFile"><%= t('topup_receipt_choose') %> · JPG, PNG, WEBP, GIF, PDF · ≤ 5 MB</label><input id="paymentFile" name="receipt" type="file" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" required><input name="topupId" type="hidden" value="<%= topup.id %>"><button type="submit" class="provider-primary"><%= t('pay_upload') %></button><p id="paymentMessage" role="alert"></p></form><% } else if(topup.status!=='credited') { %><p><%= t('pay_wait') %></p><% } %>
</section><p><%= t('pay_notice') %></p><p><%= t('pay_support') %></p></div></main>
<script>
 document.getElementById("documentLanguage").addEventListener("change",function(){document.getElementById("downloadDocument").href="/master/<%= master.master_token %>/topups/<%= topup.id %>/pdf?lang="+encodeURIComponent(this.value);});
document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.getElementById(button.dataset.copy).textContent);button.textContent=<%- JSON.stringify(t('pay_copied')) %>;}catch{button.textContent=<%- JSON.stringify(t('pay_error')) %>;}}));
const receiptForm=document.getElementById('paymentReceipt');if(receiptForm)receiptForm.addEventListener('submit',async event=>{event.preventDefault();const button=receiptForm.querySelector('button'),msg=document.getElementById('paymentMessage');button.disabled=true;msg.textContent=<%- JSON.stringify(t('pay_processing')) %>;try{const response=await fetch('/api/master/<%= master.master_token %>/topup-receipt',{method:'POST',body:new FormData(receiptForm)});if(!response.ok)throw Error();location.reload();}catch{msg.textContent=<%- JSON.stringify(t('pay_error')) %>;button.disabled=false;}});
</script></body></html>

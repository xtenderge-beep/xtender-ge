<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Кабинет менеджера · Xtender</title><style>
*{box-sizing:border-box}body{margin:0;background:#f4f5f7;color:#19232d;font:16px system-ui,sans-serif}main{max-width:1180px;margin:auto;padding:24px}header{background:#162b28;color:white;padding:16px 20px}header div{max-width:1132px;margin:auto;display:flex;gap:16px;align-items:center;flex-wrap:wrap}header a{color:white}a{color:#08765f}h1{font-size:28px}h2{font-size:20px}.card{background:white;border:1px solid #dde3e2;border-radius:14px;padding:20px;margin:18px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}.grid .card{margin:0}.value{font-size:27px;font-weight:750}small,.muted{color:#62716e}table{border-collapse:collapse;width:100%;font-size:14px}td,th{text-align:left;padding:12px;border-bottom:1px solid #e5e9e8}.scroll{overflow:auto}input,textarea,button,select{font:inherit}input,textarea,button{padding:10px;border:1px solid #bbc9c5;border-radius:8px}select{max-width:100%;padding:10px;border:1px solid #bbc9c5;border-radius:8px;background:white}button{cursor:pointer;background:#08765f;color:white;border:0;min-height:44px}textarea{display:block;width:100%;margin:10px 0}label{display:block;margin:12px 0}nav{display:flex;gap:16px;flex-wrap:wrap}.danger{background:#a53030}.pre{white-space:pre-wrap;overflow-wrap:anywhere}form.inline{display:inline}p{line-height:1.5}.form-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.form-actions button{flex:1 1 190px}.secondary-action{background:#edf3f1;color:#075d4b}.need-grid,.service-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:10px;margin:16px 0}.need-item{border:1px solid #dce5e1;border-radius:12px;padding:8px 14px;margin:0;min-width:0}.need-item:has(input[name=needs]:checked){border-color:#08765f;background:#f4faf7}.need-item legend{max-width:100%;padding:0 4px}.need-item legend label,.service-tile{display:flex;align-items:center;gap:10px;margin:0;padding:8px 2px;cursor:pointer}.need-item input[type=checkbox],.service-tile input[type=checkbox]{width:20px;height:20px;flex:none;accent-color:#08765f}.need-fields{padding:4px 0 8px}.need-fields label{margin:10px 0}.need-fields select,.need-fields input[type=number]{display:block;width:100%;margin-top:5px}.need-fields label:has(input[type=checkbox]){display:flex;align-items:center;gap:10px;min-height:44px}.service-tile{border:1px solid #dce5e1;border-radius:10px;padding:10px 12px;min-height:48px}.service-tile:has(input:checked){border-color:#08765f;background:#f4faf7}.selection-summary{color:#075d4b;font-weight:600;min-height:24px}.flow-fields{display:flex;gap:12px;align-items:end;flex-wrap:wrap}.flow-fields label{flex:1 1 220px;margin:0}.flow-fields select{display:block;width:100%;margin-top:5px}.flow-fields button{flex:0 0 auto}.review-total{font-size:20px;font-weight:700;color:#075d4b}.result-list{padding-left:22px;line-height:1.6}@media(max-width:600px){main{padding:14px}header{padding:10px 14px}header div{gap:8px 12px}header nav{order:3;width:100%;gap:8px 14px;font-size:14px}header form{margin-left:auto}header button{min-height:36px;padding:6px 10px}h1{font-size:24px}.card{padding:16px;margin:12px 0}.need-grid,.service-grid{display:block}.need-item,.service-tile{margin:8px 0}.need-item{padding:2px 12px}.need-item legend label{min-height:44px}.flow-fields>*{width:100%;flex-basis:100%!important}.flow-fields button,.form-actions button{width:100%}.form-actions{display:block}.form-actions button+button{margin-top:10px}}</style></head><body>

<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Кабинет менеджера · Xtender</title><style>
*{box-sizing:border-box}body{margin:0;background:#f4f5f7;color:#19232d;font:16px system-ui,sans-serif}main{max-width:1180px;margin:auto;padding:24px}header{background:#162b28;color:white;padding:20px}header div{max-width:1132px;margin:auto;display:flex;gap:24px;align-items:center;flex-wrap:wrap}header a{color:white}a{color:#08765f}h1{font-size:28px}h2{font-size:20px}.card{background:white;border:1px solid #dde3e2;border-radius:14px;padding:20px;margin:18px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}.grid .card{margin:0}.value{font-size:27px;font-weight:750}small,.muted{color:#62716e}table{border-collapse:collapse;width:100%;font-size:14px}td,th{text-align:left;padding:12px;border-bottom:1px solid #e5e9e8}.scroll{overflow:auto}input,textarea,button{font:inherit;padding:10px;border:1px solid #bbc9c5;border-radius:8px}button{cursor:pointer;background:#08765f;color:white;border:0}textarea{display:block;width:100%;margin:10px 0}label{display:block;margin:12px 0}nav{display:flex;gap:20px;flex-wrap:wrap}.danger{background:#a53030}.pre{white-space:pre-wrap;overflow-wrap:anywhere}form.inline{display:inline}p{line-height:1.5}</style></head><body>
<header><div><strong>XTENDER · менеджер</strong><% if(typeof manager!=='undefined'){ %><span><%= manager.name %></span><nav><a href="/manager">Моя база</a><% if(manager.is_head_moderator){ %><a href="/manager/orders">Рассылки</a><% } %><a href="/manager/processes">Процессы и планы</a><a href="/manager/finances">Начисления и выплаты</a></nav><form method="post" action="/manager/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Выйти</button></form><% } %></div></header><main>

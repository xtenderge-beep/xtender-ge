<%- include('_header') %>
<a href="/manager/orders">← Все заявки</a><h1>Заявка #<%= order.id %></h1>
<p class="pre"><%= order.description %></p>
<% if(order.is_technical){ %><p>🧪 Техническая заявка: рассылка только техническим исполнителям.</p><% } %>
<% if((order.target_categories||[]).length>1){ %><div class="card"><h2>Открытые потребности</h2><% order.target_categories.filter(key=>!(order.closedCategories||[]).includes(key)).forEach(key=>{ %><form method="post" action="/manager/orders/<%= order.token %>/close-category" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="category" value="<%= key %>"><button type="submit">Закрыть «<%= groups[key]||key %>»</button></form> <% }); %></div><% } %>
<% if(error){ %><div class="card" role="alert"><%= error %></div><% } %>
<% if(result){ %><div class="card" role="status">Принято каналом: <strong><%= result.count %></strong>. Списано: <strong><%= (result.count*result.price/100).toFixed(2) %> ₾</strong>. Просмотры и нажатия контактов видны ниже; это не подтверждение сделки.</div><% } %>
<% if(order.status==='pending_review' && !order.first_dispatched_at){ %>
<section class="card"><h2>1. Потребности клиента</h2><p>Выберите каждую услугу отдельно. После выбора появятся только её характеристики. Сохраните до первой рассылки.</p>
<form method="post" action="/manager/orders/<%= order.token %>/needs"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% Object.entries(groups).forEach(([key,label])=>{const svc=serviceConfig.find(s=>s.type===(key==='transport'||key==='flatbed'?'van':key));const fields=(svc?.fields||[]).filter(f=>f.input!=='size'&&f.input!=='text'&&f.match&&f.match!=='ignore'&&!(key==='flatbed'&&f.key==='body'));const values=order.requirements?.services?.[key]||{}; %>
<fieldset data-need-panel="<%= key %>" class="card"><legend><label><input type="checkbox" name="needs" value="<%= key %>" <%= (order.target_categories||[]).includes(key)?'checked':'' %>> <%= label %></label></legend><div data-need-fields>
<% fields.forEach(f=>{ %><label><%= f.label %> <% if(f.input==='enum'){ %><select name="needAttributes[<%= key %>][<%= f.key %>]"><option value="">Не ограничивать</option><% f.options.forEach(o=>{ %><option value="<%= o.value %>" <%= values[f.key]===o.value?'selected':'' %>><%= o.label %></option><% }); %></select><% } else if(f.input==='number'){ %><input type="number" step="any" name="needAttributes[<%= key %>][<%= f.key %>]" value="<%= values[f.key]??'' %>" <%= f.min==null?'':'min="'+f.min+'"' %> <%= f.max==null?'':'max="'+f.max+'"' %> placeholder="Не ограничивать"> <%= f.unit||'' %><% } else if(f.input==='bool'){ %><input type="checkbox" name="needAttributes[<%= key %>][<%= f.key %>]" <%= values[f.key]===true?'checked':'' %>><% } %></label><% }); %>
<% if(key==='transport'){ %><label>Размер транспорта <select name="transportSize"><option value="">Не ограничивать</option><% ['S','M','L','XL','XXL'].forEach(size=>{ %><option <%= order.requirements?.transport_size===size?'selected':'' %>><%= size %></option><% }); %></select></label><% } %>
</div></fieldset><% }); %><button>Сохранить потребности</button></form></section>
<script>(()=>{const update=()=>document.querySelectorAll('[data-need-panel]').forEach(panel=>{const active=panel.querySelector('input[name=needs]').checked;panel.querySelector('[data-need-fields]').hidden=!active;panel.querySelectorAll('[data-need-fields] input,[data-need-fields] select').forEach(input=>input.disabled=!active)});document.querySelectorAll('input[name=needs]').forEach(input=>input.addEventListener('change',update));update()})()</script>
<% } %>
<% if(['pending_review','new'].includes(order.status)){ %><section class="card"><h2>2. Подобрать получателей</h2>
<% if(!order.requirements?.configured){ %><p>Сначала сохраните потребности и характеристики выше, затем рассчитывайте рассылку.</p><% } else { %>
<form method="get" action="/manager/orders/<%= order.token %>"><label>Потребность <select name="category"><% Object.entries(groups).filter(([key])=>(order.target_categories||[]).includes(key)&&!(order.closedCategories||[]).includes(key)).forEach(([key,label])=>{ %><option value="<%= key %>" <%= plan?.category===key?'selected':'' %>><%= label %></option><% }); %></select></label><label>Кому <select name="language"><option value="">Все подходящие</option><% Object.entries(speakLabels).forEach(([code,label])=>{ %><option value="<%= code %>" <%= plan?.language===code?'selected':'' %>>Говорят <%= label %></option><% }); %></select></label><button>Рассчитать</button></form>
<% } %></section><% } %>
<% if(plan){ %><section class="card"><h2>3. Проверить и отправить: <%= groups[plan.category]||plan.category %></h2>
<p>Требования: <%= plan.criteria.length?plan.criteria.map(item=>item.label+': '+item.value).join(' · '):'дополнительные характеристики не заданы' %>.</p>
<p>Подходят и ещё не получили: <strong><%= plan.count %></strong>. Уже получили: <%= plan.alreadyReceived %>. Отправка в обработке: <%= plan.pending %>. Исключены по характеристикам: <%= plan.attributeExcluded %>.</p>
<p>Цена одному: <%= (plan.price/100).toFixed(2) %> ₾. Расчётное списание: <strong><%= (plan.count*plan.price/100).toFixed(2) %> ₾</strong>.</p>
<% if(plan.recipients.length){ %><details><summary>Показать получателей</summary><ul><% plan.recipients.forEach(m=>{ %><li>#<%= m.id %> · <%= m.phone %> · <%= m.telegram_id?'Telegram, резерв SMS':'SMS' %></li><% }); %></ul></details><% } %>
<% if(plan.alreadySent){ %><p>Эта рассылка уже запускалась.</p><% } else if(plan.count){ %><form method="post" action="/manager/orders/<%= order.token %>/dispatch" onsubmit="this.querySelector('button').disabled=true"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="category" value="<%= plan.category %>"><input type="hidden" name="size" value="<%= plan.size %>"><input type="hidden" name="language" value="<%= plan.language %>"><input type="hidden" name="price" value="<%= plan.price %>"><input type="hidden" name="count" value="<%= plan.count %>"><input type="hidden" name="revision" value="<%= plan.order.revision_version||0 %>"><button>Отправить и списать баланс</button></form><% } else { %><p>Подходящих получателей сейчас нет.</p><% } %></section><% } %>
<section class="card"><h2>Результаты</h2><p>Просмотров: <strong><%= funnel.view %></strong> · Нажатий «Позвонить»: <strong><%= funnel.call %></strong> · WhatsApp: <strong><%= funnel.whatsapp %></strong> · Нажали хотя бы один контакт: <strong><%= funnel.contacted||0 %></strong>.</p>
<% if(funnelByCategory.length){ %><ul><% funnelByCategory.forEach(row=>{ %><li><%= groups[row.category]||row.category %>: уведомлены <%= row.received %> · просмотров <%= row.view %> · звонок <%= row.call %> · WhatsApp <%= row.whatsapp %></li><% }); %></ul><% } %>
<p>Принятие Telegram/SMS не означает прочтение. Просмотр и нажатие контакта не подтверждают договорённость с клиентом. Один исполнитель может подходить нескольким услугам.</p>
<% if(!runs.length){ %><p>Рассылок ещё нет.</p><% } %>
<% runs.forEach(run=>{ %><div class="card"><strong>#<%= run.id %> · <%= groups[run.category]||run.category %></strong><p>Выбрано: <%= run.selected %> · Принято: <%= run.accepted %> (Telegram: <%= run.telegram %>, SMS: <%= run.sms %>) · Ошибки: <%= run.failed %> · Пропущено: <%= run.skipped %> · В обработке / неизвестно: <%= run.pending %></p>
<details><summary>Получатели и причины</summary><ul><% run.deliveries.forEach(d=>{ %><li>Исполнитель #<%= d.master_id %> · <%= d.status %> · <%= d.reason||'' %></li><% }); %></ul></details>
<% if(run.deliveries.some(d=>d.status==='failed'&&!d.retry_run_id)){ %><form method="post" action="/manager/orders/<%= order.token %>/retry"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="runId" value="<%= run.id %>"><button>Повторить подтверждённые ошибки</button></form><% } %></div><% }); %></section>
</main></body></html>

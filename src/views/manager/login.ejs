<%- include('_header') %><div class="card" style="max-width:440px;margin:60px auto"><h1>Вход для менеджера</h1><p>Используйте доступ, выданный администратором.</p><% if(error){ %><p role="alert"><%= error %></p><% } %><form method="post" action="/manager/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= typeof next==='string'?next:'' %>"><label>Логин <input name="login" autocomplete="username" required maxlength="64"></label><label>Пароль <input type="password" name="password" autocomplete="current-password" required maxlength="128"></label><button>Войти в кабинет</button></form></div></main></body></html>

<%- include('_header') %><a href="/manager">← Моя база</a><h1><%= master.name %></h1><p><%= master.phone %> · <%= master.category %> · зарегистрирован <%= date(master.created_at) %></p><% if(master.van_body){ %><p>Кузов: <strong><%= master.van_body %></strong></p><% } %><div class="grid"><div class="card">Баланс<div class="value"><%= money(master.balance_tetri) %></div></div><div class="card">Подписка до<div><%= date(master.subscription_until) %></div></div><div class="card">Статус<div><%= master.is_banned?'Заблокирован':master.is_active?'Активен':'На модерации' %></div><p><%= master.banned_reason %></p></div></div>
<h2>Статистика за последние 30 дней</h2><div class="grid"><div class="card">Заявок с нажатием контакта<div class="value"><%= metrics.contacts %></div></div><div class="card">Среднее время до первого контакта<div class="value"><%= metrics.averageMinutes===null?'—':metrics.averageMinutes.toFixed(1)+' мин' %></div><small>От первой рассылки заявки. Только заявки с известной датой рассылки.</small></div><div class="card">Пополнений: <%= metrics.topups.count %><div class="value"><%= money(metrics.topups.amount) %></div></div></div>
<% if(!master.is_banned){ %><div class="card"><h2>Услуги и описание</h2><p>Измените описание, услуги и характеристики специалиста. Категории и характеристики определяют, в какие группы рассылки он попадёт.</p><a href="/manager/review/<%= master.id %>"><%= master.is_active ? 'Изменить описание и услуги →' : 'Открыть карточку одобрения →' %></a></div><% } %>
<% const channels = master.contact_channels || {}; %><div class="card" id="messengers"><h2>Мессенджеры для заказчиков</h2><p>Заполненное поле даёт кнопку на карточке специалиста в каталоге, пустое её убирает. Указывайте только то, что подтвердил сам специалист. Номер для звонков здесь не меняется.</p>
<% if(typeof messengers!=='undefined' && messengers==='saved'){ %><p role="status">Мессенджеры сохранены.</p><% } %>
<% if(typeof messengers!=='undefined' && messengers==='invalid'){ %><p role="alert">Не сохранено. Номера WhatsApp и Viber — в международном формате: +код страны и номер. Telegram — имя пользователя: латиница, цифры и «_», от 5 знаков.</p><% } %>
<form method="post" action="/manager/masters/<%= master.id %>/messengers"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% [['whatsapp','WhatsApp'],['viber','Viber']].forEach(([key,label])=>{ %><label><%= label %> <input type="tel" name="<%= key %>" id="messenger-<%= key %>" value="<%= channels[key] || '' %>" maxlength="30" placeholder="+995 5XX XX XX XX"> <button type="button" class="secondary-action" data-messenger-primary="messenger-<%= key %>" data-phone="<%= master.phone %>">Подставить основной номер</button></label><% }) %>
<label>Telegram <input type="text" name="telegram" value="<%= channels.telegram || '' %>" maxlength="64" placeholder="@username"></label>
<button type="submit">Сохранить мессенджеры</button></form>
<script>document.querySelectorAll('[data-messenger-primary]').forEach(b=>b.addEventListener('click',()=>{document.getElementById(b.dataset.messengerPrimary).value=b.dataset.phone;}));</script></div>
<div class="card"><h2>Заметка</h2><form method="post" action="/manager/masters/<%= master.id %>/note"><input type="hidden" name="_csrf" value="<%= csrf %>"><textarea name="body" maxlength="2000" required placeholder="Результат разговора, договорённости, следующий шаг"></textarea><button>Сохранить заметку</button></form></div>
<% if(!master.is_banned || master.banned_by_manager_id===manager.id){ %><div class="card"><h2><%= master.is_banned?'Снять свою блокировку':'Заблокировать специалиста' %></h2><form method="post" action="/manager/masters/<%= master.id %>/<%= master.is_banned?'unban':'ban' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><textarea name="body" maxlength="2000" required placeholder="Обязательная причина"></textarea><button class="danger"><%= master.is_banned?'Снять блокировку':'Заблокировать' %></button></form></div><% }else{ %><p>Эту блокировку может снять администратор.</p><% } %>
<div class="card"><h2>Заметки и история управления · последние 100 событий</h2><% events.forEach(e=>{ %><p><small><%= date(e.created_at) %> · <%= ({note:'Заметка',ban:'Блокировка',unban:'Разблокировка',approve:'Быстрое одобрение',assign_category:'Назначена категория',edit_contact:'Правка контактов',reject:'Отклонена заявка'})[e.action] || e.action %></small><br><span class="pre"><%= e.body %></span></p><% }) %></div><div class="card scroll"><h2>История баланса · последние 100 операций</h2><table><tr><th>Дата</th><th>Операция</th><th>Сумма</th></tr><% ledger.forEach(b=>{ %><tr><td><%= date(b.created_at) %></td><td><%= ({topup:'Пополнение',lead_charge:'Доступ к заявке',catalog_call:'Контакт из каталога',promo:'Бонус',admin_correction:'Корректировка'})[b.reason] || b.reason %></td><td><%= money(b.amount_tetri) %></td></tr><% }) %></table></div><div class="card scroll"><h2>Активность · последние 100 событий</h2><p class="muted">Нажатие контакта не подтверждает состоявшийся разговор или выполнение заказа.</p><table><tr><th>Дата</th><th>Заявка</th><th>Событие</th></tr><% activity.forEach(v=>{ %><tr><td><%= date(v.viewed_at) %></td><td>#<%= v.order_id %></td><td><%= ({view:'Просмотр',call:'Нажатие телефона',whatsapp:'WhatsApp'})[v.event_type] || v.event_type %></td></tr><% }) %></table></div></main></body></html>

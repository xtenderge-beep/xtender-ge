<%- include('_header') %><a href="/manager/masters/<%= master.id %>">← Карточка специалиста</a><h1><%= master.name %></h1><p><%= master.phone %> · зарегистрирован <%= date(master.created_at) %></p>
<% if (master.description) { %><div class="card"><h2>Описание услуг</h2><p class="pre"><%= master.description %></p></div><% } %>
<% if (master.avatar_url) { %><div class="card"><h2>Фото</h2><img src="<%= master.avatar_url %>" alt="" style="max-width:280px;border-radius:12px;display:block"></div><% } %>

<% if (manager.is_head_moderator && !master.is_active) { %>
<details class="card">
  <summary>✏️ Поправить имя/телефон (опечатка при регистрации)</summary>
  <form method="post" action="/manager/review/<%= master.id %>/contact" style="margin-top:10px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Имя<input type="text" name="name" value="<%= master.name %>" maxlength="120" required></label>
    <label>Телефон<input type="text" name="phone" value="<%= master.phone %>" pattern="\+995[0-9]{9}" placeholder="+995XXXXXXXXX" required></label>
    <button type="submit">Сохранить контакты</button>
  </form>
</details>
<% } %>

<form method="post" action="/manager/review/<%= master.id %>/approve" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="servicesForm" value="1">
  <h2>1. Города работы</h2><p>Отметьте все города, где специалист готов получать заявки. Выключенный город может включить администратор.</p>
  <div class="service-grid"><% workCities.forEach(city=>{ %><label class="service-tile"><input type="checkbox" name="cityIds" value="<%= city.id %>" <%= city.is_active?'':'disabled' %> <%= (master.work_cities||[]).some(row=>row.city_id===city.id) || (!(master.work_cities||[]).length && (master.city_id===city.id || (!master.city_id && city.slug==='tbilisi'))) ? 'checked' : '' %>> <%= city.name_ru %><%= city.is_active?'':' · выключен' %></label><% }); %></div>
  <h2>2. Языки общения</h2><p>Выберите языки, на которых исполнитель сможет ответить клиенту. Они используются при подборе.</p>
  <div class="service-grid"><% Object.entries(languageNames).forEach(([code,label])=>{ %><label class="service-tile"><input type="checkbox" name="spokenLanguages" value="<%= code %>" <%= (master.spoken_languages||[]).includes(code)?'checked':'' %>> <%= label %></label><% }); %></div>
  <h2>3. Выберите услуги</h2><p>Отметьте всё, что исполнитель реально выполняет. Характеристики выбранных услуг появятся ниже.</p>
  <div class="service-grid"><% categories.forEach(c=>{ %><label class="service-tile"><input type="checkbox" name="services" value="<%= c.type %>" <%= (master.services || []).some(s=>s.service_type===c.type) ? 'checked' : '' %>> <%= c.label %></label><% }); %></div>
  <h2>4. Уточните возможности</h2><p>Для грузчиков отдельно укажите, берут ли они заявки без своей машины.</p>
  <div id="vehicleSizeField" hidden><label>Класс кузова<select name="vehicleSize"><option value="">Размер неизвестен</option><% vanSizes.forEach(s=>{ %><option value="<%= s.code %>" data-spec="<%= s.spec %>" data-length="<%= s.length %>" data-width="<%= s.width %>" data-height="<%= s.height %>" <%= master.vehicle_size === s.code ? 'selected' : '' %>><%= s.code %> — от <%= s.spec %></option><% }); %></select></label>
  <div data-van-dimensions class="service-grid"><span>Длина: <output data-dimension="length">—</output> см</span><span>Ширина: <output data-dimension="width">—</output> см</span><span>Высота: <output data-dimension="height">—</output> см</span></div>
  <p data-van-preset aria-live="polite">Это минимальные габариты класса, а не точные размеры машины.</p>
  <details><summary>Измерены точные внутренние размеры кузова?</summary><p>Укажите все три размера в см — система определит класс по ним.</p>
  <label>Длина<input type="number" name="cargoLength" min="1" max="2000"></label><label>Ширина<input type="number" name="cargoWidth" min="1" max="2000"></label><label>Высота<input type="number" name="cargoHeight" min="1" max="2000"></label></details></div>
  <%- include('../admin/_master-service-fields', {master,serviceConfig:categories}) %>
  <div class="form-actions"><button type="submit" formaction="/manager/review/<%= master.id %>/assign" class="secondary-action">Сохранить услуги без одобрения</button><% if (!master.is_active) { %><button type="submit">Сохранить и одобрить исполнителя</button><% } %></div>
</form>

<% if (manager.is_head_moderator && !master.is_active) { %>
<details class="card">
  <summary style="color:#a53030">🚫 Отклонить заявку (явный спам/дубль/фейк)</summary>
  <form method="post" action="/manager/review/<%= master.id %>/reject" style="margin-top:10px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Причина<input type="text" name="reason" maxlength="500" required placeholder="Например: дубль заявки #123 / номер не отвечает / явный спам"></label>
    <button type="submit" class="danger">Отклонить</button>
  </form>
</details>
<% } %>

<p><small>Другой случай (необязательные характеристики) — <a href="/admin/masters/<%= master.id %>">полная карточка в админке</a>.</small></p>

</main></body></html>

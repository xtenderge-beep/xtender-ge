<%- include('_header') %><a href="/manager">← Моя база</a><h1><%= master.name %></h1><p><%= master.phone %> · заявка от <%= date(master.created_at) %><% if (master.category) { %> · текущая категория: <%= master.category %><% } %></p>
<% if (master.description) { %><div class="card"><h2>Описание услуг</h2><p class="pre"><%= master.description %></p></div><% } %>
<% if (master.avatar_url) { %><div class="card"><h2>Фото</h2><img src="<%= master.avatar_url %>" alt="" style="max-width:280px;border-radius:12px;display:block"></div><% } %>
<div class="card">
  <h2>Выберите категорию и одобрите</h2>
  <p class="muted">Категория закрепляет заявку за вами и сразу пробует одобрить профиль. Обязательные характеристики — прямо здесь; если чего-то не хватит, попросим открыть полную карточку в админке.</p>
  <div class="grid">
    <% categories.forEach(function (c) { %>
      <form method="post" action="/manager/review/<%= master.id %>/approve" class="card">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="category" value="<%= c.type %>">
        <h3 style="margin:0 0 8px"><%= c.icon ? c.icon + ' ' : '' %><%= c.label %></h3>
        <% c.fields.filter(function (f) { return f.required; }).forEach(function (f) { %>
          <label><%= f.label %>
            <% if (f.input === 'enum') { %>
              <select name="attr_<%= f.key %>" required>
                <% f.options.forEach(function (o) { %><option value="<%= o.value %>"><%= o.label %></option><% }); %>
              </select>
            <% } else if (f.input === 'number') { %>
              <input type="number" name="attr_<%= f.key %>" min="<%= f.min %>" max="<%= f.max %>" required>
            <% } else if (f.input === 'bool') { %>
              <input type="checkbox" name="attr_<%= f.key %>" value="true">
            <% } else { %>
              <input type="text" name="attr_<%= f.key %>" required>
            <% } %>
          </label>
        <% }); %>
        <button style="width:100%">Одобрить</button>
      </form>
    <% }); %>
  </div>
</div>
<p><small>Другой случай (поправить телефон, имя, необязательные характеристики) — <a href="/admin/masters/<%= master.id %>">полная карточка в админке</a>.</small></p>
</main></body></html>

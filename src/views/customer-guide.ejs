<!DOCTYPE html><html lang="<%= lang %>"><head>
<%- include('partials/head', {title: guide.title, metaDescription: guide.description}) %>
<link rel="canonical" href="<%= seo.canonical %>"><% Object.entries(seo.alternates).forEach(([code,url]) => { %><link rel="alternate" hreflang="<%= code %>" href="<%= url %>"><% }); %><link rel="alternate" hreflang="x-default" href="<%= seo.xDefault %>">
<meta property="og:title" content="<%= guide.title %>"><meta property="og:description" content="<%= guide.description %>"><meta property="og:url" content="<%= seo.canonical %>"><meta property="og:type" content="article">
</head><body class="bg-stone-50 text-stone-900"><main class="max-w-3xl mx-auto px-5 py-12"><a class="text-emerald-700 font-bold" href="<%= home %>">Xtender</a><nav class="flex gap-4 my-6" aria-label="Language"><% Object.entries({ka:'ქართული',ru:'Русский',en:'English'}).forEach(([code,name]) => { %><a href="<%= code==='ka'?'/guides/request?lang=ka':'/'+code+'/guides/request' %>" lang="<%= code %>"><%= name %></a><% }); %></nav>
<article><h1 class="text-3xl font-extrabold mb-5"><%= guide.heading %></h1><p class="text-lg leading-relaxed text-stone-600"><%= guide.intro %></p><% guide.sections.forEach(([heading,body]) => { %><section class="mt-8"><h2 class="text-xl font-bold mb-3"><%= heading %></h2><p class="leading-relaxed text-stone-600"><%= body %></p></section><% }); %></article>
<div class="flex flex-wrap gap-4 mt-10"><a class="bg-emerald-700 text-white px-5 py-3 rounded-xl font-bold" href="<%= home %>#post-section"><%= guide.cta %></a><a class="px-5 py-3 text-emerald-700 font-bold" href="<%= home %>#masters-section"><%= guide.catalog %></a></div></main></body></html>
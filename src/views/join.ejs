<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
    <%- include('partials/head', {
      title: t('join_page_title'),
      metaDescription: t('meta_description_join'),
      viewport: 'width=device-width, initial-scale=1.0, interactive-widget=resizes-content',
    }) %>

    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="alternate" hreflang="ka" href="<%= seo.alternates.ka %>">
    <link rel="alternate" hreflang="ru" href="<%= seo.alternates.ru %>">
    <link rel="alternate" hreflang="en" href="<%= seo.alternates.en %>">
    <link rel="alternate" hreflang="x-default" href="<%= seo.xDefault %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="xtender.ge">
    <meta property="og:title" content="<%= t('join_page_title') %>">
    <meta property="og:description" content="<%= t('meta_description_join') %>">
    <meta property="og:url" content="<%= seo.canonical %>">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= t('join_page_title') %>">
    <meta name="twitter:description" content="<%= t('meta_description_join') %>">
</head>
<%
    // focused: the visitor came by a manager's link or a promo link, so the page is only the registration form.
    const focusMode = typeof focused !== 'undefined' && focused === true;
    const hasPromo = typeof promo !== 'undefined' && promo;
%>
<body class="provider-page provider-join <%= focusMode ? 'provider-join-focused ' : '' %>font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

    <header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
        <div class="max-w-4xl mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center gap-2">
                    <%- include('partials/brand') %>
                </a>
                <%- include('partials/lang-switch', { alternates: seo.alternates, switchQuery: typeof switchQuery === 'string' ? switchQuery : '' }) %>
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
        <% if (focusMode) { %>
        <h1 class="text-2xl font-black tracking-tight text-stone-900"><%= t('join_headline') %></h1>
        <p class="text-sm text-stone-500 mt-2"><%= t('join_have_profile') %> <a href="/master" class="font-bold text-emerald-700 underline underline-offset-2"><%= t('master_login_nav') %></a></p>
        <% } else { %>
        <h1 class="text-2xl font-black tracking-tight text-stone-900"><%= t('provider_intro') %></h1>
        <p class="text-sm text-stone-500 mt-1"><%= t('provider_demo_lead') %></p>
        <a href="/master" class="inline-flex items-center gap-2 mt-3 px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-800 text-sm font-bold transition">
            <i class="fa-solid fa-right-to-bracket text-emerald-600"></i><%= t('master_login_title') %>
        </a>
        <% } %>

        <div class="provider-join-grid">
        <div id="signupCard" class="bg-white rounded-2xl shadow-xl border border-stone-200/80 border-l-4 border-l-emerald-600 overflow-hidden">

            <% if (focusMode && hasPromo) { %>
            <%# A promo link is the one thing worth a line at the top: the amount is verified and it is why the person came. %>
            <section class="provider-focus-promo <%= promo.valid ? 'is-valid' : 'is-invalid' %>" role="status">
                <i class="fa-solid fa-gift" aria-hidden="true"></i>
                <p><%= promo.valid ? t('join_promo_banner').replace('{code}', promo.code).replace('{amount}', promo.amountGel.toFixed(2)) : t('join_promo_bad').replace('{code}', promo.code) %></p>
            </section>
            <% } %>

            <% if (!focusMode && welcomeBonusTetri > 0) { %>
            <section class="provider-welcome provider-welcome-intro">
                <h2><%= t('welcome_title') %></h2>
                <strong>+<%= (welcomeBonusTetri / 100).toFixed(2) %> ₾</strong>
                <p><%= t('welcome_description') %></p>
            </section>
            <% } %>

            <div id="signupTopbar" class="hidden items-center gap-3 px-4 py-3 border-b border-stone-200 bg-white shrink-0">
                <button id="signupTopbarBack" type="button" onclick="changeSignupStep(signupStep - 1)" aria-label="<%= t('otp_back') %>" class="w-9 h-9 -ml-1 flex items-center justify-center rounded-full text-stone-600 hover:bg-stone-100 active:scale-95 transition shrink-0" hidden>
                    <i class="fa-solid fa-arrow-left text-base"></i>
                </button>
                <a href="/" class="flex items-center gap-2"><%- include('partials/brand') %></a>
            </div>
            <div id="signupProgress" class="provider-signup-header">
                <p id="signupStepCount" class="provider-signup-count" aria-live="polite"><%= t('provider_signup_count').replace('{step}', '1') %></p>
                <ol class="provider-signup-progress" aria-label="<%= t('provider_signup_progress') %>">
                    <% ['provider_signup_services','provider_signup_city','provider_signup_profile'].forEach((key, i) => { %>
                    <li data-signup-indicator="<%= i %>" <%- i === 0 ? 'aria-current="step"' : '' %>><span class="provider-signup-progress-num"><%= i + 1 %></span><span class="provider-signup-progress-label"><%= t(key) %></span></li>
                    <% }); %>
                </ol>
                <h2 id="signupStepTitle" class="provider-section-title" tabindex="-1"><%= t('provider_services_section') %></h2>
            </div>
            <div id="detailsStep" class="p-5 sm:p-6 space-y-4">
                <div data-signup-panel="0" class="space-y-4">
                <div class="compose-topbar hidden items-center gap-3 px-3 py-2.5 border-b border-stone-200 bg-white shrink-0">
                    <button type="button" onclick="exitSignupCompose()" aria-label="<%= t('otp_back') %>" class="w-9 h-9 -ml-1 flex items-center justify-center rounded-full text-stone-600 hover:bg-stone-100 active:scale-95 transition shrink-0">
                        <i class="fa-solid fa-arrow-left text-base"></i>
                    </button>
                    <img src="/brand-mark.svg" width="22" height="22" alt="" class="shrink-0">
                    <span class="flex-1 font-extrabold text-stone-900 text-sm"><%= t('provider_services_section') %></span>
                    <button type="button" onclick="nextSignupStep()" class="px-3 py-1.5 rounded-lg text-emerald-600 font-extrabold text-sm uppercase tracking-wide hover:bg-emerald-50 active:scale-95 transition shrink-0"><%= t('home_next') %></button>
                </div>
                <div class="signup-compose-field">
                    <label for="descriptionInput" class="sr-only"><%= t('join_services_description') %></label>
                    <textarea id="descriptionInput" required maxlength="2000" rows="3" placeholder="<%= t('provider_description_examples')[0] %>"
                        class="w-full text-sm font-medium outline-none transition text-stone-800 resize-none placeholder:text-stone-400 bg-stone-50 border border-stone-200 rounded-xl p-3 focus:border-emerald-500 focus:bg-white"></textarea>
                    <p class="provider-help mt-2"><%= t('join_services_hint') %></p>
                </div>
                </div>
                <div data-signup-panel="1" class="space-y-6" hidden>
                    <fieldset>
                        <legend class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_work_cities_label') %></legend>
                        <p class="provider-help mb-2"><%= t('join_work_cities_hint') %></p>
                        <div class="flex flex-wrap gap-2">
                        <% cities.forEach(c => { %>
                            <label class="flex items-center gap-2 px-3 py-3 rounded-xl border border-stone-200 text-sm"><input type="checkbox" name="cityIds" value="<%= c.id %>"><span><%= c.name %></span></label>
                        <% }); %>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_languages_label') %></legend>
                        <p class="provider-help mb-2"><%= t('join_languages_hint') %></p>
                        <div class="grid grid-cols-2 gap-2">
                        <% Object.entries({ka:'ქართული',ru:'Русский',en:'English',hy:'Հայերեն',az:'Azərbaycan dili',tr:'Türkçe',uk:'Українська'}).forEach(([code,label]) => { %>
                            <label class="flex items-center gap-2 px-3 py-3 rounded-xl border border-stone-200 text-sm"><input type="checkbox" name="spokenLanguages" value="<%= code %>"><span><%= label %></span></label>
                        <% }); %>
                        </div>
                    </fieldset>
                </div>
                <div data-signup-panel="2" class="space-y-4" hidden>
                <div>
                    <label for="nameInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_name_label') %></label>
                    <input type="text" id="nameInput" autocomplete="name" placeholder="<%= t('join_name_placeholder') %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                </div>

                <div>
                    <label for="phoneInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_phone_label') %></label>
                    <input type="tel" data-georgian-phone value="+995" pattern="\+995(?:\s*[0-9]){9}\s*" id="phoneInput" autocomplete="tel" inputmode="tel" placeholder="<%= t('form_phone_placeholder') %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                </div>

                <%# In focused mode the promo line is already at the top of the card. %>
                <% if (!focusMode && hasPromo && promo.valid) { %>
                    <div class="flex items-center gap-2 text-sm font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl p-3">
                        <i class="fa-solid fa-gift"></i><span><%= t('join_promo_banner').replace('{code}', promo.code).replace('{amount}', promo.amountGel.toFixed(2)) %></span>
                    </div>
                <% } else if (!focusMode && hasPromo && !promo.valid) { %>
                    <p class="text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-2.5"><%= t('join_promo_bad').replace('{code}', promo.code) %></p>
                <% } %>
                <details class="group" <%= hasPromo ? 'open' : '' %>>
                    <summary class="cursor-pointer text-xs font-bold text-emerald-700 flex items-center gap-1.5 select-none">
                        <i class="fa-solid fa-tag text-[10px]"></i><%= t('join_promo_toggle') %>
                        <i class="fa-solid fa-chevron-down text-[9px] text-stone-400 transition group-open:rotate-180"></i>
                    </summary>
                    <input type="text" id="promoInput" value="<%= hasPromo ? promo.code : '' %>" placeholder="<%= t('join_promo_placeholder') %>" autocomplete="off"
                        class="mt-2 w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold uppercase tracking-wider text-stone-900 bg-white placeholder:normal-case placeholder:tracking-normal placeholder:font-medium">
                </details>
                <% const legalPrefix = lang === 'ka' ? '' : '/' + lang; %>
                <section class="rounded-xl border border-stone-200 bg-stone-50 p-3" aria-labelledby="signupBeforeTitle">
                    <h3 id="signupBeforeTitle" class="block text-[11px] font-bold text-stone-700 uppercase mb-1.5"><%= t('signup_before_title') %></h3>
                    <ul class="space-y-1.5 text-sm text-stone-700 list-disc pl-5">
                        <% consent.notices.forEach(notice => { %><li><%= notice %></li><% }) %>
                    </ul>
                </section>
                <div class="space-y-3">
                <label class="flex items-start gap-3 p-3 rounded-xl border border-stone-200 text-sm cursor-pointer">
                    <input type="checkbox" id="termsCheckbox" aria-describedby="termsError" class="mt-1 w-4 h-4 accent-emerald-600 shrink-0">
                    <span><%= consent.termsLabel %> <a href="<%= legalPrefix %>/terms" target="_blank" rel="noopener" class="text-emerald-700 underline"><%= t('signup_terms_link') %></a></span>
                </label>
                <p id="termsError" class="hidden text-xs text-red-700" role="alert"></p>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-stone-200 text-sm cursor-pointer">
                    <input type="checkbox" id="privacyCheckbox" aria-describedby="privacyError" class="mt-1 w-4 h-4 accent-emerald-600 shrink-0">
                    <span><%= consent.privacyLabel %> <a href="<%= legalPrefix %>/privacy" target="_blank" rel="noopener" class="text-emerald-700 underline"><%= t('join_privacy_link') %></a></span>
                </label>
                <p id="privacyError" class="hidden text-xs text-red-700" role="alert"></p>
                <p class="text-xs text-stone-500"><%= consent.confirmationHint %></p>
                </div>
                </div>
                <div class="provider-signup-actions">
                    <button id="signupBack" type="button" onclick="changeSignupStep(signupStep - 1)" class="provider-signup-back" hidden><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><%= t('otp_back') %></button>
                    <button id="signupNext" type="button" onclick="nextSignupStep()" class="provider-signup-next"><%= t('home_next') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    <button id="sendOtpButton" type="button" onclick="sendOtp()" class="provider-signup-next" hidden><span id="sendOtpButtonLabel"><%= t('signup_code') %></span><i id="sendOtpButtonIcon" class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                </div>
            </div>

            <div id="otpStep" class="p-5 sm:p-6 hidden">
                <h2 id="otpTitle" class="provider-section-title" tabindex="-1"><%= t('provider_otp_title') %></h2>
                <p class="text-sm text-stone-600 mt-2 mb-4"><span id="otpSentTo" aria-live="polite"></span> <button id="otpChangeNumber" type="button" onclick="backToDetails()" class="font-bold text-emerald-700 underline underline-offset-2"><%= t('otp_change_number') %></button></p>
                <label for="codeInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1">
                    <i class="fa-solid fa-key text-emerald-600 mr-1"></i><%= t('otp_label') %>
                </label>
                <input type="text" id="codeInput" maxlength="4" inputmode="numeric" autocomplete="one-time-code"
                    class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none font-mono text-lg font-black tracking-[0.3em] text-center text-stone-900 bg-white">
                <button id="verifyOtpButton" type="button" onclick="verifyAndRegister()" class="mt-4 w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i>
                    <span><%= t('signup_confirm') %></span>
                </button>
                <button id="otpResend" type="button" onclick="sendOtp(true)" class="mt-2 w-full py-3 text-sm font-bold text-stone-600 hover:text-stone-900 disabled:opacity-50 disabled:cursor-not-allowed transition"><%= t('otp_resend') %></button>
            </div>

            <div role="alert" aria-live="polite" id="formMsg" class="hidden text-xs font-bold mx-5 sm:mx-6 mb-5 sm:mb-6 p-3 rounded-xl"></div>
        </div>
        <% if (!focusMode) { %>
        <aside>
          <% const providerNotifFirst = t('provider_notifications_data')[0]; %>
          <div class="provider-illustration">
            <p class="provider-illustration-label"><%= t('provider_illustration_label') %></p>
            <div class="provider-illustration-track" id="providerIllustrationTrack" aria-live="polite">
              <div class="provider-illustration-card is-active">
                <p class="provider-illustration-category"><span aria-hidden="true"><%= providerNotifFirst.emoji %></span><span><%= providerNotifFirst.notification %></span></p>
                <p class="provider-illustration-body"><%= providerNotifFirst.body %></p>
                <div class="provider-illustration-actions">
                  <span class="provider-illustration-btn provider-illustration-btn--call"><i class="fa-solid fa-phone" aria-hidden="true"></i><%= t('btn_call') %></span>
                  <span class="provider-illustration-btn provider-illustration-btn--whatsapp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><%= t('btn_whatsapp') %></span>
                </div>
              </div>
            </div>
            <button type="button" id="providerExampleNext" class="example-next"><%= t('example_next') %></button>
            <p class="provider-illustration-note"><%= t('provider_illustration_note') %></p>
          </div>
          <%- include('partials/provider-pricing') %><%- include('partials/provider-guide') %></aside>
        <% } %>
    </div></main>

    <script>
        const T = <%- JSON.stringify(clientStrings) %>;
<% if (typeof focused === 'undefined' || focused !== true) { %>        const PROVIDER_NOTIFICATIONS = <%- JSON.stringify(t('provider_notifications_data')) %>;
<% } %>

        // --- Режим фокуса на шаге 1 (описание услуг): тот же полноэкранный
        //     композер, что и в клиентской заявке на главной — тут тоже
        //     свободный текст, только этот текст длиннее и его удобнее писать
        //     на весь экран, а не в трёхстрочном поле под остальными шагами.
        //
        // signup-started ставится один раз и больше не снимается: как только
        // регистрация реально началась (напечатали описание или ушли дальше
        // первого шага), шапка/интро/сайдбар с ценами прячутся до конца анкеты —
        // чтобы они не выныривали заново на каждом шаге после выхода из
        // полноэкранного режима.
        const descriptionInput = document.getElementById('descriptionInput');
        function enterSignupCompose() {
            if (window.innerWidth >= 640) return;
            document.body.classList.add('signup-started', 'signup-compose-active');
        }
        function exitSignupCompose() {
            if (!document.body.classList.contains('signup-compose-active')) return;
            document.body.classList.remove('signup-compose-active');
            if (document.activeElement === descriptionInput) descriptionInput.blur();
        }
        if (descriptionInput) descriptionInput.addEventListener('focus', enterSignupCompose);

        function showMsg(text, isError) {
            const el = document.getElementById('formMsg');
            if (!text) { el.classList.add('hidden'); return; }
            el.textContent = text;
            el.classList.remove('hidden');
            el.classList.toggle('bg-red-50', Boolean(isError));
            el.classList.toggle('text-red-700', Boolean(isError));
            el.classList.toggle('bg-emerald-50', !isError);
            el.classList.toggle('text-emerald-700', !isError);
        }

        function collectPayload() {
            return {
                name: document.getElementById('nameInput').value.trim(),
                cityIds: [...document.querySelectorAll('input[name="cityIds"]:checked')].map(el => el.value),
                spokenLanguages: [...document.querySelectorAll('input[name="spokenLanguages"]:checked')].map(el => el.value),
                description: document.getElementById('descriptionInput').value.trim(),
                phone: document.getElementById('phoneInput').value.trim(),
                promoCode: document.getElementById('promoInput').value.trim(),
                termsAccepted: document.getElementById('termsCheckbox').checked,
                privacyAccepted: document.getElementById('privacyCheckbox').checked,
            };
        }

        const sendOtpButton = document.getElementById('sendOtpButton');

        let signupStep = 0;
        let signupBusy = false;
        let otpVisible = false; // true while the phone-code screen replaces the form
        let lockedSignupFields = [];
        const signupTitles = [T.provider_services_section, T.provider_signup_where_title, T.provider_signup_profile_title];
        const LAST_STEP = signupTitles.length - 1;

        function changeSignupStep(step, focusTitle = true) {
            if (signupBusy || !Number.isInteger(step) || step < 0 || step > LAST_STEP) return;
            // The phone-code screen replaces the form: "back" there means "change the number".
            if (otpVisible) { backToDetails(); return; }
            exitSignupCompose();
            if (step > 0) document.body.classList.add('signup-started');
            signupStep = step;
            showMsg('');
            document.querySelectorAll('[data-signup-panel]').forEach((panel, index) => { panel.hidden = index !== step; });
            document.querySelectorAll('[data-signup-indicator]').forEach((item, index) => {
                if (index === step) item.setAttribute('aria-current', 'step');
                else item.removeAttribute('aria-current');
                item.classList.toggle('is-complete', index < step);
            });
            document.getElementById('signupStepCount').textContent = T.provider_signup_count.replace('{step}', String(step + 1));
            const title = document.getElementById('signupStepTitle');
            title.textContent = signupTitles[step];
            document.getElementById('signupBack').hidden = step === 0;
            document.getElementById('signupTopbarBack').hidden = step === 0;
            document.getElementById('signupNext').hidden = step === LAST_STEP;
            sendOtpButton.hidden = step !== LAST_STEP;
            if (focusTitle) {
                document.getElementById('signupCard').scrollIntoView({ block: 'start' });
                title.focus({ preventScroll: true });
            }
        }

        function signupError(step, message, selector) {
            changeSignupStep(step, false);
            showMsg(message, true);
            const field = document.querySelector(selector);
            field.focus();
            if (field.id === 'termsCheckbox' || field.id === 'privacyCheckbox') {
                field.setAttribute('aria-invalid', 'true');
                const hint = document.getElementById(field.id === 'termsCheckbox' ? 'termsError' : 'privacyError');
                hint.textContent = message; hint.classList.remove('hidden');
            }
            return false;
        }

        function validateSignupStep(step) {
            const payload = collectPayload();
            if (step === 0 && (!payload.description || payload.description.length > 2000)) {
                return signupError(0, T.join_services_required, '#descriptionInput');
            }
            if (step === 1) {
                if (!payload.cityIds.length) return signupError(1, T.join_work_cities_required, 'input[name="cityIds"]');
                if (!payload.spokenLanguages.length) return signupError(1, T.join_languages_required, 'input[name="spokenLanguages"]');
            }
            if (step === 2) {
                if (!payload.name) return signupError(2, T.join_err_name_required, '#nameInput');
                if (!window.GeorgianPhone.validate(document.getElementById('phoneInput'))) return false;
                if (!payload.termsAccepted) return signupError(2, T.signup_terms_required, '#termsCheckbox');
                if (!payload.privacyAccepted) return signupError(2, T.signup_privacy_required, '#privacyCheckbox');
            }
            return true;
        }

        function nextSignupStep() {
            if (!signupBusy && signupStep < LAST_STEP && validateSignupStep(signupStep)) changeSignupStep(signupStep + 1);
        }

        document.getElementById('detailsStep').addEventListener('input', function () {
            showMsg('');
            ['terms', 'privacy'].forEach(key => {
                document.getElementById(key + 'Checkbox').removeAttribute('aria-invalid');
                document.getElementById(key + 'Error').classList.add('hidden');
            });
        });

        function setSignupBusy(busy) {
            signupBusy = busy;
            document.getElementById('signupCard').setAttribute('aria-busy', String(busy));
            if (busy) {
                // The resend button keeps its own cooldown state, so it is not part of the busy lock.
                lockedSignupFields = [...document.querySelectorAll('#signupCard input, #signupCard textarea, #signupCard button')].filter(el => !el.disabled && el.id !== 'otpResend');
                lockedSignupFields.forEach(el => { el.disabled = true; });
            } else {
                lockedSignupFields.forEach(el => { el.disabled = false; });
                lockedSignupFields = [];
            }
        }

        let consentChallenge = null;
        let consentVerified = false;
        const consentLanguage = <%- JSON.stringify(consent.language) %>;
        const consentDigest = <%- JSON.stringify(consent.digest) %>;
        // A new code can be requested after 30 seconds; the server rate limit still applies.
        let resendTimer = null;
        function startResendCooldown() {
            const button = document.getElementById('otpResend');
            clearInterval(resendTimer);
            let left = 30;
            button.disabled = true;
            button.textContent = T.otp_resend + ' (' + left + ')';
            resendTimer = setInterval(function () {
                left -= 1;
                if (left <= 0) { clearInterval(resendTimer); button.disabled = false; button.textContent = T.otp_resend; }
                else button.textContent = T.otp_resend + ' (' + left + ')';
            }, 1000);
        }

        async function sendOtp(isResend) {
            if (signupBusy) return;
            showMsg('');
            for (let step = 0; step <= LAST_STEP; step++) { if (!validateSignupStep(step)) return; }
            const payload = collectPayload();
            setSignupBusy(true);
            try {
            const res = await fetch('/api/masters/otp/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone: payload.phone, termsAccepted: payload.termsAccepted, privacyAccepted: payload.privacyAccepted, consentLanguage, consentDigest }),
            });
            const data = await res.json();
            if (!data.success) return showMsg(data.message || T.js_err_send_code, true);
            consentChallenge = data.challengeId; consentVerified = false;

            showMsg(isResend === true ? T.js_ok_code_sent : '', false);
            document.getElementById('otpSentTo').textContent = T.otp_sent_to.replace('{phone}', payload.phone);
            document.getElementById('detailsStep').classList.add('hidden');
            otpVisible = true;
            document.getElementById('signupProgress').classList.add('hidden');
            document.getElementById('otpStep').classList.remove('hidden');
            document.getElementById('codeInput').value = '';
            startResendCooldown();
            document.getElementById('signupCard').scrollIntoView({ block: 'start' });
            } catch (_) {
                showMsg(T.provider_signup_network, true);
            } finally {
                setSignupBusy(false);
                if (!document.getElementById('otpStep').classList.contains('hidden')) document.getElementById('codeInput').focus({ preventScroll: true });
            }
        }

        function backToDetails() {
            if (signupBusy) return;
            consentChallenge = null;
            consentVerified = false;
            clearInterval(resendTimer);
            otpVisible = false;
            showMsg('');
            document.getElementById('otpStep').classList.add('hidden');
            document.getElementById('detailsStep').classList.remove('hidden');
            document.getElementById('signupProgress').classList.remove('hidden');
            changeSignupStep(LAST_STEP);
        }

        async function verifyAndRegister() {
            if (signupBusy) return;
            const payload = collectPayload();
            const code = document.getElementById('codeInput').value.trim();
            if (!code) return showMsg(T.js_err_empty_code, true);

            setSignupBusy(true);
            try {
            let res, data;
            if (!consentVerified) {
            res = await fetch('/api/masters/otp/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    phone: payload.phone,
                    code, challengeId: consentChallenge,
                    termsAccepted: payload.termsAccepted,
                    privacyAccepted: payload.privacyAccepted,
                }),
            });
            data = await res.json();
            if (!data.success) return showMsg(data.message || T.js_err_wrong_code, true);
            consentVerified = true;
            }

            const fd = new FormData();
            if (!payload.spokenLanguages.length) return showMsg(T.join_languages_required, true);
            payload.spokenLanguages.forEach(code => fd.append('spokenLanguages', code));
            fd.append('name', payload.name);
            if (!payload.cityIds.length) return showMsg(T.join_work_cities_required, true);
            payload.cityIds.forEach(id => fd.append('cityIds', id));
            fd.append('description', payload.description);
            fd.append('phone', payload.phone);
            fd.append('challengeId', consentChallenge);
            fd.append('promoCode', payload.promoCode);
            fd.append('termsAccepted', String(payload.termsAccepted));
            fd.append('privacyAccepted', String(payload.privacyAccepted));

            res = await fetch('/api/masters/register', { method: 'POST', body: fd });
            data = await res.json();
            if (!data.success) return showMsg(data.message || T.js_err_send_code, true);

            // Профиль на модерации и первые вопросы («как приходят заявки», billing)
            // теперь отвечает сам кабинет (guide-блок открыт для профиля на проверке) —
            // отдельный промежуточный экран здесь только откладывал вход в кабинет.
            window.location.href = data.link;
            } catch (_) {
                showMsg(T.provider_signup_network, true);
            } finally {
                setSignupBusy(false);
            }
        }

<% if (typeof focused === 'undefined' || focused !== true) { %>        (function () {
            const track = document.getElementById('providerIllustrationTrack');
            const next = document.getElementById('providerExampleNext');
            if (!track || !next || !Array.isArray(PROVIDER_NOTIFICATIONS) || PROVIDER_NOTIFICATIONS.length < 2) return;
            let index = 0;
            next.addEventListener('click', function () {
                index = (index + 1) % PROVIDER_NOTIFICATIONS.length;
                const example = PROVIDER_NOTIFICATIONS[index];
                const category = track.querySelector('.provider-illustration-category');
                category.children[0].textContent = example.emoji;
                category.children[1].textContent = example.notification;
                track.querySelector('.provider-illustration-body').textContent = example.body;
            });
        })();
<% } %>
    </script>
</body>
</html>

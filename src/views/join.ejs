<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
    <%- include('partials/head', {
      title: t('join_page_title'),
      metaDescription: t('meta_description_join'),
    }) %>

    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="alternate" hreflang="ka" href="<%= seo.alternates.ka %>">
    <link rel="alternate" hreflang="ru" href="<%= seo.alternates.ru %>">
    <link rel="alternate" hreflang="en" href="<%= seo.alternates.en %>">
    <link rel="alternate" hreflang="x-default" href="<%= seo.xDefault %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="xtender.ge">
    <meta property="og:title" content="<%= t('join_page_title') %>">
    <meta property="og:description" content="<%= t('meta_description_join') %>">
    <meta property="og:url" content="<%= seo.canonical %>">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= t('join_page_title') %>">
    <meta name="twitter:description" content="<%= t('meta_description_join') %>">
</head>
<body class="provider-page provider-join font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

    <header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
        <div class="max-w-4xl mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-xl font-black tracking-tight text-stone-900">xtender<span class="text-emerald-600">.ge</span></span>
                </a>
                <%- include('partials/lang-switch', { alternates: seo.alternates }) %>
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
        <h1 class="text-2xl font-black tracking-tight text-stone-900"><%= t('provider_intro') %></h1>
        <p class="text-sm text-stone-500 mt-1"><%= t('provider_intro_body') %></p>
        <a href="/master" class="inline-flex items-center gap-2 mt-3 px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-800 text-sm font-bold transition">
            <i class="fa-solid fa-right-to-bracket text-emerald-600"></i><%= t('master_login_title') %>
        </a>

        <ol class="provider-steps"><% ['provider_step1','provider_step2','provider_step3','provider_step4'].forEach((key,i)=>{ %><li><span><%= i+1 %></span><%= t(key) %></li><% }) %></ol>
        <div class="provider-join-grid"><aside><% if(welcomeBonusTetri > 0) { %><section class="provider-welcome"><h2><%= t('welcome_title') %></h2><strong>+<%= (welcomeBonusTetri/100).toFixed(2) %> ₾</strong><p><%= t('welcome_description') %></p></section><% } %><%- include('partials/provider-pricing') %><%- include('partials/provider-guide') %></aside>
        <div class="bg-white rounded-2xl shadow-xl border border-stone-200/80 border-l-4 border-l-emerald-600 overflow-hidden">

            <div id="detailsStep" class="p-5 sm:p-6 space-y-4"><h2 class="provider-section-title"><%= t('provider_services_section') %></h2><p class="provider-help"><%= t('provider_registration_hint') %></p>

                <div>
                    <label for="nameInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_name_label') %></label>
                    <input type="text" id="nameInput" autocomplete="name" placeholder="<%= t('join_name_placeholder') %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_service_type_label') %></label>
                    <div class="grid grid-cols-2 gap-2" id="serviceTypeBar">
                        <% serviceConfig.forEach(function (svc) { %>
                            <button type="button" data-svc="<%= svc.type %>" onclick="selectServiceType('<%= svc.type %>')"
                                class="svc-btn flex flex-col items-center gap-1 px-3 py-3 rounded-xl text-xs font-bold transition border bg-white text-stone-600 border-stone-200">
                                <span class="text-xl leading-none"><%= svc.icon %></span>
                                <span class="text-center leading-tight"><%= svc.label %></span>
                            </button>
                        <% }); %>
                    </div>
                </div>

                <% serviceConfig.forEach(function (svc) { %>
                <div class="svc-fields hidden space-y-3" data-svc-fields="<%= svc.type %>">
                    <% if (svc.type === 'van') { %>
                        <div>
                            <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_vehicle_details_label') %></label>
                            <input type="text" data-field="vehicleType" placeholder="<%= t('join_vehicle_type_placeholder_transport') %>"
                                class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-medium text-stone-900 bg-white">
                        </div>
                    <% } %>
                    <% svc.fields.forEach(function (f) { %>
                        <% if (f.input === 'size') { %>
                            <div>
                                <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_cargo_dims_label') %></label>
                                <div class="grid grid-cols-3 gap-2">
                                    <input type="number" min="0" data-field="cargo_length_cm" oninput="updateSizeBadge()" placeholder="<%= t('join_cargo_length_placeholder') %>"
                                        class="w-full px-3 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-medium text-stone-900 bg-white">
                                    <input type="number" min="0" data-field="cargo_width_cm" oninput="updateSizeBadge()" placeholder="<%= t('join_cargo_width_placeholder') %>"
                                        class="w-full px-3 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-medium text-stone-900 bg-white">
                                    <input type="number" min="0" data-field="cargo_height_cm" oninput="updateSizeBadge()" placeholder="<%= t('join_cargo_height_placeholder') %>"
                                        class="w-full px-3 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-medium text-stone-900 bg-white">
                                </div>
                                <p id="sizeBadge" class="mt-1.5 text-xs font-bold text-stone-500"><%= t('join_size_auto_empty') %></p>
                            </div>
                        <% } else if (f.input === 'enum') { %>
                            <div>
                                <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= f.label %></label>
                                <div class="grid grid-cols-2 gap-2" data-enum="<%= f.key %>">
                                    <% f.options.forEach(function (o) { %>
                                        <button type="button" data-val="<%= o.value %>" onclick="selectEnum(this)"
                                            class="opt-btn flex flex-col items-center justify-center gap-1 px-3 py-2.5 rounded-xl text-xs font-bold text-center leading-tight transition border bg-white text-stone-600 border-stone-200">
                                            <% if (o.icon) { %><i class="fa-solid <%= o.icon %> text-lg"></i><% } %>
                                            <span><%= o.label %></span>
                                        </button>
                                    <% }); %>
                                </div>
                            </div>
                        <% } else if (f.input === 'number') { %>
                            <div>
                                <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= f.label %><%= f.unit ? ', ' + f.unit : '' %></label>
                                <input type="number" data-field="<%= f.key %>" <%= f.min != null ? 'min=' + f.min : '' %> <%= f.max != null ? 'max=' + f.max : '' %>
                                    class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-medium text-stone-900 bg-white">
                            </div>
                        <% } else if (f.input === 'bool') { %>
                            <label class="flex items-center gap-2.5 text-sm font-bold text-stone-700 cursor-pointer bg-stone-50 border border-stone-200 rounded-xl px-3 py-3">
                                <input type="checkbox" data-field="<%= f.key %>" class="w-4 h-4 accent-emerald-600 shrink-0">
                                <span><%= f.label %></span>
                            </label>
                        <% } %>
                    <% }); %>
                </div>
                <% }); %>

                <div id="locationFields" class="hidden space-y-3">
                    <% if (cities.length > 1) { %>
                        <div>
                            <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_city_label') %></label>
                            <select id="cityInput" onchange="renderDistricts()"
                                class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                                <% cities.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
                            </select>
                        </div>
                    <% } else if (cities.length === 1) { %>
                        <input type="hidden" id="cityInput" value="<%= cities[0].id %>">
                    <% } %>
                    <div>
                        <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_districts_label') %></label>
                        <p class="text-[11px] text-stone-400 mb-1.5"><%= t('provider_districts_note') %></p>
                        <div id="districtBar" class="flex flex-wrap gap-1.5"></div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_photo_label') %></label>
                        <label for="photoInput" class="flex items-center gap-2.5 cursor-pointer bg-stone-50 hover:bg-stone-100 border border-stone-200 rounded-xl px-3 py-3 text-sm font-bold text-stone-700 transition active:scale-[0.99]">
                            <i class="fa-regular fa-image text-emerald-600 shrink-0"></i>
                            <span id="photoName" class="truncate"><%= t('join_photo_btn') %></span>
                        </label>
                        <input type="file" id="photoInput" accept="image/*" class="hidden">
                        <img id="photoPreview" alt="" class="hidden mt-2 w-20 h-20 object-cover rounded-xl border border-stone-200">
                    </div>
                </div>

                <div>
                    <label for="descriptionInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_description_label') %></label>
                    <textarea id="descriptionInput" rows="3" placeholder="<%= t('provider_description_example') %>"
                        class="w-full text-sm font-medium outline-none transition text-stone-800 resize-none placeholder:text-stone-400 bg-stone-50 border border-stone-200 rounded-xl p-3 focus:border-emerald-500 focus:bg-white"></textarea>
                </div>

                <div>
                    <label for="phoneInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('join_phone_label') %></label>
                    <input type="tel" id="phoneInput" autocomplete="tel" inputmode="tel" placeholder="<%= t('form_phone_placeholder') %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                </div>

                <% const hasPromo = typeof promo !== 'undefined' && promo; %>
                <% if (hasPromo && promo.valid) { %>
                    <div class="flex items-center gap-2 text-sm font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl p-3">
                        <i class="fa-solid fa-gift"></i><span><%= t('join_promo_banner').replace('{code}', promo.code).replace('{amount}', promo.amountGel.toFixed(2)) %></span>
                    </div>
                <% } else if (hasPromo && !promo.valid) { %>
                    <p class="text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-2.5"><%= t('join_promo_bad').replace('{code}', promo.code) %></p>
                <% } %>
                <details class="group" <%= hasPromo ? 'open' : '' %>>
                    <summary class="cursor-pointer text-xs font-bold text-emerald-700 flex items-center gap-1.5 select-none">
                        <i class="fa-solid fa-tag text-[10px]"></i><%= t('join_promo_toggle') %>
                        <i class="fa-solid fa-chevron-down text-[9px] text-stone-400 transition group-open:rotate-180"></i>
                    </summary>
                    <input type="text" id="promoInput" value="<%= hasPromo ? promo.code : '' %>" placeholder="<%= t('join_promo_placeholder') %>" autocomplete="off"
                        class="mt-2 w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold uppercase tracking-wider text-stone-900 bg-white placeholder:normal-case placeholder:tracking-normal placeholder:font-medium">
                </details>

                <% const legalPrefix = lang === 'ka' ? '' : '/' + lang; %>
                <label class="flex items-start gap-2.5 text-xs text-stone-600 leading-snug cursor-pointer">
                    <input type="checkbox" id="termsCheckbox" class="mt-0.5 w-4 h-4 accent-emerald-600 shrink-0">
                    <span><%= t('join_terms_label') %> <a href="<%= legalPrefix %>/terms" target="_blank" class="text-emerald-700 underline"><%= t('join_terms_link') %></a></span>
                </label>
                <label class="flex items-start gap-2.5 text-xs text-stone-600 leading-snug cursor-pointer">
                    <input type="checkbox" id="privacyCheckbox" class="mt-0.5 w-4 h-4 accent-emerald-600 shrink-0">
                    <span><%= t('join_privacy_label') %> <a href="<%= legalPrefix %>/privacy" target="_blank" class="text-emerald-700 underline"><%= t('join_privacy_link') %></a></span>
                </label>

                <button type="button" onclick="sendOtp()" class="w-full py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                    <span><%= t('otp_send') %></span>
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </div>

            <div id="otpStep" class="p-5 sm:p-6 hidden">
                <label class="block text-[11px] font-bold text-stone-700 uppercase mb-1">
                    <i class="fa-solid fa-key text-emerald-600 mr-1"></i><%= t('otp_label') %>
                </label>
                <input type="text" id="codeInput" maxlength="4" inputmode="numeric"
                    class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none font-mono text-lg font-black tracking-[0.3em] text-center text-stone-900 bg-white">
                <button onclick="verifyAndRegister()" class="mt-4 w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i>
                    <span><%= t('join_otp_confirm_btn') %></span>
                </button>
                <button onclick="backToDetails()" class="mt-2 w-full py-2 text-xs font-bold text-stone-500 hover:text-stone-800 transition"><%= t('otp_back') %></button>
            </div>

            <div id="successStep" class="p-6 hidden text-center space-y-4">
                <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl mx-auto">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h2 class="text-lg font-black text-stone-900"><%= t('join_success_title') %></h2>
                <p class="text-sm text-stone-500"><%= t('join_success_desc') %></p>

                <p id="welcomeBonusMsg" class="hidden provider-welcome"></p>
                <p id="promoBonusMsg" class="hidden text-sm font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl p-3"></p>

                <div class="bg-stone-900 text-white p-4 rounded-2xl text-left space-y-2 text-xs">
                    <p class="font-bold text-amber-400"><%= t('join_payment_title') %></p>
                    <p class="text-stone-300 leading-relaxed"><%= t('join_payment_desc') %></p>
                    <p class="text-stone-300"><%= t('join_payment_contact') %><span class="font-mono text-emerald-400">@xtendergebot</span></p>
                </div>

                <a id="statusLink" href="#" class="block w-full py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 font-bold text-xs break-all"></a>
            </div>

            <div role="alert" aria-live="polite" id="formMsg" class="hidden text-xs font-bold mx-5 sm:mx-6 mb-5 sm:mb-6 p-3 rounded-xl"></div>
        </div>
    </div></main>

    <script>
        const T = <%- JSON.stringify(clientStrings) %>;
        const DISTRICTS_BY_CITY = <%- JSON.stringify(districtsByCity) %>;

        let selectedServiceType = null;
        const selectedDistricts = new Set();

        const svcBtns = document.querySelectorAll('.svc-btn');
        const locationFields = document.getElementById('locationFields');

        function selectServiceType(type) {
            selectedServiceType = type;
            svcBtns.forEach((btn) => btn.classList.toggle('active', btn.dataset.svc === type));
            document.querySelectorAll('.svc-fields').forEach((el) => {
                el.classList.toggle('hidden', el.dataset.svcFields !== type);
            });
            locationFields.classList.remove('hidden');
            updateSizeBadge();
        }

        function selectEnum(btn) {
            const group = btn.closest('[data-enum]');
            const active = btn.classList.contains('active');
            group.querySelectorAll('.opt-btn').forEach((b) => b.classList.remove('active'));
            if (!active) btn.classList.add('active');
        }

        function deriveVanSize(l, w, h) {
            l = Number(l) || 0; w = Number(w) || 0; h = Number(h) || 0;
            if (!l || !w || !h) return null;
            const v = (l * w * h) / 1e6;
            if (v >= 17 || l >= 450) return 'XXL';
            if (v >= 12 || l >= 400) return 'XL';
            if (v >= 4) return 'L';
            return 'S';
        }

        function visibleFields() {
            const block = document.querySelector('.svc-fields:not(.hidden)');
            return block ? block : null;
        }

        function updateSizeBadge() {
            const badge = document.getElementById('sizeBadge');
            if (!badge) return;
            const block = visibleFields();
            if (!block) return;
            const g = (k) => (block.querySelector('[data-field="' + k + '"]') || {}).value;
            const size = deriveVanSize(g('cargo_length_cm'), g('cargo_width_cm'), g('cargo_height_cm'));
            badge.textContent = size ? (T.join_size_auto + ': ' + size) : T.join_size_auto_empty;
            badge.classList.toggle('text-emerald-700', Boolean(size));
            badge.classList.toggle('text-stone-500', !size);
        }

        function renderDistricts() {
            const cityEl = document.getElementById('cityInput');
            const cityId = cityEl ? cityEl.value : null;
            const bar = document.getElementById('districtBar');
            selectedDistricts.clear();
            bar.innerHTML = '';
            (DISTRICTS_BY_CITY[cityId] || []).forEach((d) => {
                const b = document.createElement('button');
                b.type = 'button';
                b.className = 'district-btn px-3 py-1.5 rounded-lg text-xs font-bold transition border bg-white text-stone-600 border-stone-200';
                b.textContent = d.name;
                b.onclick = () => {
                    if (selectedDistricts.has(d.id)) { selectedDistricts.delete(d.id); b.classList.remove('active'); }
                    else { selectedDistricts.add(d.id); b.classList.add('active'); }
                };
                bar.appendChild(b);
            });
        }
        renderDistricts();

        const photoInput = document.getElementById('photoInput');
        const photoName = document.getElementById('photoName');
        const photoPreview = document.getElementById('photoPreview');
        if (photoInput) {
            photoInput.addEventListener('change', () => {
                const file = photoInput.files[0];
                photoName.textContent = file ? file.name : T.join_photo_btn;
                if (file && file.type.startsWith('image/')) {
                    photoPreview.src = URL.createObjectURL(file);
                    photoPreview.classList.remove('hidden');
                } else {
                    photoPreview.classList.add('hidden');
                }
            });
        }

        function collectAttributes() {
            const block = visibleFields();
            const attrs = {};
            if (!block) return attrs;
            block.querySelectorAll('[data-field]').forEach((el) => {
                const k = el.dataset.field;
                if (k === 'vehicleType') return;
                if (el.type === 'checkbox') attrs[k] = el.checked;
                else if (el.value !== '') attrs[k] = el.value.trim();
            });
            block.querySelectorAll('[data-enum]').forEach((g) => {
                const active = g.querySelector('.opt-btn.active');
                if (active) attrs[g.dataset.enum] = active.dataset.val;
            });
            return attrs;
        }

        function showMsg(text, isError) {
            const el = document.getElementById('formMsg');
            if (!text) { el.classList.add('hidden'); return; }
            el.textContent = text;
            el.classList.remove('hidden');
            el.classList.toggle('bg-red-50', Boolean(isError));
            el.classList.toggle('text-red-700', Boolean(isError));
            el.classList.toggle('bg-emerald-50', !isError);
            el.classList.toggle('text-emerald-700', !isError);
        }

        function collectPayload() {
            const cityEl = document.getElementById('cityInput');
            const vehTypeEl = document.querySelector('.svc-fields:not(.hidden) [data-field="vehicleType"]');
            return {
                name: document.getElementById('nameInput').value.trim(),
                serviceType: selectedServiceType,
                attributes: collectAttributes(),
                vehicleType: vehTypeEl ? vehTypeEl.value.trim() : '',
                cityId: cityEl ? cityEl.value : '',
                districtIds: [...selectedDistricts],
                description: document.getElementById('descriptionInput').value.trim(),
                phone: document.getElementById('phoneInput').value.trim(),
                promoCode: document.getElementById('promoInput').value.trim(),
                termsAccepted: document.getElementById('termsCheckbox').checked,
                privacyAccepted: document.getElementById('privacyCheckbox').checked,
            };
        }

        async function sendOtp() {
            const payload = collectPayload();

            if (!payload.name) return showMsg(T.join_err_name_required, true);
            if (!payload.serviceType) return showMsg(T.join_err_service_required, true);
            if (!payload.cityId) return showMsg(T.join_err_city_required, true);
            if (!payload.phone) return showMsg(T.js_err_empty_phone, true);
            if (!payload.termsAccepted) return showMsg(T.join_err_terms_required, true);
            if (!payload.privacyAccepted) return showMsg(T.join_err_privacy_required, true);

            const res = await fetch('/api/masters/otp/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone: payload.phone }),
            });
            const data = await res.json();
            if (!data.success) return showMsg(data.message || T.js_err_send_code, true);

            showMsg('');
            document.getElementById('detailsStep').classList.add('hidden');
            document.getElementById('otpStep').classList.remove('hidden');
        }

        function backToDetails() {
            showMsg('');
            document.getElementById('otpStep').classList.add('hidden');
            document.getElementById('detailsStep').classList.remove('hidden');
        }

        async function verifyAndRegister() {
            const payload = collectPayload();
            const code = document.getElementById('codeInput').value.trim();
            if (!code) return showMsg(T.js_err_empty_code, true);

            let res = await fetch('/api/masters/otp/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    phone: payload.phone,
                    code,
                    termsAccepted: payload.termsAccepted,
                    privacyAccepted: payload.privacyAccepted,
                }),
            });
            let data = await res.json();
            if (!data.success) return showMsg(data.message || T.js_err_wrong_code, true);

            const fd = new FormData();
            fd.append('name', payload.name);
            fd.append('serviceType', payload.serviceType);
            fd.append('vehicleType', payload.vehicleType);
            fd.append('cityId', payload.cityId);
            fd.append('description', payload.description);
            fd.append('phone', payload.phone);
            fd.append('promoCode', payload.promoCode);
            fd.append('termsAccepted', String(payload.termsAccepted));
            fd.append('privacyAccepted', String(payload.privacyAccepted));
            payload.districtIds.forEach((id) => fd.append('districtIds', id));
            Object.entries(payload.attributes).forEach(([k, v]) => fd.append(k, String(v)));
            const photo = document.getElementById('photoInput').files[0];
            if (photo) fd.append('photo', photo);

            res = await fetch('/api/masters/register', { method: 'POST', body: fd });
            data = await res.json();
            if (!data.success) return showMsg(data.message || T.js_err_send_code, true);

            showMsg('');
            document.getElementById('otpStep').classList.add('hidden');
            document.getElementById('successStep').classList.remove('hidden');
            if (data.link) {
                const statusLink = document.getElementById('statusLink');
                statusLink.href = data.link;
                statusLink.textContent = T.provider_start_cabinet;
            }
            if (data.welcomeBonusGel > 0) {
                const welcome = document.getElementById('welcomeBonusMsg');
                welcome.textContent = T.welcome_credited.replace('{amount}', data.welcomeBonusGel.toFixed(2));
                welcome.classList.remove('hidden');
            }
            if (data.promoBonusGel && data.promoBonusGel > 0) {
                const pb = document.getElementById('promoBonusMsg');
                pb.textContent = '🎁 ' + T.join_promo_applied.replace('{amount}', data.promoBonusGel.toFixed(2));
                pb.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>

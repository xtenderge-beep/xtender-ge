<style>.crm{font:15px system-ui;color:#19332c}.crm h1{font-size:28px;margin:20px 0}.crm h2{font-size:21px;margin:18px 0}.crm .card{background:white;border:1px solid #dce4e0;border-radius:14px;padding:18px;margin:16px 0}.crm .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}.crm .grid .card{margin:0}.crm .muted{color:#63756d;font-size:13px}.crm input:not([type=hidden]),.crm textarea,.crm select{font:inherit;padding:10px;border:1px solid #b5c7bd;border-radius:8px;max-width:100%;background:white;color:#19332c}.crm textarea{width:100%;min-height:100px}.crm label{display:block;margin:12px 0}.crm button{background:#08765f;color:white;border:0;border-radius:8px;padding:11px;cursor:pointer;font:inherit}.crm a{color:#08765f;text-decoration:underline}.crm table{border-collapse:collapse;width:100%;font-size:14px}.crm td,.crm th{padding:12px;text-align:left;border-bottom:1px solid #e1e8e4}.crm .scroll{overflow:auto}.crm .value{font-size:25px;font-weight:750}.crm .pre{white-space:pre-wrap;overflow-wrap:anywhere}.crm nav{display:flex;gap:16px;flex-wrap:wrap}.crm progress{width:100%;height:14px;accent-color:#08765f}</style>

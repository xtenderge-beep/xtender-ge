<%- admin?include('../admin/_header',{active:'managers'}):include('../manager/_header') %><%- include('_style') %><div class="crm"><a href="<%= prefix %>/processes">← Процессы и планы</a><h1><%= item.phone %></h1><p><%= ({provider:'Приглашение специалиста',client:'Самостоятельная заявка заказчика',operator:'Заявка со слов клиента'})[item.kind] %></p><div class="card"><label>Ссылка для отправки<input id="invite-url" readonly style="width:100%" value="<%= baseUrl %>/<%= item.kind==='provider'?'i':'d' %>/<%= item.token %>"></label><button id="copy" type="button">Копировать ссылку</button><p id="copy-status" role="status"></p><p>Создано: <%= date(item.created_at) %> (<%= item.created_by==='admin'?'администратор':'менеджер' %>) · Отправка отмечена: <%= date(item.sent_at) %> · Открыто: <%= date(item.opened_at) %></p><% if(!item.sent_at){ %><form method="post" action="<%= prefix %>/crm/<%= item.id %>/sent"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Я отправил ссылку клиенту</button></form><% } %><p class="muted">Копирование не считается отправкой. Отметьте отправку после общения с клиентом. Это ручная отметка, а не подтверждение SMS/WhatsApp.</p></div>
<% if(item.order_id){ %><div class="card"><h2>Заявка #<%= item.order_id %></h2><p>Статус: <%= item.status==='unverified'?'Ожидает подтверждения клиента':item.status %> · Подтверждена: <%= date(item.confirmed_at) %></p><p class="pre"><%= item.description %></p><p><%= item.district_name %></p><% files.forEach(f=>{ %><p><a href="<%= f.file_path %>" target="_blank" rel="noopener"><%= f.original_name %></a></p><% }) %><h2>Активность по заявке · последние 100 событий</h2><% activity.forEach(v=>{ %><p><%= date(v.viewed_at) %> · <%= ({view:'Просмотр',call:'Нажатие телефона',whatsapp:'WhatsApp'})[v.event_type]||v.event_type %></p><% }) %></div><% } %>
<div class="card"><h2>Другие обращения этого телефона · последние 100</h2><% related.filter(r=>r.id!==item.id).forEach(r=>{ %><p><a href="<%= prefix %>/crm/<%= r.id %>"><%= date(r.created_at) %> · <%= ({provider:'Специалист',client:'Заказчик',operator:'По телефону'})[r.kind] %> <%= r.order_id?'#'+r.order_id:'' %></a></p><% }) %></div><div class="card"><h2>История общения</h2><form method="post" action="<%= prefix %>/crm/<%= item.id %>/note"><input type="hidden" name="_csrf" value="<%= csrf %>"><textarea name="body" required maxlength="2000" placeholder="Результат разговора и следующий шаг"></textarea><button>Добавить заметку</button></form><% notes.forEach(n=>{ %><p class="muted"><%= date(n.created_at) %> · <%= n.actor==='admin'?'Администратор':n.name %></p><p class="pre"><%= n.body %></p><% }) %></div></div><script>document.getElementById('copy').addEventListener('click',async()=>{const input=document.getElementById('invite-url');try{await navigator.clipboard.writeText(input.value);document.getElementById('copy-status').textContent='Ссылка скопирована';}catch{input.focus();input.select();document.getElementById('copy-status').textContent='Скопируйте выделенную ссылку';}});</script><%- admin?include('../admin/_footer'):'</main></body></html>' %>

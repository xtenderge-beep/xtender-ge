<% const labels={ru:{title:'Проверьте и подтвердите заявку',phone:'Телефон для SMS-подтверждения',description:'Опишите задачу',address:'Адрес / район',photos:'Фотографии или PDF: до 5 файлов, до 5 МБ каждый',send:'Получить код подтверждения',code:'Код из SMS',confirm:'Подтвердить и отправить',sent:'Заявка уже подтверждена и отправлена. Повторное создание не требуется.',wait:'Подождите…',received:'Код отправлен. Проверьте SMS.',change:'Чтобы изменить текст после получения кода, обновите страницу и запросите новый код.',error:'Не удалось выполнить действие. Повторите попытку.'},en:{title:'Review and confirm your request',phone:'Phone for SMS verification',description:'Describe the task',address:'Address / district',photos:'Photos or PDF: up to 5 files, 5 MB each',send:'Get verification code',code:'SMS code',confirm:'Confirm and submit',sent:'This request has already been submitted. No need to create it again.',wait:'Please wait…',received:'Code sent. Check your SMS.',change:'To change the text after requesting a code, reload the page and request a new code.',error:'Could not complete the action. Please try again.'},ka:{title:'შეამოწმეთ და დაადასტურეთ განაცხადი',phone:'ტელეფონი SMS დადასტურებისთვის',description:'აღწერეთ დავალება',address:'მისამართი / რაიონი',photos:'ფოტო ან PDF: მაქსიმუმ 5 ფაილი, თითო 5 მბ',send:'დადასტურების კოდის მიღება',code:'SMS კოდი',confirm:'დადასტურება და გაგზავნა',sent:'განაცხადი უკვე დადასტურებულია და გაგზავნილია.',wait:'გთხოვთ დაელოდოთ…',received:'კოდი გაგზავნილია. შეამოწმეთ SMS.',change:'ტექსტის შესაცვლელად განაახლეთ გვერდი და მოითხოვეთ ახალი კოდი.',error:'მოქმედება ვერ შესრულდა. სცადეთ ხელახლა.'}}[draftLang]; %>
<!doctype html><html lang="<%= draftLang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Xtender · <%= labels.title %></title><style>body{background:#f4f5f7;color:#19332c;font:16px system-ui;margin:0}main{max-width:700px;margin:30px auto;padding:24px;background:white;border-radius:16px}label{display:block;margin:18px 0}input:not([type=checkbox]),textarea{display:block;width:100%;box-sizing:border-box;font:inherit;padding:12px;border:1px solid #abbeb7;border-radius:8px;margin:8px 0}textarea{min-height:140px}button{background:#08765f;color:white;border:0;border-radius:8px;padding:14px;font:inherit;cursor:pointer}button:disabled{opacity:.6}a{color:#08765f}p{line-height:1.6}.note{font-size:14px;color:#56665f}[hidden]{display:none!important}</style></head><body><main><a href="/">XTENDER</a><h1><%= labels.title %></h1>
<% if(item.status!=='unverified'){ %><p><%= labels.sent %></p><% }else{ %>
<p><%= labels.phone %>: <strong><%= item.phone %></strong></p><form id="draft-form"><label><%= labels.description %><textarea id="description" required minlength="5" maxlength="5000"><%= item.description %></textarea></label><label><%= labels.address %><input id="address" maxlength="500" value="<%= item.district_name %>"></label><label><%= labels.photos %><input id="files" type="file" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" multiple></label>
<% consent.notices.forEach(n=>{ %><p class="note"><%= n %></p><% }) %><label><input id="terms" type="checkbox" required> <%= consent.termsLabel %> <a href="<%= consent.terms_url %>" target="_blank" rel="noopener">↗</a></label><label><input id="privacy" type="checkbox" required> <%= consent.privacyLabel %> <a href="<%= consent.privacy_url %>" target="_blank" rel="noopener">↗</a></label><button id="send"><%= labels.send %></button></form>
<form id="verify-form" hidden><label><%= labels.code %><input id="code" inputmode="numeric" autocomplete="one-time-code" required pattern="[0-9]{4}" maxlength="4"></label><p class="note"><%= labels.change %></p><button id="confirm"><%= labels.confirm %></button></form><p id="status" role="status"></p>
<script>(()=>{
 const $=id=>document.getElementById(id),phone=<%- JSON.stringify(item.phone).replace(/</g,'\\u003c') %>,labels=<%- JSON.stringify(labels).replace(/</g,'\\u003c') %>;let challengeId,orderToken,verified=false;
 async function post(url,body){const response=await fetch(url,{method:'POST',headers:body instanceof FormData?{}:{'Content-Type':'application/json'},body:body instanceof FormData?body:JSON.stringify(body)});const data=await response.json();if(!response.ok||!data.success)throw Error(data.message||labels.error);return data;}
 function files(){const selected=[...$('files').files];if(selected.length>5||selected.some(f=>f.size>5*1024*1024))throw Error(labels.photos);return selected;}
 $('draft-form').addEventListener('submit',async e=>{e.preventDefault();$('send').disabled=true;$('status').textContent=labels.wait;try{files();const data=await post('/api/drafts/<%= item.token %>/send',{_csrf:'<%= csrf %>',description:$('description').value,districtName:$('address').value,termsAccepted:$('terms').checked,privacyAccepted:$('privacy').checked,consentLanguage:'<%= draftLang %>',consentDigest:'<%= consent.digest %>'});challengeId=data.challengeId;orderToken=data.token;for(const id of ['description','address','terms','privacy'])$(id).disabled=true;$('verify-form').hidden=false;$('status').textContent=labels.received;$('code').focus();}catch(err){$('status').textContent=err.message;$('send').disabled=false;}});
 $('verify-form').addEventListener('submit',async e=>{e.preventDefault();$('confirm').disabled=true;$('status').textContent=labels.wait;try{const selected=files();if(!verified){await post('/api/otp/verify',{phone,challengeId,code:$('code').value});verified=true;}const body=new FormData();body.append('phone',phone);body.append('token',orderToken);body.append('challengeId',challengeId);selected.forEach(f=>body.append('files',f));const data=await post('/api/orders',body);location.assign(data.ownerLink);}catch(err){$('status').textContent=err.message;$('confirm').disabled=false;}});
})();</script><% } %></main></body></html>

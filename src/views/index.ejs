<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50 scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title><%= t('site_title_index') %></title>
    <meta name="description" content="<%= t('meta_description_index') %>">

    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="alternate" hreflang="ka" href="<%= seo.alternates.ka %>">
    <link rel="alternate" hreflang="ru" href="<%= seo.alternates.ru %>">
    <link rel="alternate" hreflang="en" href="<%= seo.alternates.en %>">
    <link rel="alternate" hreflang="x-default" href="<%= seo.xDefault %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="xtender.ge">
    <meta property="og:title" content="<%= t('site_title_index') %>">
    <meta property="og:description" content="<%= t('meta_description_index') %>">
    <meta property="og:url" content="<%= seo.canonical %>">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= t('site_title_index') %>">
    <meta name="twitter:description" content="<%= t('meta_description_index') %>">

    <%
      const orgJsonLd = {
        '@context': 'https://schema.org',
        '@type': 'MovingCompany',
        name: 'xtender.ge',
        url: seo.canonical,
        areaServed: {
          '@type': 'City',
          name: 'Tbilisi',
          address: { '@type': 'PostalAddress', addressLocality: 'Tbilisi', addressCountry: 'GE' },
        },
        makesOffer: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: t('service_name_transport'), areaServed: 'Tbilisi' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: t('service_name_movers'), areaServed: 'Tbilisi' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: t('service_name_junk'), areaServed: 'Tbilisi' } },
        ],
      };
      const faqItems = [1, 2, 3, 4, 5].map((n) => ({ q: t('faq_q' + n), a: t('faq_a' + n) }));
      const faqJsonLd = {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      };
    %>
    <script type="application/ld+json"><%- JSON.stringify(orgJsonLd) %></script>
    <script type="application/ld+json"><%- JSON.stringify(faqJsonLd) %></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'],
                        mono: ['IBM Plex Mono', 'Noto Sans Georgian', 'ui-monospace', 'monospace'],
                    },
                    colors: {
                        brand: {
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f5f5f4; }
        ::-webkit-scrollbar-thumb { background: #d6d3d1; border-radius: 4px; }
        .lang-btn.active { background: #fff; color: #1c1917; font-weight: 800; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }

        .dispatch-grid {
            background-image: radial-gradient(circle, rgba(28,25,23,0.07) 1px, transparent 1px);
            background-size: 22px 22px;
        }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
        .fade-in-up { animation: fadeInUp .45s cubic-bezier(0.16, 1, 0.3, 1) both; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        details > summary { list-style: none; }
        details > summary::-webkit-details-marker { display: none; }

        /* Compose mode: on mobile, focusing the task field opens a full-screen
           composer (Facebook-style) — top bar with back + Publish, the field
           fills the rest, Photo sits on a bottom bar above the keyboard. */
        .compose-topbar { display: none; }
        @media (max-width: 639px) {
            body.compose-active { overflow: hidden; }
            body.compose-active header,
            body.compose-active #mobileNav,
            body.compose-active #seo-hero,
            body.compose-active .composer-toprow,
            body.compose-active .composer-chips,
            body.compose-active .composer-trust-line,
            body.compose-active .composer-trust-badges { display: none !important; }

            body.compose-active #post-section {
                position: fixed; inset: 0; z-index: 50; margin: 0; background: #fff;
                animation: none; transform: none;
            }
            body.compose-active .composer-card {
                height: 100%; display: flex; flex-direction: column;
                border: 0; border-radius: 0; box-shadow: none; overflow: hidden;
            }
            body.compose-active #detailsStep {
                flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 0;
            }
            body.compose-active .compose-topbar { display: flex; }
            body.compose-active .composer-inputbox,
            body.compose-active .composer-inputbox:focus-within {
                flex: 1; min-height: 0; border: 0; border-radius: 0;
                box-shadow: none; margin: 0; padding: 14px 16px;
            }
            body.compose-active .composer-textarea {
                flex: 1; min-height: 0; height: 100%; overflow-y: auto;
            }
            body.compose-active .composer-actionbar {
                margin: 0; padding: 10px 16px; border-top: 1px solid #e7e5e4;
            }
            body.compose-active .composer-inline-publish { display: none; }
            body.compose-active #attachmentsPreview { padding: 0 16px 8px; }
        }
    </style>
</head>
<body class="font-sans text-stone-800 bg-stone-50 dispatch-grid flex flex-col min-h-screen antialiased selection:bg-emerald-500 selection:text-white">

    <a href="/join" class="block bg-red-600 hover:bg-red-700 active:bg-red-800 text-white text-center text-[13px] sm:text-sm font-black tracking-wide py-2 transition">
        <i class="fa-solid fa-briefcase text-[11px] mr-1.5"></i><%= t('jobs_strip') %><i class="fa-solid fa-arrow-right text-[10px] ml-1.5"></i>
    </a>

    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
        <div class="h-[3px] bg-emerald-600"></div>
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="flex items-center justify-between h-14 sm:h-16">

                <a href="/" class="flex items-center gap-2 shrink-0">
                    <span class="text-xl sm:text-3xl font-black tracking-tight text-stone-900">
                        xtender<span class="text-emerald-600">.ge</span>
                    </span>
                </a>

                <div class="hidden xl:flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-wide text-stone-500">
                    <span class="whitespace-nowrap px-2.5 py-1 rounded-lg bg-stone-100 border border-stone-200 flex items-center gap-1"><%= t('nav_transport') %></span>
                    <span class="whitespace-nowrap px-2.5 py-1 rounded-lg bg-stone-100 border border-stone-200 flex items-center gap-1"><%= t('nav_movers') %></span>
                    <span class="whitespace-nowrap px-2.5 py-1 rounded-lg bg-stone-100 border border-stone-200 flex items-center gap-1"><%= t('nav_junk') %></span>
                </div>

                <div class="flex items-center gap-2 sm:gap-3">
                    <a href="/my-orders" class="hidden sm:flex whitespace-nowrap px-3 py-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-bold transition items-center gap-1.5">
                        <i class="fa-solid fa-list-check text-emerald-600"></i>
                        <span><%= t('my_orders_nav') %></span>
                    </a>

                    <div class="flex items-center gap-0.5 p-1 bg-stone-100 rounded-full border border-stone-200">
                        <% [['ka','🇬🇪','GE'],['ru','🇷🇺','RU'],['en','🇬🇧','EN']].forEach(function (f) { %>
                            <% /* ?lang=ka — иначе кука ru/en тут же откидывает голый '/' обратно, см. public.routes.js */ %>
                            <a href="<%= seo.alternates[f[0]] %><%= f[0] === 'ka' ? '?lang=ka' : '' %>" title="<%= f[2] %>" aria-label="<%= f[2] %>"
                               class="flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-full text-sm sm:text-base font-bold leading-none transition <%= lang === f[0] ? 'bg-white shadow-sm text-stone-900' : 'text-stone-500 hover:bg-white/60 hover:text-stone-800 active:scale-95' %>">
                                <%= f[1] %>
                            </a>
                        <% }); %>
                    </div>

                    <a href="/master" class="px-3 py-2 rounded-xl bg-stone-900 hover:bg-stone-800 active:scale-95 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm whitespace-nowrap">
                        <i class="fa-solid fa-helmet-safety text-amber-400"></i>
                        <span><%= isRememberedProvider ? t('nav_my_cabinet') : t('nav_provider_work') %></span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow">

        <div class="max-w-3xl mx-auto px-4 pt-6 sm:pt-12 pb-28 sm:pb-16">

                    <section id="seo-hero" class="mb-5 sm:mb-8 fade-in-up">
                        <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-stone-900 leading-[1.15]"><%= t('seo_hero_h1') %></h1>
                        <p class="text-sm sm:text-base leading-snug text-stone-500 mt-2 sm:mt-3 max-w-xl"><%= t('seo_hero_lead') %></p>
                        <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-semibold text-emerald-700">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                            </span>
                            <%= t('hero_response_badge') %>
                        </p>
                    </section>

                    <section id="post-section" class="fade-in-up scroll-mt-20">
                        <div class="composer-card bg-white rounded-2xl shadow-xl border border-stone-200/80 border-l-4 border-l-emerald-600 overflow-hidden">

                            <div id="detailsStep" class="p-3.5 sm:p-5">
                                <input type="hidden" id="description">

                                <div class="compose-topbar hidden items-center gap-3 px-3 py-2.5 border-b border-stone-200 bg-white shrink-0">
                                    <button type="button" onclick="exitCompose()" aria-label="<%= t('otp_back') %>" class="w-9 h-9 -ml-1 flex items-center justify-center rounded-full text-stone-600 hover:bg-stone-100 active:scale-95 transition shrink-0">
                                        <i class="fa-solid fa-arrow-left text-base"></i>
                                    </button>
                                    <span class="flex-1 font-extrabold text-stone-900 text-sm"><%= t('composer_tag') %></span>
                                    <button type="button" onclick="submitFreeform()" class="px-3 py-1.5 rounded-lg text-emerald-600 font-extrabold text-sm uppercase tracking-wide hover:bg-emerald-50 active:scale-95 transition shrink-0"><%= t('composer_publish') %></button>
                                </div>

                                <div class="composer-toprow flex items-center justify-between gap-2">
                                    <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500"><%= t('composer_label') %></span>
                                    <span class="text-[11px] font-medium text-emerald-600 whitespace-nowrap"><%= t('composer_tag') %></span>
                                </div>

                                <div class="composer-chips flex gap-1.5 overflow-x-auto no-scrollbar pb-0.5 mt-2.5">
                                    <%
                                      const composerChips = [
                                        { emoji: '🧹', label: t('chip_junk') },
                                        { emoji: '🚚', label: t('chip_move') },
                                        { emoji: '💪', label: t('chip_movers') },
                                      ];
                                    %>
                                    <% composerChips.forEach(function (chip) { %>
                                      <button type="button" data-chip="<%= chip.label %>" class="composer-chip shrink-0 px-3 py-1.5 bg-stone-100 hover:bg-emerald-50 hover:text-emerald-700 rounded-full text-xs font-semibold text-stone-700 whitespace-nowrap transition active:scale-95">
                                          <%= chip.emoji %> <%= chip.label %>
                                      </button>
                                    <% }); %>
                                </div>

                                <div class="composer-inputbox mt-2.5 flex flex-col rounded-2xl border border-stone-300 bg-white p-2.5 transition focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-500/15">
                                    <textarea id="freeformInput" rows="3" placeholder="<%= t('freeform_placeholder') %>"
                                        class="composer-textarea w-full text-base outline-none text-stone-800 placeholder:text-stone-400 resize-none bg-transparent leading-snug min-h-[76px] sm:min-h-[104px]"></textarea>

                                    <div id="attachmentsPreview" class="hidden flex-wrap gap-1.5 pt-2"></div>

                                    <div class="composer-actionbar flex items-center justify-between gap-2 pt-2 mt-1 border-t border-stone-100">
                                        <label for="attachments" class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-600 bg-stone-100 hover:bg-stone-200 px-3 py-2.5 min-h-[44px] rounded-lg cursor-pointer transition active:scale-95">
                                            <i class="fa-regular fa-image text-emerald-600"></i>
                                            <span><%= t('composer_photo_btn') %></span>
                                        </label>
                                        <input type="file" id="attachments" multiple accept="image/*" class="hidden">

                                        <button type="button" onclick="submitFreeform()" class="composer-inline-publish inline-flex items-center gap-1.5 px-4 sm:px-5 py-2.5 sm:py-3 min-h-[44px] bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-bold text-sm rounded-xl shadow-sm shadow-emerald-600/30 transition">
                                            <span><%= t('composer_publish') %></span>
                                            <i class="fa-solid fa-arrow-right text-[11px]"></i>
                                        </button>
                                    </div>
                                </div>

                                <p class="composer-trust-line mt-2 text-[11px] text-stone-400 text-center"><i class="fa-solid fa-lock text-[9px] mr-1"></i><%= t('composer_trust') %></p>
                            </div>

                            <div id="phoneStep" class="p-5 sm:p-6 hidden">
                                <label for="phone" class="block text-[11px] font-bold text-stone-700 uppercase mb-1">
                                    <i class="fa-solid fa-phone text-emerald-600 mr-1"></i><%= t('form_phone_label') %>
                                </label>
                                <input type="tel" id="phone" placeholder="<%= t('form_phone_placeholder') %>"
                                    class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-base font-bold text-stone-900 bg-white">
                                <button onclick="sendOtp()" class="mt-4 w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-shield-halved"></i>
                                    <span><%= t('otp_send') %></span>
                                </button>
                                <button onclick="goToDetailsStep()" class="mt-2 w-full py-2 text-xs font-bold text-stone-500 hover:text-stone-800 transition"><%= t('otp_back') %></button>
                            </div>

                            <div id="otpStep" class="p-5 sm:p-6 hidden">
                                <label for="code" class="block text-[11px] font-bold text-stone-700 uppercase mb-1">
                                    <i class="fa-solid fa-key text-emerald-600 mr-1"></i><%= t('otp_label') %>
                                </label>
                                <input type="text" id="code" maxlength="4" inputmode="numeric"
                                    class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none font-mono text-lg font-black tracking-[0.3em] text-center text-stone-900 bg-white">
                                <button onclick="verifyOtp()" class="mt-4 w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-check"></i>
                                    <span><%= t('otp_verify') %></span>
                                </button>
                            </div>

                            <div id="formMsg" class="hidden text-xs font-bold mx-3.5 sm:mx-5 mb-3.5 sm:mb-5 p-3 rounded-xl"></div>
                        </div>

                        <div class="composer-trust-badges grid grid-cols-2 gap-2 mt-2.5">
                            <div class="flex items-center gap-2 rounded-xl bg-white border border-stone-200 px-3 py-2 text-[11px] font-semibold text-stone-600">
                                <i class="fa-solid fa-bolt text-emerald-600 shrink-0"></i><span><%= t('trust_badge_speed') %></span>
                            </div>
                            <div class="flex items-center gap-2 rounded-xl bg-white border border-stone-200 px-3 py-2 text-[11px] font-semibold text-stone-600">
                                <i class="fa-solid fa-shield-halved text-emerald-600 shrink-0"></i><span><%= t('trust_badge_spam') %></span>
                            </div>
                        </div>
                    </section>

                    <section id="tender-live-section" class="hidden mt-6">
                        <div class="bg-stone-900 text-white rounded-2xl p-5 sm:p-6 shadow-xl border border-stone-700 space-y-4">

                            <div class="flex items-center justify-between text-xs border-b border-stone-800 pb-3">
                                <span class="font-bold text-emerald-400 flex items-center gap-2">
                                    <span class="relative flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                                    </span>
                                    <span><%= t('live_badge') %></span>
                                </span>
                                <span id="live-order-id" class="text-stone-400 font-mono text-[11px]"></span>
                            </div>

                            <div class="space-y-1 text-xs">
                                <p class="text-stone-100 font-bold text-sm">
                                    <i class="fa-solid fa-paper-plane text-amber-400 mr-1.5"></i> <%= t('live_sms_status') %>
                                </p>
                                <p class="text-stone-400 text-[11px]"><%= t('live_sms_hint') %></p>
                            </div>

                            <div class="bg-stone-800 p-3.5 rounded-2xl border border-stone-700 flex flex-col sm:flex-row items-center justify-between gap-3">
                                <div class="text-xs">
                                    <p class="font-bold text-amber-400"><%= t('live_delete_title') %></p>
                                    <p class="text-stone-400 text-[11px]"><%= t('live_delete_hint') %></p>
                                </div>
                                <button onclick="closeActiveOrder()" class="w-full sm:w-auto px-4 py-2.5 bg-red-600/90 hover:bg-red-600 text-white font-bold text-xs rounded-xl transition flex items-center justify-center gap-1.5 shrink-0 shadow-md">
                                    <i class="fa-solid fa-trash-can"></i>
                                    <span><%= t('live_delete_btn') %></span>
                                </button>
                            </div>

                        </div>
                    </section>

                    <section id="masters-section" class="mt-10 space-y-5">

                        <div class="border-b border-stone-200 pb-4">
                            <h2 class="text-xl font-extrabold text-stone-900 flex items-center gap-2">
                                <i class="fa-solid fa-address-book text-emerald-600"></i>
                                <span><%= t('catalog_title') %></span>
                            </h2>
                            <p class="text-xs text-stone-500 mt-1"><%= t('catalog_hint') %></p>
                        </div>

                        <a href="/master" class="group flex items-center justify-between gap-3 bg-stone-900 hover:bg-stone-800 text-white rounded-2xl px-4 py-3.5 transition active:scale-[0.98] shadow-sm">
                            <span class="flex items-center gap-2.5 min-w-0">
                                <i class="fa-solid fa-helmet-safety text-amber-400 text-lg shrink-0"></i>
                                <span class="text-xs sm:text-sm font-semibold text-stone-200 leading-snug"><%= t('become_provider_cta') %></span>
                            </span>
                            <span class="shrink-0 px-3 py-2 rounded-xl bg-emerald-600 group-hover:bg-emerald-500 text-white text-xs font-black transition whitespace-nowrap"><%= isRememberedProvider ? t('nav_my_cabinet') : t('nav_provider_work') %></span>
                        </a>

                        <%
                          const groups = [
                            { key: 'transport', anchor: 'group-transport', label: t('catalog_group_transport'), icon: '🚚', color: 'bg-amber-100 text-amber-900 border-amber-200' },
                            { key: 'movers', anchor: 'group-movers', label: t('catalog_group_movers'), icon: '💪', color: 'bg-emerald-100 text-emerald-900 border-emerald-200' },
                            { key: 'junk', anchor: 'group-junk', label: t('catalog_group_junk'), icon: '🧹', color: 'bg-stone-100 text-stone-900 border-stone-300' },
                          ];
                          const reviewLocale = lang === 'ka' ? 'ka-GE' : (lang === 'en' ? 'en-US' : 'ru-RU');
                          function reviewsWord(n) {
                            const m10 = n % 10, m100 = n % 100;
                            if (m10 === 1 && m100 !== 11) return t('reviews_word_one');
                            if (m10 >= 2 && m10 <= 4 && !(m100 >= 12 && m100 <= 14)) return t('reviews_word_few');
                            return t('reviews_word_many');
                          }
                        %>

                        <div class="flex flex-wrap gap-2" id="categoryFilterBar">
                            <button type="button" onclick="setCategoryFilter('all')" data-filter-cat="all" class="filter-btn px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition border bg-emerald-600 text-white border-emerald-600">
                                <%= t('filter_all') %>
                            </button>
                            <% groups.forEach(function (group) { %>
                              <button type="button" onclick="setCategoryFilter('<%= group.key %>')" data-filter-cat="<%= group.key %>" class="filter-btn px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">
                                  <%= group.icon %> <%= group.label %>
                              </button>
                            <% }); %>
                        </div>

                        <div class="hidden flex-wrap gap-2" id="sizeFilterBar">
                            <button type="button" onclick="setSizeFilter('all')" data-filter-size="all" class="filter-btn px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-emerald-600 text-white border-emerald-600">
                                <%= t('filter_all_sizes') %>
                            </button>
                            <button type="button" onclick="setSizeFilter('L')" data-filter-size="L" class="filter-btn min-w-[42px] text-center px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">L</button>
                            <button type="button" onclick="setSizeFilter('XL')" data-filter-size="XL" class="filter-btn min-w-[42px] text-center px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">XL</button>
                            <button type="button" onclick="setSizeFilter('XXL')" data-filter-size="XXL" class="filter-btn min-w-[42px] text-center px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">XXL</button>
                        </div>

                    <% groups.forEach(function (group) { %>
                      <% const groupMasters = masters.filter((m) => m.category === group.key); %>
                      <% if (groupMasters.length) { %>
                        <div id="<%= group.anchor %>" data-group="<%= group.key %>" class="scroll-mt-24">
                            <h3 class="text-sm font-extrabold text-stone-800 flex items-center gap-2 mb-3">
                                <span class="text-lg"><%= group.icon %></span>
                                <span><%= group.label %></span>
                                <span class="text-[11px] font-bold text-stone-400"><%= groupMasters.length %></span>
                            </h3>
                            <div class="space-y-3">
                                <% groupMasters.forEach(function (master) { %>
                                  <div class="master-card bg-white rounded-2xl border border-stone-200/90 p-4 sm:p-5 shadow-sm hover:shadow-md transition flex flex-col gap-3" data-category="<%= group.key %>" data-size="<%= master.vehicle_size || '' %>">

                                      <% const ratingStars = Math.round(Number(master.rating) || 0); %>

                                      <div class="flex items-start justify-between gap-3">
                                          <div class="flex-1 min-w-0">
                                              <div class="flex items-center gap-2 flex-wrap">
                                                  <h3 class="font-extrabold text-stone-900 text-sm sm:text-base"><%= master.name %></h3>
                                                  <% if (master.price_text) { %>
                                                    <span class="font-mono text-[11px] font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md whitespace-nowrap"><%= master.price_text %></span>
                                                  <% } %>
                                              </div>

                                              <% if (master.reviews.length) { %>
                                                <button type="button" class="review-toggle mt-1 flex items-center gap-1.5 text-xs">
                                                    <span class="tracking-tight text-amber-500 text-[13px]"><%= '★'.repeat(ratingStars) %><span class="text-stone-300"><%= '★'.repeat(5 - ratingStars) %></span></span>
                                                    <span class="font-bold text-stone-900"><%= Number(master.rating).toFixed(1) %></span>
                                                    <span class="text-stone-400"><%= master.reviews.length %> <%= reviewsWord(master.reviews.length) %></span>
                                                    <i class="fa-solid fa-chevron-down text-[8px] text-stone-400 transition review-chevron"></i>
                                                </button>
                                              <% } else { %>
                                                <div class="mt-1 flex items-center gap-1.5 text-xs">
                                                    <span class="tracking-tight text-stone-300 text-[13px]">★★★★★</span>
                                                    <span class="font-bold text-stone-400">5.0</span>
                                                    <span class="text-stone-400"><%= t('reviews_none') %></span>
                                                </div>
                                              <% } %>
                                          </div>

                                          <span class="shrink-0 text-[10px] font-extrabold uppercase px-2 py-0.5 rounded border <%= group.color %>">
                                              <%= group.icon %> <%= group.label %>
                                          </span>
                                      </div>

                                      <% if (master.vehicle_type) { %>
                                        <p class="text-xs font-semibold text-emerald-700 -mt-1">🚚 <%= master.vehicle_type %></p>
                                      <% } %>

                                      <% if (master.description) { %>
                                        <p class="text-xs text-stone-600 leading-snug -mt-1"><%= master.description %></p>
                                      <% } %>

                                      <% if (master.reviews.length) { %>
                                        <div class="review-list hidden space-y-2">
                                            <% master.reviews.forEach(function (rv) { %>
                                              <div class="bg-stone-50 border border-stone-100 rounded-xl p-3">
                                                  <div class="flex items-center justify-between gap-2">
                                                      <span class="text-[11px] tracking-tight text-amber-500"><%= '★'.repeat(rv.rating) %><span class="text-stone-300"><%= '★'.repeat(5 - rv.rating) %></span></span>
                                                      <span class="text-[10px] text-stone-400"><%= new Date(rv.created_at).toLocaleDateString(reviewLocale, { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                                  </div>
                                                  <% if (rv.comment) { %>
                                                    <p class="text-xs text-stone-700 leading-snug mt-1.5"><%= rv.comment %></p>
                                                  <% } %>
                                                  <p class="text-[10px] font-semibold text-stone-400 mt-1.5"><%= t('reviews_author') %></p>
                                              </div>
                                            <% }); %>
                                        </div>
                                      <% } %>

                                      <div class="flex gap-2">
                                          <a href="tel:<%= master.phone %>" class="flex-1 px-3 py-3 min-h-[44px] bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 shadow-sm">
                                              <i class="fa-solid fa-phone text-[10px]"></i>
                                              <span><%= t('btn_call') %></span>
                                          </a>
                                          <a href="https://wa.me/<%= master.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="flex-1 px-3 py-3 min-h-[44px] bg-emerald-50 hover:bg-emerald-100 active:scale-95 text-emerald-700 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 border border-emerald-200/70">
                                              <i class="fa-brands fa-whatsapp"></i>
                                              <span>WhatsApp</span>
                                          </a>
                                      </div>

                                      <div class="border-t border-stone-100 pt-3">
                                          <button type="button" class="review-leave-btn text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5"
                                                  data-master-id="<%= master.id %>" data-master-name="<%= master.name %>">
                                              <i class="fa-solid fa-pen text-[10px]"></i><%= t('reviews_leave_btn') %>
                                          </button>
                                      </div>
                                  </div>
                                <% }); %>
                            </div>
                        </div>
                      <% } %>
                    <% }); %>

                    </section>

                    <section id="how-it-works" class="mt-12">
                        <h2 class="text-xl font-extrabold text-stone-900"><%= t('how_it_works_title') %></h2>
                        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <% [1, 2, 3, 4].forEach(function (n) { %>
                              <div class="bg-white rounded-2xl border border-stone-200/90 p-4">
                                  <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white text-xs font-black flex items-center justify-center"><%= n %></div>
                                  <h3 class="mt-2 text-sm font-extrabold text-stone-900"><%= t('how_it_works_step' + n + '_title') %></h3>
                                  <p class="mt-1 text-xs text-stone-600 leading-snug"><%= t('how_it_works_step' + n + '_desc') %></p>
                              </div>
                            <% }); %>
                        </div>
                    </section>

                    <section id="service-categories" class="mt-10">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <% groups.forEach(function (group) { %>
                              <div class="bg-white rounded-xl border border-stone-200/90 p-3.5">
                                  <span class="inline-block text-[10px] font-extrabold uppercase px-2 py-0.5 rounded border <%= group.color %>"><%= group.icon %> <%= t('service_desc_' + group.key + '_title') %></span>
                                  <p class="mt-1.5 text-xs text-stone-500 leading-snug"><%= t('service_desc_' + group.key + '_body') %></p>
                              </div>
                            <% }); %>
                        </div>
                    </section>

                    <section id="faq" class="mt-10">
                        <h2 class="text-xl font-extrabold text-stone-900 mb-3"><%= t('faq_title') %></h2>
                        <div class="divide-y divide-stone-200 border border-stone-200 rounded-2xl bg-white overflow-hidden">
                            <% [1, 2, 3, 4, 5].forEach(function (n) { %>
                              <details class="group" <%= n === 1 ? 'open' : '' %>>
                                  <summary class="flex items-center justify-between gap-3 px-4 py-3.5 cursor-pointer list-none text-sm font-extrabold text-stone-900 hover:bg-stone-50">
                                      <span><%= t('faq_q' + n) %></span>
                                      <i class="fa-solid fa-chevron-down text-[11px] text-stone-400 transition group-open:rotate-180 shrink-0"></i>
                                  </summary>
                                  <p class="px-4 pb-4 -mt-1 text-xs text-stone-600 leading-relaxed"><%= t('faq_a' + n) %></p>
                              </details>
                            <% }); %>
                        </div>
                    </section>

        </div>

    </main>


                       class="w-full text-center tracking-[0.4em] font-mono text-lg border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500">
                <button type="button" onclick="reviewVerifyCode()" id="review-code-btn"
                        class="w-full py-3 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition"><%= t('reviews_confirm_code') %></button>
            </div>

            <div id="review-step-rating" class="hidden space-y-3">
                <p class="text-xs font-bold text-stone-500 uppercase tracking-wide"><%= t('review_rating_label') %></p>
                <div id="review-stars" class="flex gap-1.5 text-3xl text-stone-300">
                    <% [1,2,3,4,5].forEach(function (n) { %>
                      <button type="button" class="review-star transition hover:text-amber-400" data-star="<%= n %>"><i class="fa-solid fa-star"></i></button>
                    <% }); %>

        <div class="bg-white rounded-2xl max-w-sm w-full p-6 space-y-4 relative shadow-2xl">
            <button onclick="closeModal('review-modal')" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-stone-100 text-stone-500 flex items-center justify-center text-xs font-bold hover:bg-stone-200 transition">✕</button>

            <div class="space-y-1">
                <h3 class="text-base font-bold text-stone-900"><%= t('reviews_modal_title') %></h3>
                <p id="review-modal-master" class="text-sm font-extrabold text-emerald-700"></p>
            </div>

            <p id="review-modal-msg" class="hidden text-xs font-bold p-3 rounded-xl"></p>

            <div id="review-step-phone" class="space-y-3">
                <p class="text-xs text-stone-500"><%= t('reviews_phone_hint') %></p>
                <input id="review-phone" type="tel" inputmode="tel" placeholder="+995 5XX XX XX XX"
                       class="w-full text-sm border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500">
                <button type="button" onclick="reviewRequestCode()" id="review-phone-btn"

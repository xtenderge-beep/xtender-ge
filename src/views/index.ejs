<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50 scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('site_title_index') %></title>
    <meta name="description" content="<%= t('meta_description_index') %>">

    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="alternate" hreflang="ka" href="<%= seo.alternates.ka %>">
    <link rel="alternate" hreflang="ru" href="<%= seo.alternates.ru %>">
    <link rel="alternate" hreflang="en" href="<%= seo.alternates.en %>">
    <link rel="alternate" hreflang="x-default" href="<%= seo.xDefault %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="xtender.ge">
    <meta property="og:title" content="<%= t('site_title_index') %>">
    <meta property="og:description" content="<%= t('meta_description_index') %>">
    <meta property="og:url" content="<%= seo.canonical %>">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= t('site_title_index') %>">
    <meta name="twitter:description" content="<%= t('meta_description_index') %>">

    <%
      const orgJsonLd = {
        '@context': 'https://schema.org',
        '@type': 'MovingCompany',
        name: 'xtender.ge',
        url: seo.canonical,
        areaServed: {
          '@type': 'City',
          name: 'Tbilisi',
          address: { '@type': 'PostalAddress', addressLocality: 'Tbilisi', addressCountry: 'GE' },
        },
        makesOffer: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: t('service_name_transport'), areaServed: 'Tbilisi' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: t('service_name_movers'), areaServed: 'Tbilisi' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: t('service_name_junk'), areaServed: 'Tbilisi' } },
        ],
      };
      const faqItems = [1, 2, 3, 4, 5].map((n) => ({ q: t('faq_q' + n), a: t('faq_a' + n) }));
      const faqJsonLd = {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      };
    %>
    <script type="application/ld+json"><%- JSON.stringify(orgJsonLd) %></script>
    <script type="application/ld+json"><%- JSON.stringify(faqJsonLd) %></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'],
                        mono: ['IBM Plex Mono', 'Noto Sans Georgian', 'ui-monospace', 'monospace'],
                    },
                    colors: {
                        brand: {
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f5f5f4; }
        ::-webkit-scrollbar-thumb { background: #d6d3d1; border-radius: 4px; }
        .lang-btn.active { background: #fff; color: #1c1917; font-weight: 800; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }

        .dispatch-grid {
            background-image: radial-gradient(circle, rgba(28,25,23,0.07) 1px, transparent 1px);
            background-size: 22px 22px;
        }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
        .fade-in-up { animation: fadeInUp .45s cubic-bezier(0.16, 1, 0.3, 1) both; }
    </style>
</head>
<body class="font-sans text-stone-800 bg-stone-50 dispatch-grid flex flex-col min-h-screen antialiased selection:bg-emerald-500 selection:text-white">

    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
        <div class="h-[3px] bg-emerald-600"></div>
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="flex items-center justify-between h-16 sm:h-20">

                <a href="/" class="flex items-center gap-2">
                    <span class="text-2xl sm:text-3xl font-black tracking-tight text-stone-900">
                        xtender<span class="text-emerald-600">.ge</span>
                    </span>
                </a>

                <div class="hidden xl:flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-wide text-stone-500">
                    <span class="whitespace-nowrap px-2.5 py-1 rounded-lg bg-stone-100 border border-stone-200 flex items-center gap-1"><%= t('nav_transport') %></span>
                    <span class="whitespace-nowrap px-2.5 py-1 rounded-lg bg-stone-100 border border-stone-200 flex items-center gap-1"><%= t('nav_movers') %></span>
                    <span class="whitespace-nowrap px-2.5 py-1 rounded-lg bg-stone-100 border border-stone-200 flex items-center gap-1"><%= t('nav_junk') %></span>
                </div>

                <div class="flex items-center gap-2 sm:gap-3">
                    <a href="/my-orders" class="hidden sm:flex whitespace-nowrap px-3 py-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-bold transition items-center gap-1.5">
                        <i class="fa-solid fa-list-check text-emerald-600"></i>
                        <span><%= t('my_orders_nav') %></span>
                    </a>

                    <div class="flex bg-stone-100 p-1 rounded-xl text-xs font-bold border border-stone-200">
                        <a href="<%= seo.alternates.ka %>" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ka' ? 'active' : 'hover:bg-white/50' %>">GE</a>
                        <a href="<%= seo.alternates.ru %>" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ru' ? 'active' : 'hover:bg-white/50' %>">RU</a>
                        <a href="<%= seo.alternates.en %>" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'en' ? 'active' : 'hover:bg-white/50' %>">EN</a>
                    </div>

                    <a href="/master" class="px-2.5 sm:px-3 py-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-bold transition flex items-center gap-1.5" title="<%= t('master_login_title') %>">
                        <i class="fa-solid fa-right-to-bracket text-emerald-600"></i>
                        <span class="hidden sm:inline"><%= t('master_login_nav') %></span>
                    </a>

                    <a href="/join" class="px-2.5 sm:px-3.5 py-2 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-truck text-amber-400"></i>
                        <span class="hidden sm:inline"><%= t('become_provider_btn') %></span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow">

        <div class="max-w-3xl mx-auto px-4 pt-6 pb-28 sm:pb-16">

                    <section id="seo-hero" class="mb-6 fade-in-up">
                        <h1 class="text-xl sm:text-2xl font-black tracking-tight text-stone-900"><%= t('seo_hero_h1') %></h1>
                        <p class="text-sm text-stone-500 mt-1.5 max-w-2xl"><%= t('seo_hero_lead') %></p>
                    </section>

                    <section id="post-section" class="fade-in-up">
                        <div class="bg-white rounded-2xl shadow-xl border border-stone-200/80 border-l-4 border-l-emerald-600 overflow-hidden">

                            <div id="detailsStep" class="p-5 sm:p-6">
                                <input type="hidden" id="description">

                                <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-stone-900"><%= t('composer_headline') %></h2>
                                <p class="text-sm text-stone-500 mt-1"><%= t('composer_subtitle') %></p>

                                <div class="mt-5">
                                    <textarea id="freeformInput" rows="6" placeholder="<%= t('freeform_placeholder') %>"
                                        class="w-full text-[15px] font-medium outline-none transition text-stone-800 resize-none placeholder:text-stone-400 placeholder:font-normal bg-stone-50 border border-stone-200 rounded-2xl p-4 focus:border-emerald-500 focus:bg-white"></textarea>

                                    <div id="attachmentsPreview" class="hidden mt-3 flex-wrap gap-2"></div>

                                    <label for="attachments" class="mt-3 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 text-sm font-bold cursor-pointer transition">
                                        <i class="fa-regular fa-image text-emerald-600"></i>
                                        <span><%= t('composer_photo_btn') %></span>
                                    </label>
                                    <input type="file" id="attachments" multiple accept="image/*,application/pdf" class="hidden">
                                </div>

                                <button type="button" onclick="submitFreeform()" class="mt-6 w-full py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                                    <span><%= t('composer_publish') %></span>
                                    <i class="fa-solid fa-arrow-right text-xs"></i>
                                </button>
                            </div>

                            <div id="phoneStep" class="p-5 sm:p-6 hidden">
                                <label for="phone" class="block text-[11px] font-bold text-stone-700 uppercase mb-1">
                                    <i class="fa-solid fa-phone text-emerald-600 mr-1"></i><%= t('form_phone_label') %>
                                </label>
                                <input type="tel" id="phone" placeholder="<%= t('form_phone_placeholder') %>"
                                    class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                                <button onclick="sendOtp()" class="mt-4 w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-shield-halved"></i>
                                    <span><%= t('otp_send') %></span>
                                </button>
                                <button onclick="goToDetailsStep()" class="mt-2 w-full py-2 text-xs font-bold text-stone-500 hover:text-stone-800 transition"><%= t('otp_back') %></button>
                            </div>

                            <div id="otpStep" class="p-5 sm:p-6 hidden">
                                <label for="code" class="block text-[11px] font-bold text-stone-700 uppercase mb-1">
                                    <i class="fa-solid fa-key text-emerald-600 mr-1"></i><%= t('otp_label') %>
                                </label>
                                <input type="text" id="code" maxlength="4" inputmode="numeric"
                                    class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none font-mono text-lg font-black tracking-[0.3em] text-center text-stone-900 bg-white">
                                <button onclick="verifyOtp()" class="mt-4 w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.97] duration-150 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-check"></i>
                                    <span><%= t('otp_verify') %></span>
                                </button>
                            </div>

                            <div id="formMsg" class="hidden text-xs font-bold mx-5 sm:mx-6 mb-5 sm:mb-6 p-3 rounded-xl"></div>
                        </div>
                        <p class="mt-2 text-center text-[11px] text-stone-400"><%= t('composer_publish_hint') %></p>
                    </section>

                    <section id="tender-live-section" class="hidden mt-6">
                        <div class="bg-stone-900 text-white rounded-2xl p-5 sm:p-6 shadow-xl border border-stone-700 space-y-4">

                            <div class="flex items-center justify-between text-xs border-b border-stone-800 pb-3">
                                <span class="font-bold text-emerald-400 flex items-center gap-2">
                                    <span class="relative flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                                    </span>
                                    <span><%= t('live_badge') %></span>
                                </span>
                                <span id="live-order-id" class="text-stone-400 font-mono text-[11px]"></span>
                            </div>

                            <div class="space-y-1 text-xs">
                                <p class="text-stone-100 font-bold text-sm">
                                    <i class="fa-solid fa-paper-plane text-amber-400 mr-1.5"></i> <%= t('live_sms_status') %>
                                </p>
                                <p class="text-stone-400 text-[11px]"><%= t('live_sms_hint') %></p>
                            </div>

                            <div class="bg-stone-800 p-3.5 rounded-2xl border border-stone-700 flex flex-col sm:flex-row items-center justify-between gap-3">
                                <div class="text-xs">
                                    <p class="font-bold text-amber-400"><%= t('live_delete_title') %></p>
                                    <p class="text-stone-400 text-[11px]"><%= t('live_delete_hint') %></p>
                                </div>
                                <button onclick="closeActiveOrder()" class="w-full sm:w-auto px-4 py-2.5 bg-red-600/90 hover:bg-red-600 text-white font-bold text-xs rounded-xl transition flex items-center justify-center gap-1.5 shrink-0 shadow-md">
                                    <i class="fa-solid fa-trash-can"></i>
                                    <span><%= t('live_delete_btn') %></span>
                                </button>
                            </div>

                        </div>
                    </section>

                    <section id="masters-section" class="mt-10 space-y-5">

                        <div class="border-b border-stone-200 pb-4">
                            <h2 class="text-xl font-extrabold text-stone-900 flex items-center gap-2">
                                <i class="fa-solid fa-address-book text-emerald-600"></i>
                                <span><%= t('catalog_title') %></span>
                            </h2>
                            <p class="text-xs text-stone-500 mt-1"><%= t('catalog_hint') %></p>
                        </div>

                        <div class="bg-stone-900 text-white rounded-2xl px-4 py-3.5 shadow-sm">
                            <p class="flex items-center gap-2.5">
                                <i class="fa-solid fa-truck-fast text-amber-400 text-lg shrink-0"></i>
                                <span class="text-xs sm:text-sm font-semibold text-stone-200 leading-snug"><%= t('become_provider_cta') %></span>
                            </p>
                            <div class="flex flex-col sm:flex-row gap-2 mt-3">
                                <a href="/join" class="flex-1 text-center px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black transition"><%= t('become_provider_btn') %></a>
                                <a href="/master" class="flex-1 text-center px-3 py-2 rounded-xl bg-stone-700 hover:bg-stone-600 text-white text-xs font-bold transition"><%= t('master_login_title') %></a>
                            </div>
                        </div>

                        <%
                          const groups = [
                            { key: 'transport', anchor: 'group-transport', label: t('catalog_group_transport'), icon: '🚚', color: 'bg-amber-100 text-amber-900 border-amber-200' },
                            { key: 'movers', anchor: 'group-movers', label: t('catalog_group_movers'), icon: '💪', color: 'bg-emerald-100 text-emerald-900 border-emerald-200' },
                            { key: 'junk', anchor: 'group-junk', label: t('catalog_group_junk'), icon: '🧹', color: 'bg-stone-100 text-stone-900 border-stone-300' },
                          ];
                          const reviewLocale = lang === 'ka' ? 'ka-GE' : (lang === 'en' ? 'en-US' : 'ru-RU');
                          function reviewsWord(n) {
                            const m10 = n % 10, m100 = n % 100;
                            if (m10 === 1 && m100 !== 11) return t('reviews_word_one');
                            if (m10 >= 2 && m10 <= 4 && !(m100 >= 12 && m100 <= 14)) return t('reviews_word_few');
                            return t('reviews_word_many');
                          }
                        %>

                        <div class="flex flex-wrap gap-2" id="categoryFilterBar">
                            <button type="button" onclick="setCategoryFilter('all')" data-filter-cat="all" class="filter-btn px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition border bg-emerald-600 text-white border-emerald-600">
                                <%= t('filter_all') %>
                            </button>
                            <% groups.forEach(function (group) { %>
                              <button type="button" onclick="setCategoryFilter('<%= group.key %>')" data-filter-cat="<%= group.key %>" class="filter-btn px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">
                                  <%= group.icon %> <%= group.label %>
                              </button>
                            <% }); %>
                        </div>

                        <div class="hidden flex-wrap gap-2" id="sizeFilterBar">
                            <button type="button" onclick="setSizeFilter('all')" data-filter-size="all" class="filter-btn px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-emerald-600 text-white border-emerald-600">
                                <%= t('filter_all_sizes') %>
                            </button>
                            <button type="button" onclick="setSizeFilter('L')" data-filter-size="L" class="filter-btn min-w-[42px] text-center px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">L</button>
                            <button type="button" onclick="setSizeFilter('XL')" data-filter-size="XL" class="filter-btn min-w-[42px] text-center px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">XL</button>
                            <button type="button" onclick="setSizeFilter('XXL')" data-filter-size="XXL" class="filter-btn min-w-[42px] text-center px-3 py-1.5 rounded-md font-mono text-[11px] font-bold uppercase tracking-wide transition border bg-white text-stone-600 border-stone-200 hover:brightness-95">XXL</button>
                        </div>

                    <% groups.forEach(function (group) { %>
                      <% const groupMasters = masters.filter((m) => m.category === group.key); %>
                      <% if (groupMasters.length) { %>
                        <div id="<%= group.anchor %>" data-group="<%= group.key %>" class="scroll-mt-24">
                            <h3 class="text-sm font-extrabold text-stone-800 flex items-center gap-2 mb-3">
                                <span class="text-lg"><%= group.icon %></span>
                                <span><%= group.label %></span>
                                <span class="text-[11px] font-bold text-stone-400"><%= groupMasters.length %></span>
                            </h3>
                            <div class="space-y-3">
                                <% groupMasters.forEach(function (master) { %>
                                  <div class="master-card bg-white rounded-2xl border border-stone-200/90 p-4 sm:p-5 shadow-sm hover:shadow-md transition flex flex-col gap-3.5" data-category="<%= group.key %>" data-size="<%= master.vehicle_size || '' %>">

                                      <div class="flex flex-col sm:flex-row gap-4">

                                      <div class="flex sm:flex-col items-center sm:items-start gap-3 sm:gap-2 sm:w-16 shrink-0">
                                          <% if (master.avatar_url) { %>
                                            <img src="<%= master.avatar_url %>" alt="<%= master.name %>" class="w-14 h-14 rounded-2xl object-cover border border-stone-200">
                                          <% } else { %>
                                            <div class="w-14 h-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center font-black text-lg shrink-0">
                                                <%= master.name.charAt(0).toUpperCase() %>
                                            </div>
                                          <% } %>
                                      </div>

                                      <div class="flex-1 min-w-0 space-y-1.5">
                                          <div class="flex items-center gap-2 flex-wrap">
                                              <h3 class="font-extrabold text-stone-900 text-sm sm:text-base"><%= master.name %></h3>
                                              <span class="font-mono text-[10px] font-bold uppercase tracking-wide text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md flex items-center gap-1">
                                                  <i class="fa-solid fa-circle-check"></i><%= t('catalog_verified') %>
                                              </span>
                                          </div>

                                          <span class="inline-block text-[10px] font-extrabold uppercase px-2 py-0.5 rounded border <%= group.color %>">
                                              <%= group.icon %> <%= group.label %>
                                          </span>

                                          <% if (master.vehicle_type) { %>
                                            <p class="text-xs font-semibold text-emerald-700"><%= master.vehicle_type %></p>
                                          <% } %>

                                          <% if (master.description) { %>
                                            <p class="text-xs text-stone-600 leading-snug"><%= master.description %></p>
                                          <% } %>

                                          <% if (master.price_text) { %>
                                            <p class="font-mono text-sm font-bold text-stone-900 pt-1"><%= master.price_text %></p>
                                          <% } %>
                                      </div>

                                      <div class="sm:w-40 shrink-0 flex sm:flex-col gap-2">
                                          <a href="tel:<%= master.phone %>" class="flex-1 sm:flex-none px-3 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 shadow-sm">
                                              <i class="fa-solid fa-phone text-[10px]"></i>
                                              <span><%= t('btn_call') %></span>
                                          </a>
                                          <a href="https://wa.me/<%= master.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="flex-1 sm:flex-none px-3 py-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 border border-emerald-200/70">
                                              <i class="fa-brands fa-whatsapp"></i>
                                              <span>WhatsApp</span>
                                          </a>
                                      </div>

                                      </div>

                                      <div class="review-footer border-t border-stone-100 pt-3">
                                          <div class="flex items-center justify-between gap-3 flex-wrap">
                                              <% if (master.reviews.length) { %>
                                                <button type="button" class="review-toggle text-xs font-bold text-stone-600 hover:text-stone-900 flex items-center gap-1.5">
                                                    <i class="fa-solid fa-star text-[10px] text-amber-500"></i>
                                                    <span class="text-stone-900"><%= Number(master.rating).toFixed(1) %></span>
                                                    <span class="text-stone-300">·</span>
                                                    <span><%= master.reviews.length %> <%= reviewsWord(master.reviews.length) %></span>
                                                    <i class="fa-solid fa-chevron-down text-[8px] text-stone-400 transition review-chevron"></i>
                                                </button>
                                              <% } else { %>
                                                <span class="text-xs font-semibold text-stone-400 flex items-center gap-1.5">
                                                    <i class="fa-regular fa-star text-[10px]"></i><%= t('reviews_none') %>
                                                </span>
                                              <% } %>
                                              <button type="button" class="review-leave-btn text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5"
                                                      data-master-id="<%= master.id %>" data-master-name="<%= master.name %>">
                                                  <i class="fa-solid fa-pen text-[10px]"></i><%= t('reviews_leave_btn') %>
                                              </button>
                                          </div>

                                          <% if (master.reviews.length) { %>
                                            <div class="review-list hidden mt-3 space-y-2">
                                                <% master.reviews.forEach(function (rv) { %>
                                                  <div class="bg-stone-50 border border-stone-100 rounded-xl p-3">
                                                      <div class="flex items-center justify-between gap-2">
                                                          <span class="text-[11px] tracking-tight text-amber-500"><%= '★'.repeat(rv.rating) %><span class="text-stone-300"><%= '★'.repeat(5 - rv.rating) %></span></span>
                                                          <span class="text-[10px] text-stone-400"><%= new Date(rv.created_at).toLocaleDateString(reviewLocale, { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                                      </div>
                                                      <% if (rv.comment) { %>
                                                        <p class="text-xs text-stone-700 leading-snug mt-1.5"><%= rv.comment %></p>
                                                      <% } %>
                                                      <p class="text-[10px] font-semibold text-stone-400 mt-1.5"><%= t('reviews_author') %></p>
                                                  </div>
                                                <% }); %>
                                            </div>
                                          <% } %>
                                      </div>
                                  </div>
                                <% }); %>
                            </div>
                        </div>
                      <% } %>
                    <% }); %>

                    </section>

                    <section id="how-it-works" class="mt-12">
                        <h2 class="text-xl font-extrabold text-stone-900"><%= t('how_it_works_title') %></h2>
                        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <% [1, 2, 3, 4].forEach(function (n) { %>
                              <div class="bg-white rounded-2xl border border-stone-200/90 p-4">
                                  <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white text-xs font-black flex items-center justify-center"><%= n %></div>
                                  <h3 class="mt-2 text-sm font-extrabold text-stone-900"><%= t('how_it_works_step' + n + '_title') %></h3>
                                  <p class="mt-1 text-xs text-stone-600 leading-snug"><%= t('how_it_works_step' + n + '_desc') %></p>
                              </div>
                            <% }); %>
                        </div>
                    </section>

                    <section id="service-categories" class="mt-10">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <% groups.forEach(function (group) { %>
                              <div class="bg-white rounded-2xl border border-stone-200/90 p-4">
                                  <span class="inline-block text-[10px] font-extrabold uppercase px-2 py-0.5 rounded border <%= group.color %>"><%= group.icon %> <%= t('service_desc_' + group.key + '_title') %></span>
                                  <p class="mt-2 text-xs text-stone-600 leading-snug"><%= t('service_desc_' + group.key + '_body') %></p>
                              </div>
                            <% }); %>
                        </div>
                    </section>

                    <section id="coverage" class="mt-10">
                        <h2 class="text-xl font-extrabold text-stone-900"><%= t('coverage_title') %></h2>
                        <p class="mt-1 text-sm text-stone-600"><%= t('coverage_body') %></p>
                    </section>

                    <section id="faq" class="mt-10">
                        <h2 class="text-xl font-extrabold text-stone-900"><%= t('faq_title') %></h2>
                        <div class="mt-4 space-y-3">
                            <% [1, 2, 3, 4, 5].forEach(function (n) { %>
                              <div class="bg-white rounded-2xl border border-stone-200/90 p-4">
                                  <h3 class="text-sm font-extrabold text-stone-900"><%= t('faq_q' + n) %></h3>
                                  <p class="mt-1 text-xs text-stone-600 leading-snug"><%= t('faq_a' + n) %></p>
                              </div>
                            <% }); %>
                        </div>
                    </section>

        </div>

    </main>

    <nav class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-stone-900/95 backdrop-blur-md border-t border-stone-700/60 grid grid-cols-3">
        <button type="button" onclick="scrollToId('post-section')" class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-emerald-400">
            <i class="fa-solid fa-square-plus text-base"></i>
            <span class="text-[10px] font-bold"><%= t('mobilenav_post') %></span>
        </button>
        <button type="button" onclick="setCategoryFilter('all', 'masters-section')" class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-stone-300">
            <i class="fa-solid fa-address-book text-base"></i>
            <span class="text-[10px] font-bold"><%= t('mobilenav_masters') %></span>
        </button>
        <a href="/my-orders" class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-stone-300">
            <i class="fa-solid fa-list-check text-base"></i>
            <span class="text-[10px] font-bold"><%= t('my_orders_nav') %></span>
        </a>
    </nav>

    <footer class="bg-stone-900 text-stone-400 py-8 border-t border-stone-800 text-xs">
        <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <span class="text-base font-black text-white">xtender<span class="text-emerald-500">.ge</span></span>
                <p class="text-stone-500 text-[11px]"><%= t('footer_desc') %></p>
            </div>
            <div class="flex flex-col sm:items-end gap-1.5">
                <div class="flex gap-3">
                    <a href="/join" class="text-stone-400 hover:text-white transition"><%= t('become_provider_btn') %></a>
                    <a href="/master" class="text-stone-400 hover:text-white transition"><%= t('master_login_title') %></a>
                </div>
                <p class="font-mono text-stone-500 text-[11px]"><%= t('footer_copy') %></p>
            </div>
        </div>
    </footer>

    <div id="review-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-stone-900/70 backdrop-blur-sm">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 space-y-4 relative shadow-2xl">
            <button onclick="closeModal('review-modal')" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-stone-100 text-stone-500 flex items-center justify-center text-xs font-bold hover:bg-stone-200 transition">✕</button>

            <div class="space-y-1">
                <h3 class="text-base font-bold text-stone-900"><%= t('reviews_modal_title') %></h3>
                <p id="review-modal-master" class="text-sm font-extrabold text-emerald-700"></p>
            </div>

            <p id="review-modal-msg" class="hidden text-xs font-bold p-3 rounded-xl"></p>

            <div id="review-step-phone" class="space-y-3">
                <p class="text-xs text-stone-500"><%= t('reviews_phone_hint') %></p>
                <input id="review-phone" type="tel" inputmode="tel" placeholder="+995 5XX XX XX XX"
                       class="w-full text-sm border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500">
                <button type="button" onclick="reviewRequestCode()" id="review-phone-btn"
                        class="w-full py-3 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition"><%= t('reviews_get_code') %></button>
            </div>

            <div id="review-step-code" class="hidden space-y-3">
                <input id="review-code" type="text" inputmode="numeric" maxlength="4" placeholder="1234"
                       class="w-full text-center tracking-[0.4em] font-mono text-lg border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500">
                <button type="button" onclick="reviewVerifyCode()" id="review-code-btn"
                        class="w-full py-3 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition"><%= t('reviews_confirm_code') %></button>
            </div>

            <div id="review-step-rating" class="hidden space-y-3">
                <p class="text-xs font-bold text-stone-500 uppercase tracking-wide"><%= t('review_rating_label') %></p>
                <div id="review-stars" class="flex gap-1.5 text-3xl text-stone-300">
                    <% [1,2,3,4,5].forEach(function (n) { %>
                      <button type="button" class="review-star transition hover:text-amber-400" data-star="<%= n %>"><i class="fa-solid fa-star"></i></button>
                    <% }); %>
                </div>
                <textarea id="review-comment" rows="3" placeholder="<%= t('review_comment_placeholder') %>"
                          class="w-full text-sm border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500 resize-none"></textarea>
                <button type="button" onclick="reviewSubmit()" id="review-submit-btn"
                        class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl transition"><%= t('review_submit_btn') %></button>
            </div>

            <div id="review-step-done" class="hidden text-center py-4">
                <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl mx-auto mb-3">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <p class="text-sm font-semibold text-stone-700"><%= t('reviews_thanks') %></p>
            </div>
        </div>
    </div>

    <script>
        const T = <%- JSON.stringify(clientStrings) %>;

        const descriptionInput = document.getElementById('description');
        const phoneInput = document.getElementById('phone');
        const codeInput = document.getElementById('code');
        const formMsg = document.getElementById('formMsg');

        const detailsStep = document.getElementById('detailsStep');
        const phoneStep = document.getElementById('phoneStep');
        const otpStep = document.getElementById('otpStep');

        function showMsg(text, isError) {
            if (!text) {
                formMsg.classList.add('hidden');
                return;
            }
            formMsg.classList.remove('hidden');
            formMsg.textContent = text;
            formMsg.className = 'text-xs font-bold p-3 rounded-xl ' + (isError ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200');
        }

        function resetWizard() {
            document.getElementById('freeformInput').value = '';
            document.getElementById('attachments').value = '';
            document.getElementById('attachmentsPreview').innerHTML = '';
            document.getElementById('attachmentsPreview').classList.add('hidden');
        }

        let activeCategory = 'all';
        let activeSize = 'all';

        const catFilterBtns = document.querySelectorAll('[data-filter-cat]');
        const sizeFilterBtns = document.querySelectorAll('[data-filter-size]');
        const sizeFilterBar = document.getElementById('sizeFilterBar');

        function styleFilterBtn(btn, active) {
            btn.classList.toggle('bg-emerald-600', active);
            btn.classList.toggle('text-white', active);
            btn.classList.toggle('border-emerald-600', active);
            btn.classList.toggle('bg-white', !active);
            btn.classList.toggle('text-stone-600', !active);
            btn.classList.toggle('border-stone-200', !active);
        }

        function applyFilters() {
            document.querySelectorAll('[data-group]').forEach((group) => {
                const show = activeCategory === 'all' || group.dataset.group === activeCategory;
                group.classList.toggle('hidden', !show);
            });
            document.querySelectorAll('.master-card').forEach((card) => {
                let show = activeCategory === 'all' || card.dataset.category === activeCategory;
                if (show && activeCategory === 'transport' && activeSize !== 'all') {
                    show = card.dataset.size === activeSize;
                }
                card.classList.toggle('hidden', !show);
            });
            sizeFilterBar.classList.toggle('hidden', activeCategory !== 'transport');
            sizeFilterBar.classList.toggle('flex', activeCategory === 'transport');
            catFilterBtns.forEach((btn) => styleFilterBtn(btn, btn.dataset.filterCat === activeCategory));
            sizeFilterBtns.forEach((btn) => styleFilterBtn(btn, btn.dataset.filterSize === activeSize));
        }

        function scrollToId(id) {
            const el = document.getElementById(id);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function setCategoryFilter(cat, anchorId) {
            activeCategory = cat;
            activeSize = 'all';
            applyFilters();
            if (anchorId) setTimeout(() => scrollToId(anchorId), 50);
        }

        function setSizeFilter(size) {
            activeSize = size;
            applyFilters();
        }

        const attachmentsInput = document.getElementById('attachments');
        const attachmentsPreview = document.getElementById('attachmentsPreview');

        attachmentsInput.addEventListener('change', () => {
            const files = Array.from(attachmentsInput.files);
            attachmentsPreview.innerHTML = '';
            if (!files.length) {
                attachmentsPreview.classList.add('hidden');
                return;
            }
            attachmentsPreview.classList.remove('hidden');
            attachmentsPreview.classList.add('flex');
            files.forEach((file) => {
                const chip = document.createElement('span');
                chip.className = 'px-2.5 py-1 rounded-lg bg-stone-100 border border-stone-200 text-[11px] font-semibold text-stone-600 flex items-center gap-1';
                chip.innerHTML = '<i class="fa-solid fa-paperclip text-[10px]"></i> ' + file.name;
                attachmentsPreview.appendChild(chip);
            });
        });

        function submitFreeform() {
            const text = document.getElementById('freeformInput').value.trim();
            if (!text) return showMsg(T.js_err_wizard_required, true);
            showMsg('');
            descriptionInput.value = text;
            goToPhoneStep();
        }

        function goToPhoneStep() {
            showMsg('');
            detailsStep.classList.add('hidden');
            phoneStep.classList.remove('hidden');
        }

        function goToDetailsStep() {
            showMsg('');
            phoneStep.classList.add('hidden');
            otpStep.classList.add('hidden');
            detailsStep.classList.remove('hidden');
        }

        let pendingOrderToken = null;

        async function sendOtp() {
            const phone = phoneInput.value.trim();
            if (!phone) return showMsg(T.js_err_empty_phone, true);

            const description = descriptionInput.value.trim();
            const res = await fetch('/api/otp/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, description }),
            });
            const data = await res.json();
            if (data.success) {
                pendingOrderToken = data.token;
                showMsg(T.js_ok_code_sent, false);
                phoneStep.classList.add('hidden');
                otpStep.classList.remove('hidden');
            } else {
                showMsg(data.message || T.js_err_send_code, true);
            }
        }

        async function verifyOtp() {
            const phone = phoneInput.value.trim();
            const code = codeInput.value.trim();
            if (!code) return showMsg(T.js_err_empty_code, true);

            let res = await fetch('/api/otp/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, code }),
            });
            let data = await res.json();
            if (!data.success) {
                return showMsg(data.message || T.js_err_wrong_code, true);
            }

            const formData = new FormData();
            formData.append('phone', phone);
            formData.append('token', pendingOrderToken);

            Array.from(document.getElementById('attachments').files).forEach((file) => formData.append('files', file));

            res = await fetch('/api/orders', { method: 'POST', body: formData });
            data = await res.json();
            if (data.success) {
                showLiveOrder(data.token);
            } else {
                showMsg(data.message || T.js_err_create_order, true);
            }
        }

        let activeOrderToken = null;

        function showLiveOrder(token) {
            activeOrderToken = token;
            document.getElementById('live-order-id').textContent = '#' + token.slice(0, 8);
            const liveSection = document.getElementById('tender-live-section');
            liveSection.classList.remove('hidden');
            liveSection.scrollIntoView({ behavior: 'smooth' });

            otpStep.classList.add('hidden');
            phoneStep.classList.add('hidden');
            detailsStep.classList.remove('hidden');
            phoneInput.value = '';
            codeInput.value = '';
            pendingOrderToken = null;
            showMsg('');
            resetWizard();
        }

        async function closeActiveOrder() {
            if (!activeOrderToken) return;
            await fetch('/api/orders/' + activeOrderToken + '/close', { method: 'POST' });
            document.getElementById('tender-live-section').classList.add('hidden');
            activeOrderToken = null;
            showToast(T.js_deleted_toast);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            document.getElementById(id).classList.add('flex');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            document.getElementById(id).classList.remove('flex');
        }

        function showToast(text) {
            const toast = document.createElement('div');
            toast.className = 'fixed top-5 left-1/2 -translate-x-1/2 z-50 bg-stone-900 text-white px-4 py-2.5 rounded-2xl text-xs font-bold shadow-2xl border border-stone-700 flex items-center gap-2';
            toast.innerHTML = '<span>' + text + '</span>';
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3200);
        }

        // --- Отзывы: разворачивание списка в карточке ---
        document.querySelectorAll('.review-toggle').forEach((btn) => {
            btn.addEventListener('click', () => {
                const list = btn.closest('.review-footer').querySelector('.review-list');
                const chevron = btn.querySelector('.review-chevron');
                const open = list.classList.toggle('hidden');
                if (chevron) chevron.classList.toggle('rotate-180', !open);
            });
        });

        // --- Отзывы: форма «оставить отзыв» (телефон -> код -> оценка) ---
        const reviewModalMsg = document.getElementById('review-modal-msg');
        const reviewSteps = {
            phone: document.getElementById('review-step-phone'),
            code: document.getElementById('review-step-code'),
            rating: document.getElementById('review-step-rating'),
            done: document.getElementById('review-step-done'),
        };
        let reviewMasterId = null;
        let reviewRating = 0;

        function reviewShowStep(name) {
            Object.entries(reviewSteps).forEach(([key, el]) => el.classList.toggle('hidden', key !== name));
        }

        function reviewMsg(text, isError) {
            if (!text) { reviewModalMsg.classList.add('hidden'); return; }
            reviewModalMsg.classList.remove('hidden');
            reviewModalMsg.textContent = text;
            reviewModalMsg.className = 'text-xs font-bold p-3 rounded-xl ' + (isError
                ? 'bg-red-50 text-red-700 border border-red-200'
                : 'bg-emerald-50 text-emerald-700 border border-emerald-200');
        }

        document.querySelectorAll('.review-leave-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                reviewMasterId = btn.dataset.masterId;
                reviewRating = 0;
                document.getElementById('review-modal-master').textContent = btn.dataset.masterName;
                document.getElementById('review-phone').value = '';
                document.getElementById('review-code').value = '';
                document.getElementById('review-comment').value = '';
                paintReviewStars(0);
                reviewMsg('');
                reviewShowStep('phone');
                openModal('review-modal');
            });
        });

        function paintReviewStars(upTo) {
            document.querySelectorAll('.review-star').forEach((s) => {
                s.classList.toggle('text-amber-400', Number(s.dataset.star) <= upTo);
                s.classList.toggle('text-stone-300', Number(s.dataset.star) > upTo);
            });
        }
        document.querySelectorAll('.review-star').forEach((s) => {
            s.addEventListener('mouseenter', () => paintReviewStars(Number(s.dataset.star)));
            s.addEventListener('mouseleave', () => paintReviewStars(reviewRating));
            s.addEventListener('click', () => { reviewRating = Number(s.dataset.star); paintReviewStars(reviewRating); });
        });

        async function reviewRequestCode() {
            const phone = document.getElementById('review-phone').value.trim();
            if (!phone) return reviewMsg(T.js_err_empty_phone, true);
            const btn = document.getElementById('review-phone-btn');
            btn.disabled = true;
            try {
                const res = await fetch('/api/reviews/request-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone }),
                });
                const data = await res.json();
                if (data.success) {
                    reviewMsg(T.js_ok_code_sent, false);
                    reviewShowStep('code');
                } else {
                    reviewMsg(data.message || T.js_err_send_code, true);
                }
            } catch (e) {
                reviewMsg(T.js_err_send_code, true);
            } finally {
                btn.disabled = false;
            }
        }

        async function reviewVerifyCode() {
            const phone = document.getElementById('review-phone').value.trim();
            const code = document.getElementById('review-code').value.trim();
            if (!code) return reviewMsg(T.js_err_empty_code, true);
            const btn = document.getElementById('review-code-btn');
            btn.disabled = true;
            try {
                const res = await fetch('/api/reviews/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone, code, masterId: reviewMasterId }),
                });
                const data = await res.json();
                if (!data.success) return reviewMsg(data.message || T.js_err_wrong_code, true);
                if (data.eligible) {
                    reviewMsg('');
                    reviewShowStep('rating');
                } else {
                    reviewMsg(data.reason === 'already_reviewed' ? T.reviews_err_already : T.reviews_err_not_eligible, true);
                }
            } catch (e) {
                reviewMsg(T.js_err_wrong_code, true);
            } finally {
                btn.disabled = false;
            }
        }

        async function reviewSubmit() {
            if (!reviewRating) return reviewMsg(T.reviews_pick_rating, true);
            const phone = document.getElementById('review-phone').value.trim();
            const comment = document.getElementById('review-comment').value;
            const btn = document.getElementById('review-submit-btn');
            btn.disabled = true;
            try {
                const res = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone, masterId: reviewMasterId, rating: reviewRating, comment }),
                });
                const data = await res.json();
                if (data.success) {
                    reviewMsg('');
                    reviewShowStep('done');
                } else if (res.status === 409) {
                    reviewMsg(T.reviews_err_already, true);
                } else {
                    reviewMsg(data.message || T.js_err_send_code, true);
                }
            } catch (e) {
                reviewMsg(T.js_err_send_code, true);
            } finally {
                btn.disabled = false;
            }
        }

        resetWizard();
    </script>
</body>
</html>

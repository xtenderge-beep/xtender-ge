<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>xtender.ge</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style>
  /* Лёгкая отдельная страница (согласие перед первой публикацией из ChatGPT, возврат по ссылке из SMS): открывается
     с телефона из SMS или из окна ChatGPT, без общей вёрстки сайта. */
  :root { --bg:#fafaf9; --card:#fff; --text:#1c1917; --muted:#57534e; --line:#e7e5e4; --accent:#047857; --accent-hover:#065f46; --error:#b91c1c; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans Georgian",sans-serif; }
  main { max-width:480px; margin:0 auto; padding:28px 16px 48px; }
  .brand { font-weight:700; font-size:20px; margin:0 0 16px; color:var(--accent); text-decoration:none; display:inline-block; }
  .langs { float:right; font-size:14px; }
  .langs a { color:var(--muted); margin-left:8px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:22px 18px; overflow-wrap:anywhere; }
  h1 { font-size:20px; line-height:1.3; margin:0 0 12px; }
  p { margin:0 0 12px; }
  .muted { color:var(--muted); font-size:14px; }
  .notice { font-size:14px; color:var(--muted); margin:0 0 8px; }
  .check { display:flex; gap:10px; align-items:flex-start; margin:14px 0; font-size:15px; }
  .check input { margin-top:4px; width:18px; height:18px; flex-shrink:0; }
  .check a { color:var(--accent); }
  button, .button { font:inherit; cursor:pointer; border-radius:10px; padding:12px 16px; border:1px solid transparent; display:inline-block; text-align:center; text-decoration:none; }
  .primary { width:100%; margin-top:12px; background:var(--accent); color:#fff; font-weight:600; }
  .primary:hover { background:var(--accent-hover); }
  .secondary { width:100%; margin-top:10px; background:#fff; color:var(--text); border-color:#d6d3d1; }
  .row { display:flex; gap:8px; }
  .row > * { flex:1; }
  textarea { width:100%; font:14px/1.4 inherit; padding:10px; border:1px solid var(--line); border-radius:10px; background:#f5f5f4; color:var(--text); }
  .error { color:var(--error); font-weight:600; margin-top:12px; }
  .ok { color:var(--accent); font-weight:600; margin-top:12px; }
  .status { padding:12px 14px; border-radius:12px; background:#f0f9ff; border:1px solid #bae6fd; margin:0 0 12px; }
</style>
</head>
<body>
<main>
  <a class="brand" href="/">xtender.ge</a>
  <% if (typeof langHref === 'string' && langHref) { %><span class="langs"><% ['ka', 'ru', 'en'].filter(function (l) { return l !== lang; }).forEach(function (l) { %><a href="<%= langHref + l %>"><%= l.toUpperCase() %></a><% }); %></span><% } %>
  <div class="card">
  <% if (view === 'consent') { %>
    <h1><%= c('consent_title') %></h1>
    <p class="muted"><%= c('consent_intro') %></p>
    <% consent.notices.forEach(function (n) { %><p class="notice"><%= n %></p><% }); %>
    <form method="post" action="/consent/<%= token %>">
      <input type="hidden" name="digest" value="<%= consent.digest %>">
      <input type="hidden" name="lang" value="<%= lang %>">
      <label class="check"><input type="checkbox" name="terms" value="1" required><span><%= consent.termsLabel %> <a href="<%= consent.terms_url %>" target="_blank" rel="noopener">↗</a></span></label>
      <label class="check"><input type="checkbox" name="privacy" value="1" required><span><%= consent.privacyLabel %> <a href="<%= consent.privacy_url %>" target="_blank" rel="noopener">↗</a></span></label>
      <p class="muted" style="margin-top:18px;font-weight:600"><%= c('consent_sms_label') %></p>
      <label class="check"><input type="checkbox" name="sms" value="1"><span><%= c('notify_consent') %></span></label>
      <% if (typeof error === 'string' && error) { %><p class="error"><%= error %></p><% } %>
      <button class="primary"><%= c('consent_submit') %></button>
    </form>
  <% } else if (view === 'consent_done') { %>
    <h1><%= c('consent_title') %></h1>
    <p class="ok"><%= c('consent_done') %></p>
  <% } else if (view === 'expired') { %>
    <p><%= message %></p>
  <% } else if (view === 'resume') { %>
    <h1><%= c('resume_title', { id: resume.id }) %></h1>
    <div class="status"><%= resume.status %></div>
    <% if (resume.offerCount !== null) { %><p><%= c('resume_offers', { n: resume.offerCount }) %></p><% } %>
    <p class="muted"><%= c('resume_private') %></p>
    <form method="post" action="/t/<%= token %>/link">
      <input type="hidden" name="lang" value="<%= lang %>">
      <button class="secondary"><%= c('resume_send_link') %></button>
    </form>
    <% if (typeof sent === 'string' && sent) { %><p class="ok"><%= sent %></p><% } %>
    <% if (typeof error === 'string' && error) { %><p class="error"><%= error %></p><% } %>
    <hr style="border:none;border-top:1px solid var(--line);margin:20px 0">
    <p style="font-weight:600;margin-bottom:6px"><%= c('chatgpt_title') %></p>
    <p class="muted"><%= c('chatgpt_hint') %></p>
    <textarea id="prompt" readonly rows="3"><%= resume.prompt %></textarea>
    <div class="row" style="margin-top:8px">
      <button type="button" class="secondary" style="margin-top:0" id="copyPrompt" data-done="<%= c('copied') %>"><%= c('copy') %></button>
      <a class="button primary" style="margin-top:0" href="https://chatgpt.com/?q=<%= encodeURIComponent(resume.prompt) %>" target="_blank" rel="noopener"><%= c('open_chatgpt') %></a>
    </div>
    <script>
      document.getElementById('copyPrompt').addEventListener('click', function () {
        var field = document.getElementById('prompt'); var button = this; var before = button.textContent;
        var done = function () { button.textContent = button.getAttribute('data-done'); setTimeout(function () { button.textContent = before; }, 1800); };
        if (navigator.clipboard) navigator.clipboard.writeText(field.value).then(done, function () { field.select(); document.execCommand('copy'); done(); });
        else { field.select(); document.execCommand('copy'); done(); }
      });
    </script>
  <% } %>
  </div>
</main>
</body>
</html>

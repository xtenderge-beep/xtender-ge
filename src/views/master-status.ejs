<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= t('master_status_page_title') %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'],
                        mono: ['IBM Plex Mono', 'Noto Sans Georgian', 'ui-monospace', 'monospace'],
                    },
                }
            }
        }
    </script>
    <style>
        .lang-btn.active { background: #fff; color: #1c1917; font-weight: 800; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
        details > summary { list-style: none; }
        details > summary::-webkit-details-marker { display: none; }
    </style>
</head>
<body class="font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

<%
    const reviewLocale = lang === 'ka' ? 'ka-GE' : (lang === 'en' ? 'en-US' : 'ru-RU');
    const categoryLabels = {
        transport: t('catalog_group_transport'),
        movers: t('catalog_group_movers'),
        junk: t('catalog_group_junk'),
    };
    function historyReason(reason) {
        if (reason === 'topup') return t('master_status_history_topup');
        if (reason === 'lead_charge') return t('master_status_history_lead');
        return t('master_status_history_correction');
    }
%>

    <header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm sticky top-0 z-20">
        <div class="max-w-xl mx-auto px-4">
            <div class="flex items-center justify-between h-16 gap-3">
                <a href="/" class="flex items-center gap-2 shrink-0">
                    <span class="text-xl font-black tracking-tight text-stone-900">xtender<span class="text-emerald-600">.ge</span></span>
                </a>
                <div class="flex items-center gap-2">
                    <% if (master) { %>
                        <span class="font-mono text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg whitespace-nowrap">
                            <%= (master.balance_tetri / 100).toFixed(2) %> ₾
                        </span>
                    <% } %>
                    <div class="flex bg-stone-100 p-1 rounded-xl text-xs font-bold border border-stone-200">
                        <a href="/lang/ka" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ka' ? 'active' : 'hover:bg-white/50' %>">GE</a>
                        <a href="/lang/ru" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ru' ? 'active' : 'hover:bg-white/50' %>">RU</a>
                        <a href="/lang/en" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'en' ? 'active' : 'hover:bg-white/50' %>">EN</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-xl mx-auto px-4 py-8 space-y-4">
        <% if (!master) { %>
            <div class="bg-white rounded-2xl shadow-xl border border-stone-200/80 p-6 sm:p-7 space-y-4">
                <div>
                    <h1 class="text-xl font-black tracking-tight text-stone-900"><%= t('master_login_title') %></h1>
                    <p class="text-sm text-stone-500 mt-1"><%= t('master_login_subtitle') %></p>
                </div>

                <% if (typeof badToken !== 'undefined' && badToken) { %>
                    <p class="text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-2.5"><%= t('master_login_bad_token') %></p>
                <% } %>

                <p id="loginMsg" class="hidden text-xs font-bold p-3 rounded-xl"></p>

                <div id="loginPhoneStep" class="space-y-3">
                    <input id="loginPhone" type="tel" inputmode="tel" placeholder="+995 5XX XX XX XX"
                           class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                    <button type="button" id="loginPhoneBtn" onclick="loginRequestCode()"
                            class="w-full py-3 rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold transition"><%= t('master_login_get_code') %></button>
                </div>

                <div id="loginCodeStep" class="hidden space-y-3">
                    <input id="loginCode" type="text" inputmode="numeric" maxlength="4" placeholder="1234"
                           class="w-full text-center tracking-[0.4em] font-mono text-lg px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-stone-900 bg-white">
                    <button type="button" id="loginCodeBtn" onclick="loginVerify()"
                            class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition"><%= t('master_login_submit') %></button>
                </div>

                <p class="text-[11px] text-stone-400 text-center">
                    <a href="/join" class="hover:text-stone-700 underline"><%= t('become_provider_btn') %></a>
                </p>
            </div>
        <% } else { %>
            <h1 class="text-xl font-black tracking-tight text-stone-900"><%= t('master_status_headline') %></h1>

            <%
                const statusColor = master.is_banned ? 'border-l-red-500'
                    : master.is_active ? 'border-l-emerald-600' : 'border-l-amber-500';
                const leadsLeft = Math.floor(master.balance_tetri / leadPriceTetri);
            %>

            <div class="bg-white rounded-2xl shadow-xl border border-stone-200/80 border-l-4 <%= statusColor %> overflow-hidden">
                <div class="p-5 sm:p-6 space-y-4">
                    <% if (master.is_banned) { %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-red-50 text-red-700"><%= t('master_status_banned') %></span>
                    <% } else if (master.is_active) { %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700"><%= t('master_status_active') %></span>
                    <% } else { %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700"><%= t('master_status_pending') %></span>
                    <% } %>

                    <div>
                        <h2 class="font-extrabold text-stone-900 text-lg"><%= master.name %></h2>
                        <p class="text-xs text-stone-500">
                            <%= categoryLabels[master.category] || master.category %><% if (master.vehicle_type) { %> — <%= master.vehicle_type %><% } %>
                        </p>
                    </div>

                    <div class="bg-stone-900 text-white p-4 rounded-2xl space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-stone-300"><%= t('master_status_balance_label') %></span>
                            <span class="font-mono text-xl font-bold text-emerald-400"><%= (master.balance_tetri / 100).toFixed(2) %> GEL</span>
                        </div>
                        <div class="text-[11px] text-stone-400 text-right">
                            ≈ <span class="font-mono font-bold text-stone-200"><%= leadsLeft %></span> <%= t('master_status_leads_word') %>
                        </div>
                    </div>

                    <% if (master.is_banned) { %>
                        <div class="p-3.5 rounded-2xl bg-red-50 border border-red-200 text-sm text-red-800 font-medium">
                            <%= t('master_status_banned_hint') %><% if (master.banned_reason) { %> <span class="text-red-600">(<%= master.banned_reason %>)</span><% } %>
                        </div>
                    <% } else { %>
                        <% if (!master.is_active) { %>
                            <div class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200 text-sm text-amber-800 font-medium">
                                <%= t('master_status_pending_hint') %>
                            </div>
                        <% } %>

                        <details class="topup-box group rounded-2xl border border-stone-200 bg-stone-50 overflow-hidden" <%= master.is_active ? '' : 'open' %>>
                            <summary class="flex items-center justify-between gap-2 px-4 py-3 cursor-pointer text-sm font-bold text-stone-800">
                                <span class="flex items-center gap-2"><i class="fa-solid fa-building-columns text-emerald-600"></i><%= t('topup_title') %></span>
                                <i class="fa-solid fa-chevron-down text-[10px] text-stone-400 transition group-open:rotate-180"></i>
                            </summary>

                            <div class="px-4 pb-4 space-y-4 text-sm">
                                <p class="text-stone-600"><%= t('topup_intro') %></p>

                                <div class="bg-white rounded-xl border border-stone-200 divide-y divide-stone-100">
                                    <div class="flex items-center justify-between gap-3 px-3 py-2.5">
                                        <span class="text-xs text-stone-400 shrink-0"><%= t('topup_account_label') %></span>
                                        <span class="flex items-center gap-2 min-w-0">
                                            <span id="iban" class="font-mono font-bold text-stone-900 text-[13px] truncate"><%= payment.BANK_ACCOUNT %></span>
                                            <button type="button" id="ibanCopy" class="shrink-0 text-emerald-600 hover:text-emerald-700" aria-label="<%= t('topup_copy') %>"><i class="fa-regular fa-copy"></i></button>
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between gap-3 px-3 py-2.5">
                                        <span class="text-xs text-stone-400"><%= t('topup_bank_label') %></span>
                                        <span class="font-semibold text-stone-800"><%= payment.BANK_NAME %></span>
                                    </div>
                                    <div class="flex items-center justify-between gap-3 px-3 py-2.5">
                                        <span class="text-xs text-stone-400"><%= t('topup_recipient_label') %></span>
                                        <span class="font-semibold text-stone-800"><%= payment.RECIPIENT_NAME %></span>
                                    </div>
                                    <div class="flex items-center justify-between gap-3 px-3 py-2.5">
                                        <span class="text-xs text-stone-400"><%= t('topup_min_label') %></span>
                                        <span class="font-semibold text-stone-800"><%= payment.MIN_TOPUP_GEL %> GEL</span>
                                    </div>
                                </div>

                                <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-2.5 flex items-start gap-2">
                                    <i class="fa-solid fa-circle-info mt-0.5 shrink-0"></i><span><%= t('topup_purpose_note') %></span>
                                </p>

                                <div class="space-y-2.5">
                                    <div>
                                        <p class="font-bold text-stone-800 text-[11px] uppercase tracking-wide mb-1"><i class="fa-solid fa-mobile-screen text-stone-400 mr-1"></i><%= t('topup_method_app_title') %></p>
                                        <p class="text-xs text-stone-600 leading-snug"><%= t('topup_method_app_text') %></p>
                                    </div>
                                    <div>
                                        <p class="font-bold text-stone-800 text-[11px] uppercase tracking-wide mb-1"><i class="fa-solid fa-building-columns text-stone-400 mr-1"></i><%= t('topup_method_other_title') %></p>
                                        <p class="text-xs text-stone-600 leading-snug"><%= t('topup_method_other_text') %></p>
                                    </div>
                                </div>

                                <div class="border-t border-stone-200 pt-3 space-y-2">
                                    <p class="text-xs text-stone-500 leading-snug"><%= t('topup_receipt_note') %></p>
                                    <form id="receiptForm" class="flex flex-col gap-2">
                                        <label class="flex items-center justify-center gap-2 py-2.5 rounded-xl border border-dashed border-stone-300 bg-white text-xs font-bold text-stone-600 cursor-pointer hover:border-emerald-400 transition">
                                            <i class="fa-solid fa-paperclip"></i><span id="receiptName"><%= t('topup_receipt_choose') %></span>
                                            <input type="file" id="receiptFile" accept="image/*,application/pdf" class="hidden">
                                        </label>
                                        <button type="submit" id="receiptSubmit" disabled
                                                class="py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-sm font-bold transition"><%= t('topup_receipt_send') %></button>
                                        <p id="receiptMsg" class="hidden text-xs font-bold"></p>
                                    </form>
                                </div>
                            </div>
                        </details>
                    <% } %>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-5 sm:p-6">
                <h2 class="text-sm font-extrabold text-stone-900 uppercase tracking-wide mb-3"><%= t('master_status_reviews_title') %></h2>
                <% if (!reviews.length) { %>
                    <p class="text-sm text-stone-400"><%= t('master_status_reviews_none') %></p>
                <% } else { %>
                    <%
                        const avg = (reviews.reduce((s, r) => s + r.rating, 0) / reviews.length).toFixed(1);
                    %>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-amber-500 text-sm"><i class="fa-solid fa-star text-xs"></i></span>
                        <span class="font-bold text-stone-900"><%= avg %></span>
                        <span class="text-xs text-stone-400"><%= reviews.length %></span>
                    </div>
                    <div class="space-y-2">
                        <% reviews.forEach(function (rv) { %>
                            <div class="bg-stone-50 border border-stone-100 rounded-xl p-3">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-[11px] tracking-tight text-amber-500"><%= '★'.repeat(rv.rating) %><span class="text-stone-300"><%= '★'.repeat(5 - rv.rating) %></span></span>
                                    <span class="text-[10px] text-stone-400"><%= new Date(rv.created_at).toLocaleDateString(reviewLocale, { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                </div>
                                <% if (rv.comment) { %>
                                    <p class="text-xs text-stone-700 leading-snug mt-1.5"><%= rv.comment %></p>
                                <% } %>
                                <p class="text-[10px] font-semibold text-stone-400 mt-1.5"><%= t('reviews_author') %></p>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-5 sm:p-6">
                <h2 class="text-sm font-extrabold text-stone-900 uppercase tracking-wide mb-3"><%= t('master_status_activity_title') %></h2>
                <% if (activity && activity.totalCount > 0) { %>
                    <div class="space-y-2 text-sm">
                        <% if (activity.avgSeconds !== null) { %>
                            <div class="flex items-center justify-between">
                                <span class="text-stone-500"><%= t('master_status_response_avg') %></span>
                                <span class="font-bold text-stone-900"><%= Math.max(1, Math.round(activity.avgSeconds / 60)) %> <%= t('master_status_minutes_short') %></span>
                            </div>
                        <% } %>
                        <div class="flex items-center justify-between">
                            <span class="text-stone-500"><%= t('master_status_responded') %></span>
                            <span class="font-bold text-stone-900"><%= activity.respondedCount %> / <%= activity.totalCount %></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-stone-500"><%= t('master_status_leads_30d') %></span>
                            <span class="font-bold text-stone-900"><%= activity.leads30d %></span>
                        </div>
                    </div>
                <% } else { %>
                    <p class="text-sm text-stone-400"><%= t('master_status_response_none') %></p>
                <% } %>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-5 sm:p-6">
                <h2 class="text-sm font-extrabold text-stone-900 uppercase tracking-wide mb-3"><%= t('master_status_history_title') %></h2>
                <% if (!history.length) { %>
                    <p class="text-sm text-stone-400"><%= t('master_status_history_none') %></p>
                <% } else { %>
                    <div class="divide-y divide-stone-100">
                        <% history.forEach(function (h) { %>
                            <div class="flex items-center justify-between gap-3 py-2 text-sm">
                                <div class="min-w-0">
                                    <div class="text-stone-700"><%= historyReason(h.reason) %><% if (h.note) { %> <span class="text-stone-400">— <%= h.note %></span><% } %></div>
                                    <div class="text-[10px] text-stone-400 font-mono"><%= new Date(h.created_at).toLocaleDateString(reviewLocale, { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                </div>
                                <span class="font-mono font-bold shrink-0 <%= h.amount_tetri >= 0 ? 'text-emerald-700' : 'text-red-600' %>">
                                    <%= h.amount_tetri >= 0 ? '+' : '−' %><%= (Math.abs(h.amount_tetri) / 100).toFixed(2) %> ₾
                                </span>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-5 sm:p-6">
                <h2 class="text-sm font-extrabold text-stone-900 uppercase tracking-wide mb-1"><%= t('master_status_profile_title') %></h2>
                <p class="text-[11px] text-stone-400 mb-3"><%= t('master_status_profile_hint') %></p>
                <div class="space-y-2 text-sm">
                    <div class="flex items-start justify-between gap-3">
                        <span class="text-stone-500"><%= t('master_status_category_label') %></span>
                        <span class="font-semibold text-stone-800 text-right"><%= categoryLabels[master.category] || master.category %></span>
                    </div>
                    <% if (master.vehicle_type) { %>
                        <div class="flex items-start justify-between gap-3">
                            <span class="text-stone-500">—</span>
                            <span class="font-semibold text-stone-800 text-right"><%= master.vehicle_type %></span>
                        </div>
                    <% } %>
                    <% if (master.price_text) { %>
                        <div class="flex items-start justify-between gap-3">
                            <span class="text-stone-500"><%= t('master_status_price_label') %></span>
                            <span class="font-mono font-bold text-stone-900 text-right"><%= master.price_text %></span>
                        </div>
                    <% } %>
                    <% if (master.description) { %>
                        <p class="text-xs text-stone-600 leading-snug pt-1 border-t border-stone-100"><%= master.description %></p>
                    <% } %>
                </div>
            </div>
        <% } %>
    </main>

    <% if (!master) { %>
    <script>
        (function () {
            var MSG = document.getElementById('loginMsg');
            var phoneStep = document.getElementById('loginPhoneStep');
            var codeStep = document.getElementById('loginCodeStep');
            var phoneInput = document.getElementById('loginPhone');
            var codeInput = document.getElementById('loginCode');
            var phoneBtn = document.getElementById('loginPhoneBtn');
            var codeBtn = document.getElementById('loginCodeBtn');
            var T = {
                empty_phone: <%- JSON.stringify(t('js_err_empty_phone')) %>,
                empty_code: <%- JSON.stringify(t('js_err_empty_code')) %>,
                sent: <%- JSON.stringify(t('js_ok_code_sent')) %>,
                send_err: <%- JSON.stringify(t('js_err_send_code')) %>,
                wrong_code: <%- JSON.stringify(t('js_err_wrong_code')) %>,
                not_registered: <%- JSON.stringify(t('master_login_not_registered')) %>,
            };

            function msg(text, isError) {
                if (!text) { MSG.classList.add('hidden'); return; }
                MSG.classList.remove('hidden');
                MSG.textContent = text;
                MSG.className = 'text-xs font-bold p-3 rounded-xl ' + (isError
                    ? 'bg-red-50 text-red-700 border border-red-200'
                    : 'bg-emerald-50 text-emerald-700 border border-emerald-200');
            }

            window.loginRequestCode = function () {
                var phone = phoneInput.value.trim();
                if (!phone) return msg(T.empty_phone, true);
                phoneBtn.disabled = true;
                fetch('/api/master/login/request-code', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: phone }),
                }).then(function (r) { return r.json().then(function (d) { return { status: r.status, d: d }; }); })
                  .then(function (res) {
                      phoneBtn.disabled = false;
                      if (res.d.success) { msg(T.sent, false); phoneStep.classList.add('hidden'); codeStep.classList.remove('hidden'); }
                      else if (res.status === 404) { msg(T.not_registered, true); }
                      else { msg(res.d.message || T.send_err, true); }
                  }).catch(function () { phoneBtn.disabled = false; msg(T.send_err, true); });
            };

            window.loginVerify = function () {
                var phone = phoneInput.value.trim();
                var code = codeInput.value.trim();
                if (!code) return msg(T.empty_code, true);
                codeBtn.disabled = true;
                fetch('/api/master/login/verify', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: phone, code: code }),
                }).then(function (r) { return r.json(); })
                  .then(function (d) {
                      if (d.success && d.link) { window.location = d.link; return; }
                      codeBtn.disabled = false;
                      msg(d.message || T.wrong_code, true);
                  }).catch(function () { codeBtn.disabled = false; msg(T.wrong_code, true); });
            };
        })();
    </script>
    <% } %>

    <% if (master && !master.is_banned) { %>
    <script>
        (function () {
            var ibanCopy = document.getElementById('ibanCopy');
            if (ibanCopy) {
                ibanCopy.addEventListener('click', function () {
                    var iban = document.getElementById('iban').textContent.trim();
                    if (!navigator.clipboard) return;
                    navigator.clipboard.writeText(iban).then(function () {
                        var orig = ibanCopy.innerHTML;
                        ibanCopy.innerHTML = '<i class="fa-solid fa-check"></i>';
                        setTimeout(function () { ibanCopy.innerHTML = orig; }, 1500);
                    });
                });
            }

            var form = document.getElementById('receiptForm');
            if (!form) return;
            var file = document.getElementById('receiptFile');
            var nameEl = document.getElementById('receiptName');
            var submit = document.getElementById('receiptSubmit');
            var msg = document.getElementById('receiptMsg');
            var CHOOSE = <%- JSON.stringify(t('topup_receipt_choose')) %>;
            var SENT = <%- JSON.stringify(t('topup_receipt_sent')) %>;
            var ERR = <%- JSON.stringify(t('topup_receipt_error')) %>;

            file.addEventListener('change', function () {
                if (file.files.length) { nameEl.textContent = file.files[0].name; submit.disabled = false; }
                else { nameEl.textContent = CHOOSE; submit.disabled = true; }
            });

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!file.files.length) return;
                submit.disabled = true;
                msg.classList.add('hidden');
                var fd = new FormData();
                fd.append('receipt', file.files[0]);
                fetch('/api/master/<%= master.master_token %>/topup-receipt', { method: 'POST', body: fd })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        msg.classList.remove('hidden');
                        if (d.success) {
                            msg.className = 'text-xs font-bold text-emerald-700';
                            msg.textContent = SENT;
                            form.reset();
                            nameEl.textContent = CHOOSE;
                        } else {
                            msg.className = 'text-xs font-bold text-red-600';
                            msg.textContent = ERR;
                            submit.disabled = false;
                        }
                    })
                    .catch(function () {
                        msg.classList.remove('hidden');
                        msg.className = 'text-xs font-bold text-red-600';
                        msg.textContent = ERR;
                        submit.disabled = false;
                    });
            });
        })();
    </script>
    <% } %>
</body>
</html>

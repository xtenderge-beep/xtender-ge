<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('master_status_page_title') %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'],
                        mono: ['IBM Plex Mono', 'Noto Sans Georgian', 'ui-monospace', 'monospace'],
                    },
                }
            }
        }
    </script>
    <style>
        .lang-btn.active { background: #fff; color: #1c1917; font-weight: 800; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
    </style>
</head>
<body class="font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

    <header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
        <div class="max-w-xl mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center gap-2">
                    <span class="text-xl font-black tracking-tight text-stone-900">xtender<span class="text-emerald-600">.ge</span></span>
                </a>
                <div class="flex bg-stone-100 p-1 rounded-xl text-xs font-bold border border-stone-200">
                    <a href="/lang/ka" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ka' ? 'active' : 'hover:bg-white/50' %>">GE</a>
                    <a href="/lang/ru" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ru' ? 'active' : 'hover:bg-white/50' %>">RU</a>
                    <a href="/lang/en" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'en' ? 'active' : 'hover:bg-white/50' %>">EN</a>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-xl mx-auto px-4 py-8">
        <% if (!master) { %>
            <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm p-6 text-center text-sm text-stone-500 font-medium">
                <%= t('master_status_not_found') %>
            </div>
        <% } else { %>
            <h1 class="text-xl font-black tracking-tight text-stone-900"><%= t('master_status_headline') %></h1>

            <div class="mt-4 bg-white rounded-2xl shadow-xl border border-stone-200/80 border-l-4 <%= master.is_active ? 'border-l-emerald-600' : 'border-l-amber-500' %> overflow-hidden">
                <div class="p-5 sm:p-6 space-y-4">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold <%= master.is_active ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                        <%= master.is_active ? t('master_status_active') : t('master_status_pending') %>
                    </span>

                    <div>
                        <h2 class="font-extrabold text-stone-900 text-lg"><%= master.name %></h2>
                        <p class="text-xs text-stone-500"><%= t('master_status_category_label') %>: <%= master.category %><% if (master.vehicle_type) { %> — <%= master.vehicle_type %><% } %></p>
                    </div>

                    <div class="bg-stone-900 text-white p-4 rounded-2xl flex items-center justify-between">
                        <span class="text-xs font-bold text-stone-300"><%= t('master_status_balance_label') %></span>
                        <span class="font-mono text-xl font-bold text-emerald-400"><%= (master.balance_tetri / 100).toFixed(2) %> GEL</span>
                    </div>

                    <p class="text-xs text-stone-500"><%= t('master_status_topup_hint') %><span class="font-mono text-stone-700">@xtendergebot</span></p>
                </div>
            </div>
        <% } %>
    </main>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
  <%- include('partials/head', { title: t('review_page_title'), noindex: true }) %>
</head>
<body class="font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

  <header class="bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm">
    <div class="max-w-xl mx-auto px-4">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2">
          <%- include('partials/brand') %>
        </a>
        <%- include('partials/lang-switch') %>
      </div>
    </div>
  </header>

  <main class="max-w-xl mx-auto px-4 py-8">

    <% if (!order) { %>
      <div class="bg-white rounded-2xl shadow-xl border border-stone-200/80 p-6 text-center">
          <p class="text-stone-700 font-semibold"><%= t('review_order_not_found') %></p>
      </div>
    <% } else if (!masters.length) { %>
      <div class="bg-white rounded-2xl shadow-xl border border-stone-200/80 p-6 text-center">
          <p class="text-stone-700 font-semibold"><%= t('review_no_masters') %></p>
      </div>
    <% } else { %>
      <h1 class="text-xl font-black tracking-tight text-stone-900"><%= t('review_headline') %></h1>
      <p class="text-sm text-stone-500 mt-1"><%= t('review_intro') %></p>

      <div class="mt-5 space-y-4">
          <% masters.forEach(function (m) { %>
            <div class="bg-white rounded-2xl shadow-xl border border-stone-200/80 p-5" data-master-card="<%= m.id %>">
                <h3 class="font-extrabold text-stone-900"><%= m.name %></h3>

                <% if (m.review_id) { %>
                  <p class="mt-2 text-sm text-emerald-700 font-semibold"><i class="fa-solid fa-circle-check"></i> <%= t('review_already_submitted') %></p>
                <% } else { %>
                  <div class="mt-3 flex gap-1 text-2xl" data-stars data-master-id="<%= m.id %>">
                      <% [1,2,3,4,5].forEach(function (n) { %>
                        <button type="button" class="star-btn" data-star="<%= n %>"><i class="fa-solid fa-star"></i></button>
                      <% }); %>
                  </div>
                  <textarea data-comment rows="2" placeholder="<%= t('review_comment_placeholder') %>"
                      class="mt-3 w-full text-sm border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500 resize-none"></textarea>
                  <button type="button" data-submit class="mt-3 px-4 py-2.5 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition">
                      <%= t('review_submit_btn') %>
                  </button>
                  <p data-status class="mt-2 text-sm font-semibold hidden"></p>
                <% } %>
            </div>
          <% }); %>
      </div>
    <% } %>

  </main>

  <script>
    const OWNER_TOKEN = <%- JSON.stringify(order ? order.owner_token : null) %>;
    const T = <%- JSON.stringify(clientStrings) %>;

    document.querySelectorAll('[data-master-card]').forEach((card) => {
      const starsWrap = card.querySelector('[data-stars]');
      if (!starsWrap) return;

      const masterId = starsWrap.dataset.masterId;
      const starBtns = Array.from(starsWrap.querySelectorAll('.star-btn'));
      let selected = 0;

      function paint(upTo) {
        starBtns.forEach((btn) => {
          btn.classList.toggle('selected', Number(btn.dataset.star) <= upTo);
        });
      }

      starBtns.forEach((btn) => {
        btn.addEventListener('mouseenter', () => paint(Number(btn.dataset.star)));
        btn.addEventListener('mouseleave', () => paint(selected));
        btn.addEventListener('click', () => {
          selected = Number(btn.dataset.star);
          paint(selected);
        });
      });

      const submitBtn = card.querySelector('[data-submit]');
      const statusEl = card.querySelector('[data-status]');
      const commentEl = card.querySelector('[data-comment]');

      submitBtn.addEventListener('click', async () => {
        if (!selected) return;
        submitBtn.disabled = true;
        try {
          const res = await fetch('/api/reviews', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ownerToken: OWNER_TOKEN,
              masterId: masterId,
              rating: selected,
              comment: commentEl.value,
            }),
          });
          const data = await res.json();
          if (data.success) {
            starsWrap.remove();
            commentEl.remove();
            submitBtn.remove();
            statusEl.textContent = T.review_thanks || 'Спасибо!';
            statusEl.classList.remove('hidden');
            statusEl.classList.add('text-emerald-700');
          } else {
            statusEl.textContent = data.message || 'Error';
            statusEl.classList.remove('hidden');
            statusEl.classList.add('text-red-600');
            submitBtn.disabled = false;
          }
        } catch (err) {
          submitBtn.disabled = false;
        }
      });
    });
  </script>

</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= t('review_page_title') %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'] },
        }
      }
    }
  </script>
  <style>
    .lang-btn.active { background: #fff; color: #0f172a; font-weight: 800; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
    .star-btn { color: #cbd5e1; transition: color 0.15s; }
    .star-btn.selected, .star-btn.hovered { color: #f59e0b; }
  </style>
</head>
<body class="font-sans text-slate-800 bg-slate-50 min-h-screen antialiased">

  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-xl mx-auto px-4">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-slate-900">xtender<span class="text-emerald-600">.ge</span></span>
        </a>
        <div class="flex bg-slate-100 p-1 rounded-xl text-xs font-bold border border-slate-200">
          <a href="/lang/ka" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ka' ? 'active' : 'hover:bg-white/50' %>">GE</a>
          <a href="/lang/ru" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'ru' ? 'active' : 'hover:bg-white/50' %>">RU</a>
          <a href="/lang/en" class="lang-btn px-2.5 py-1 rounded-lg transition <%= lang === 'en' ? 'active' : 'hover:bg-white/50' %>">EN</a>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-xl mx-auto px-4 py-8">

    <% if (!order) { %>
      <div class="bg-white rounded-2xl shadow-xl border border-slate-200/80 p-6 text-center">
          <p class="text-slate-700 font-semibold"><%= t('review_order_not_found') %></p>
      </div>
    <% } else if (!masters.length) { %>
      <div class="bg-white rounded-2xl shadow-xl border border-slate-200/80 p-6 text-center">
          <p class="text-slate-700 font-semibold"><%= t('review_no_masters') %></p>
      </div>
    <% } else { %>
      <h1 class="text-xl font-black tracking-tight text-slate-900"><%= t('review_headline') %></h1>
      <p class="text-sm text-slate-500 mt-1"><%= t('review_intro') %></p>

      <div class="mt-5 space-y-4">
          <% masters.forEach(function (m) { %>
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200/80 p-5" data-master-card="<%= m.id %>">
                <h3 class="font-extrabold text-slate-900"><%= m.name %></h3>

                <% if (m.review_id) { %>
                  <p class="mt-2 text-sm text-emerald-700 font-semibold"><i class="fa-solid fa-circle-check"></i> <%= t('review_already_submitted') %></p>
                <% } else { %>
                  <div class="mt-3 flex gap-1 text-2xl" data-stars data-master-id="<%= m.id %>">
                      <% [1,2,3,4,5].forEach(function (n) { %>
                        <button type="button" class="star-btn" data-star="<%= n %>"><i class="fa-solid fa-star"></i></button>
                      <% }); %>
                  </div>
                  <textarea data-comment rows="2" placeholder="<%= t('review_comment_placeholder') %>"
                      class="mt-3 w-full text-sm border border-slate-200 rounded-xl p-3 outline-none focus:border-emerald-500 resize-none"></textarea>
                  <button type="button" data-submit class="mt-3 px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-sm font-bold rounded-xl transition">
                      <%= t('review_submit_btn') %>
                  </button>
                  <p data-status class="mt-2 text-sm font-semibold hidden"></p>
                <% } %>
            </div>
          <% }); %>
      </div>
    <% } %>

  </main>

  <script>
    const OWNER_TOKEN = <%- JSON.stringify(order ? order.owner_token : null) %>;
    const T = <%- JSON.stringify(clientStrings) %>;

    document.querySelectorAll('[data-master-card]').forEach((card) => {
      const starsWrap = card.querySelector('[data-stars]');
      if (!starsWrap) return;

      const masterId = starsWrap.dataset.masterId;
      const starBtns = Array.from(starsWrap.querySelectorAll('.star-btn'));
      let selected = 0;

      function paint(upTo) {
        starBtns.forEach((btn) => {
          btn.classList.toggle('selected', Number(btn.dataset.star) <= upTo);
        });
      }

      starBtns.forEach((btn) => {
        btn.addEventListener('mouseenter', () => paint(Number(btn.dataset.star)));
        btn.addEventListener('mouseleave', () => paint(selected));
        btn.addEventListener('click', () => {
          selected = Number(btn.dataset.star);
          paint(selected);
        });
      });

      const submitBtn = card.querySelector('[data-submit]');
      const statusEl = card.querySelector('[data-status]');
      const commentEl = card.querySelector('[data-comment]');

      submitBtn.addEventListener('click', async () => {
        if (!selected) return;
        submitBtn.disabled = true;
        try {
          const res = await fetch('/api/reviews', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ownerToken: OWNER_TOKEN,
              masterId: masterId,
              rating: selected,
              comment: commentEl.value,
            }),
          });
          const data = await res.json();
          if (data.success) {
            starsWrap.remove();
            commentEl.remove();
            submitBtn.remove();
            statusEl.textContent = T.review_thanks || 'Спасибо!';
            statusEl.classList.remove('hidden');
            statusEl.classList.add('text-emerald-700');
          } else {
            statusEl.textContent = data.message || 'Error';
            statusEl.classList.remove('hidden');
            statusEl.classList.add('text-red-600');
            submitBtn.disabled = false;
          }
        } catch (err) {
          submitBtn.disabled = false;
        }
      });
    });
  </script>

</body>
</html>

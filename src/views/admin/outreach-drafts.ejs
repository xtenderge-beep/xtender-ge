<%- include('./_header', { active: 'outreach' }) %>
<% const fmt = d => d ? new Date(d).toLocaleString('ru', { timeZone: 'Asia/Tbilisi', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'; %>
<% const day = d => d ? new Date(d).toLocaleDateString('ru', { timeZone: 'Asia/Tbilisi' }) : '—'; %>

<a href="/admin/outreach" class="text-sm font-bold text-stone-500 hover:text-stone-900">&larr; рассылки</a>
<h1 class="text-2xl font-black text-stone-900 mt-2 mb-1">Анкеты от бота</h1>
<p class="text-sm text-stone-500 mb-5">Бот владельца создаёт черновик анкеты и сам отправляет исполнителю ссылку. Исполнитель проверяет анкету, ставит галочки и подтверждает кодом из SMS сайта — дальше обычная модерация. Ссылка живёт <%= ttlDays %> дней, потом анкета стирается. Бесплатно — <%= freeDays %> дней от подтверждения. Описание API — docs/outreach-bot-drafts.md.</p>

<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-5">
    <% [['Создано черновиков', stats.created], ['Открыли ссылку', stats.opened], ['Подтвердили', stats.confirmed], ['В каталоге', stats.active],
        ['Не интересно', stats.declined], ['Просили не писать', stats.opted_out], ['Ссылка истекла', stats.expired], ['Бесплатный период кончается за 14 дней', stats.free_ending]].forEach(([label, n]) => { %>
    <div class="bg-white rounded-2xl border border-stone-200 p-3">
        <div class="text-2xl font-black text-stone-900"><%= n %></div>
        <div class="text-xs font-bold text-stone-500"><%= label %></div>
    </div>
    <% }); %>
</div>
<p class="text-xs text-stone-400 -mt-3 mb-5">Без проб бота (test: true).</p>

<form method="GET" action="/admin/outreach/drafts" class="flex flex-wrap items-end gap-2 mb-4">
    <label class="text-sm"><span class="block text-xs font-bold text-stone-500">Источник</span>
        <select name="source" class="border border-stone-200 rounded-xl px-3 py-2 bg-white">
            <option value="">все</option>
            <% sources.forEach(s => { %><option value="<%= s %>" <%= filter.source === s ? 'selected' : '' %>><%= s %></option><% }); %>
        </select>
    </label>
    <label class="text-sm"><span class="block text-xs font-bold text-stone-500">Статус</span>
        <select name="status" class="border border-stone-200 rounded-xl px-3 py-2 bg-white">
            <option value="">все</option>
            <% statuses.forEach(s => { %><option value="<%= s %>" <%= filter.status === s ? 'selected' : '' %>><%= labels[s] %></option><% }); %>
        </select>
    </label>
    <button class="px-4 py-2 bg-stone-900 text-white text-sm font-bold rounded-xl">Показать</button>
</form>

<% if (!rows.length) { %>
    <p class="text-sm text-stone-500 mb-6">Пока пусто.</p>
<% } else { %>
<div class="overflow-x-auto bg-white rounded-2xl border border-stone-200 mb-6">
    <table class="w-full text-sm">
        <thead class="text-left text-xs text-stone-500 border-b border-stone-200">
            <tr><th class="p-2">Телефон</th><th class="p-2">Статус</th><th class="p-2">Источник</th><th class="p-2">Создан</th><th class="p-2">Открыл</th><th class="p-2">Подтвердил</th><th class="p-2">Бесплатно до</th><th class="p-2">Профиль</th></tr>
        </thead>
        <tbody>
        <% rows.forEach(r => { const soon = r.free_until && new Date(r.free_until) - Date.now() < 14 * 864e5; %>
            <tr class="border-b border-stone-100 align-top">
                <td class="p-2 font-mono whitespace-nowrap"><%= r.phone %><% if (r.is_test) { %> <span class="text-[10px] font-bold text-violet-700 bg-violet-50 border border-violet-200 rounded-full px-1.5">проба</span><% } %></td>
                <td class="p-2"><%= labels[r.current] || r.current %><% if (r.reason) { %><span class="block text-xs text-stone-400"><%= r.reason %></span><% } %></td>
                <td class="p-2 text-xs"><%= r.source || '—' %><% if (r.external_id) { %><span class="block text-stone-400"><%= r.external_id %></span><% } %></td>
                <td class="p-2 text-xs whitespace-nowrap"><%= fmt(r.created_at) %></td>
                <td class="p-2 text-xs whitespace-nowrap"><%= fmt(r.opened_at) %></td>
                <td class="p-2 text-xs whitespace-nowrap"><%= fmt(r.confirmed_at) %></td>
                <td class="p-2 text-xs whitespace-nowrap <%= soon ? 'font-bold text-amber-700' : '' %>"><%= day(r.free_until) %></td>
                <td class="p-2 text-xs"><% if (r.master_id && r.master_name !== null) { %><a class="text-emerald-700 font-bold underline" href="/admin/masters/<%= r.master_id %>">#<%= r.master_id %> <%= r.master_name %></a><% } else { %>—<% } %></td>
            </tr>
        <% }); %>
        </tbody>
    </table>
</div>
<% } %>

<section class="bg-white rounded-2xl border border-stone-200 p-4">
    <h2 class="font-extrabold text-stone-900">Ключ API для бота</h2>
    <% if (newKey) { %>
        <p class="text-sm text-stone-700 mt-2">Новый ключ — скопируйте сейчас, второй раз он не покажется. Прежний ключ больше не работает.</p>
        <p class="mt-2 p-3 rounded-xl bg-stone-100 font-mono text-sm break-all select-all"><%= newKey %></p>
        <p class="text-xs text-stone-500 mt-2">Бот передаёт его в заголовке <code>Authorization: Bearer …</code>. В адрес запроса и в код страниц ключ не кладите.</p>
    <% } else { %>
        <p class="text-sm text-stone-600 mt-1"><%= keyInfo.issuedAt ? 'Ключ выпущен ' + fmt(keyInfo.issuedAt) + '.' : 'Ключ ещё не выпущен.' %><%= keyInfo.env ? ' Есть и запасной ключ в переменной OUTREACH_API_KEY.' : '' %></p>
    <% } %>
    <form method="POST" action="/admin/outreach/drafts/key" class="mt-3 flex flex-wrap items-center gap-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="text-sm flex items-center gap-2"><input type="checkbox" name="confirm" value="yes" required> прежний ключ перестанет работать</label>
        <button class="px-4 py-2 bg-stone-900 text-white text-sm font-bold rounded-xl"><%= keyInfo.issuedAt ? 'Выпустить новый ключ' : 'Выпустить ключ' %></button>
    </form>
</section>

<%- include('./_footer') %>

<!DOCTYPE html>
<html lang="ru" class="h-full bg-stone-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>xtender.ge — Вход в админку</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans bg-stone-100 min-h-screen flex items-center justify-center">

    <form method="POST" action="/admin/login" class="bg-white rounded-2xl shadow-xl border border-stone-200 p-8 w-full max-w-sm space-y-4">
        <h1 class="text-xl font-black text-stone-900">xtender.ge — Админка</h1>

        <% if (error) { %>
          <p class="text-sm text-red-600 font-semibold bg-red-50 border border-red-200 rounded-lg px-3 py-2"><%= error %></p>
        <% } %>

        <div>
            <label class="text-xs font-bold text-stone-500 uppercase tracking-wide">Пароль</label>
            <input type="password" name="password" required autofocus
                class="mt-1 w-full border border-stone-300 rounded-xl px-3 py-2.5 outline-none focus:border-emerald-500">
        </div>

        <button type="submit" class="w-full py-2.5 bg-stone-900 hover:bg-stone-800 text-white font-bold rounded-xl transition">
            Войти
        </button>
    </form>

</body>
</html>

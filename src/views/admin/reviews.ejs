<%- include('./_header', { active: 'reviews' }) %>

<h1 class="text-2xl font-black text-stone-900 mb-5">Отзывы на модерации (<%= pending.length %>)</h1>

<% if (!pending.length) { %>
  <p class="text-sm text-stone-500">Очередь пуста.</p>
<% } %>

<div class="space-y-3">
    <% pending.forEach(function (r) { %>
      <div class="bg-white rounded-2xl border border-stone-200 p-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
              <a href="/admin/masters/<%= r.master_id %>" class="font-extrabold text-stone-900 hover:text-emerald-700"><%= r.master_name %></a>
              <span class="font-mono text-xs text-amber-600 font-bold"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %></span>
          </div>
          <p class="text-xs text-stone-500 mt-1">По заявке: <%= r.order_description %></p>
          <% if (r.comment) { %>
            <p class="text-sm text-stone-700 mt-2 italic">«<%= r.comment %>»</p>
          <% } %>
          <p class="text-[11px] text-stone-400 mt-2"><%= new Date(r.created_at).toLocaleString('ru') %></p>
          <div class="mt-3 flex gap-2">
              <form method="POST" action="/admin/reviews/<%= r.id %>/approve">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition">Одобрить</button>
              </form>
              <form method="POST" action="/admin/reviews/<%= r.id %>/reject">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="px-3 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-bold rounded-xl transition">Отклонить</button>
              </form>
          </div>
      </div>
    <% }); %>
</div>

<%- include('./_footer') %>

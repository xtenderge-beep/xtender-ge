<%- include('./_header', { active: 'outreach' }) %>

<%
    const s = stats;
    const draft = !campaign.sent_at;
    const when = d => d ? new Date(d).toLocaleString('ru', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
    const langLabel = { ka: 'ქართ.', ru: 'рус.', en: 'eng.' };
    const filters = [['all', 'Все', s.total], ['unseen', 'Не открыли', s.sent - s.seen], ['seen', 'Открыли', s.seen],
                     ['waiting', 'Открыли, не ответили', rows.filter(r => r.seen_at && !r.reply).length], ['replied', 'Ответили', s.replied],
                     ['failed', 'Ошибки', rows.filter(r => r.status === 'failed' || r.sms_status === 'failed').length]];
    const visible = rows.filter(function (r) {
        if (filter === 'seen') return r.seen_at;
        if (filter === 'unseen') return r.status === 'sent' && !r.seen_at;
        if (filter === 'waiting') return r.seen_at && !r.reply;
        if (filter === 'replied') return r.reply;
        if (filter === 'failed') return r.status === 'failed' || r.sms_status === 'failed';
        return true;
    });
%>

<a href="/admin/outreach" class="text-sm font-bold text-stone-500 hover:text-stone-900">&larr; все рассылки</a>
<div class="flex items-center justify-between flex-wrap gap-2 mt-2 mb-4">
    <h1 class="text-2xl font-black text-stone-900"><%= campaign.title %></h1>
    <% if (draft) { %>
        <span class="text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2.5 py-1">черновик — ничего не отправлено</span>
    <% } else { %>
        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-2.5 py-1">отправлена <%= when(campaign.sent_at) %></span>
    <% } %>
</div>

<% if (error) { %><p class="mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-sm font-bold text-red-700"><%= error %></p><% } %>
<% if (notice) { %><p class="mb-4 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-sm font-bold text-emerald-800"><%= notice %></p><% } %>

<div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-4">
    <% [['Получателей', s.total], ['Ушло в кабинет', s.sent], ['SMS принято шлюзом', s.smsAccepted, s.smsFailed ? 'ошибок: ' + s.smsFailed : ''], ['Открыли', s.seen], ['Ответили', s.replied]].forEach(function (tile, i) { %>
        <div class="bg-white rounded-2xl border border-stone-200 p-3 <%= i === 4 ? 'col-span-2 sm:col-span-1' : '' %>">
            <div class="text-[11px] font-bold text-stone-400 uppercase tracking-wide leading-tight"><%= tile[0] %></div>
            <div class="text-xl font-black text-stone-900 mt-0.5"><%= tile[1] %></div>
            <% if (tile[2]) { %><div class="text-[11px] font-bold text-red-600"><%= tile[2] %></div><% } %>
        </div>
    <% }); %>
</div>
<p class="text-[11px] text-stone-400 mb-5">
    «SMS принято шлюзом» — шлюз взял сообщение; дошло ли оно до телефона, шлюз нам не сообщает.
    «Открыл» — вопрос был показан исполнителю первым на экране кабинета. «Ответил» — его первое сообщение в поддержке после рассылки.
</p>

<div class="bg-white rounded-2xl border border-stone-200 p-4 sm:p-5 mb-5 space-y-4">
    <form method="POST" action="/admin/outreach/<%= campaign.id %>/sms" class="space-y-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <span class="block text-sm font-bold text-stone-800">SMS-уведомление (латиницей, до 160 знаков)</span>
        <textarea name="smsText" rows="3" maxlength="160" <%= draft ? '' : 'disabled' %>
                  class="w-full text-sm font-mono break-all resize-none bg-stone-50 border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500 focus:bg-white disabled:text-stone-600"><%= campaign.sms_text %></textarea>
        <% if (draft) { %><button class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-800 text-sm font-bold rounded-xl">Сохранить SMS</button><% } %>
    </form>
    <form method="POST" action="/admin/outreach/<%= campaign.id %>/test" class="space-y-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <span class="block text-sm font-bold text-stone-800">Пробное SMS на номер</span>
        <div class="flex gap-2">
            <input name="phone" inputmode="tel" placeholder="5XX XXX XXX" class="flex-1 min-w-0 sm:flex-none sm:w-48 text-sm bg-stone-50 border border-stone-200 rounded-xl p-2.5 outline-none focus:border-emerald-500 focus:bg-white">
            <button class="shrink-0 px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-800 text-sm font-bold rounded-xl">Отправить пробу</button>
        </div>
    </form>
    <% if (draft) { %>
        <form method="POST" action="/admin/outreach/<%= campaign.id %>/send" class="border-t border-stone-100 pt-4 flex gap-3 flex-wrap items-center">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="flex items-center gap-2 text-sm text-stone-700">
                <input type="checkbox" name="confirm" value="yes" class="w-4 h-4"> Проверил тексты и пробное SMS
            </label>
            <button class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl">Отправить <%= s.draft %> получателям</button>
        </form>
    <% } %>
</div>

<div class="flex gap-1.5 flex-wrap mb-3">
    <% filters.forEach(function (f) { %>
        <a href="?show=<%= f[0] %>" class="text-xs font-bold rounded-full px-3 py-1.5 border <%= filter === f[0] ? 'bg-stone-900 text-white border-stone-900' : 'bg-white text-stone-600 border-stone-200 hover:border-stone-400' %>"><%= f[1] %> · <%= f[2] %></a>
    <% }); %>
</div>

<div class="space-y-2">
    <% if (!visible.length) { %><p class="text-sm text-stone-500">Здесь пусто.</p><% } %>
    <% visible.forEach(function (r) { %>
        <div id="r<%= r.id %>" class="bg-white rounded-2xl border <%= r.status === 'skipped' ? 'border-stone-200 opacity-50' : r.reply ? 'border-emerald-300' : 'border-stone-200' %> p-4">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <span class="font-extrabold text-stone-900">
                    <a href="/admin/masters/<%= r.master_id %>" class="hover:underline">#<%= r.master_id %> · <%= r.name %></a>
                    <span class="text-xs font-semibold text-stone-400"><%= langLabel[r.language] || r.language %> · <%= r.is_active ? 'одобрен' : 'на модерации' %></span>
                </span>
                <span class="flex items-center gap-1.5 flex-wrap text-[11px] font-bold">
                    <% if (r.status === 'skipped') { %><span class="px-2 py-0.5 rounded-full bg-stone-100 text-stone-500">убран из рассылки</span><% } %>
                    <% if (r.status === 'draft') { %><span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">ждёт отправки</span><% } %>
                    <% if (r.status === 'failed') { %><span class="px-2 py-0.5 rounded-full bg-red-50 text-red-700 border border-red-200">не отправлено</span><% } %>
                    <% if (r.sent_at) { %>
                        <span class="px-2 py-0.5 rounded-full bg-stone-100 text-stone-700">Кабинет ✓ <%= when(r.sent_at) %></span>
                        <% if (r.sms_status === 'off') { %><span class="px-2 py-0.5 rounded-full bg-stone-50 text-stone-400">без SMS</span><% } else { %><span class="px-2 py-0.5 rounded-full <%= r.sms_status === 'accepted' ? 'bg-stone-100 text-stone-700' : 'bg-red-50 text-red-700 border border-red-200' %>">SMS <%= r.sms_status === 'accepted' ? '✓ принято' : r.sms_status === 'failed' ? '✗ ошибка' : '…' %></span><% } %>
                        <% if (r.telegram_id) { %><span class="px-2 py-0.5 rounded-full <%= r.telegram_sent ? 'bg-sky-50 text-sky-700' : 'bg-red-50 text-red-700' %>">Telegram <%= r.telegram_sent ? '✓' : '✗' %></span><% } %>
                        <span class="px-2 py-0.5 rounded-full <%= r.seen_at ? 'bg-sky-50 text-sky-700 border border-sky-200' : 'bg-stone-50 text-stone-400' %>"><%= r.seen_at ? 'Открыл ' + when(r.seen_at) : 'Не открыл' %></span>
                        <span class="px-2 py-0.5 rounded-full <%= r.reply ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-stone-50 text-stone-400' %>"><%= r.reply ? 'Ответил ' + when(r.reply.created_at) : 'Нет ответа' %></span>
                    <% } %>
                </span>
            </div>
            <% if (r.sms_error) { %><p class="text-[11px] text-red-600 mt-1">Ошибка: <%= r.sms_error %></p><% } %>

            <% if (r.status === 'draft' || r.status === 'skipped') { %>
                <form method="POST" action="/admin/outreach/<%= campaign.id %>/items/<%= r.id %>" class="mt-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="anchor" value="r<%= r.id %>">
                    <textarea name="body" rows="5" maxlength="2000" data-autosize class="w-full resize-none overflow-hidden text-sm text-stone-800 bg-stone-50 border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500 focus:bg-white"><%= r.body %></textarea>
                    <div class="flex gap-2 mt-1.5">
                        <button class="px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-bold rounded-lg">Сохранить текст</button>
                        <button formaction="/admin/outreach/<%= campaign.id %>/items/<%= r.id %>/skip" name="skipped" value="<%= r.status === 'skipped' ? '0' : '1' %>"
                                class="px-3 py-1.5 bg-white border border-stone-200 hover:border-stone-400 text-stone-600 text-xs font-bold rounded-lg"><%= r.status === 'skipped' ? 'Вернуть в рассылку' : 'Убрать из рассылки' %></button>
                    </div>
                </form>
            <% } else { %>
                <details class="mt-2">
                    <summary class="text-xs font-bold text-stone-500 cursor-pointer">Что отправили</summary>
                    <p class="text-sm text-stone-700 whitespace-pre-wrap break-words mt-1.5 bg-stone-50 rounded-xl p-3"><%= r.body %></p>
                </details>
            <% } %>

            <% if (r.reply) { %>
                <div class="mt-2 bg-emerald-50 rounded-xl p-3">
                    <p class="text-sm text-stone-800 whitespace-pre-wrap break-words"><%= r.reply.body %></p>
                    <a href="/admin/support/<%= r.master_id %>" class="text-xs font-bold text-emerald-700 hover:underline">открыть переписку и ответить &rarr;</a>
                </div>
            <% } %>
        </div>
    <% }); %>
</div>

<script>
    // Текст получателя виден целиком: поле растягивается под содержимое (и при правке, и при смене ширины экрана).
    (function () {
        var fields = document.querySelectorAll('textarea[data-autosize]');
        function fit(el) { el.style.height = 'auto'; el.style.height = (el.scrollHeight + 2) + 'px'; }
        fields.forEach(function (el) { fit(el); el.addEventListener('input', function () { fit(el); }); });
        window.addEventListener('resize', function () { fields.forEach(fit); });
    })();
</script>

<%- include('./_footer') %>

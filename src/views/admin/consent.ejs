<%- include('./_header', { active: 'consent' }) %>

<%
  const EVENT_META = {
    PROVIDER_BILLING_ACCEPTED: { label: 'Тарифы приняты', cls: 'bg-emerald-100 text-emerald-800' },
    LEAD_CHARGE_ACCEPTED: { label: 'Списание за уведомление', cls: 'bg-sky-100 text-sky-800' },
    CATALOG_CHARGE_ACCEPTED: { label: 'Списание за каталог', cls: 'bg-sky-100 text-sky-800' },
    ORDER_CONTACT_RELEASED: { label: 'Контакт выдан', cls: 'bg-sky-100 text-sky-800' },
    ORDER_CONTACT_DENIED: { label: 'В выдаче контакта отказано', cls: 'bg-stone-100 text-stone-600' },
    SMS_SEND_FAILED: { label: 'Отправка SMS не подтверждена', cls: 'bg-stone-100 text-stone-600' },
    CLIENT_CONSENT_OTP_VERIFIED: { label: 'Согласие клиента подтверждено', cls: 'bg-emerald-100 text-emerald-800' },
    MASTER_REGISTERED: { label: 'Профиль создан / обновлён', cls: 'bg-sky-100 text-sky-800' },
    ORDER_PUBLISHED: { label: 'Заявка опубликована', cls: 'bg-sky-100 text-sky-800' },
    ORDER_DETAILS_RECORDED: { label: 'Содержание заявки', cls: 'bg-sky-100 text-sky-800' },
    ORDER_CLOSED: { label: 'Заявка закрыта', cls: 'bg-stone-100 text-stone-600' },
    CONTACT_SHARING_WITHDRAWN: { label: 'Передача контактов прекращена', cls: 'bg-stone-100 text-stone-600' },
    CONSENT_SMS_OTP_VERIFIED: { label: 'Согласие специалиста подтверждено', cls: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
    AUTH_SMS_OTP_VERIFIED:    { label: 'Подтверждение · вход',    cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    ORDER_SMS_OTP_VERIFIED:   { label: 'Подтверждение · заявка',  cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    REVIEW_SMS_OTP_VERIFIED:  { label: 'Подтверждение · отзыв',   cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    SMS_OTP_SENT:             { label: 'Код отправлен',           cls: 'bg-stone-100 text-stone-600 border-stone-200' },
    LEAD_SMS_SENT:            { label: 'Лид-SMS',                 cls: 'bg-stone-100 text-stone-600 border-stone-200' },
    TX_SMS_SENT:              { label: 'SMS',                     cls: 'bg-stone-100 text-stone-600 border-stone-200' },
    LEAD_SMS_OPT_OUT:         { label: 'Отказ от заявок',         cls: 'bg-stone-100 text-stone-600 border-stone-200' },
    LEAD_SMS_OPT_IN:          { label: 'Согласие на заявки',      cls: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
    MARKETING_SMS_OPT_IN:     { label: 'Согласие на предложения', cls: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
    MARKETING_SMS_OPT_OUT:    { label: 'Отказ от предложений',    cls: 'bg-stone-100 text-stone-600 border-stone-200' },
    LEAD_SMS_PAUSED:          { label: 'Пауза SMS о заявках',     cls: 'bg-amber-100 text-amber-800 border-amber-200' },
    LEAD_SMS_RESUMED:         { label: 'Пауза снята кодом',       cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    LEAD_RESUME_OTP_VERIFIED: { label: 'Подтверждение · снятие паузы', cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    PHONE_CHANGED:            { label: 'Номер установлен',        cls: 'bg-amber-100 text-amber-800 border-amber-200' },
    PHONE_REPLACED:           { label: 'Номер заменён другим',    cls: 'bg-amber-100 text-amber-800 border-amber-200' },
  };
  function evtBadge(type, metadata) {
    const m = EVENT_META[type] || { label: type, cls: 'bg-stone-100 text-stone-600 border-stone-200' };
    const label = type === 'MASTER_REGISTERED' && metadata && ['created','updated'].includes(metadata.profile_action)
      ? (metadata.profile_action === 'created' ? 'Профиль создан' : 'Профиль обновлён') : m.label;
    return `<span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded border ${m.cls}">${label}</span>`;
  }
  const fmt = (d) => d ? new Date(d).toLocaleString('ru', { timeZone: 'UTC' }) : '—';
  const short = (s, n) => !s ? '—' : (String(s).length > n ? String(s).slice(0, n) + '…' : String(s));
%>

<div class="flex items-center justify-between flex-wrap gap-2">
  <h1 class="text-xl font-black text-stone-900">Согласия и действия пользователей</h1>
  <% if (phoneQuery) { %>
    <a href="/admin/consent" class="text-xs font-bold text-stone-500 hover:text-stone-800">&larr; весь список</a>
  <% } %>
</div>
<p class="text-sm text-stone-500 mt-1">
  Double Opt-In: момент подтверждения кода (IP, User-Agent, версия оферты, текст согласия) + каждая отправленная транзакционная SMS.
  Записи неизменяемы. Поиск — по любому формату номера.
  Каждая строка — отдельное событие, а не новый пользователь. Подтверждение согласия не означает завершённую регистрацию.
  Профиль показан по текущему совпадению номера; он мог появиться позже события. Для старых событий создания / обновления точный тип может быть неизвестен.
</p>

<form method="GET" action="/admin/consent" class="mt-4 flex flex-wrap items-center gap-2">
  <input type="text" name="phone" value="<%= phoneQuery %>" placeholder="+9955XXXXXXXX или 5XXXXXXXX"
         class="border border-stone-300 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500 w-64">
  <button type="submit" class="px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition">Найти</button>
  <% if (phoneQuery && report && !report.error) { %>
    <a href="/admin/consent/export?phone=<%= encodeURIComponent(phoneQuery) %>"
       class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl transition">
      Скачать пакет доказательств (JSON)
    </a>
  <% } %>
</form>

<% if (phoneQuery && report) { %>

  <% if (report.error) { %>
    <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5 text-sm text-stone-600">
      <% if (report.error === 'invalid_phone') { %>
        Не похоже на номер телефона.
      <% } else { %>
        <%= report.error %>
      <% } %>
    </div>
  <% } else { %>

    <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-500 uppercase">Номер</div>
      <div class="text-lg font-black text-stone-900 font-mono"><%= report.query.phone %></div>
      <div class="text-xs text-stone-500 mt-1">
        Совпадения по форматам: <%= (report.query.matched_phone_formats || []).join(', ') %> · событий: <b><%= report.event_count %></b>
      </div>

      <% if (report.subject.profiles.length) { %>
        <div class="mt-3 pt-3 border-t border-stone-100">
          <div class="text-xs font-bold text-stone-500 uppercase mb-1">Профиль исполнителя</div>
          <% report.subject.profiles.forEach(function (p) { %>
            <div class="text-sm text-stone-700">
              <a href="/admin/masters/<%= p.id %>" class="font-bold text-emerald-700 hover:underline"><%= p.name %></a>
              · <%= p.category %>
              · <%= p.is_active ? 'активен' : 'на модерации' %><%= p.is_banned ? ' · забанен' : '' %>
              · регистрация <%= fmt(p.created_at) %>
              <% if (p.terms_accepted_at) { %> · <span class="text-stone-500">terms_accepted_at <%= fmt(p.terms_accepted_at) %></span><% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <% if (report.provider_evidence) { const evidence = report.provider_evidence; %>
      <section class="mt-4 bg-white rounded-2xl border border-stone-200 p-5 space-y-2">
        <h2 class="text-sm font-bold">Доказательства по исполнителю</h2>
        <p class="text-sm">Принятия тарифов: <b><%= evidence.billing_acceptance_events.length %></b> · операций баланса: <b><%= evidence.transactions.length %></b> · событий выдачи контакта: <b><%= evidence.contact_events.length %></b></p>
        <p class="text-xs text-stone-500">В JSON включены тарифные согласия, списания, результаты отправок и хронология закрытия заявок. Принятие сообщения шлюзом не доказывает доставку на телефон. Выдача контакта не доказывает звонок.</p>
        <details><summary class="text-sm font-bold cursor-pointer">Хронология событий (<%= evidence.timeline.length %>)</summary>
          <div class="overflow-x-auto"><table class="w-full text-xs mt-2"><thead><tr><th class="text-left">Время UTC</th><th class="text-left">Событие</th><th class="text-left">Заявка</th><th class="text-left">Запись</th></tr></thead><tbody>
            <% evidence.timeline.forEach(event => { %><tr><td class="py-2"><%= new Date(event.timestamp_utc).toISOString() %></td><td><%= (EVENT_META[event.event_type] || {}).label || event.event_type %></td><td><%= event.order_id || '—' %></td><td><%= event.id %></td></tr><% }); %>
          </tbody></table></div>
        </details>
      </section>
    <% } %>
    <% var oi = report.subject.double_opt_in || {}; %>
    <% if (oi.status === 'VERIFIED') { %>
      <div class="mt-4 bg-emerald-50 rounded-2xl border border-emerald-200 p-5">
        <div class="text-xs font-extrabold text-emerald-800 uppercase mb-2">Double Opt-In — явное согласие на SMS подтверждено</div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
          <div><dt class="text-stone-500 text-xs font-bold uppercase">Дата (UTC)</dt><dd class="font-mono"><%= oi.verified_at_utc %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">Версия оферты / политики</dt><dd class="font-mono"><%= oi.terms_version || '—' %> / <%= oi.privacy_version || '—' %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">IP</dt><dd class="font-mono"><%= oi.ip_address || '—' %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">Язык</dt><dd class="font-mono"><%= oi.consent_language || '—' %></dd></div>
          <div class="sm:col-span-2"><dt class="text-stone-500 text-xs font-bold uppercase">User-Agent</dt><dd class="font-mono text-xs break-all"><%= oi.user_agent || '—' %></dd></div>
          <div class="sm:col-span-2"><dt class="text-stone-500 text-xs font-bold uppercase">X-Forwarded-For</dt><dd class="font-mono text-xs break-all"><%= oi.x_forwarded_for || '—' %></dd></div>
          <div class="sm:col-span-2"><dt class="text-stone-500 text-xs font-bold uppercase">Текст согласия (снимок)</dt><dd class="text-stone-700"><%= oi.consent_text_shown || '—' %></dd></div>
          <% if (oi.terms_scroll_confirmed !== null) { %>
          <div class="sm:col-span-2"><dt class="text-stone-500 text-xs font-bold uppercase">Прокрутка Оферты до конца перед принятием</dt><dd class="font-mono"><%= oi.terms_scroll_confirmed ? ('Да · ' + fmt(oi.terms_scroll_confirmed_at)) : 'Нет' %></dd></div>
          <% } %>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">ID у SMS-шлюза</dt><dd class="font-mono text-xs"><%= oi.otp_reference_id || '—' %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">SHA-256 кода</dt><dd class="font-mono text-xs break-all"><%= oi.otp_code_sha256 || '—' %></dd></div>
        </dl>
      </div>
    <% } else { %>
      <div class="mt-4 bg-amber-50 rounded-2xl border border-amber-200 p-4 text-sm text-amber-800">
        <div class="font-extrabold uppercase text-xs mb-1">Double Opt-In: <%= oi.status || 'NO_RECORD' %></div>
        <p><%= oi.note || 'По этому номеру нет строки CONSENT_SMS_OTP_VERIFIED.' %></p>
        <% if (oi.latest_phone_verification) { %>
          <p class="mt-1 text-xs">
            Последняя верификация номера: <b><%= oi.latest_phone_verification.event_type %></b>
            · <%= oi.latest_phone_verification.at_utc %>
            · IP <%= oi.latest_phone_verification.ip_address || '—' %>
          </p>
        <% } %>
      </div>
    <% } %>

    <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-500 uppercase mb-3">Все события (<%= report.events.length %>)</div>
      <% if (!report.events.length) { %>
        <p class="text-sm text-stone-500">Событий по этому номеру нет.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[10px] uppercase text-stone-400 border-b border-stone-200">
                <th class="py-1.5 pr-3">Время (UTC)</th>
                <th class="py-1.5 pr-3">Событие</th>
                <th class="py-1.5 pr-3">purpose</th>
                <th class="py-1.5 pr-3">IP</th>
                <th class="py-1.5 pr-3">ID шлюза</th>
                <th class="py-1.5 pr-3">SHA-256</th>
              </tr>
            </thead>
            <tbody>
              <% report.events.forEach(function (e) { %>
                <tr class="border-b border-stone-100 align-top">
                  <td class="py-1.5 pr-3 font-mono text-xs whitespace-nowrap"><%= e.timestamp_utc %></td>
                  <td class="py-1.5 pr-3"><%- evtBadge(e.event_type, e.metadata) %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs"><%= e.purpose || '—' %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs"><%= e.ip_address || '—' %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs"><%= short(e.otp_reference_id, 18) %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs" title="<%= e.otp_code_hash || e.message_body_hash || '' %>"><%= short(e.otp_code_hash || e.message_body_hash, 12) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  <% } %>

<% } else { %>

  <% if (typeof leadGate !== 'undefined' && leadGate) { %>
    <div id="lead-gate" class="mt-4 bg-white rounded-2xl border border-stone-200 p-5" style="scroll-margin-top:110px">
      <div class="text-xs font-bold text-stone-500 uppercase mb-2">Заявки только с согласием</div>
      <p class="text-sm text-stone-600">Когда включено, заявки по SMS и в Telegram получают только исполнители, у которых в журнале есть подтверждённое согласие: код на странице регистрации.</p>
      <ul class="text-sm text-stone-900 mt-2">
        <li class="py-0.5">Подписаны на заявки: <b><%= leadGate.total %></b><% if (leadGate.telegram) { %>, из них с Telegram: <%= leadGate.telegram %> (заявка приходит в Telegram, SMS — если Telegram её не принял)<% } %><% if (leadGate.paused) { %>; SMS на паузе после двух неоткрытых заявок: <%= leadGate.paused %><% } %>.</li>
        <li class="py-0.5">Согласие на предложения Xtender: <b><%= leadGate.marketing || 0 %></b>.</li>
        <li class="py-0.5">С записью согласия: <b><%= leadGate.consented %></b><% if (leadGate.versions.length) { %>; версия показанного текста: <%= leadGate.versions.map(function (v) { return v.version + ' — ' + v.count; }).join(', ') %><% } %>.</li>
        <li class="py-0.5">Без записи согласия: <b><%= leadGate.missing.length %></b><% if (leadGate.reasons.length) { %>: <%= leadGate.reasons.map(function (r) { return r.label + ' — ' + r.count; }).join('; ') %><% } %><% if (leadGate.required && leadGate.missing.length) { %>. Им заявки сейчас не отправляются<% } %>.</li>
      </ul>
      <% if (leadGate.journalStart) { %><p class="text-xs text-stone-500 mt-1">Журнал согласий ведётся с <%= fmt(leadGate.journalStart) %> (UTC).</p><% } %>
      <form method="POST" action="/admin/consent/lead-gate" class="mt-3 flex flex-wrap items-center gap-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="enabled" value="<%= leadGate.required ? '0' : '1' %>">
        <span class="text-sm text-stone-700">Сейчас: <b class="<%= leadGate.required ? 'text-emerald-700' : 'text-stone-900' %>"><%= leadGate.required ? 'включено' : 'выключено' %></b></span>
        <button type="submit" class="px-4 py-2.5 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition"><%= leadGate.required ? 'Выключить' : 'Включить' %></button>
      </form>
      <% if (!leadGate.required && leadGate.missing.length) { %>
        <p class="text-xs text-amber-700 mt-2">После включения эти исполнители перестанут получать заявки, пока не подтвердят согласие.</p>
      <% } %>
      <% if (leadGate.missing.length) { %>
        <details class="mt-3">
          <summary class="text-sm font-bold cursor-pointer text-stone-700">Без записи согласия: <%= leadGate.missing.length %></summary>
          <ul class="mt-2 text-sm">
            <% leadGate.missing.forEach(function (m) { %>
              <li class="py-0.5"><a href="/admin/masters/<%= m.id %>" class="text-stone-800 hover:underline">#<%= m.id %> <%= m.name %></a> · <a href="/admin/consent?phone=<%= encodeURIComponent(m.phone) %>" class="font-mono text-emerald-700 hover:underline"><%= m.phone %></a> · с <%= fmt(m.created_at) %> · <%= m.reasonLabel %></li>
            <% }); %>
          </ul>
        </details>
      <% } %>
    </div>
  <% } %>

  <% if (typeof chain !== 'undefined' && chain) { %>
    <div id="journal-chain" class="mt-4 bg-white rounded-2xl border border-stone-200 p-5" style="scroll-margin-top:110px">
      <div class="text-xs font-bold text-stone-500 uppercase mb-2">Целостность журнала</div>
      <p class="text-sm text-stone-600">Каждая запись журнала получает отпечаток, зависящий от предыдущей: изменённая или удалённая запись ломает цепочку. Раз в сутки отпечаток уходит в Telegram модератора — это копия вне базы.</p>
      <p class="text-sm text-stone-900 mt-2">В цепочке: <b><%= chain.chained %></b> из <%= chain.logs %> записей<% if (chain.lastAnchor) { %>; последний отпечаток <%= fmt(chain.lastAnchor.created_at) %> (UTC)<%= chain.lastAnchor.sent_to ? ', отправлен в Telegram' : ', в Telegram не отправлен' %><% } else { %>; отпечатков ещё не было<% } %>.</p>
      <% if (typeof chainCheck !== 'undefined' && chainCheck) { %>
        <p class="text-sm mt-2 font-bold <%= chainCheck.ok ? 'text-emerald-700' : 'text-red-600' %>"><%= chainCheck.ok ? 'Проверено: цепочка цела, звеньев ' + chainCheck.checked + '.' : 'Цепочка нарушена: проблем ' + chainCheck.problems + ' из ' + chainCheck.checked + ' звеньев. Подробности — в журнале сервера.' %><% if (chainCheck.unchained) { %> Ещё не в цепочке: <%= chainCheck.unchained %>.<% } %></p>
      <% } %>
      <form method="POST" action="/admin/consent/verify-chain" class="mt-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="px-4 py-2.5 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition">Проверить сейчас</button>
      </form>
    </div>
  <% } %>

  <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
    <div class="text-xs font-bold text-stone-500 uppercase mb-3">Последние подтверждения и действия</div>
    <% if (!recent.length) { %>
      <p class="text-sm text-stone-500">Пока пусто — журнал ведётся с момента деплоя этой функции.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-[10px] uppercase text-stone-400 border-b border-stone-200">
              <th class="py-1.5 pr-3">Время (UTC)</th>
              <th class="py-1.5 pr-3">Событие</th>
              <th class="py-1.5 pr-3">Номер</th>
              <th class="py-1.5 pr-3">Текущий профиль по номеру</th>
              <th class="py-1.5 pr-3">Оферта</th>
              <th class="py-1.5 pr-3">IP</th>
            </tr>
          </thead>
          <tbody>
            <% recent.forEach(function (r) { %>
              <tr class="border-b border-stone-100">
                <td class="py-1.5 pr-3 font-mono text-xs whitespace-nowrap"><%= fmt(r.timestamp_utc) %></td>
                <td class="py-1.5 pr-3"><%- evtBadge(r.event_type, r.metadata) %><div class="text-xs text-stone-500">Событие #<%= r.id %><% if (r.metadata && r.metadata.consent_log_id) { %> · Согласие #<%= r.metadata.consent_log_id %><% } %><% if (r.order_id) { %> · Заявка #<%= r.order_id %><% } %></div></td>
                <td class="py-1.5 pr-3">
                  <a href="/admin/consent?phone=<%= encodeURIComponent(r.phone_number) %>" class="font-mono text-emerald-700 hover:underline"><%= r.phone_number %></a>
                </td>
                <td class="py-1.5 pr-3">
                  <% if (r.master_id) { %>
                    <a href="/admin/masters/<%= r.master_id %>" class="text-stone-700 hover:underline"><%= r.master_name %></a>
                  <% } else { %>
                    <span class="text-stone-400">—</span>
                  <% } %>
                </td>
                <td class="py-1.5 pr-3 font-mono text-xs"><%= r.terms_version || '—' %></td>
                <td class="py-1.5 pr-3 font-mono text-xs"><%= r.ip_address || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<% } %>



<% if (report && report.events) { %><details class="mt-6 p-4 border rounded-xl"><summary class="font-bold cursor-pointer">Полные тексты согласий и история действий</summary><% report.events.filter(e => e.consent_text_snapshot || ['ORDER_CLOSED','CONTACT_SHARING_WITHDRAWN','ORDER_PUBLISHED','MASTER_REGISTERED','LEAD_SMS_OPT_OUT','LEAD_SMS_OPT_IN','MARKETING_SMS_OPT_IN','MARKETING_SMS_OPT_OUT','LEAD_SMS_PAUSED','LEAD_SMS_RESUMED','PHONE_CHANGED','PHONE_REPLACED'].includes(e.event_type)).forEach(e => { %><div class="mt-4"><h3 class="font-bold"><%= e.event_type %> · <%= fmt(e.timestamp_utc) %></h3><p class="whitespace-pre-wrap"><%= e.consent_text_snapshot || '' %></p><pre class="text-xs whitespace-pre-wrap break-all"><%= JSON.stringify(e.metadata, null, 2) %></pre></div><% }) %></details><% } %>


<%- include('./_header', { active: 'consent' }) %>

<%
  const EVENT_META = {
    CONSENT_SMS_OTP_VERIFIED: { label: 'Согласие · регистрация', cls: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
    AUTH_SMS_OTP_VERIFIED:    { label: 'Подтверждение · вход',    cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    ORDER_SMS_OTP_VERIFIED:   { label: 'Подтверждение · заявка',  cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    REVIEW_SMS_OTP_VERIFIED:  { label: 'Подтверждение · отзыв',   cls: 'bg-sky-100 text-sky-800 border-sky-200' },
    SMS_OTP_SENT:             { label: 'Код отправлен',           cls: 'bg-stone-100 text-stone-600 border-stone-200' },
    LEAD_SMS_SENT:            { label: 'Лид-SMS',                 cls: 'bg-stone-100 text-stone-600 border-stone-200' },
    TX_SMS_SENT:              { label: 'SMS',                     cls: 'bg-stone-100 text-stone-600 border-stone-200' },
  };
  function evtBadge(type) {
    const m = EVENT_META[type] || { label: type, cls: 'bg-stone-100 text-stone-600 border-stone-200' };
    return `<span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded border ${m.cls}">${m.label}</span>`;
  }
  const fmt = (d) => d ? new Date(d).toLocaleString('ru') : '—';
  const short = (s, n) => !s ? '—' : (String(s).length > n ? String(s).slice(0, n) + '…' : String(s));
%>

<div class="flex items-center justify-between flex-wrap gap-2">
  <h1 class="text-xl font-black text-stone-900">Журнал согласий на SMS</h1>
  <% if (phoneQuery) { %>
    <a href="/admin/consent" class="text-xs font-bold text-stone-500 hover:text-stone-800">&larr; весь список</a>
  <% } %>
</div>
<p class="text-sm text-stone-500 mt-1">
  Double Opt-In: момент подтверждения кода (IP, User-Agent, версия оферты, текст согласия) + каждая отправленная транзакционная SMS.
  Записи неизменяемы. Поиск — по любому формату номера.
</p>

<form method="GET" action="/admin/consent" class="mt-4 flex flex-wrap items-center gap-2">
  <input type="text" name="phone" value="<%= phoneQuery %>" placeholder="+9955XXXXXXXX или 5XXXXXXXX"
         class="border border-stone-300 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500 w-64">
  <button type="submit" class="px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition">Найти</button>
  <% if (phoneQuery && report && !report.error) { %>
    <a href="/admin/consent/export?phone=<%= encodeURIComponent(phoneQuery) %>"
       class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl transition">
      Скачать JSON (для регулятора)
    </a>
  <% } %>
</form>

<% if (phoneQuery && report) { %>

  <% if (report.error) { %>
    <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5 text-sm text-stone-600">
      <% if (report.error === 'invalid_phone') { %>
        Не похоже на номер телефона.
      <% } else { %>
        <%= report.error %>
      <% } %>
    </div>
  <% } else { %>

    <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-500 uppercase">Номер</div>
      <div class="text-lg font-black text-stone-900 font-mono"><%= report.query.phone %></div>
      <div class="text-xs text-stone-500 mt-1">
        Совпадения по форматам: <%= (report.query.matched_phone_formats || []).join(', ') %> · событий: <b><%= report.event_count %></b>
      </div>

      <% if (report.subject.profiles.length) { %>
        <div class="mt-3 pt-3 border-t border-stone-100">
          <div class="text-xs font-bold text-stone-500 uppercase mb-1">Профиль исполнителя</div>
          <% report.subject.profiles.forEach(function (p) { %>
            <div class="text-sm text-stone-700">
              <a href="/admin/masters/<%= p.id %>" class="font-bold text-emerald-700 hover:underline"><%= p.name %></a>
              · <%= p.category %>
              · <%= p.is_active ? 'активен' : 'на модерации' %><%= p.is_banned ? ' · забанен' : '' %>
              · регистрация <%= fmt(p.created_at) %>
              <% if (p.terms_accepted_at) { %> · <span class="text-stone-500">terms_accepted_at <%= fmt(p.terms_accepted_at) %></span><% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <% var oi = report.subject.double_opt_in || {}; %>
    <% if (oi.status === 'VERIFIED') { %>
      <div class="mt-4 bg-emerald-50 rounded-2xl border border-emerald-200 p-5">
        <div class="text-xs font-extrabold text-emerald-800 uppercase mb-2">Double Opt-In — явное согласие на SMS подтверждено</div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
          <div><dt class="text-stone-500 text-xs font-bold uppercase">Дата (UTC)</dt><dd class="font-mono"><%= oi.verified_at_utc %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">Версия оферты / политики</dt><dd class="font-mono"><%= oi.terms_version || '—' %> / <%= oi.privacy_version || '—' %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">IP</dt><dd class="font-mono"><%= oi.ip_address || '—' %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">Язык</dt><dd class="font-mono"><%= oi.consent_language || '—' %></dd></div>
          <div class="sm:col-span-2"><dt class="text-stone-500 text-xs font-bold uppercase">User-Agent</dt><dd class="font-mono text-xs break-all"><%= oi.user_agent || '—' %></dd></div>
          <div class="sm:col-span-2"><dt class="text-stone-500 text-xs font-bold uppercase">X-Forwarded-For</dt><dd class="font-mono text-xs break-all"><%= oi.x_forwarded_for || '—' %></dd></div>
          <div class="sm:col-span-2"><dt class="text-stone-500 text-xs font-bold uppercase">Текст согласия (снимок)</dt><dd class="text-stone-700"><%= oi.consent_text_shown || '—' %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">ID у SMS-шлюза</dt><dd class="font-mono text-xs"><%= oi.otp_reference_id || '—' %></dd></div>
          <div><dt class="text-stone-500 text-xs font-bold uppercase">SHA-256 кода</dt><dd class="font-mono text-xs break-all"><%= oi.otp_code_sha256 || '—' %></dd></div>
        </dl>
      </div>
    <% } else { %>
      <div class="mt-4 bg-amber-50 rounded-2xl border border-amber-200 p-4 text-sm text-amber-800">
        <div class="font-extrabold uppercase text-xs mb-1">Double Opt-In: <%= oi.status || 'NO_RECORD' %></div>
        <p><%= oi.note || 'По этому номеру нет строки CONSENT_SMS_OTP_VERIFIED.' %></p>
        <% if (oi.latest_phone_verification) { %>
          <p class="mt-1 text-xs">
            Последняя верификация номера: <b><%= oi.latest_phone_verification.event_type %></b>
            · <%= oi.latest_phone_verification.at_utc %>
            · IP <%= oi.latest_phone_verification.ip_address || '—' %>
          </p>
        <% } %>
      </div>
    <% } %>

    <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
      <div class="text-xs font-bold text-stone-500 uppercase mb-3">Все события (<%= report.events.length %>)</div>
      <% if (!report.events.length) { %>
        <p class="text-sm text-stone-500">Событий по этому номеру нет.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-[10px] uppercase text-stone-400 border-b border-stone-200">
                <th class="py-1.5 pr-3">Время (UTC)</th>
                <th class="py-1.5 pr-3">Событие</th>
                <th class="py-1.5 pr-3">purpose</th>
                <th class="py-1.5 pr-3">IP</th>
                <th class="py-1.5 pr-3">ID шлюза</th>
                <th class="py-1.5 pr-3">SHA-256</th>
              </tr>
            </thead>
            <tbody>
              <% report.events.forEach(function (e) { %>
                <tr class="border-b border-stone-100 align-top">
                  <td class="py-1.5 pr-3 font-mono text-xs whitespace-nowrap"><%= e.timestamp_utc %></td>
                  <td class="py-1.5 pr-3"><%- evtBadge(e.event_type) %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs"><%= e.purpose || '—' %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs"><%= e.ip_address || '—' %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs"><%= short(e.otp_reference_id, 18) %></td>
                  <td class="py-1.5 pr-3 font-mono text-xs" title="<%= e.otp_code_hash || e.message_body_hash || '' %>"><%= short(e.otp_code_hash || e.message_body_hash, 12) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  <% } %>

<% } else { %>

  <div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
    <div class="text-xs font-bold text-stone-500 uppercase mb-3">Последние подтверждённые согласия</div>
    <% if (!recent.length) { %>
      <p class="text-sm text-stone-500">Пока пусто — журнал ведётся с момента деплоя этой функции.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-[10px] uppercase text-stone-400 border-b border-stone-200">
              <th class="py-1.5 pr-3">Время (UTC)</th>
              <th class="py-1.5 pr-3">Событие</th>
              <th class="py-1.5 pr-3">Номер</th>
              <th class="py-1.5 pr-3">Профиль</th>
              <th class="py-1.5 pr-3">Оферта</th>
              <th class="py-1.5 pr-3">IP</th>
            </tr>
          </thead>
          <tbody>
            <% recent.forEach(function (r) { %>
              <tr class="border-b border-stone-100">
                <td class="py-1.5 pr-3 font-mono text-xs whitespace-nowrap"><%= r.timestamp_utc %></td>
                <td class="py-1.5 pr-3"><%- evtBadge(r.event_type) %></td>
                <td class="py-1.5 pr-3">
                  <a href="/admin/consent?phone=<%= encodeURIComponent(r.phone_number) %>" class="font-mono text-emerald-700 hover:underline"><%= r.phone_number %></a>
                </td>
                <td class="py-1.5 pr-3">
                  <% if (r.master_id) { %>
                    <a href="/admin/masters/<%= r.master_id %>" class="text-stone-700 hover:underline"><%= r.master_name %></a>
                  <% } else { %>
                    <span class="text-stone-400">—</span>
                  <% } %>
                </td>
                <td class="py-1.5 pr-3 font-mono text-xs"><%= r.terms_version || '—' %></td>
                <td class="py-1.5 pr-3 font-mono text-xs"><%= r.ip_address || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<% } %>

<%- include('./_footer') %>

<%- include('./_header', { active: 'masters' }) %>

<h1 class="text-2xl font-black text-stone-900 mb-5">Специалисты (<%= masters.length %>)</h1>

<%# Сводка по языкам: то, на чём строится решение «кому какую рассылку». Каждая плашка — фильтр списка. %>
<% const href = function (over) { const q = Object.assign({}, filter, over); const p = new URLSearchParams(); Object.keys(q).forEach(function (k) { if (q[k]) p.set(k, q[k]); }); const s = p.toString(); return '/admin/masters' + (s ? '?' + s : ''); }; %>
<% const chip = function (on) { return 'px-3 py-2 text-xs font-bold rounded-xl transition ' + (on ? 'bg-emerald-600 text-white' : 'bg-stone-100 hover:bg-stone-200 text-stone-700'); }; %>
<% const main = ['ru', 'ka', 'en']; %>
<% const spokenCodes = main.concat(Object.keys(languageNames).filter(function (c) { return main.indexOf(c) === -1 && languageSummary.spoken[c]; })); %>
<section class="bg-white rounded-2xl border border-stone-200 p-4 mb-4 space-y-3" aria-label="Языки исполнителей">
    <div>
        <p class="text-xs text-stone-500 mb-2">Говорят на языке (отмечено при регистрации)</p>
        <div class="flex flex-wrap gap-2">
            <% spokenCodes.forEach(function (code) { %>
                <a href="<%= href({ lang: filter.lang === code ? '' : code }) %>" class="<%= chip(filter.lang === code) %>"><%= languageNames[code] %> <b><%= languageSummary.spoken[code] || 0 %></b></a>
            <% }); %>
            <a href="<%= href({ lang: filter.lang === 'none' ? '' : 'none' }) %>" class="<%= chip(filter.lang === 'none') %>">Не указали <b><%= languageSummary.spokenNone %></b></a>
        </div>
    </div>
    <div>
        <p class="text-xs text-stone-500 mb-2">Регистрировались с сайта на языке</p>
        <div class="flex flex-wrap gap-2">
            <% main.forEach(function (code) { %>
                <a href="<%= href({ site: filter.site === code ? '' : code }) %>" class="<%= chip(filter.site === code) %>"><%= languageNames[code] %> <b><%= languageSummary.site[code] || 0 %></b></a>
            <% }); %>
            <a href="<%= href({ site: filter.site === 'none' ? '' : 'none' }) %>" class="<%= chip(filter.site === 'none') %>">Не записано <b><%= languageSummary.siteNone %></b></a>
        </div>
    </div>
    <p class="text-xs text-stone-500">Считаем <%= languageSummary.total %> исполнителей без 🧪 технических и забаненных. «Не записано» — те, кто зарегистрировался раньше, чем сайт начал запоминать язык.<% if (filter.lang || filter.site) { %> <a href="<%= href({ lang: '', site: '' }) %>" class="font-bold text-emerald-700 hover:text-emerald-800">Сбросить фильтр языка</a><% } %></p>
</section>

<div class="space-y-3">
    <% masters.forEach(function (m) { %>
      <div class="bg-white rounded-2xl border border-stone-200 p-4 flex flex-col sm:flex-row sm:items-center gap-3">
          <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                  <a href="/admin/masters/<%= m.id %>" class="font-extrabold text-stone-900 hover:text-emerald-700"><%= m.name %></a><% if(m.is_technical) { %><span class="text-amber-700 font-bold">🧪 Технический</span><% } %>
                  <span class="font-mono text-xs text-stone-500"><%= m.phone %></span>
                  <% if (m.is_banned) { %>
                    <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-red-100 text-red-700 border border-red-200">Забанен</span>
                  <% } else if (!m.is_active) { %>
                    <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200">На модерации</span>
                  <% } else { %>
                    <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200">Активен</span>
                  <% } %>
              </div>
              <p class="text-xs text-stone-500 mt-1">
                  <%= m.category_label || m.category || 'Категория не назначена' %><% if (m.vehicle_type) { %> — <%= m.vehicle_type %><% } %>
                  · рейтинг <%= m.rating %> (<%= m.review_count %>)
                  · баланс <b class="text-stone-800"><%= (m.balance_tetri / 100).toFixed(2) %> ₾</b>
                  · <%= m.last_topup_at ? 'пополнял ' + new Date(m.last_topup_at).toLocaleDateString('ru') : 'ни разу не пополнял' %>
              </p>
              <p class="text-xs text-stone-500 mt-1">
                  Говорит: <% if (m.spoken_languages.length) { %><b class="text-stone-800"><%= m.spoken_languages.map(function (c) { return languageNames[c] || c; }).join(', ') %></b><% } else { %>не указано<% } %>
                  · интерфейс при регистрации: <% if (m.registration_language) { %><b class="text-stone-800"><%= languageNames[m.registration_language] || m.registration_language %></b><% } else { %>не записан<% } %>
              </p>
          </div>
          <% if (!m.is_active && !m.is_banned) { %>
            <form method="POST" action="/admin/masters/<%= m.id %>/approve">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition">Одобрить</button>
            </form>
          <% } %>
          <a href="/admin/masters/<%= m.id %>" class="px-3 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-bold rounded-xl transition text-center">Детали</a>
      </div>
    <% }); %>
</div>

<%- include('./_footer') %>

<%- include('./_header', { active: 'managers' }) %>
<% const gel=n=>(Number(n)/100).toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2})+' ₾'; const date=v=>new Date(v).toLocaleString('ru-RU',{timeZone:'Asia/Tbilisi'}); %>
<style>.partner-scroll{overflow-x:auto}.partner-table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}.partner-table td,.partner-table th{padding:12px 9px;border-bottom:1px solid #e7e5e4;vertical-align:top}.partner-table a{color:#047857;text-decoration:underline}.partner-section{background:white;border:1px solid #e7e5e4;padding:20px;border-radius:16px;margin:20px 0}.partner-section h2{font-weight:800;font-size:18px}.partner-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}.partner-cards>div{background:#f5f5f4;padding:14px;border-radius:12px}.partner-cards strong{display:block;font-size:22px;margin-top:8px}.partner-note{font-size:12px;color:#57534e;line-height:1.6;margin:10px 0}.partner-section input,.partner-section textarea{border:1px solid #d6d3d1;padding:10px;border-radius:8px;max-width:100%}.partner-section button{background:#1c1917;color:white;padding:10px 14px;border-radius:8px}.partner-section label{display:block;margin:10px 0;font-size:13px}.partner-section label input{display:block}.partner-void{color:#78716c;text-decoration:line-through}</style>
<h1 class="text-2xl font-black">Выплаты менеджерам<% if(detail) { %> · <%= detail.name %><% } %></h1>
<form method="GET" class="mt-4 flex gap-3 items-center flex-wrap"><label>Месяц <input type="month" name="month" value="<%= report.month %>" required class="border border-stone-300 rounded-xl p-2"></label><% if(detail) { %><input type="hidden" name="manager" value="<%= detail.id %>"><% } %><button class="px-3 py-2 bg-stone-900 text-white rounded-xl">Показать</button><a href="/admin/partner-payouts?month=<%= report.month %>" class="text-emerald-700 underline">Все менеджеры</a></form>
<p class="partner-note">Месяцы по Тбилиси. Выплаты отражают зарегистрированные переводы на момент просмотра. Бонусы и ручные корректировки баланса исключены. Ставка фиксируется отдельно для каждого денежного пополнения; комиссия округляется до тетри.</p>
<% if(!detail) { %>
<section class="partner-section"><div class="partner-cards"><div>Начислено всем за месяц<strong><%= gel(report.rows.reduce((s,m)=>s+m.earned,0)) %></strong></div><div>Выплачено за месяц<strong><%= gel(report.rows.reduce((s,m)=>s+m.paid,0)) %></strong></div><div>Осталось с учётом старого долга<strong><%= gel(report.rows.reduce((s,m)=>s+m.due+m.previousDue,0)) %></strong></div></div></section>
<section class="partner-section"><div class="partner-scroll"><table class="partner-table"><thead><tr><th>Менеджер</th><th>Привлечено</th><th>Текущая ставка</th><th>Пополнения месяца</th><th>Начислено</th><th>Выплачено за месяц</th><th>Осталось за месяц</th><th>Долг прошлых месяцев</th></tr></thead><tbody><% report.rows.forEach(m=>{ %><tr><th><a href="/admin/partner-payouts?manager=<%= m.id %>&month=<%= report.month %>"><%= m.name %></a><% if(!m.is_active) { %><small> · выключен</small><% } %></th><td><%= m.providers.length %></td><td><%= m.commission_bps/100 %>%</td><td><%= gel(m.base) %><br><small><%= m.count %> операций</small></td><td><%= gel(m.earned) %></td><td><%= gel(m.paid) %></td><td><b><%= gel(m.due) %></b></td><td><%= gel(m.previousDue) %></td></tr><% }); %><% if(!report.rows.length) { %><tr><td colspan="8">Сначала добавьте менеджера в разделе «Менеджеры».</td></tr><% } %></tbody></table></div></section>
<% } else { %>
<p class="mt-3"><a href="/admin/managers/<%= detail.id %>" class="text-emerald-700 underline">Карточка менеджера: ссылка и настройка процента →</a></p>
<section class="partner-section"><div class="partner-cards"><div>Начислено за месяц<strong><%= gel(detail.earned) %></strong></div><div>Выплачено за месяц<strong><%= gel(detail.paid) %></strong></div><div>Осталось за месяц<strong><%= gel(detail.due) %></strong></div><div>Долг прошлых месяцев<strong><%= gel(detail.previousDue) %></strong></div></div><p class="partner-note">Чтобы погасить долг прошлого месяца, выберите этот месяц. Платёж относится к выбранному месяцу начисления, дата регистрации перевода хранится отдельно.</p></section>
<section class="partner-section"><h2>Зафиксировать выполненный перевод</h2><p class="partner-note">Это запись уже выполненной выплаты менеджеру. Кнопка не переводит деньги и не меняет баланс специалиста.</p>
<% if(detail.due>0) { %><form method="POST" action="/admin/managers/<%= detail.id %>/partner-payment"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= report.month %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><label>Сумма, ₾<input name="amount" type="number" step="0.01" min="0.01" max="<%= detail.due/100 %>" required></label><label>Номер перевода / подтверждение<input name="reference" minlength="3" maxlength="300" required style="width:100%"></label><button>Записать выплату за <%= report.month %></button></form><% } else { %><p>За этот месяц выплачивать нечего.</p><% } %></section>
<section class="partner-section"><h2>Начисления за <%= report.month %></h2><div class="partner-scroll"><table class="partner-table"><thead><tr><th>Дата</th><th>Специалист</th><th>Операция баланса</th><th>Пополнение</th><th>Ставка тогда</th><th>Комиссия</th></tr></thead><tbody><% detail.commissions.forEach(c=>{ %><tr><td><%= date(c.created_at) %></td><td><a href="/admin/masters/<%= c.master_id %>"><%= c.master_name || c.master_id %></a></td><td>#<%= c.transaction_id %></td><td><%= gel(c.base_tetri) %></td><td><%= c.rate_bps/100 %>%</td><td><%= gel(c.amount_tetri) %></td></tr><% }); %><% if(!detail.commissions.length) { %><tr><td colspan="6">Начислений за этот месяц нет. Старые пополнения автоматически не пересчитываются.</td></tr><% } %></tbody></table></div></section>
<section class="partner-section"><h2>Выплаты за выбранный месяц</h2><% detail.payments.forEach(p=>{ %><div style="padding:12px 0;border-bottom:1px solid #e7e5e4"><p class="<%= p.voided_at ? 'partner-void' : '' %>">#<%= p.id %> · <%= date(p.paid_at) %> · <b><%= gel(p.amount_tetri) %></b> · <%= p.reference %></p><% if(p.voided_at) { %><p class="partner-note">Запись отменена <%= date(p.voided_at) %>: <%= p.void_reason %></p><% } else { %><details><summary class="partner-note">Исправить ошибочно записанную выплату</summary><p class="partner-note">Отмена записи восстановит долг. Банковский перевод не возвращается.</p><form method="POST" action="/admin/managers/<%= detail.id %>/partner-payment/<%= p.id %>/void"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= report.month %>"><label>Причина<input name="reason" minlength="5" maxlength="1000" required style="width:100%"></label><button>Отменить запись выплаты</button></form></details><% } %></div><% }); %><% if(!detail.payments.length) { %><p class="partner-note">Выплаты ещё не записаны.</p><% } %></section>
<section class="partner-section"><h2>Привлечённые специалисты — <%= detail.providers.length %></h2><div class="partner-scroll"><table class="partner-table"><thead><tr><th>Специалист</th><th>Закреплён</th><th>Баланс сейчас</th><th>Ответственный менеджер, ID</th></tr></thead><tbody><% detail.providers.forEach(p=>{ %><tr><td><a href="/admin/masters/<%= p.id %>"><%= p.name %></a><br><%= p.phone %></td><td><%= date(p.referral_bound_at) %></td><td><%= gel(p.balance_tetri) %></td><td><%= p.manager_id || 'Не назначен' %></td></tr><% }); %></tbody></table></div></section>
<% } %>
<%- include('./_footer') %>

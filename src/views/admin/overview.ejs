<%- include('./_header', { active: 'overview' }) %>
<style>
.dash-heading,.dash-section-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.dash-heading{margin-bottom:16px}.dash-heading h1{font-size:26px;font-weight:900}.dash-section-heading{margin:22px 0 12px}.dash-section-heading h2,.dash-panel h2{font-size:18px;font-weight:800}.dash-section-heading>span,.dash-note,.dash-card small{font-size:12px;color:#57534e}.dash-periods{display:flex;gap:6px}.dash-periods a,.dash-refresh{padding:8px 12px;border:1px solid #d6d3d1;border-radius:9px;background:white;font-size:13px;font-weight:700}.dash-periods a[aria-current=page]{background:#1c1917;color:white;border-color:#1c1917}.dash-live{display:flex;gap:12px;align-items:center;flex-wrap:wrap;color:#57534e;font-size:12px;margin-bottom:20px}.dash-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.dash-card{background:white;border:1px solid #e7e5e4;border-radius:14px;padding:16px;min-width:0}.dash-card>span{display:block;font-size:12px;color:#57534e}.dash-card strong{display:block;font-size:25px;font-weight:900;margin:8px 0;overflow-wrap:anywhere}.dash-card strong.dash-time{font-size:19px}.dash-card small{display:block}.dash-queues{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.dash-queues a{background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:14px;font-size:13px}.dash-queues strong{display:block;font-size:23px;color:#9a3412;font-weight:900}.dash-panel{background:white;border:1px solid #e7e5e4;border-radius:16px;padding:20px;margin-top:20px}.dash-panel .dash-section-heading{margin-top:0}.dash-note{line-height:1.6;margin:10px 0 14px}.dash-panel a{color:#047857;text-decoration:underline;text-underline-offset:3px}.dash-table-wrap{overflow-x:auto}.dash-table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}.dash-table th,.dash-table td{padding:12px 9px;border-bottom:1px solid #e7e5e4;vertical-align:top}.dash-table thead{color:#57534e;font-size:11px}.dash-table th{font-weight:700}.dash-table td small{font-size:11px;color:#78716c}.dash-signal{font-size:12px}.dash-description{max-width:330px;min-width:160px;margin:4px 0;overflow-wrap:anywhere}.dash-nowrap{white-space:nowrap}.dash-funnel-row{display:grid;grid-template-columns:260px 1fr 45px 55px;gap:12px;align-items:center;margin:16px 0;font-size:13px}.dash-funnel-row b,.dash-funnel-row small{text-align:right}.dash-track{height:12px;background:#f5f5f4;border-radius:6px;overflow:hidden}.dash-track>div{height:100%;background:#059669;border-radius:6px}.dash-empty{padding:20px 0;color:#047857}.dash-error{color:#b91c1c!important}@media(max-width:760px){.dash-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.dash-queues{grid-template-columns:repeat(2,minmax(0,1fr))}.dash-panel{padding:14px}.dash-funnel-row{grid-template-columns:1fr 65px 35px 40px;gap:7px;font-size:11px}}@media(prefers-reduced-motion:no-preference){.dash-refresh:disabled{opacity:.5}}
</style>
<div class="dash-heading"><h1>Управление маркетплейсом</h1><nav class="dash-periods" aria-label="Период аналитики"><% [['today','Сегодня'],['7','7 дней'],['30','30 дней'],['90','90 дней']].forEach(([key,label]) => { %><a href="/admin?period=<%= key %>&tab=<%= dashboard.tab %>&manager=<%= dashboard.managerFilter %>" <%- dashboard.period === key ? 'aria-current="page"' : '' %>><%= label %></a><% }); %></nav></div>
<nav class="dash-periods" aria-label="Разделы аналитики" style="margin-bottom:16px;flex-wrap:wrap"><% [['overview','Операции и спрос'],['providers','Исполнители'],['managers','Менеджеры'],['finance','Финансы']].forEach(([key,label]) => { %><a href="/admin?tab=<%= key %>&period=<%= dashboard.period %><%= dashboard.rangeQuery %>" <%- dashboard.tab === key ? 'aria-current="page"' : '' %>><%= label %></a><% }); %></nav><form method="GET" action="/admin" class="dash-live"><input type="hidden" name="tab" value="<%= dashboard.tab %>"><input type="hidden" name="manager" value="<%= dashboard.managerFilter %>"><label>С <input type="date" name="from" value="<%= dashboard.from %>" required></label><label>По <input type="date" name="to" value="<%= dashboard.to %>" required></label><button class="dash-refresh">Показать период</button></form>
<div class="dash-live"><span id="dashboard-freshness" role="status" aria-live="polite"></span><label><input type="checkbox" id="dashboard-auto" checked> Обновлять каждые 45 секунд</label><button type="button" class="dash-refresh" id="dashboard-refresh">Обновить</button></div>
<div id="dashboard-content"><%- include('./_dashboard', { dashboard }) %></div>
<script>
(() => {
  const root = document.getElementById('dashboard-content');
  const status = document.getElementById('dashboard-freshness');
  const button = document.getElementById('dashboard-refresh');
  const auto = document.getElementById('dashboard-auto');
  let busy = false;
  const stamp = () => new Date(root.querySelector('[data-dashboard-time]').dataset.dashboardTime).toLocaleTimeString('ru-RU', { timeZone: 'Asia/Tbilisi' });
  const fresh = () => { status.classList.remove('dash-error'); status.textContent = 'Обновлено в ' + stamp() + ' · Тбилиси'; };
  fresh();
  async function refresh() {
    if (busy) return;
    busy = true; button.disabled = true;
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 20000);
    try {
      const url = new URL(window.location.href); url.searchParams.set('format', 'json');
      const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store', signal: controller.signal });
      if (response.redirected || response.status === 401) throw new Error('Сессия истекла. Войдите в админку снова.');
      if (!response.ok || !(response.headers.get('content-type') || '').includes('application/json')) throw new Error('Не удалось обновить данные.');
      const data = await response.json();
      if (typeof data.html !== 'string') throw new Error('Некорректный ответ сервера.');
      root.innerHTML = data.html; fresh();
    } catch (error) {
      status.classList.add('dash-error');
      status.textContent = (error.name === 'AbortError' ? 'Сервер не ответил вовремя.' : error.message) + ' Данные на ' + stamp() + '.';
    } finally { clearTimeout(timeout); busy = false; button.disabled = false; }
  }
  button.addEventListener('click', refresh);
  setInterval(() => { if (auto.checked && !document.hidden && !root.contains(document.activeElement)) refresh(); }, 45000);
})();
</script>

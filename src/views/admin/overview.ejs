<%- include('./_header', { active: 'overview' }) %>

<h1 class="text-2xl font-black text-stone-900 mb-5">Обзор</h1>

<h2 class="text-lg font-bold mb-3">Требуют внимания</h2><div class="admin-queue">
<a href="/admin/orders?status=waiting"><strong><%= waitingOrders %></strong><span>Заявок без рассылки →</span></a>
<a href="/admin/masters?status=pending"><strong><%= stats.mastersPending %></strong><span>Профилей на проверке →</span></a>
<a href="/admin/receipts"><strong><%= waitingReceipts %></strong><span>Чеков на проверке →</span></a>
<a href="/admin/support"><strong><%= stats.supportOpenCount %></strong><span>Вопросов без ответа →</span></a></div>
<h2 class="text-lg font-bold mb-3">Состояние платформы</h2><div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Активны</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= stats.mastersActive %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">На модерации</p>
        <p class="text-2xl font-black text-amber-600 mt-1"><%= stats.mastersPending %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Забанены</p>
        <p class="text-2xl font-black text-red-600 mt-1"><%= stats.mastersBanned %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Мало баланса</p>
        <p class="text-2xl font-black text-amber-600 mt-1"><%= stats.lowBalanceCount %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Суммарный баланс</p>
        <p class="text-2xl font-black text-emerald-700 mt-1"><%= stats.totalBalanceGel.toFixed(2) %> ₾</p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Заявок сегодня</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= stats.ordersToday %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Заявок за неделю</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= stats.ordersThisWeek %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Отзывов на модерации</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= stats.pendingReviewsCount %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">С Telegram</p>
        <p class="text-2xl font-black text-[#229ED9] mt-1"><%= stats.mastersWithTelegram %></p>
    </div>
    <a href="/admin/support" class="bg-white rounded-2xl border border-stone-200 p-4 hover:shadow-md transition">
        <p class="text-xs font-bold text-stone-500 uppercase">Вопросов без ответа</p>
        <p class="text-2xl font-black <%= stats.supportOpenCount > 0 ? 'text-amber-600' : 'text-stone-900' %> mt-1"><%= stats.supportOpenCount %></p>
    </a>
</div>

<h2 class="text-lg font-bold mb-3 mt-6">Списания по каналам</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Лид (рассылка заявок)</p>
        <p class="text-2xl font-black text-stone-900 mt-1">
            <%= stats.channelStatsToday.lead.gel.toFixed(2) %> ₾
            <span class="text-xs font-semibold text-stone-500">сегодня · <%= stats.channelStatsToday.lead.count %> списаний</span>
        </p>
        <p class="text-sm text-stone-600 mt-1">
            <%= stats.channelStatsWeek.lead.gel.toFixed(2) %> ₾ за неделю · <%= stats.channelStatsWeek.lead.count %> списаний
        </p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Каталог (показ номера)</p>
        <p class="text-2xl font-black text-stone-900 mt-1">
            <%= stats.channelStatsToday.catalog.gel.toFixed(2) %> ₾
            <span class="text-xs font-semibold text-stone-500">сегодня · <%= stats.channelStatsToday.catalog.count %> списаний</span>
        </p>
        <p class="text-sm text-stone-600 mt-1">
            <%= stats.channelStatsWeek.catalog.gel.toFixed(2) %> ₾ за неделю · <%= stats.channelStatsWeek.catalog.count %> списаний
        </p>
    </div>
</div>

<h2 class="text-lg font-bold mb-3 mt-6">Срез за период</h2>
<%
    const _fmt = (d) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    const _today = new Date(new Date().setHours(0,0,0,0));
    const _presets = [
        ['7 дней', new Date(_today.getTime() - 6*24*60*60*1000), _today],
        ['30 дней', new Date(_today.getTime() - 29*24*60*60*1000), _today],
        ['90 дней', new Date(_today.getTime() - 89*24*60*60*1000), _today],
    ];
%>
<div class="bg-white rounded-2xl border border-stone-200 p-4">
    <form method="GET" class="admin-filter" action="/admin">
        <label>С <input type="date" name="from" value="<%= rangeFromValue %>"></label>
        <label>По <input type="date" name="to" value="<%= rangeToValue %>"></label>
        <button>Показать</button>
    </form>
    <div class="mt-2 flex gap-3 flex-wrap text-xs font-bold">
        <% _presets.forEach(function ([label, from, to]) { %>
          <a class="text-emerald-700 hover:underline" href="/admin?from=<%= _fmt(from) %>&to=<%= _fmt(to) %>"><%= label %></a>
        <% }); %>
    </div>
    <% if (rangeInvalid) { %>
      <p class="mt-3 text-sm text-red-600 font-semibold">«С» должно быть раньше «По». Показан пустой результат.</p>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
          <div>
              <p class="text-xs font-bold text-stone-500 uppercase">Заявок за период</p>
              <p class="text-2xl font-black text-stone-900 mt-1"><%= rangeStats.ordersCount %></p>
          </div>
          <div>
              <p class="text-xs font-bold text-stone-500 uppercase">Лид (рассылка)</p>
              <p class="text-2xl font-black text-stone-900 mt-1"><%= rangeStats.channelStats.lead.gel.toFixed(2) %> ₾
                  <span class="text-xs font-semibold text-stone-500"><%= rangeStats.channelStats.lead.count %> списаний</span></p>
          </div>
          <div>
              <p class="text-xs font-bold text-stone-500 uppercase">Каталог (показ номера)</p>
              <p class="text-2xl font-black text-stone-900 mt-1"><%= rangeStats.channelStats.catalog.gel.toFixed(2) %> ₾
                  <span class="text-xs font-semibold text-stone-500"><%= rangeStats.channelStats.catalog.count %> списаний</span></p>
          </div>
      </div>
    <% } %>
</div>

<div class="mt-4 bg-white rounded-2xl border border-stone-200 p-4">
    <p class="text-xs font-bold text-stone-500 uppercase">Время до открытия заявки или нажатия контакта</p>
    <% if (stats.responseStats.avgSeconds === null) { %>
      <p class="text-sm text-stone-500 mt-1">Пока нет данных</p>
    <% } else { %>
      <p class="text-lg font-black text-stone-900 mt-1">
        <%= Math.round(stats.responseStats.avgSeconds / 60) %> мин
        <span class="text-xs font-semibold text-stone-500">(открыли или нажали контакт <%= stats.responseStats.respondedCount %> из <%= stats.responseStats.totalCount %> уведомлений)</span>
      </p>
    <% } %>
</div>

<%- include('./_footer') %>

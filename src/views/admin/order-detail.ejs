<%- include('../manager/_header', { adminBar: true }) %>
<%
  // Страница заявки у администратора: тот же экран, что в кабинете менеджера, и ниже блок
  // «Только для администратора» — действия и сведения, которых у менеджера нет.
  const statusText = order.status === 'closed' ? 'Закрыта' : order.status === 'needs_revision' ? 'Возвращена заказчику на доработку'
    : order.status === 'unverified' ? 'Телефон заказчика не подтверждён' : order.first_dispatched_at ? 'В работе' : 'Ждёт рассылки';
  const openNeeds = (order.target_categories || []).filter(key => !closedCategories.includes(key));
%>
<style>
.admin-only h2{margin-top:0}.admin-only form{margin:0}.admin-only .row{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}
.admin-only .plain{background:#edf3f1;color:#075d4b}.admin-only table td{vertical-align:top}
.admin-note{background:#fff3d6;border:1px solid #f0d58c;border-radius:14px;padding:14px 18px;margin:14px 0}
</style>
<% if(order.is_technical){ %><p class="admin-note"><strong>🧪 Тестовая заявка.</strong> Рассылка только техническим исполнителям. В рабочую статистику не входит.</p><% } %>
<% if(revisionNotice){ %><p class="admin-note" role="status"><%= revisionNotice === 'sent' ? 'Заявка возвращена на доработку. SMS со ссылкой отправлена.' : 'Заявка возвращена на доработку, но SMS отправить не удалось. Клиент увидит комментарий на странице своей заявки.' %></p><% } %>
<% if(order.revision_reason){ %><div class="admin-note"><b>Комментарий для доработки</b><p class="pre"><%= order.revision_reason %></p><small><%= order.status === 'needs_revision' ? 'Ожидаем исправления от клиента' : 'Клиент повторно отправил заявку либо её статус изменён' %></small></div><% } %>
<%- include('../partials/order-screen', { base: '/admin/orders/' + order.token, listHref: '/admin/orders', csrf: csrfToken, canCloseNeed: false, masterHref: '/admin/masters/' }) %>

<section class="card admin-only" id="admin-only">
<h2>Только для администратора</h2>
<p>Состояние: <strong><%= statusText %></strong> · создана <%= date(order.created_at) %><% if(order.closed_at){ %> · закрыта <%= date(order.closed_at) %><% } %></p>
<% if(order.status === 'pending_review' && !order.first_dispatched_at){ %>
<details><summary>Вернуть заказчику на доработку</summary>
<form method="post" action="/admin/orders/<%= order.token %>/request-revision"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Что нужно исправить или уточнить?<textarea name="reason" required minlength="5" maxlength="1000" rows="3"></textarea></label>
<button>Вернуть на доработку и уведомить клиента</button></form></details>
<% } %>
<div class="row">
<% if(open){ %><form method="post" action="/admin/orders/<%= order.token %>/refresh-categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="plain">Обновить сообщения в Telegram</button></form><% } %>
<% if(order.status !== 'closed'){ %>
<% if(openNeeds.length > 1){ openNeeds.forEach(key => { %><form method="post" action="/admin/orders/<%= order.token %>/close-category"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category" value="<%= key %>"><button class="plain">Закрыть «<%= groups[key] || key %>»</button></form><% }); } %>
<form method="post" action="/admin/orders/<%= order.token %>/close" onsubmit="return confirm('Закрыть заявку? Клиенту SMS не уйдёт.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="plain"><%= openNeeds.length > 1 ? 'Закрыть всю заявку' : 'Закрыть заявку' %> (без SMS клиенту)</button></form>
<% } %>
<form method="post" action="/admin/orders/<%= order.token %>/delete" onsubmit="return confirm('Удалить эту заявку без возможности восстановления?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">Удалить заявку</button></form>
</div>
<h3>Кто получил заявку и сколько списано</h3>
<% if(!notifiedMasters.length){ %><p class="muted">Пока никто не получил.</p><% } else { %>
<div class="scroll"><table><thead><tr><th>Исполнитель</th><th>Телефон</th><th>Списано</th><th>Когда</th></tr></thead><tbody>
<% notifiedMasters.forEach(row => { %><tr><td><a href="/admin/masters/<%= row.master_id %>"><%= row.name %></a></td><td><%= row.phone %></td><td><%= (Math.abs(row.amount_tetri) / 100).toFixed(2) %> ₾</td><td><%= date(row.created_at) %></td></tr><% }); %>
</tbody></table></div>
<% } %>
</section>
</main></body></html>

<%- include('./_header', { active: 'masters' }) %>
<style>
.admin-services,.admin-service-details{margin-top:20px;padding:18px;border:1px solid #dbe5df;border-radius:16px;background:#f8fbf9}
#admin-services{scroll-margin-top:95px}
.admin-services h3,.admin-service-details h3{font-size:16px;font-weight:800;color:#173d32}
.admin-services>p{font-size:13px;color:#52645d;margin-top:5px}
.admin-service-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-top:16px}
.admin-service-tile{display:flex;gap:10px;align-items:center;min-height:54px;padding:11px 13px;border:1px solid #cddbd3;border-radius:12px;background:white;cursor:pointer;font-size:14px;font-weight:650}
.admin-service-tile label{display:flex;align-items:center;gap:10px;flex:1;cursor:pointer}
.admin-service-tile:has(input:checked){background:#e9f7f0;border-color:#059669;color:#065f46}
.admin-service-tile input{width:20px;height:20px;flex:none;accent-color:#059669}
.admin-service-summary{font-weight:650;color:#047857;min-height:20px}
.admin-service-details [data-service-panel]{background:white;margin-top:14px;padding:16px}
.admin-service-details [data-service-panel] legend{padding:0 6px}
.admin-service-details select,.admin-service-details input[type=text],.admin-service-details input[type=number]{max-width:100%}
#vehicleSizeField{margin-top:14px;padding:14px;border:1px solid #dbe5df;border-radius:12px;background:white}
.admin-extra-fields{margin-top:18px;border:1px solid #dbe5df;border-radius:12px;padding:12px 16px}
.admin-extra-fields summary{cursor:pointer;font-weight:650;color:#475569}
.admin-extra-fields label{display:block;margin-top:14px;font-size:13px;font-weight:650}
.admin-service-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.admin-service-actions button{min-height:44px}
@media(max-width:600px){.admin-services,.admin-service-details{padding:14px}.admin-service-grid{grid-template-columns:1fr}.admin-service-actions button{width:100%}}
</style>

<% if (error === 'service_required') { %><p role="alert" class="mt-3 text-red-600">Назначьте категорию, заполните обязательные характеристики и сохраните профиль перед одобрением.</p><% } %>
<% if (error === 'invalid_city') { %><p role="alert" class="mt-3 text-red-600">Выберите хотя бы один активный город работы.</p><% } %>
<% if (error === 'invalid_language') { %><p role="alert" class="mt-3 text-red-600">Выберите хотя бы один язык общения.</p><% } %>
<% if (error === 'description_phone') { %><p role="alert" class="mt-3 text-red-600">Изменения не сохранены: в описании или цене есть номер телефона. Уберите его. Заказчики получают номер через кнопки в каталоге, показ номера платный.</p><% } %>
<a href="/admin/masters" class="text-xs font-bold text-stone-500 hover:text-stone-800">&larr; Все специалисты</a>

<section class="mt-3 p-4 bg-white border border-stone-200 rounded-xl"><h2 class="font-bold">Источник привлечения и комиссия</h2><% if(partnerReferrer) { %><p class="text-sm mt-2">Привёл: <a href="/admin/managers/<%= partnerReferrer.id %>" class="text-emerald-700 underline"><%= partnerReferrer.name %></a> · ставка на будущие пополнения: <%= partnerReferrer.commission_bps/100 %>%.</p><a href="/admin/partner-payouts?manager=<%= partnerReferrer.id %>" class="text-sm text-emerald-700 underline">Начисления и выплаты →</a><p class="text-xs text-stone-500 mt-2">Смена ответственного менеджера не меняет этот источник привлечения.</p><% } else { %><p class="text-sm mt-2">Источник для комиссии не закреплён. Для ранее привлечённого специалиста укажите его ID <%= master.id %> и основание в карточке менеджера. Прошлые пополнения автоматически не пересчитываются.</p><% } %></section>
<div class="mt-3 bg-white rounded-2xl border border-stone-200 p-5">
    <div class="flex items-center gap-2 flex-wrap">
        <h1 class="text-xl font-black text-stone-900"><%= master.name %></h1><% if(master.is_technical) { %><a href="/admin/settings/technical" class="text-amber-700 font-bold underline">🧪 Технический — только тестовые заявки</a><% } %>
        <% if (master.is_banned) { %>
          <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-red-100 text-red-700 border border-red-200">Забанен<% if (master.banned_reason) { %>: <%= master.banned_reason %><% } %></span>
        <% } else if (!master.is_active) { %>
          <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200">На модерации</span>
        <% } else { %>
          <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200">Активен</span>
        <% } %>
    </div>
    <p class="text-sm text-stone-600 mt-2">
        <%= master.phone %> · <%= master.category_label || master.category %><% if (master.vehicle_type) { %> — <%= master.vehicle_type %><% } %>
    </p>
    <p class="text-sm text-stone-600 mt-1">Рейтинг: <b><%= master.computed_rating %></b> (<%= master.review_count %> отзывов)</p>
    <a href="#admin-services" class="inline-block mt-2 px-3 py-2 rounded-xl bg-emerald-50 text-emerald-800 text-sm font-bold border border-emerald-200">Назначить услуги и характеристики ↓</a>
    <p class="text-sm mt-1">
      <a href="/admin/consent?phone=<%= encodeURIComponent(master.phone) %>" class="font-bold text-emerald-700 hover:underline">Журнал согласий на SMS &rarr;</a>
    </p>
    <% if (master.promo_code_used) { %>
      <p class="text-sm text-stone-600 mt-1">Пришёл по промокоду:
          <a href="/admin/promo/<%= master.promo_code_used %>" class="font-mono font-bold text-emerald-700 hover:underline"><%= master.promo_code_used %></a><% if (promoOrigin && promoOrigin.label) { %> <span class="text-stone-500">(<%= promoOrigin.label %>)</span><% } %>
      </p>
    <% } %>
    <form method="POST" action="/admin/masters/<%= master.id %>/assign-manager" class="text-sm text-stone-600 mt-1 flex items-center gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <span>Менеджер:</span>
        <select name="managerId" onchange="this.form.submit()" class="border border-stone-300 rounded-lg px-2 py-1 text-sm font-semibold outline-none focus:border-emerald-500">
            <option value="">— не назначен —</option>
            <% managers.forEach(function (mg) { %>
                <option value="<%= mg.id %>" <%= currentManager && currentManager.id === mg.id ? 'selected' : '' %>><%= mg.name %></option>
            <% }); %>
        </select>
    </form>
    <p class="text-lg font-black text-stone-900 mt-2">Баланс: <%= (master.balance_tetri / 100).toFixed(2) %> ₾</p>

    <% if (error === 'invalid_amount') { %>
      <p class="mt-2 text-sm text-red-600 font-semibold">Некорректная сумма коррекции.</p>
    <% } else if (error === 'invalid_fields') { %>
      <p class="mt-2 text-sm text-red-600 font-semibold">Заполните имя, телефон и категорию.</p>
    <% } else if (error === 'phone_taken') { %>
      <p class="mt-2 text-sm text-red-600 font-semibold">Этот номер телефона уже занят другим мастером.</p>
    <% } %>

    <div class="mt-4 flex flex-wrap gap-3">
        <% if (master.is_active && !master.is_banned) { %>
          <form method="POST" action="/admin/masters/<%= master.id %>/unapprove" onsubmit="return confirm('Вернуть специалиста на модерацию? Он перестанет получать заявки, пока его снова не одобрят.')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="px-3 py-2 bg-amber-100 hover:bg-amber-200 text-amber-800 border border-amber-200 text-xs font-bold rounded-xl transition">Вернуть на модерацию</button>
          </form>
        <% } %>
        <% if (master.is_banned) { %>
          <form method="POST" action="/admin/masters/<%= master.id %>/unban">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="px-3 py-2 bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold rounded-xl transition">Разбанить</button>
          </form>
        <% } else { %>
          <form method="POST" action="/admin/masters/<%= master.id %>/ban" class="flex items-center gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" name="reason" placeholder="Причина бана (необязательно)" class="border border-stone-300 rounded-xl px-3 py-2 text-xs">
              <button type="submit" class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition">Забанить</button>
          </form>
        <% } %>
        <form method="POST" action="/admin/masters/<%= master.id %>/delete"
            onsubmit="return confirm('Удалить этого исполнителя без возможности восстановления? Профиль, баланс, отзывы и история удалятся — номер <%= master.phone %> освободится для новой регистрации на /join.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="px-3 py-2 bg-white hover:bg-red-50 text-red-600 border border-red-200 text-xs font-bold rounded-xl transition">
                Удалить полностью
            </button>
        </form>
    </div>

    <form method="POST" action="/admin/masters/<%= master.id %>/balance-correction" class="mt-4 flex flex-wrap items-center gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="text-xs font-bold text-stone-500">Коррекция баланса (₾, можно отрицательное):</label>
        <input type="text" name="amountGel" required placeholder="напр. 10 или -5" class="border border-stone-300 rounded-xl px-3 py-2 text-xs w-32">
        <input type="text" name="note" placeholder="Причина" class="border border-stone-300 rounded-xl px-3 py-2 text-xs">
        <button type="submit" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition">Применить</button>
    </form>
</div>

<% const masterNotes = typeof notes === 'undefined' ? [] : notes; %>
<% const onFollowup = typeof followup !== 'undefined' && followup; %>
<section id="master-notes" class="mt-4 bg-white rounded-2xl border <%= masterNotes.length ? 'border-amber-300 border-l-4 border-l-amber-400' : 'border-stone-200' %> p-5" style="scroll-margin-top:110px" aria-labelledby="master-notes-title">
    <div class="flex items-center justify-between gap-3 flex-wrap mb-1">
        <h2 id="master-notes-title" class="text-sm font-extrabold text-stone-900 uppercase">Заметки (<%= masterNotes.length %>)<% if (onFollowup) { %> <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-amber-400 text-stone-900 align-middle">На уточнении</span><% } %></h2>
        <form method="POST" action="/admin/masters/<%= master.id %>/followup">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="returnTo" value="/admin/masters/<%= master.id %>">
            <input type="hidden" name="on" value="<%= onFollowup ? '0' : '1' %>">
            <% if (onFollowup) { %>
              <button type="submit" class="px-3 py-2 bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold rounded-xl transition">Вернуть в список</button>
            <% } else { %>
              <button type="submit" class="px-3 py-2 bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs font-bold rounded-xl transition">На уточнение</button>
            <% } %>
        </form>
    </div>
    <p class="text-xs text-stone-500 mb-3">Заметки менеджеров и администратора. Заметку администратора видно только в админке. «На уточнение» убирает специалиста из рабочего списка на отдельную вкладку; заявки и каталог не меняются.</p>
    <% if (masterNotes.length) { %>
      <div class="bg-amber-50 border border-amber-300 rounded-xl p-3 space-y-1.5 mb-3">
          <% masterNotes.forEach(function (n) { %>
            <p class="text-sm text-stone-700 whitespace-pre-wrap break-words"><span class="text-xs text-stone-500"><%= new Date(n.created_at).toLocaleString('ru-RU', { timeZone: 'Asia/Tbilisi', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %> · <%= n.manager_name %>:</span> <%= n.body %></p>
          <% }); %>
      </div>
    <% } %>
    <form method="POST" action="/admin/masters/<%= master.id %>/note" class="flex flex-col sm:flex-row gap-2 sm:items-start">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="/admin/masters/<%= master.id %>">
        <textarea name="body" rows="2" required maxlength="2000" placeholder="Заметка администратора: договорённости, что уточнить" aria-label="Заметка администратора" class="flex-1 border border-stone-300 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500"></textarea>
        <button type="submit" class="px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition">Сохранить заметку</button>
    </form>
</section>

<div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
    <h2 class="text-sm font-extrabold text-stone-900 uppercase mb-3">Редактировать данные</h2>
    <%- include('./_master-messengers') %>
    <%- include('./_master-display-name') %>
    <form method="POST" action="/admin/masters/<%= master.id %>/update" class="space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label class="text-xs font-bold text-stone-500">Имя</label>
                <p class="text-xs text-stone-500">В каталоге: <%= typeof publicName !== 'undefined' ? publicName : master.name %><% if (master.display_name_override) { %> (задано вручную)<% } %>.</p>
                <input type="text" name="name" required value="<%= master.name %>" class="mt-1 w-full border border-stone-300 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500">
            </div>
            <div>
                <label class="text-xs font-bold text-stone-500">Телефон</label>
                <input type="text" name="phone" required value="<%= master.phone %>" class="mt-1 w-full border border-stone-300 rounded-xl px-3 py-2 text-sm outline-none focus:border-emerald-500">
            </div>
        </div>
        <section id="admin-services" class="admin-services" aria-labelledby="admin-services-title">
            <h3>1. Города работы</h3><p>Можно выбрать несколько. Выключенный город сначала включите в <a href="/admin/cities">справочнике городов</a>.</p>
            <div class="admin-service-grid"><% workCities.forEach(city=>{ %><label class="admin-service-tile"><input type="checkbox" name="cityIds" value="<%= city.id %>" <%= city.is_active?'':'disabled' %> <%= (master.work_cities||[]).some(row=>row.id===city.id) || (!(master.work_cities||[]).length && (master.city_id===city.id || (!master.city_id && city.slug==='tbilisi'))) ? 'checked' : '' %>> <span><%= city.name_ru %><%= city.is_active?'':' · выключен' %></span></label><% }); %></div>
            <h3>2. Языки общения</h3><p>Отметьте все языки, на которых исполнитель готов общаться с заказчиком. Это фильтр рассылки; язык интерфейса кабинета не меняется.</p>
            <div class="admin-service-grid"><% Object.entries(languageNames).forEach(([code,label])=>{ %><label class="admin-service-tile"><input type="checkbox" name="spokenLanguages" value="<%= code %>" <%= (master.spoken_languages||[]).includes(code)?'checked':'' %>> <span><%= label %></span></label><% }); %></div>
            <p>Язык при регистрации: <%= languageNames[master.registration_language] || 'не записан' %>. Язык кабинета: <%= languageNames[master.language] || 'не записан' %>.</p>
            <h3 id="admin-services-title">3. Какие услуги выполняет специалист?</h3>
            <p>Выберите все подходящие услуги. У каждой появятся свои характеристики для каталога и точной рассылки.</p>
            <p><a href="/admin/categories/new?returnTo=<%= encodeURIComponent('/admin/masters/'+master.id+'#admin-services') %>" target="_blank" rel="noopener">+ Добавить новую услугу и её характеристики</a> · <a href="/admin/categories" target="_blank" rel="noopener">Открыть справочник услуг</a>. После добавления обновите карточку, чтобы новая услуга появилась здесь.</p>
            <input type="hidden" name="servicesForm" value="1">
            <div class="admin-service-grid">
            <% serviceConfig.forEach(svc => { const selected = (master.services || []).some(s=>s.service_type === svc.type); %>
              <div class="admin-service-tile"><label><input type="checkbox" name="services" value="<%= svc.type %>" <%= selected ? 'checked' : '' %>> <span><%= svc.label %></span></label><a href="/admin/categories/<%= encodeURIComponent(svc.type) %>?returnTo=<%= encodeURIComponent('/admin/masters/'+master.id+'#admin-services') %>" target="_blank" rel="noopener" aria-label="Настроить характеристики: <%= svc.label %>">⚙</a></div>
            <% }); %>
            </div>
            <p id="admin-service-summary" class="admin-service-summary" aria-live="polite"></p>
        </section>
        <section class="admin-service-details" aria-labelledby="admin-service-details-title">
            <h3 id="admin-service-details-title">4. Уточните возможности по выбранным услугам</h3>
            <div id="vehicleSizeField" hidden>
                <label class="text-sm font-bold text-stone-700">Размер кузова — S / M / L / XL / XXL</label>
                <select name="vehicleSize" class="mt-1 w-full border border-stone-300 rounded-xl px-3 py-2 text-sm">
                    <option value="" <%= !master.vehicle_size ? 'selected' : '' %>>Размер неизвестен</option>
                    <% vanSizes.forEach(s => { %>
                    <option value="<%= s.code %>" data-spec="<%= s.spec %>" data-length="<%= s.length %>" data-width="<%= s.width %>" data-height="<%= s.height %>" <%= master.vehicle_size === s.code ? 'selected' : '' %>><%= s.code %> — от <%= s.spec %></option>
                    <% }); %>
                </select>
                <div class="grid grid-cols-3 gap-2 text-xs mt-2" data-van-dimensions><span>Длина: <output data-dimension="length">—</output> см</span><span>Ширина: <output data-dimension="width">—</output> см</span><span>Высота: <output data-dimension="height">—</output> см</span></div>
                <p data-van-preset class="text-xs text-stone-600" aria-live="polite">Это минимальные габариты класса, не точные размеры машины.</p>
            </div>
        <%- include('./_master-service-fields', { master, serviceConfig }) %>
        </section>
        <details class="admin-extra-fields"><summary>Дополнительные данные профиля: описание, цена, инструмент</summary>
            <label>Детали (тип машины / инструмент и т.п.)<input type="text" name="vehicleType" value="<%= master.vehicle_type || '' %>" class="mt-1 w-full border border-stone-300 rounded-xl px-3 py-2 text-sm"></label>
            <label>Цена<input type="text" name="priceText" value="<%= master.price_text || '' %>" class="mt-1 w-full border border-stone-300 rounded-xl px-3 py-2 text-sm"></label>
            <label>Описание<textarea name="description" rows="2" class="mt-1 w-full border border-stone-300 rounded-xl px-3 py-2 text-sm"><%= master.description || '' %></textarea></label>
        </details>
        <div class="admin-service-actions">
            <button type="submit" class="px-4 py-2.5 bg-stone-900 hover:bg-stone-800 text-white text-sm font-bold rounded-xl transition">Сохранить услуги и данные</button>
            <% if (!master.is_active && !master.is_banned) { %>
              <button type="submit" name="thenApprove" value="1" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl transition">Сохранить и одобрить специалиста</button>
            <% } %>
        </div>
    </form>
</div>

<div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
    <h2 class="text-sm font-extrabold text-stone-900 uppercase">Время реакции</h2>
    <% if (responseStats.avgSeconds === null) { %>
      <p class="text-sm text-stone-500 mt-1">Пока нет данных</p>
    <% } else { %>
      <p class="text-sm text-stone-700 mt-1">
        В среднем <b><%= Math.round(responseStats.avgSeconds / 60) %> мин</b>,
        ответил на <%= responseStats.respondedCount %> из <%= responseStats.totalCount %> уведомлений
      </p>
    <% } %>
</div>

<% const channelNames = { show: 'Показать номер', call: 'Позвонить', whatsapp: 'WhatsApp', viber: 'Viber', telegram: 'Telegram' };
   const channelLine = (counts) => Object.keys(channelNames).filter(key => counts[key]).map(key => channelNames[key] + ': ' + counts[key]).join(' · ') || 'нет'; %>
<section class="mt-4 bg-white rounded-2xl border border-stone-200 p-5" aria-labelledby="catalog-stats-title">
    <h2 id="catalog-stats-title" class="text-sm font-extrabold text-stone-900 uppercase mb-1">Каталог: действия заказчиков</h2>
    <p class="text-xs text-stone-500 mb-3">Считается с 30.09.2026. Тестовые телефоны из «Технических» не списывают деньги и в остальные цифры не входят.</p>
    <dl class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm">
        <div><dt class="text-stone-500">Платные открытия номера</dt><dd class="font-bold text-stone-900"><%= catalogStats.paid %></dd></div>
        <div><dt class="text-stone-500">Повторные, без списания</dt><dd class="font-bold text-stone-900"><%= catalogStats.repeat %></dd></div>
        <div><dt class="text-stone-500">Просили SMS, не подтвердив телефон</dt><dd class="font-bold text-stone-900"><%= catalogStats.smsGate %></dd></div>
        <div><dt class="text-stone-500">Недоступен при нажатии</dt><dd class="font-bold text-stone-900"><%= catalogStats.unavailable %></dd></div>
        <div><dt class="text-stone-500">Упёрлись в лимит 20 в час</dt><dd class="font-bold text-stone-900"><%= catalogStats.rateLimited %></dd></div>
        <div><dt class="text-stone-500">Открытия с тестовых телефонов</dt><dd class="font-bold text-stone-900"><%= catalogStats.technical %></dd></div>
    </dl>
    <p class="mt-3 text-sm text-stone-700"><span class="text-stone-500">Открывали с кнопки:</span> <%= channelLine(catalogStats.openedFrom) %></p>
    <p class="mt-1 text-sm text-stone-700"><span class="text-stone-500">После открытия нажали:</span> <%= channelLine(catalogStats.contacts) %></p>
</section>

<div class="mt-4 bg-white rounded-2xl border border-stone-200 p-5">
    <h2 class="text-sm font-extrabold text-stone-900 uppercase mb-3">История баланса</h2>
    <% if (!history.length) { %>
      <p class="text-sm text-stone-500">Пока нет операций (журнал ведётся с момента запуска этой функции — историю до этого он не объясняет).</p>
    <% } else { %>
      <div class="space-y-1.5">
          <% history.forEach(function (h) { %>
            <div class="flex items-center justify-between text-sm border-b border-stone-100 pb-1.5">
                <span class="text-stone-500 font-mono text-xs"><%= new Date(h.created_at).toLocaleString('ru') %></span>
                <span class="text-stone-600">
                    <%= h.reason === 'topup' ? 'Пополнение' : h.reason === 'lead_charge' ? 'Списание за лид' : h.reason === 'catalog_call' ? 'Показ номера в каталоге' : 'Коррекция' %>
                    <% if (h.note) { %> — <%= h.note %><% } %>
                </span>
                <span class="font-mono font-bold <%= h.amount_tetri >= 0 ? 'text-emerald-700' : 'text-red-600' %>">
                    <span class="text-xs text-stone-400">#<%= h.id %></span> <%= h.amount_tetri >= 0 ? '+' : '' %> <%= (h.amount_tetri / 100).toFixed(2) %> ₾
                </span>
            </div>
          <% }); %>
      </div>
    <% } %>
</div>

<%- include('./_footer') %>

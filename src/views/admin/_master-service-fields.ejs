<style>
label.service-choice{display:flex;align-items:center;gap:8px;margin:8px 0}
label.service-choice input[type=checkbox]{min-height:0;width:18px;height:18px;flex:0 0 18px;margin:0;padding:0}
.van-vehicle{border:1px solid #dbe5df;border-radius:12px;padding:12px;margin:10px 0;background:#fff}
.van-vehicle-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 6px}
</style>
<% serviceConfig.forEach(svc => { const saved = (master.services || []).find(s => s.service_type === svc.type); const attrs = saved ? saved.attributes : {}; %>
<fieldset data-service-panel="<%= svc.type %>" class="space-y-3 border border-stone-200 rounded-xl p-3">
  <legend class="text-sm font-bold"><%= svc.label %>: характеристики</legend>
  <% if (svc.type === 'movers') { %>
    <label class="service-choice text-sm"><input type="checkbox" name="moversOwnTransport" <%= saved?.requires_own_transport ? 'checked' : '' %>> Погрузка только вместе со своим транспортом</label>
    <p class="text-xs">Без этой отметки принимает отдельные заявки на грузчиков. Для отметки нужно также выбрать перевозки.</p>
  <% } %>
  <% const vanList = svc.type === 'van' && typeof vanSizes !== 'undefined'; %>
  <% if (vanList) { const vehicleFields = { vanSizes, bodyField: svc.fields.find(f => f.key === 'body'), liftField: svc.fields.find(f => f.key === 'tail_lift') }; %>
    <div data-van-vehicles data-max="<%= typeof maxVanVehicles === 'undefined' ? 10 : maxVanVehicles %>" data-tiers="<%= JSON.stringify(vanSizes.map(s => [s.code, s.length, s.width, s.height, s.spec])) %>">
      <p class="text-sm"><b>Машины исполнителя</b></p>
      <p class="text-sm">Впишите внутренние размеры кузова, как в объявлении исполнителя. Класс S / M / L / XL / XXL система поставит сама. Если машин несколько, добавьте каждую: заявку исполнитель получит, если подходит хотя бы одна. Уведомление и списание при этом одно.</p>
      <%- include('./_van-vehicle', { ...vehicleFields, vehicle: { ...attrs, size: attrs.size || master.vehicle_size || '' }, index: 0, number: 1 }) %>
      <% (Array.isArray(attrs.more_vehicles) ? attrs.more_vehicles : []).forEach((vehicle, i) => { %><%- include('./_van-vehicle', { ...vehicleFields, vehicle, index: i + 1, number: i + 2 }) %><% }); %>
      <button type="button" data-van-add class="secondary-action px-3 py-2 border rounded-xl text-sm">+ Добавить машину</button>
      <template><%- include('./_van-vehicle', { ...vehicleFields, vehicle: {}, index: 'INDEX', number: '' }) %></template>
    </div>
  <% } %>
  <% if (svc.type === 'junk') { %>
    <% if (svc.fields.some(f => f.key === 'dump_body')) { %>
    <label class="service-choice text-sm"><input type="checkbox" name="junk_dump_body" <%= attrs.dump_body === true ? 'checked' : '' %>> Самосвал — кузов поднимается и сам высыпает груз</label>
    <p class="text-xs">Необязательно. Отметьте, если кузов поднимается. Заявки на вывоз мусора получают все; отметка нужна для заявок, где прямо просят самосвал или груз надо высыпать.</p>
    <% } %>
    <p class="text-sm">Укажите внутренние размеры кузова. Объём рассчитается автоматически; грузоподъёмность укажите отдельно.</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" data-junk-dimensions>
      <% [['body_length_cm','Длина кузова'],['body_width_cm','Ширина кузова'],['side_height_cm','Высота борта (у фургона — высота кузова)']].forEach(([key,label])=>{ %>
      <label class="text-sm"><%= label %>, см<input type="number" name="junk_<%= key %>" min="1" max="2000" step="1" value="<%= attrs[key] ?? '' %>" class="block w-full border rounded-xl px-3 py-2"></label>
      <% }); %>
    </div>
    <p class="text-sm" data-junk-volume aria-live="polite">Расчётный объём: <%= attrs.body_length_cm && attrs.body_width_cm && attrs.side_height_cm ? (Number(attrs.body_length_cm)*Number(attrs.body_width_cm)*Number(attrs.side_height_cm)/1000000).toFixed(2)+' м³' : 'укажите три размера' %></p>
    <details><summary class="text-sm">Габариты неизвестны — выбрать примерный класс объёма</summary>
      <label class="text-sm">Класс объёма<select name="junk_volume_m3" class="block w-full border rounded-xl px-3 py-2"><option value="">Не выбран</option><% (svc.fields.find(f=>f.key==='volume_m3')?.options || []).forEach(o=>{ %><option value="<%= o.value %>" <%= attrs.volume_m3===o.value?'selected':'' %>><%= o.label %></option><% }); %></select></label>
    </details>
  <% } %>
  <% svc.fields.filter(f => f.input !== 'size' && !(vanList && ['body','tail_lift'].includes(f.key)) && !(svc.type === 'junk' && ['dump_body','volume_m3','body_length_cm','body_width_cm','side_height_cm'].includes(f.key))).forEach(f => { %>
    <label class="<%= f.input === 'bool' ? 'service-choice' : 'block' %> text-sm"><%= f.label %><%= f.required ? ' *' : '' %>
    <% if (f.input === 'enum') { %>
      <select name="<%= svc.type %>_<%= f.key %>" <%= f.required ? 'required' : '' %> class="block w-full border rounded-xl px-3 py-2">
        <option value="">Выберите</option>
        <% f.options.forEach(o => { %><option value="<%= o.value %>" <%= attrs[f.key] === o.value ? 'selected' : '' %>><%= o.label %></option><% }); %>
      </select>
    <% } else if (f.input === 'bool') { %>
      <input type="checkbox" name="<%= svc.type %>_<%= f.key %>" <%= attrs[f.key] ? 'checked' : '' %>>
    <% } else if (f.input === 'text') { %>
      <input type="text" maxlength="500" name="<%= svc.type %>_<%= f.key %>" value="<%= attrs[f.key] || '' %>" <%= f.required ? 'required' : '' %> class="block w-full border rounded-xl px-3 py-2">
    <% } else { %>
      <input type="number" name="<%= svc.type %>_<%= f.key %>" value="<%= attrs[f.key] == null ? '' : attrs[f.key] %>" min="<%= f.min %>" max="<%= f.max %>" step="any" <%= f.required ? 'required' : '' %> class="block w-full border rounded-xl px-3 py-2">
    <% } %>
    </label>
    <% if(svc.type === 'van' && f.key === 'with_helpers') { %><p class="text-xs">Это характеристика перевозки. Чтобы получать предложения по погрузке, выберите также услугу «Грузчики» и её условия.</p><% } %>
  <% }); %>
</fieldset>
<% }); %>
<script>
(() => {
 const choices = [...document.querySelectorAll('input[name=services]')];
 function update() {
  const types = choices.filter(input=>input.checked).map(input=>input.value);
  document.querySelectorAll('[data-service-panel]').forEach(panel => {
   const active = types.includes(panel.dataset.servicePanel);
   panel.hidden = !active;
   panel.querySelectorAll('input,select').forEach(input => input.disabled = !active);
  });
  const summary = document.getElementById('admin-service-summary');
  if (summary) summary.textContent = types.length
   ? 'Выбрано: ' + choices.filter(input=>input.checked).map(input=>input.closest('label').textContent.trim()).join(' · ')
   : 'Услуги пока не выбраны.';
 }
 choices.forEach(input=>input.addEventListener('change', update)); update();
 // Машины перевозки: превью класса у каждой (итоговую букву ставит сервер по тем же порогам),
 // добавление и удаление машин.
 document.querySelectorAll('[data-van-vehicles]').forEach(list=>{
  const tiers=JSON.parse(list.dataset.tiers), max=Number(list.dataset.max), template=list.querySelector('template'), add=list.querySelector('[data-van-add]');
  const vehicles=()=>[...list.querySelectorAll('[data-van-vehicle]')];
  let next=Math.max(0,...vehicles().map(vehicle=>Number(vehicle.dataset.vanVehicle)||0))+1;
  const sync=()=>{vehicles().forEach((vehicle,i)=>{vehicle.querySelector('[data-van-number]').textContent=i+1;});add.disabled=vehicles().length>=max;};
  const init=vehicle=>{
   const inputs=[...vehicle.querySelectorAll('[data-van-cm]')], select=vehicle.querySelector('[data-van-manual]'), output=vehicle.querySelector('[data-van-class]');
   const refresh=()=>{
    const filled=inputs.filter(input=>input.value!=='').length, nums=inputs.map(input=>Number(input.value));
    inputs.forEach(input=>input.required=filled>0);
    if(filled===3 && nums.every(n=>n>=1)){
     const tier=[...tiers].reverse().find(t=>nums[0]>=t[1] && nums[1]>=t[2] && nums[2]>=t[3]) || tiers[0];
     output.textContent='Класс по размерам: '+tier[0]+' — кузов от '+tier[4]+'.';
    } else if(filled) output.textContent='Введите все три размера — система определит класс.';
    else output.textContent=select.value?'Класс выбран на глаз: '+select.value+'. Размеры не записаны.':'Размер неизвестен. С этой машиной исполнитель получит только заявки, где размер не ограничен.';
   };
   inputs.forEach(input=>input.addEventListener('input',refresh));select.addEventListener('change',refresh);refresh();
   vehicle.querySelector('[data-van-remove]')?.addEventListener('click',()=>{vehicle.remove();sync();});
  };
  vehicles().forEach(init);
  add.addEventListener('click',()=>{
   add.insertAdjacentHTML('beforebegin',template.innerHTML.split('INDEX').join(next++));
   const created=vehicles().pop();init(created);sync();created.querySelector('input').focus();
  });
  sync();
 });
 document.querySelectorAll('[data-junk-dimensions]').forEach(block=>{
  const inputs=[...block.querySelectorAll('input')], output=block.parentElement.querySelector('[data-junk-volume]');
  const refresh=()=>{const nums=inputs.map(input=>Number(input.value));output.textContent=nums.every(n=>n>0)?'Расчётный объём: '+(nums.reduce((a,b)=>a*b,1)/1e6).toFixed(2)+' м³ · класс подбора определится при сохранении':'Расчётный объём: укажите три размера';};
  inputs.forEach(input=>input.addEventListener('input',refresh));refresh();
 });
})();
</script>

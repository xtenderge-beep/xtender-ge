<style>
label.service-choice{display:flex;align-items:center;gap:8px;margin:8px 0}
label.service-choice input[type=checkbox]{min-height:0;width:18px;height:18px;flex:0 0 18px;margin:0;padding:0}
</style>
<% serviceConfig.forEach(svc => { const saved = (master.services || []).find(s => s.service_type === svc.type); const attrs = saved ? saved.attributes : {}; %>
<fieldset data-service-panel="<%= svc.type %>" class="space-y-3 border border-stone-200 rounded-xl p-3">
  <legend class="text-sm font-bold"><%= svc.label %>: характеристики</legend>
  <% if (svc.type === 'movers') { %>
    <label class="service-choice text-sm"><input type="checkbox" name="moversOwnTransport" <%= saved?.requires_own_transport ? 'checked' : '' %>> Погрузка только вместе со своим транспортом</label>
    <p class="text-xs">Без этой отметки принимает отдельные заявки на грузчиков. Для отметки нужно также выбрать перевозки.</p>
  <% } %>
  <% svc.fields.filter(f => f.input !== 'size').forEach(f => { %>
    <label class="<%= f.input === 'bool' ? 'service-choice' : 'block' %> text-sm"><%= f.label %><%= f.required ? ' *' : '' %>
    <% if (f.input === 'enum') { %>
      <select name="<%= svc.type %>_<%= f.key %>" <%= f.required ? 'required' : '' %> class="block w-full border rounded-xl px-3 py-2">
        <option value="">Выберите</option>
        <% f.options.forEach(o => { %><option value="<%= o.value %>" <%= attrs[f.key] === o.value ? 'selected' : '' %>><%= o.label %></option><% }); %>
      </select>
    <% } else if (f.input === 'bool') { %>
      <input type="checkbox" name="<%= svc.type %>_<%= f.key %>" <%= attrs[f.key] ? 'checked' : '' %>>
    <% } else if (f.input === 'text') { %>
      <input type="text" maxlength="500" name="<%= svc.type %>_<%= f.key %>" value="<%= attrs[f.key] || '' %>" <%= f.required ? 'required' : '' %> class="block w-full border rounded-xl px-3 py-2">
    <% } else { %>
      <input type="number" name="<%= svc.type %>_<%= f.key %>" value="<%= attrs[f.key] == null ? '' : attrs[f.key] %>" min="<%= f.min %>" max="<%= f.max %>" step="any" <%= f.required ? 'required' : '' %> class="block w-full border rounded-xl px-3 py-2">
    <% } %>
    </label>
    <% if(svc.type === 'van' && f.key === 'with_helpers') { %><p class="text-xs">Это характеристика перевозки. Чтобы получать предложения по погрузке, выберите также услугу «Грузчики» и её условия.</p><% } %>
  <% }); %>
</fieldset>
<% }); %>
<script>
(() => {
 const choices = [...document.querySelectorAll('input[name=services]')];
 const sizeField = document.getElementById('vehicleSizeField');
 function update() {
  const types = choices.filter(input=>input.checked).map(input=>input.value);
  document.querySelectorAll('[data-service-panel]').forEach(panel => {
   const active = types.includes(panel.dataset.servicePanel);
   panel.hidden = !active;
   panel.querySelectorAll('input,select').forEach(input => input.disabled = !active);
  });
  if (sizeField) {
   const showSize = types.includes('van');
   sizeField.hidden = !showSize;
   sizeField.querySelectorAll('input,select').forEach(input => input.disabled = !showSize);
  }
 }
 choices.forEach(input=>input.addEventListener('change', update)); update();
})();
</script>

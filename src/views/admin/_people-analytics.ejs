<% const gel = n => Number(n || 0).toLocaleString('ru-RU', { maximumFractionDigits: 2 }) + ' ₾'; const duration = n => n === null ? '—' : n < 1 ? '< 1 мин' : Math.round(n) + ' мин'; const f = dashboard.providerFunnel; %>
<section class="dash-panel"><h2>Бизнес-воронка исполнителей</h2><p class="dash-note">Размер базы и исторические этапы; допуск — текущее состояние. Этапы не обязательно последовательны: первый лид может оплачиваться бонусом.</p>
<div class="dash-cards"><% [['Всего исполнителей',f.registered],['Активных профилей сейчас',f.active],['Допущены к рассылке сейчас',f.eligible],['Получали платный лид',f.received],['Пополняли баланс',f.topped],['Пополняли 2 раза и более',f.repeated],['Нажимали контакт по лидам периода',f.contacted]].forEach(([label,value]) => { %><article class="dash-card"><span><%= label %></span><strong><%= value %></strong></article><% }); %></div>
</section>
<section class="dash-panel"><h2><%= dashboard.tab === 'managers' ? 'Результаты менеджеров' : 'Исполнители и ответственные менеджеры' %></h2>
<p class="dash-note">Лиды и контакты — уникальные пары «исполнитель + заявка» по списаниям за выбранный период. Звонок и WhatsApp по одной заявке — один контакт. Среднее время — от списания до первого нажатия контакта, только среди отреагировавших. Открытия считаются отдельно. Списание — приближение к времени уведомления.</p>
<% if (dashboard.tab === 'managers') { %>
<p class="dash-note">Группировка по текущему назначению менеджера; переназначение меняет состав отчёта. Кто привёл: доступный источник по промокоду показан в таблице исполнителей. Исторического журнала назначений до этого отчёта нет.</p>
<div class="dash-table-wrap"><table class="dash-table"><thead><tr><th>Менеджер</th><th>Исполнителей / новых за период</th><th>Допущены</th><th>Баланс сейчас</th><th>Пополнения за период</th><th>Списания за период</th><th>Лиды / контакты</th><th>Среднее до контакта</th><th>Пополняли / повторно за всё время</th></tr></thead><tbody>
<% dashboard.managers.forEach(m => { %><tr><th><% if (m.id) { %><a href="/admin/managers/<%= m.id %>"><%= m.name %></a><% } else { %><%= m.name %><% } %><% if (!m.is_active) { %><small> · неактивен</small><% } %><div><a href="/admin?tab=providers&period=<%= dashboard.period %>&manager=<%= m.id || 0 %><%= dashboard.rangeQuery %>">Исполнители →</a></div></th><td><%= m.total %> / <%= m.newCount %></td><td><%= m.eligible %></td><td><%= gel(m.balance) %></td><td><%= gel(m.topups) %></td><td><%= gel(m.spent) %></td><td><%= m.leads %> / <%= m.contacts %></td><td><%= duration(m.average) %></td><td><%= m.topped %> / <%= m.repeated %></td></tr><% }); %>
</tbody></table></div>
<% } else { %>
<form method="GET" action="/admin" class="dash-live"><input type="hidden" name="tab" value="providers"><input type="hidden" name="period" value="<%= dashboard.period %>"><% if (dashboard.period === "custom") { %><input type="hidden" name="from" value="<%= dashboard.from %>"><input type="hidden" name="to" value="<%= dashboard.to %>"><% } %><label>Менеджер <select name="manager" style="padding:8px;border:1px solid #d6d3d1;border-radius:8px"><option value="">Все</option><% dashboard.managers.forEach(m => { %><option value="<%= m.id || 0 %>" <%= dashboard.managerFilter === String(m.id || 0) ? 'selected' : '' %>><%= m.name %></option><% }); %></select></label><button class="dash-refresh">Применить</button></form>
<div class="dash-table-wrap"><table class="dash-table"><thead><tr><th>Исполнитель</th><th>Назначенный менеджер / источник</th><th>Статус</th><th>Баланс сейчас</th><th>Пополнения / списания за период</th><th>Лиды / открытия / контакты</th><th>Доля контактов</th><th>Среднее до контакта</th></tr></thead><tbody>
<% const members = dashboard.providers.filter(p => !dashboard.managerFilter || String(p.manager_id || 0) === dashboard.managerFilter); members.forEach(p => { %><tr><th><a href="/admin/masters/<%= p.id %>"><%= p.name %></a><div><%= p.phone %></div><small><%= p.category %> <%= p.vehicle_size || '' %></small></th><td><% if (p.manager_id) { %><a href="/admin/managers/<%= p.manager_id %>"><%= p.manager_name %></a><% } else { %>Не назначен<% } %><div><small>Источник: <%= p.source_manager_name || (p.promo_code_used ? 'промокод' : 'не зафиксирован') %><%= p.promo_code_used ? ' · ' + p.promo_code_used : '' %></small></div></td><td><%= p.is_banned ? 'Заблокирован' : !p.is_active ? 'На модерации' : p.eligible ? 'Допущен к рассылке' : 'Не допущен к рассылке' %></td><td><%= gel(p.balance) %></td><td><%= gel(p.topups) %> / <%= gel(p.spent) %></td><td><%= p.leads %> / <%= p.opened %> / <%= p.contacts %></td><td><%= p.contactRate === null ? '—' : p.contactRate + '%' %></td><td><%= duration(p.average) %></td></tr><% }); %>
<% if (!members.length) { %><tr><td colspan="8">В этой группе пока нет исполнителей.</td></tr><% } %>
</tbody></table></div>
<% } %>
</section>

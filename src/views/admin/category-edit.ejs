<%- include('./_header',{active:'categories'}) %>
<%
  const value=submitted || category || {};
  const fields=submitted ? submitted.fields : (category?.fields || []).map(f=>({
    key:f.key, input:f.input, name_ru:f.labels?.ru, name_ka:f.labels?.ka, name_en:f.labels?.en,
    required:f.required, unit:f.unit, min:f.min, max:f.max,
    options:(f.options || []).map(v=>({value:v, name_ru:f.optionLabels?.[v]?.ru || v, name_ka:f.optionLabels?.[v]?.ka, name_en:f.optionLabels?.[v]?.en})),
  }));
%>
<a href="/admin/categories" class="text-sm">← Категории услуг</a>
<h1 class="text-2xl font-bold mt-3"><%= category?'Редактировать категорию':'Новая категория' %></h1>
<% if(error){ %><p role="alert" class="mt-3 text-red-600"><%= error %></p><% } %>
<form method="post" action="/admin/categories<%= category ? '/'+category.slug : '' %>" class="mt-4 space-y-4 bg-white border rounded-xl p-5">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= value.version || 1 %>">
<% [['ru','Название на русском'],['ka','Название на грузинском'],['en','Название на английском']].forEach(([lang,label])=>{ %><label class="block text-sm"><%= label %><input required maxlength="80" name="name_<%= lang %>" value="<%= value['name_'+lang] || '' %>" class="block w-full border rounded-xl px-3 py-2"></label><% }); %>
<div class="flex gap-3"><label class="text-sm">Значок (необязательно)<input name="icon" maxlength="16" value="<%= value.icon || '' %>" class="block w-full border rounded-xl px-3 py-2"></label><label class="text-sm">Порядок в списке<input type="number" name="sort_order" min="0" max="10000" value="<%= value.sort_order ?? 100 %>" class="block w-full border rounded-xl px-3 py-2"></label></div>
<label class="flex items-center gap-2"><input type="checkbox" name="is_active" <%= value.is_active !== false ? 'checked' : '' %>>Категория активна</label>
<p class="text-sm text-stone-500">При отключении категория исчезает из новых назначений, каталога и рассылки. Профили и история сохраняются.</p>
<h2 class="font-bold">Характеристики для модератора</h2>
<% if(fieldsLocked){ %><p class="text-sm">У этой категории есть поле «Размер», которое всё ещё проставляется старым способом (в профиле исполнителя, а не здесь) — пока это не объединили, характеристики этой категории не редактируются, чтобы форма не показывала то, что реально ни на что не влияет.</p><% } else { %>
<p class="text-sm text-stone-500">Добавьте поля, которые модератор заполнит в анкете исполнителя. Они описывают услуги; рассылка подбирает исполнителей по категории.</p>
<div id="categoryFields" class="space-y-3">
<% fields.forEach((field,i)=>{ %><%- include('./_category-field',{field,index:i}) %><% }); %>
</div>
<button type="button" id="addCategoryField" class="px-3 py-2 border rounded-xl">Добавить характеристику</button>
<template id="categoryFieldTemplate"><%- include('./_category-field',{field:{},index:'INDEX'}) %></template>
<% } %>
<div><button class="px-4 py-2 bg-emerald-600 text-white rounded-xl">Сохранить категорию</button></div>
</form>
<% if(category){ %>
<form method="POST" action="/admin/categories/<%= category.slug %>/delete" class="mt-4"
    onsubmit="return confirm('Удалить категорию «<%= category.name_ru %>» без возможности восстановления? Это возможно только если её сейчас никто не использует.')">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="px-3 py-2 bg-white hover:bg-red-50 text-red-600 border border-red-200 text-xs font-bold rounded-xl transition">Удалить категорию полностью</button>
</form>
<% } %>
<script>
(() => {
 const container=document.getElementById('categoryFields'); if(!container)return;
 function renumber(){container.querySelectorAll('[data-field]').forEach((row,i)=>row.querySelectorAll('[name]').forEach(input=>input.name=input.name.replace(/fields\[[^\]]+\]/,'fields['+i+']')));}
 function renumberOptions(fieldRow){
  const list=fieldRow.querySelector('[data-options-list]'); if(!list) return;
  list.querySelectorAll('[data-option]').forEach((row,j)=>row.querySelectorAll('[name]').forEach(input=>input.name=input.name.replace(/\[options\]\[[^\]]+\]/,'[options]['+j+']')));
 }
 function addOption(fieldRow){
  const list=fieldRow.querySelector('[data-options-list]'), tpl=fieldRow.querySelector('[data-option-template]');
  if(!list || !tpl || list.children.length>=20) return;
  list.appendChild(tpl.content.cloneNode(true));
  renumberOptions(fieldRow);
 }
 container.addEventListener('click',e=>{
  if(e.target.matches('[data-remove]')){e.target.closest('[data-field]').remove();renumber();return;}
  if(e.target.matches('[data-remove-option]')){const fieldRow=e.target.closest('[data-field]');e.target.closest('[data-option]').remove();renumberOptions(fieldRow);return;}
  if(e.target.matches('[data-add-option]')){addOption(e.target.closest('[data-field]'));return;}
 });
 container.addEventListener('change',e=>{
  if(!e.target.matches('[data-field-input]')) return;
  const fieldRow=e.target.closest('[data-field]');
  fieldRow.querySelector('[data-number-block]').classList.toggle('hidden', e.target.value!=='number');
  const optionsBlock=fieldRow.querySelector('[data-options-block]');
  optionsBlock.classList.toggle('hidden', e.target.value!=='enum');
  if(e.target.value==='enum' && fieldRow.querySelector('[data-options-list]').children.length===0){addOption(fieldRow);addOption(fieldRow);}
 });
 document.getElementById('addCategoryField').addEventListener('click',()=>{if(container.children.length>=12)return;container.append(document.getElementById('categoryFieldTemplate').content.cloneNode(true));renumber();});
})();
</script>
<%- include('./_footer') %>

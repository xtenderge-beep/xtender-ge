<div data-field class="border rounded-xl p-3 space-y-2">
<input type="hidden" name="fields[<%= index %>][key]" value="<%= field.key || '' %>">
<label class="block text-sm">Название характеристики (русский)<input required maxlength="100" name="fields[<%= index %>][name_ru]" value="<%= field.name_ru || '' %>" class="block w-full border rounded-xl px-3 py-2"></label>
<label class="block text-sm">Название на грузинском (необязательно — иначе покажем русское)<input maxlength="100" name="fields[<%= index %>][name_ka]" value="<%= field.name_ka || '' %>" class="block w-full border rounded-xl px-3 py-2"></label>
<label class="block text-sm">Название на английском (необязательно — иначе покажем русское)<input maxlength="100" name="fields[<%= index %>][name_en]" value="<%= field.name_en || '' %>" class="block w-full border rounded-xl px-3 py-2"></label>
<label class="block text-sm">Тип поля<select data-field-input name="fields[<%= index %>][input]" class="block border rounded-xl px-3 py-2"><% [['text','Текст'],['number','Число'],['bool','Да / нет'],['enum','Выбор из списка']].forEach(([type,label])=>{ %><option value="<%= type %>" <%= field.input===type?'selected':'' %>><%= label %></option><% }); %></select></label>
<label class="block text-sm">Как подбирать исполнителя<select data-match name="fields[<%= index %>][match]" class="block border rounded-xl px-3 py-2"><% [['ignore','Не учитывать при подборе'],['exact','Точное совпадение'],['gte','Возможность не меньше требования'],['flag','Требуется отметка «Да»']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (field.match || 'ignore')===value?'selected':'' %>><%= label %></option><% }); %></select></label>
<label class="flex gap-2 text-sm"><input type="checkbox" name="fields[<%= index %>][filter]" value="on" <%= field.filter?'checked':'' %>> Показывать как фильтр в каталоге</label>

<div data-number-block class="<%= field.input==='number' ? '' : 'hidden' %> grid grid-cols-1 sm:grid-cols-3 gap-1.5">
<label class="text-sm">Единица (напр. «м», «т», «чел.»)<input maxlength="16" name="fields[<%= index %>][unit]" value="<%= field.unit || '' %>" class="block w-full border rounded-lg px-2 py-1.5 text-sm"></label>
<label class="text-sm">Минимум<input type="number" step="any" name="fields[<%= index %>][min]" value="<%= field.min ?? '' %>" class="block w-full border rounded-lg px-2 py-1.5 text-sm"></label>
<label class="text-sm">Максимум<input type="number" step="any" name="fields[<%= index %>][max]" value="<%= field.max ?? '' %>" class="block w-full border rounded-lg px-2 py-1.5 text-sm"></label>
</div>

<div data-options-block class="<%= field.input==='enum' ? '' : 'hidden' %> space-y-1.5">
<div class="text-sm font-semibold">Варианты списка</div>
<div data-options-list class="space-y-1.5">
<% (field.options || []).forEach(function (opt, j) { %><%- include('./_category-field-option', { fieldIndex: index, optIndex: j, opt }) %><% }); %>
</div>
<button type="button" data-add-option class="text-xs border rounded-lg px-2.5 py-1.5">Добавить вариант</button>
<template data-option-template><%- include('./_category-field-option', { fieldIndex: index, optIndex: 'OPTIDX', opt: {} }) %></template>
</div>

<label class="flex gap-2 text-sm"><input type="checkbox" name="fields[<%= index %>][required]" <%= field.required?'checked':'' %>>Обязательно при проверке анкеты</label>
<button type="button" data-remove class="text-sm text-red-600">Убрать характеристику</button>
</div>

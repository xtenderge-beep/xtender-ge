<%- include('./_header', { active: 'receipts' }) %>
<h1 class="text-2xl font-black">Проверка пополнений</h1>
<p class="text-sm text-stone-600 mt-3">Здесь показан каждый созданный исполнителем счёт на пополнение — включая те, к которым ещё не приложен чек. Проверьте перевод в банке и нажмите «Подтвердить оплату» — сумма сразу зачислится на баланс исполнителя.</p>
<% if (error) { %><p role="alert" class="p-4 bg-red-50 text-red-800 rounded-xl mt-3"><%= error %></p><% } %>
<% if (!receipts.length) { %><p class="p-6 mt-4 bg-white rounded-xl">Пока нет созданных счетов. Здесь будут появляться новые обращения.</p><% } %>
<% const statusLabel = {awaiting:'Ожидает оплаты', received:'Чек получен', reviewing:'На проверке', credited:'Зачислено', rejected:'Нужно уточнение'};
receipts.forEach(t=>{ %><article class="admin-receipt">
<p><strong>Пополнение <%= t.reference %> · <%= (t.amount_tetri/100).toFixed(2) %> ₾</strong></p>
<p>Назначение: <%= t.purposeText %></p>
<h2><a class="text-emerald-700 underline" href="/admin/masters/<%= t.master_id %>"><%= t.name %></a></h2>
<p><%= t.phone %> · <%= new Date(t.created_at).toLocaleString('ru') %> · <strong><%= statusLabel[t.status] %></strong></p>
<% if (t.receipt) { %>
<p>Чек #<%= t.receipt.id %> · <a class="text-emerald-700 underline" href="/uploads/<%= encodeURIComponent(t.receipt.filename) %>" target="_blank" rel="noopener">Открыть файл ↗</a> · <%= statusLabel[t.receipt.status] %></p>
<% if (t.receipt.status !== 'credited') { %>
<form class="admin-filter" method="POST" action="/admin/receipts/<%= t.receipt.id %>/review">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Статус чека<select name="status" aria-label="Статус чека"><option value="reviewing">На проверке</option><option value="rejected">Нужно уточнение</option></select></label>
<label>Сообщение исполнителю<input name="note" maxlength="500" value="<%= t.receipt.note || '' %>" placeholder="Причина или уточнение"></label>
<button type="submit">Сохранить статус чека</button></form>
<% } %>
<% } %>
<% if (t.status === 'credited') { %><p>Подтверждено <%= (t.credited_tetri/100).toFixed(2) %> ₾ · операция #<%= t.balance_transaction_id %><% if (t.note) { %> · <%= t.note %><% } %></p><% } else { %>
<form class="admin-filter" method="POST" action="/admin/receipts/<%= t.id %>/confirm">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Сумма к зачислению, ₾<input name="amountGel" type="number" min="0.01" max="1000" step="0.01" value="<%= (t.amount_tetri/100).toFixed(2) %>" required></label>
<label>Комментарий (обязателен, если сумма отличается)<input name="note" maxlength="500" value="<%= t.note || '' %>" placeholder="Например: банк удержал комиссию"></label>
<button type="submit">Подтвердить оплату и зачислить</button></form>
<form method="POST" action="/admin/receipts/<%= t.id %>/cancel" class="mt-2" onsubmit="return confirm('Удалить счёт <%= t.reference %>? Исполнитель больше не сможет его оплатить.')">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="text-red-700 underline text-sm">Удалить счёт</button></form>
<% } %></article><% }) %>
<%- include('./_footer') %>

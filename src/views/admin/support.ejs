<%- include('./_header', { active: 'support' }) %>

<%
    const catLabels = { movers: 'Грузчики', transport: 'Машины', junk: 'Мусор' };
    const open = threads.filter(function (t) { return t.is_open; });
%>

<h1 class="text-2xl font-black text-stone-900 mb-1">Поддержка</h1>
<p class="text-sm text-stone-500 mb-5">Ждут ответа: <span class="font-bold <%= open.length ? 'text-amber-600' : 'text-stone-700' %>"><%= open.length %></span> · всего тредов: <%= threads.length %></p>

<% if (!threads.length) { %>
  <p class="text-sm text-stone-500">Обращений пока нет.</p>
<% } %>

<div class="space-y-2">
    <% threads.forEach(function (t) { %>
      <a href="/admin/support/<%= t.master_id %>" class="block bg-white rounded-2xl border <%= t.is_open ? 'border-amber-300' : 'border-stone-200' %> p-4 hover:shadow-md transition">
          <div class="flex items-center justify-between flex-wrap gap-2">
              <span class="font-extrabold text-stone-900">
                  #<%= t.master_id %> · <%= t.name %>
                  <span class="text-xs font-semibold text-stone-400"><%= catLabels[t.category] || t.category %></span>
                  <% if (t.telegram_id) { %><span class="text-[10px] font-bold text-[#229ED9] align-middle">TG</span><% } %>
              </span>
              <span class="flex items-center gap-2">
                  <% if (t.is_open) { %>
                      <span class="text-[11px] font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5">ждёт ответа</span>
                  <% } %>
                  <span class="text-[11px] text-stone-400"><%= new Date(t.last_at).toLocaleString('ru') %></span>
              </span>
          </div>
          <p class="text-sm text-stone-600 mt-1.5 line-clamp-2">
              <span class="font-semibold text-stone-400"><%= t.last_sender === 'master' ? 'Исполнитель:' : 'Вы:' %></span>
              <%= t.last_body %>
          </p>
      </a>
    <% }); %>
</div>

<%- include('./_footer') %>

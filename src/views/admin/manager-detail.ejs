<%- include('./_header', { active: 'managers' }) %>

<a href="/admin/managers" class="text-sm font-bold text-stone-500 hover:text-stone-900">&larr; все менеджеры</a>

<div class="flex items-baseline gap-3 flex-wrap mt-2 mb-4">
    <h1 class="text-2xl font-black text-stone-900"><%= manager.name %></h1>
    <span class="text-sm text-stone-400"><%= manager.phone %></span>
    <% if (manager.is_moderator) { %><span class="text-xs font-bold text-emerald-700">модератор</span><% } %>
    <% if (manager.is_head_moderator) { %><span class="text-xs font-bold text-amber-800">🎖 главный модератор</span><% } %>
    <% if (!manager.is_active) { %><span class="text-xs font-bold text-stone-400">выключен</span><% } %>
    <% if (!manager.telegram_id) { %><span class="text-xs font-bold text-amber-700">Telegram не привязан</span><% } %>
</div>

<div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Привёл</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= stats.total %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Активны</p>
        <p class="text-2xl font-black text-emerald-700 mt-1"><%= stats.active %></p>
    </div>
    <div class="bg-white rounded-2xl border border-stone-200 p-4">
        <p class="text-xs font-bold text-stone-500 uppercase">Выдано бонусов</p>
        <p class="text-2xl font-black text-stone-900 mt-1"><%= (stats.bonusPaidTetri / 100).toFixed(2) %> ₾</p>
    </div>
</div>

<%- include('./_partner-settings', { partner }) %>
<div class="bg-white rounded-2xl border border-stone-200 p-4 mb-4">
  <h2 class="font-extrabold">Веб-кабинет менеджера</h2>
  <p class="text-sm my-2">Вход: <a href="/manager/login" target="_blank" rel="noopener">/manager/login</a>. При сохранении все прежние сессии закрываются. Пароль передайте менеджеру лично.</p>
  <form method="post" action="/admin/managers/<%= manager.id %>/web-access">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="block my-2">Логин <input class="border rounded px-3 py-2" name="login" value="<%= manager.web_login || '' %>" required pattern="[a-zA-Z0-9._-]{3,64}" maxlength="64" autocomplete="off"></label>
    <label class="block my-2">Новый пароль <input class="border rounded px-3 py-2" type="password" name="password" minlength="12" maxlength="128" autocomplete="new-password" placeholder="Пусто — оставить прежний"></label>
    <label class="block my-2"><input type="checkbox" name="enabled" <%= manager.web_enabled?'checked':'' %>> Разрешить вход в веб-кабинет</label>
    <button class="px-4 py-2 rounded bg-stone-900 text-white">Сохранить доступ</button>
  </form>
</div>
<h2 class="text-sm font-extrabold text-stone-900 uppercase tracking-wide mb-3">Заявки клиентов (по ссылкам менеджера)</h2>
<div class="bg-white rounded-2xl border border-stone-200 p-4 mb-4">
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 text-center">
        <div><p class="text-[11px] font-bold text-stone-400 uppercase">Ссылок</p><p class="text-xl font-black text-stone-900"><%= clientFunnel.linksSent %></p></div>
        <div><p class="text-[11px] font-bold text-stone-400 uppercase">Открыли</p><p class="text-xl font-black text-stone-900"><%= clientFunnel.linksOpened %></p></div>
        <div><p class="text-[11px] font-bold text-stone-400 uppercase">Заявок</p><p class="text-xl font-black text-emerald-700"><%= clientFunnel.ordersCreated %></p></div>
        <div><p class="text-[11px] font-bold text-stone-400 uppercase">Разослано</p><p class="text-xl font-black text-stone-900"><%= clientFunnel.ordersDispatched %></p></div>
        <div><p class="text-[11px] font-bold text-stone-400 uppercase">Связались</p><p class="text-xl font-black text-stone-900"><%= clientFunnel.ordersContacted %></p></div>
        <div><p class="text-[11px] font-bold text-stone-400 uppercase">Закрыто</p><p class="text-xl font-black text-stone-900"><%= clientFunnel.ordersClosed %></p></div>
    </div>
    <form method="POST" action="/admin/managers/<%= manager.id %>/client-link" class="mt-4 flex gap-2 flex-wrap">
        <input type="hidden" name="requestKey" value="<%= crmRequestKey %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="tel" name="phone" placeholder="+995 5XX XX XX XX" required
            class="flex-1 min-w-[200px] border border-stone-300 rounded-xl px-3 py-2 text-sm">
        <button class="px-4 py-2 rounded-xl bg-stone-900 text-white text-sm font-bold">Сгенерировать ссылку</button>
    </form>
    <% if (typeof newInviteLink !== 'undefined' && newInviteLink) { %>
        <div class="mt-2 text-sm font-mono bg-emerald-50 border border-emerald-200 rounded-xl px-3 py-2 break-all"><%= newInviteLink %></div>
    <% } %>
</div>

<h2 class="text-sm font-extrabold text-stone-900 uppercase tracking-wide mb-3">Его исполнители</h2>
<% if (!stats.providers.length) { %>
  <p class="text-sm text-stone-500">Пока никого не привёл.</p>
<% } %>
<div class="space-y-2">
    <% stats.providers.forEach(function (m) { %>
      <a href="/admin/masters/<%= m.id %>" class="flex items-center justify-between gap-3 bg-white rounded-2xl border border-stone-200 p-3 hover:shadow-md transition">
          <div>
              <span class="font-extrabold text-stone-900"><%= m.name %></span>
              <span class="text-xs text-stone-400 ml-1"><%= m.phone %></span>
              <div class="text-[11px] text-stone-400 mt-0.5">
                  <%= new Date(m.created_at).toLocaleDateString('ru') %>
                  <% if (m.promo_code_used) { %> · код <span class="font-mono"><%= m.promo_code_used %></span><% } %> ·
                  <% if (m.is_banned) { %><span class="text-red-500 font-bold">бан</span>
                  <% } else if (m.is_active) { %><span class="text-emerald-600 font-bold">активен</span>
                  <% } else { %><span class="text-amber-600 font-bold">на модерации</span><% } %>
              </div>
          </div>
          <span class="font-mono text-sm font-bold text-stone-700"><%= (m.balance_tetri / 100).toFixed(2) %> ₾</span>
      </a>
    <% }); %>
</div>

<div class="bg-white rounded-2xl border border-stone-200 p-4 mt-6">
  <h2 class="font-extrabold">Журнал веб-кабинета · последние 100 событий</h2>
  <% portalEvents.forEach(e=>{ %><div class="border-b py-3"><p class="text-xs text-stone-500"><%= new Date(e.created_at).toLocaleString('ru-RU',{timeZone:'Asia/Tbilisi'}) %> · <%= ({note:'Заметка',ban:'Блокировка',unban:'Разблокировка',access_changed:'Изменение доступа',approve:'Быстрое одобрение',assign_category:'Назначена категория',edit_contact:'Правка контактов',reject:'Отклонена заявка'})[e.action] || e.action %> <% if(e.master_id){ %> · <a href="/admin/masters/<%= e.master_id %>">Специалист #<%= e.master_id %></a><% } %></p><p class="whitespace-pre-wrap break-words"><%= e.body %></p></div><% }) %>
</div>
<%- include('./_footer') %>

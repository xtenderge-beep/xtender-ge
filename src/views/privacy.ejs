<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title><%= t('privacy_page_title') %></title>
    <meta name="description" content="<%= t('meta_description_privacy') %>">

    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="alternate" hreflang="ka" href="<%= seo.alternates.ka %>">
    <link rel="alternate" hreflang="ru" href="<%= seo.alternates.ru %>">
    <link rel="alternate" hreflang="en" href="<%= seo.alternates.en %>">
    <link rel="alternate" hreflang="x-default" href="<%= seo.xDefault %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="xtender.ge">
    <meta property="og:title" content="<%= t('privacy_page_title') %>">
    <meta property="og:description" content="<%= t('meta_description_privacy') %>">
    <meta property="og:url" content="<%= seo.canonical %>">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= t('privacy_page_title') %>">
    <meta name="twitter:description" content="<%= t('meta_description_privacy') %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Georgian:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Inter', 'Noto Sans Georgian', 'sans-serif'] } } }
        }
    </script>
</head>
<body class="font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">

<%- include('_legal-doc', {
    doc: legalDoc,
    docKind: 'privacy',
    headline: t('privacy_headline'),
    requisites: requisites,
    reqLabels: reqLabels,
    reqPending: reqPending,
    labels: labels,
}) %>

</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>" class="h-full bg-stone-50">
<head>
    <%- include('partials/head', { title: copy.pageTitle, noindex: true }) %>
</head>
<%#
  Анкета от SMS-бота владельца (docs/outreach-bot-drafts.md). Те же галочки, что на /join (consent.service, роль provider),
  все сняты; «Подтвердить» сохраняет правки и шлёт код с сайта, код подтверждает регистрацию. Номер на странице частично скрыт.
%>
<body class="provider-page font-sans text-stone-800 bg-stone-50 min-h-screen antialiased">
    <header class="bg-white/95 border-b border-stone-200 shadow-sm">
        <div class="max-w-xl mx-auto px-4 flex items-center justify-between h-14">
            <a href="/" class="flex items-center gap-2"><%- include('partials/brand') %></a>
            <nav class="flex gap-1 text-sm font-bold" aria-label="Language">
                <% [['ka','ქარ'],['ru','Рус'],['en','Eng']].forEach(([code, label]) => { %>
                <a href="?lang=<%= code %>" class="px-2 py-1 rounded-lg <%= code === lang ? 'bg-emerald-50 text-emerald-700' : 'text-stone-500' %>" <%- code === lang ? 'aria-current="true"' : '' %>><%= label %></a>
                <% }); %>
            </nav>
        </div>
    </header>

    <main class="max-w-xl mx-auto px-4 py-6">
    <% if (state !== 'form') { %>
        <section class="bg-white rounded-2xl border border-stone-200 p-5 shadow-sm">
            <h1 class="text-xl font-black text-stone-900"><%= copy[state + 'Title'] %></h1>
            <p class="text-sm text-stone-600 mt-2"><%= copy[state + 'Text'] %></p>
            <% if (state === 'confirmed') { %>
                <a href="/master" class="mt-4 inline-flex px-4 py-3 rounded-xl bg-emerald-600 text-white font-bold text-sm"><%= t('master_login_nav') %></a>
            <% } else if (state === 'expired') { %>
                <a href="<%= lang === 'ka' ? '' : '/' + lang %>/join" class="mt-4 inline-flex px-4 py-3 rounded-xl bg-emerald-600 text-white font-bold text-sm"><%= copy.join %></a>
            <% } %>
        </section>
    <% } else { %>
        <% const legalPrefix = lang === 'ka' ? '' : '/' + lang; %>
        <div id="formScreen">
            <h1 class="text-2xl font-black tracking-tight text-stone-900"><%= copy.title %></h1>
            <p class="text-sm text-stone-600 mt-1"><%= copy.lead %></p>
            <p class="join-free-lead"><i class="fa-solid fa-gift" aria-hidden="true"></i><span><%= copy.free %></span></p>

            <form id="draftForm" class="bg-white rounded-2xl shadow-sm border border-stone-200 p-4 sm:p-5 space-y-5 mt-4" novalidate>
                <div>
                    <label for="nameInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= copy.name %></label>
                    <input id="nameInput" name="name" maxlength="120" autocomplete="name" value="<%= draft.name || '' %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm font-bold text-stone-900 bg-white">
                </div>

                <fieldset>
                    <legend class="block text-[11px] font-bold text-stone-700 uppercase mb-2"><%= copy.services %></legend>
                    <% const chosen = draft.services || []; const shown = services.filter(s => chosen.includes(s.code)); %>
                    <% if (shown.length) { %>
                    <div class="flex flex-wrap gap-2">
                        <% shown.forEach(s => { %>
                        <label class="flex items-center gap-2 px-3 py-3 rounded-xl border border-stone-200 text-sm"><input type="checkbox" name="services" value="<%= s.code %>" checked><span><%= s.name %></span></label>
                        <% }); %>
                    </div>
                    <% } %>
                    <% const others = services.filter(s => !chosen.includes(s.code)); %>
                    <% if (others.length) { %>
                    <details class="mt-2">
                        <summary class="cursor-pointer text-xs font-bold text-emerald-700 select-none"><%= copy.moreServices %></summary>
                        <div class="flex flex-wrap gap-2 mt-2">
                            <% others.forEach(s => { %>
                            <label class="flex items-center gap-2 px-3 py-3 rounded-xl border border-stone-200 text-sm"><input type="checkbox" name="services" value="<%= s.code %>"><span><%= s.name %></span></label>
                            <% }); %>
                        </div>
                    </details>
                    <% } %>
                    <label for="otherInput" class="block text-[11px] font-bold text-stone-700 uppercase mt-3 mb-1"><%= copy.otherServices %></label>
                    <input id="otherInput" name="otherServices" maxlength="600" value="<%= (draft.other_services || []).join(', ') %>" placeholder="<%= copy.otherServicesHint %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm text-stone-900 bg-white">
                </fieldset>

                <div>
                    <label for="descriptionInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= copy.description %></label>
                    <textarea id="descriptionInput" name="description" maxlength="2000" rows="5"
                        class="w-full text-sm text-stone-800 bg-stone-50 border border-stone-200 rounded-xl p-3 outline-none focus:border-emerald-500 focus:bg-white"><%= draft.description || '' %></textarea>
                    <p class="provider-help mt-1"><%= copy.descriptionHint %></p>
                </div>

                <div>
                    <label for="experienceInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= copy.experience %></label>
                    <input id="experienceInput" name="experience" maxlength="100" value="<%= draft.experience || '' %>" placeholder="<%= copy.experienceExample %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm text-stone-900 bg-white">
                </div>

                <fieldset>
                    <legend class="block text-[11px] font-bold text-stone-700 uppercase mb-2"><%= t('join_work_cities_label') %></legend>
                    <div class="flex flex-wrap gap-2">
                    <% cities.forEach(c => { %>
                        <label class="flex items-center gap-2 px-3 py-3 rounded-xl border border-stone-200 text-sm"><input type="checkbox" name="cityIds" value="<%= c.id %>" <%= (draft.city_ids || []).includes(c.id) ? 'checked' : '' %>><span><%= c.name %></span></label>
                    <% }); %>
                    </div>
                    <label for="districtsInput" class="block text-[11px] font-bold text-stone-700 uppercase mt-3 mb-1"><%= copy.districts %></label>
                    <input id="districtsInput" name="districts" maxlength="600" value="<%= (draft.districts || []).join(', ') %>" placeholder="<%= copy.districtsHint %>"
                        class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none text-sm text-stone-900 bg-white">
                </fieldset>

                <fieldset>
                    <legend class="block text-[11px] font-bold text-stone-700 uppercase mb-2"><%= t('join_languages_label') %></legend>
                    <div class="grid grid-cols-2 gap-2">
                    <% Object.entries(languageOptions).forEach(([code, label]) => { %>
                        <label class="flex items-center gap-2 px-3 py-3 rounded-xl border border-stone-200 text-sm"><input type="checkbox" name="spokenLanguages" value="<%= code %>" <%= (draft.languages || []).includes(code) ? 'checked' : '' %>><span><%= label %></span></label>
                    <% }); %>
                    </div>
                </fieldset>

                <div>
                    <span class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= copy.phone %></span>
                    <p class="px-4 py-3 rounded-xl bg-stone-100 text-sm font-bold text-stone-700 font-mono"><%= draft.phone %></p>
                    <p class="provider-help mt-1"><%= copy.phoneHint %></p>
                </div>

                <section class="rounded-xl border border-stone-200 bg-stone-50 p-3" aria-labelledby="beforeTitle">
                    <h2 id="beforeTitle" class="block text-[11px] font-bold text-stone-700 uppercase mb-1.5"><%= t('signup_before_title') %></h2>
                    <ul class="space-y-1.5 text-sm text-stone-700 list-disc pl-5">
                        <% consent.notices.forEach(notice => { %><li><%= notice %></li><% }) %>
                    </ul>
                </section>
                <div class="space-y-3">
                    <label class="flex items-start gap-3 p-3 rounded-xl border border-stone-200 text-sm cursor-pointer">
                        <input type="checkbox" id="termsCheckbox" class="mt-1 w-4 h-4 accent-emerald-600 shrink-0">
                        <span><%= consent.termsLabel %> <a href="<%= legalPrefix %>/terms" target="_blank" rel="noopener" class="text-emerald-700 underline"><%= t('signup_terms_link') %></a></span>
                    </label>
                    <label class="flex items-start gap-3 p-3 rounded-xl border border-stone-200 text-sm cursor-pointer">
                        <input type="checkbox" id="privacyCheckbox" class="mt-1 w-4 h-4 accent-emerald-600 shrink-0">
                        <span><%= consent.privacyLabel %> <a href="<%= legalPrefix %>/privacy" target="_blank" rel="noopener" class="text-emerald-700 underline"><%= t('join_privacy_link') %></a></span>
                    </label>
                    <label class="flex items-start gap-3 p-3 rounded-xl border border-stone-200 text-sm cursor-pointer">
                        <input type="checkbox" id="leadSmsCheckbox" class="mt-1 w-4 h-4 accent-emerald-600 shrink-0">
                        <span><b><%= consent.leadSms.title %></b><span class="block text-xs text-stone-600 mt-1"><%= consent.leadSms.text %></span><span class="block text-xs text-stone-500 mt-1"><%= consent.leadSms.hint %></span></span>
                    </label>
                    <label class="flex items-start gap-3 p-3 rounded-xl border border-stone-200 text-sm cursor-pointer">
                        <input type="checkbox" id="marketingSmsCheckbox" class="mt-1 w-4 h-4 accent-emerald-600 shrink-0">
                        <span><b><%= consent.marketingSms.title %></b><span class="block text-xs text-stone-600 mt-1"><%= consent.marketingSms.text %></span><span class="block text-xs text-stone-500 mt-1"><%= consent.marketingSms.hint %></span></span>
                    </label>
                    <p class="text-xs text-stone-500"><%= consent.confirmationHint %></p>
                </div>

                <div role="alert" aria-live="polite" id="formMsg" class="hidden text-sm font-bold p-3 rounded-xl"></div>
                <button id="confirmButton" type="submit" disabled
                    class="w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-check" aria-hidden="true"></i><span><%= copy.confirm %></span>
                </button>
                <p id="confirmHint" class="text-xs text-stone-500 text-center"><%= copy.confirmHint %></p>
            </form>
            <button id="declineButton" type="button" class="mt-6 mb-4 w-full text-center text-sm font-bold text-stone-500 underline underline-offset-2"><%= copy.decline %></button>
        </div>

        <section id="codeScreen" class="hidden bg-white rounded-2xl shadow-sm border border-stone-200 p-5">
            <h2 class="provider-section-title" tabindex="-1" id="codeTitle"><%= t('provider_otp_title') %></h2>
            <p class="text-sm text-stone-600 mt-2 mb-4"><span id="sentTo"></span></p>
            <label for="codeInput" class="block text-[11px] font-bold text-stone-700 uppercase mb-1"><%= t('otp_label') %></label>
            <input type="text" id="codeInput" maxlength="4" inputmode="numeric" autocomplete="one-time-code"
                class="w-full px-4 py-3 rounded-xl border-2 border-stone-200 focus:border-emerald-500 outline-none font-mono text-lg font-black tracking-[0.3em] text-center text-stone-900 bg-white">
            <div role="alert" aria-live="polite" id="codeMsg" class="hidden text-sm font-bold p-3 rounded-xl mt-3"></div>
            <button id="verifyButton" type="button" class="mt-4 w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-check" aria-hidden="true"></i><span><%= t('signup_confirm') %></span>
            </button>
            <button id="resendButton" type="button" class="mt-2 w-full py-3 text-sm font-bold text-stone-600 disabled:opacity-50"><%= t('otp_resend') %></button>
            <button id="backButton" type="button" class="w-full py-2 text-sm font-bold text-stone-500"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> <%= t('otp_back') %></button>
        </section>

        <section id="doneScreen" class="hidden bg-white rounded-2xl shadow-sm border border-stone-200 p-5">
            <h2 class="text-xl font-black text-stone-900" tabindex="-1" id="doneTitle"><%= copy.doneTitle %></h2>
            <p id="doneText" class="text-sm text-stone-600 mt-2"></p>
            <a id="cabinetLink" href="/master" class="mt-4 inline-flex px-4 py-3 rounded-xl bg-emerald-600 text-white font-bold text-sm"><%= copy.cabinet %></a>
        </section>

        <section id="declinedScreen" class="hidden bg-white rounded-2xl shadow-sm border border-stone-200 p-5">
            <h2 class="text-xl font-black text-stone-900" tabindex="-1" id="declinedTitle"><%= copy.declinedTitle %></h2>
            <p class="text-sm text-stone-600 mt-2"><%= copy.declinedText %></p>
        </section>

        <script>
        (function () {
            const C = <%- JSON.stringify({ doneSms: copy.doneSms, doneNoSms: copy.doneNoSms, declineAsk: copy.declineAsk, network: clientStrings.provider_signup_network, emptyCode: clientStrings.js_err_empty_code, resend: t('otp_resend') }) %>;
            const token = <%- JSON.stringify(token) %>, lang = <%- JSON.stringify(lang) %>, csrf = <%- JSON.stringify(csrf) %>;
            const consentDigest = <%- JSON.stringify(consent.digest) %>;
            const $ = id => document.getElementById(id);
            const form = $('draftForm'), confirmButton = $('confirmButton');
            let challengeId = null, busy = false, timer = null;

            function show(el, text, isError) {
                if (!text) { el.classList.add('hidden'); return; }
                el.textContent = text;
                el.classList.remove('hidden');
                el.classList.toggle('bg-red-50', Boolean(isError)); el.classList.toggle('text-red-700', Boolean(isError));
                el.classList.toggle('bg-emerald-50', !isError); el.classList.toggle('text-emerald-700', !isError);
            }
            function screen(id) {
                ['formScreen', 'codeScreen', 'doneScreen', 'declinedScreen'].forEach(name => $(name).classList.toggle('hidden', name !== id));
                window.scrollTo(0, 0);
            }
            function checked(name) { return [...form.querySelectorAll('input[name="' + name + '"]:checked')].map(el => el.value); }
            function payload() {
                return {
                    _csrf: csrf, lang,
                    name: $('nameInput').value.trim(),
                    services: checked('services'),
                    otherServices: $('otherInput').value,
                    description: $('descriptionInput').value.trim(),
                    experience: $('experienceInput').value.trim(),
                    cityIds: checked('cityIds'),
                    districts: $('districtsInput').value,
                    spokenLanguages: checked('spokenLanguages'),
                    termsAccepted: $('termsCheckbox').checked,
                    privacyAccepted: $('privacyCheckbox').checked,
                    leadSmsAccepted: $('leadSmsCheckbox').checked,
                    marketingSmsAccepted: $('marketingSmsCheckbox').checked,
                    consentDigest,
                };
            }
            async function post(path, body) {
                const res = await fetch('/c/' + token + '/' + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                return res.json();
            }
            function refreshButton() {
                const ready = $('termsCheckbox').checked && $('privacyCheckbox').checked;
                confirmButton.disabled = !ready || busy;
                $('confirmHint').classList.toggle('hidden', ready);
            }
            ['termsCheckbox', 'privacyCheckbox'].forEach(id => $(id).addEventListener('change', refreshButton));
            form.addEventListener('input', () => show($('formMsg'), ''));

            function cooldown() {
                const button = $('resendButton');
                clearInterval(timer);
                let left = 30;
                button.disabled = true; button.textContent = C.resend + ' (' + left + ')';
                timer = setInterval(() => {
                    left -= 1;
                    if (left <= 0) { clearInterval(timer); button.disabled = false; button.textContent = C.resend; }
                    else button.textContent = C.resend + ' (' + left + ')';
                }, 1000);
            }

            async function requestCode(fromCodeScreen) {
                if (busy) return;
                busy = true; refreshButton();
                try {
                    const data = await post('code', payload());
                    if (!data.success) {
                        if (fromCodeScreen) show($('codeMsg'), data.message || C.network, true);
                        else { screen('formScreen'); show($('formMsg'), data.message || C.network, true); }
                        return;
                    }
                    challengeId = data.challengeId;
                    $('sentTo').textContent = data.sentTo || '';
                    $('codeInput').value = '';
                    show($('codeMsg'), '');
                    screen('codeScreen');
                    cooldown();
                    $('codeInput').focus();
                } catch (_) {
                    show(fromCodeScreen ? $('codeMsg') : $('formMsg'), C.network, true);
                } finally { busy = false; refreshButton(); }
            }

            form.addEventListener('submit', e => { e.preventDefault(); requestCode(false); });
            $('resendButton').addEventListener('click', () => requestCode(true));
            $('backButton').addEventListener('click', () => { clearInterval(timer); challengeId = null; screen('formScreen'); });

            async function verify() {
                if (busy) return;
                const code = $('codeInput').value.trim();
                if (!code) return show($('codeMsg'), C.emptyCode, true);
                busy = true; $('verifyButton').disabled = true;
                try {
                    const data = await post('confirm', { _csrf: csrf, lang, code, challengeId });
                    if (!data.success) return show($('codeMsg'), data.message || C.network, true);
                    clearInterval(timer);
                    $('doneText').textContent = data.leadSms ? C.doneSms : C.doneNoSms;
                    if (data.link) $('cabinetLink').href = data.link;
                    screen('doneScreen');
                    $('doneTitle').focus();
                } catch (_) {
                    show($('codeMsg'), C.network, true);
                } finally { busy = false; $('verifyButton').disabled = false; }
            }
            $('verifyButton').addEventListener('click', verify);
            $('codeInput').addEventListener('input', () => { if (/^\d{4}$/.test($('codeInput').value.trim())) verify(); });

            $('declineButton').addEventListener('click', async () => {
                if (busy || !window.confirm(C.declineAsk)) return;
                busy = true;
                try {
                    const data = await post('decline', { _csrf: csrf, lang });
                    if (!data.success) return show($('formMsg'), data.message || C.network, true);
                    screen('declinedScreen');
                    $('declinedTitle').focus();
                } catch (_) {
                    show($('formMsg'), C.network, true);
                } finally { busy = false; }
            });
            refreshButton();
        })();
        </script>
    <% } %>
    </main>
</body>
</html>

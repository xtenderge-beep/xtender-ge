PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/xtender
REDIS_URL=redis://localhost:6379
SMS_GATEWAY_URL=http://212.72.155.180:2375/api/sendmsg.php
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
DOMAIN=localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Необязательно: если задан ADMIN_PHONE, вход в /admin требует ещё и SMS-код на этот
# номер (2FA). Без него /admin работает как раньше — только по паролю.
ADMIN_PHONE=
# Резервный код на случай недоступности ADMIN_PHONE — вводится вместо SMS-кода на том же
# экране. Настоятельно рекомендуется, если включили ADMIN_PHONE: единственный способ
# войти без него — доступ к переменным окружения на Railway.
ADMIN_2FA_RECOVERY_CODE=
CONSENT_HASH_PEPPER=
# Машинный перевод текста заявки на ka/ru/en (translation.service.js). Без ключа —
# заявки создаются как раньше, везде показывается оригинал. Ключ с openrouter.ai.
OPENROUTER_API_KEY=
# API v1 и вход OAuth для плагина ChatGPT (docs/api-v1/README.md, docs/api-v1/AUTH.md).
# XTENDER_SANDBOX=1 — песочница: SMS не уходят в шлюз, а складываются в GET /api/v1/sandbox/sms, Telegram выключен.
# Только для отдельной установки со своей базой; на рабочем сайте не задавать.
XTENDER_SANDBOX=
# Полный адрес сайта с протоколом, если он не https://$DOMAIN (песочница на http://127.0.0.1:3100).
PUBLIC_BASE_URL=
# Дополнительные разрешённые адреса возврата OAuth через запятую («*» — один сегмент). ChatGPT и Claude уже разрешены.
OAUTH_REDIRECT_ALLOWLIST=
# 1 — разрешить адреса возврата http://127.0.0.1 и localhost (тестовые клиенты) вне песочницы.
OAUTH_ALLOW_LOOPBACK=
# Необязательно: модель перевода. По умолчанию google/gemini-2.5-flash-lite
# (выбрана бенчмарком: чисто по ka/ru/en, ~0.6с, ~$0.14 за 1000 заявок).
OPENROUTER_TRANSLATION_MODEL=

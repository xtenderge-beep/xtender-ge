PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/xtender
REDIS_URL=redis://localhost:6379
SMS_GATEWAY_URL=http://212.72.155.180:2375/api/sendmsg.php
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
DOMAIN=localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Необязательно: если задан ADMIN_PHONE, вход в /admin требует ещё и SMS-код на этот
# номер (2FA). Без него /admin работает как раньше — только по паролю.
ADMIN_PHONE=
# Резервный код на случай недоступности ADMIN_PHONE — вводится вместо SMS-кода на том же
# экране. Настоятельно рекомендуется, если включили ADMIN_PHONE: единственный способ
# войти без него — доступ к переменным окружения на Railway.
ADMIN_2FA_RECOVERY_CODE=
CONSENT_HASH_PEPPER=

    "seed:masters": "node scripts/seed-masters.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "multer": "^2.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "ioredis-mock": "^8.13.1",
    "nodemon": "^3.1.7",
    "pg-mem": "^3.0.14",
    "subset-font": "^2.7.0",
    "tailwindcss": "^3.4.19"

{
  "name": "xtender",
  "version": "1.0.0",
  "description": "Xtender - platform for master orders by district",
  "main": "src/app.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "build:fa": "node scripts/build-fa.js",
